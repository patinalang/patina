// This declaration will look for a file named `my_mod.rs` and will
// insert its contents inside a module named `my_mod` under this scope
mod my_mod;

fn function() {
    println!("called `function()`");
}

pub fn main() {
    my_mod::function();

    function();

    my_mod::indirect_access();

    my_mod::nested::function();
}

