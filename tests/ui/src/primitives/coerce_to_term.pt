pub fn coerce(base: int) -> term {
    base
}

pub fn coerce_map_value(base: #{str => int}) -> #{str => term} {
    base
}

pub fn coerce_map_key(base: #{int => str}) -> #{term => str} {
    base
}

pub fn update_map(base: #{str => int}) -> #{str => term} {
    #{"enabled" => true, ..base}
}

pub fn coerce_slice(values: [int]) -> [term] {
    values
}

pub fn coerce_array(values: [int; 2]) -> [term; 2] {
    values
}

pub fn coerce_tuple(value: (int, bool)) -> (term, term) {
    value
}

pub fn coerce_nested_map(base: #{str => #{str => int}}) -> #{str => #{str => term}} {
    base
}
