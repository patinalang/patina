pub fn bare_rest_must_be_last(xs: [int]) {
    match xs {
        [first, .., last] => (),
        _ => (),
    }
}

pub fn bound_rest_must_be_last(xs: [int]) {
    match xs {
        [first, middle @ .., last] => (),
        _ => (),
    }
}

pub fn only_one_rest_is_allowed(xs: [int]) {
    match xs {
        [first, .., ..] => (),
        _ => (),
    }
}
