const NAME_KEY: str = "name";

fn length(s: str) -> int {
    0
}

pub fn unpinned_local(map: #{str => int}, key: str) -> int {
    match map {
        #{key => value, ..} => value,
        _ => -1,
    }
}

pub fn nested_local(map: #{(int, str) => int}, key: str) -> int {
    match map {
        #{(1, key) => value, ..} => value,
        _ => -1,
    }
}

pub fn local_in_map(map: #{#{int => str} => int}, key: str) -> int {
    match map {
        #{#{1 => key} => value, ..} => value,
        _ => -1,
    }
}

pub fn pinned_constant(map: #{str => int}) -> int {
    match map {
        #{^NAME_KEY => value, ..} => value,
        _ => -1,
    }
}

pub fn arithmetic(map: #{int => int}) -> int {
    match map {
        #{1 + 1 => value, ..} => value,
        _ => -1,
    }
}

pub fn call(map: #{int => int}) -> int {
    match map {
        #{length("a") => value, ..} => value,
        _ => -1,
    }
}

pub fn range(map: #{int => int}) -> int {
    match map {
        #{1..3 => value, ..} => value,
        _ => -1,
    }
}

pub fn list_tail(map: #{[int] => int}, tail: [int]) -> int {
    match map {
        #{[1, ..^tail] => value, ..} => value,
        _ => -1,
    }
}

pub fn map_update(map: #{#{int => int} => int}, base: #{int => int}) -> int {
    match map {
        #{#{1 => 2, ..^base} => value, ..} => value,
        _ => -1,
    }
}

pub fn wildcard(map: #{int => int}) -> int {
    match map {
        #{_ => value, ..} => value,
        _ => -1,
    }
}

pub fn wildcard_in_assignment(map: #{int => int}) {
    #{_ => _, ..} = map;
}

pub fn splittable_or_key(map: #{int => int}) -> int {
    match map {
        #{1 | 2 | 3 => value, ..} => value,
        _ => -1,
    }
}

pub fn nested_or_key(map: #{(int, int) => int}) -> int {
    match map {
        #{(0, (1 | 2)) => value, ..} => value,
        _ => -1,
    }
}

pub fn or_key_in_assignment(map: #{int => int}) {
    #{1 | 2 => _, ..} = map;
}

pub fn pin_outside_key(value: int) -> int {
    ^value
}
