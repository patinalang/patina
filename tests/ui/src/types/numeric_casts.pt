pub fn float_to_int(value: float) -> int {
    value as int
}

pub fn int_to_float(value: int) -> float {
    value as float
}

pub fn float_to_int_to_term(value: float) -> term {
    (value as int) as term
}

pub fn int_to_float_to_term(value: int) -> term {
    (value as float) as term
}

pub fn main() {
    let _ = float_to_int(3.14);
    let _ = int_to_float(42);
    let _ = float_to_int_to_term(3.14);
    let _ = int_to_float_to_term(42);
}
