// block: 1/3

use Std::Fmt;

struct Circle {
    radius: int
}

impl Fmt::Display for Circle {
    fn fmt(self, f: Fmt::Formatter) -> Fmt::Result {
        write!(f, "Circle of radius {}", self.radius)
    }
}

pub fn main() {
    let circle = Circle { radius: 6 };
    println!("{}", circle.to_str());
}
