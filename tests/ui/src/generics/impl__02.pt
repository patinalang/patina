// source: patina-by-example/src/generics/impl.md
// block: 2/2

struct Val {
    val: int,
}

struct GenVal<T> {
    gen_val: T,
}

// impl of Val
impl Val {
    fn value(self) -> int {
        self.val
    }
}

// impl of GenVal for a generic type `T`
impl<T> GenVal<T> {
    fn value(self) -> T {
        self.gen_val
    }
}

pub fn main() {
    let x = Val { val: 3 };
    let y = GenVal { gen_val: 42 };

    println!("{}, {}", x.value(), y.value());
}
