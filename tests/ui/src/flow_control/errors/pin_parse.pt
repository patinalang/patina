pub fn literal(value: int) -> bool {
    match value {
        ^1 => true,
        _ => false,
    }
}

pub fn expression(value: int, expected: int) -> bool {
    match value {
        ^(expected) => true,
        _ => false,
    }
}

pub fn path(value: int) -> bool {
    match value {
        ^foo::bar => true,
        _ => false,
    }
}
