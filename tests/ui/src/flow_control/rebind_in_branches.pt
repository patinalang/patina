pub fn branch_result(take_then: bool) -> int {
    let mut value = 10;

    let block_value = if take_then {
        value += 1;
        100
    } else {
        value += 2;
        200
    };

    block_value + value
}

pub fn latest_version_wins(take_then: bool) -> int {
    let mut value = 1;

    if take_then {
        value = 2;
        value = 3;
    } else {
        value = 4;
    }

    value
}

pub fn initialize_in_branches(take_then: bool) -> int {
    let value;

    if take_then {
        value = 10;
    } else {
        value = 20;
    }

    value
}

pub fn initialize_or_return(take_then: bool) -> int {
    let value;

    if take_then {
        value = 30;
    } else {
        return 40;
    }

    value
}

pub fn nested_result() -> int {
    let mut value = 10;

    let block_value = {
        let inner_value = {
            value += 1;
            100
        };

        value += 2;
        inner_value + 1000
    };

    block_value + value
}

pub fn nested_branches(take_outer: bool, take_inner: bool) -> int {
    let mut value = 0;

    let block_value = if take_outer {
        let inner_value = if take_inner {
            value = 1;
            10
        } else {
            value = 2;
            20
        };
        inner_value + 100
    } else {
        value = 3;
        300
    };

    block_value + value
}

pub fn nested_diverging_rebind(take_outer: bool, take_inner: bool) -> int {
    let mut value = 0;

    if take_outer {
        if take_inner {
            value = 1;
            return value;
        } else {
            ()
        }
    } else {
        ()
    }

    10
}

pub fn short_circuit_result(run_block: bool) -> int {
    let mut value = 10;

    let _result = run_block && {
        value += 5;
        true
    };

    value
}

enum Branch {
    First,
    Second,
}

pub fn match_result(take_first: bool) -> int {
    let mut value = 10;
    let branch = if take_first { Branch::First } else { Branch::Second };

    let block_value = match branch {
        Branch::First => {
            value += 1;
            100
        }
        Branch::Second => {
            value += 2;
            200
        }
    };

    block_value + value
}
