pub fn break_outer_loop() -> int {
    let mut value = 0;

    'outer: loop {
        loop {
            value += 1;
            break 'outer value;
        }
    }
}

pub fn break_two_loops() -> int {
    let mut value = 0;

    'outer: loop {
        loop {
            loop {
                value += 1;

                if value == 3 {
                    break 'outer value * 10;
                }
            }
        }
    }
}

pub fn outer_break_initializes() -> int {
    let value;

    'outer: loop {
        loop {
            value = 7;
            break 'outer;
        }
    }

    value
}
