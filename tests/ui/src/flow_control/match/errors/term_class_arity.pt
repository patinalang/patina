fn no_fields(value: term) -> bool {
    match value { int() => true, _ => false }
}

fn two_fields(value: term) -> bool {
    match value { atom(_, _) => true, _ => false }
}

fn keyword_no_fields(value: term) -> bool {
    match value { fn() => true, _ => false }
}

fn keyword_two_fields(value: term) -> bool {
    match value { ref(_, _) => true, _ => false }
}
