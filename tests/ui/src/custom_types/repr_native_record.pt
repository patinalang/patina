#[repr(native_record)]
enum WholeEnum {
    Unit,
}

enum MixedEnum {
    AtomUnit,
    #[repr(native_record)]
    RecordUnit,
}

#[repr(Elixir)]
struct ElixirUnit;

#[repr(native_record)]
pub struct NativeRecordStruct {
    x: int,
    y: int,
}

#[repr(native_record)]
pub struct NativeRecordPair(int, int);

impl NativeRecordStruct {
    pub fn sum(self) -> int {
        self.x + self.y
    }
}

pub fn inherited_unit() -> term {
    WholeEnum::Unit as term
}

pub fn overridden_unit() -> term {
    MixedEnum::RecordUnit as term
}

pub fn elixir_unit() -> term {
    ElixirUnit as term
}

pub fn record_struct() -> NativeRecordStruct {
    NativeRecordStruct { x: 10, y: 20 }
}

pub fn struct_x(value: NativeRecordStruct) -> int {
    value.x
}

pub fn record_pair() -> NativeRecordPair {
    NativeRecordPair(30, 40)
}

pub fn pair_second(value: NativeRecordPair) -> int {
    value.1
}

#[repr(native_record)]
pub struct KeywordField {
    `type`: int,
    other: int,
}

pub fn keyword_field() -> KeywordField {
    KeywordField { `type`: 7, other: 1 }
}

pub fn keyword_field_value(value: KeywordField) -> int {
    value.`type`
}

pub fn keyword_field_updated(value: KeywordField) -> KeywordField {
    KeywordField { `type`: 8, ..value }
}

pub fn keyword_field_pattern(value: KeywordField) -> int {
    let KeywordField { `type`, .. } = value;
    `type`
}
