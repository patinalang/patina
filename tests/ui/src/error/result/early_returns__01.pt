// block: 1/1

use Std::Num::ParseIntError;

fn multiply(first_number_str: str, second_number_str: str) -> Result<int, ParseIntError> {
    let first_number = match first_number_str.parse::<int>() {
        Ok(first_number)  => first_number,
        Err(e) => return Err(e),
    };

    let second_number = match second_number_str.parse::<int>() {
        Ok(second_number)  => second_number,
        Err(e) => return Err(e),
    };

    Ok(first_number * second_number)
}

fn print(result: Result<int, ParseIntError>) {
    match result {
        Ok(n)  => println!("n is {}", n),
        Err(e) => println!("Error: {}", e),
    }
}

pub fn main() {
    print(multiply("10", "2"));
    print(multiply("t", "2"));
}
