use Std::Num::ParseIntError;

pub fn main() -> Result<(), ParseIntError> {
    let number_str = "10";
    let number = match number_str.parse::<int>() {
        Ok(number)  => number,
        Err(e) => return Err(e),
    };
    println!("{}", number);
    Ok(())
}
