#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

trait Show {
    fn show(self)
    -> str;
}

impl Show for int {
    fn show(self) -> str { "i" }
}

impl Show for str {
    fn show(self) -> str { self }
}

impl Show for () {
    fn show(self) -> str { "()" }
}

macro_rules! tuple_show {
    ($($name:ident)+) =>
    {
        impl<$($name: Show),+> Show for ($($name,)+)
        {
            #[allow(non_snake_case)] fn show(self) -> str
            { let ($($name,)+) = self; "(" $(+ $name.show() + ",")+ + ")" }
        }
    };
}
impl<A: Show> Show for (A,) {
    #[allow(non_snake_case)]
    fn show(self) -> str { let (A,) = self; "(" + A.show() + "," + ")" }
}
impl<A: Show, B: Show> Show for (A, B) {
    #[allow(non_snake_case)]
    fn show(self) -> str {
        let (A, B) = self;
        "(" + A.show() + "," + B.show() + "," + ")"
    }
}
impl<A: Show, B: Show, C: Show> Show for (A, B, C) {
    #[allow(non_snake_case)]
    fn show(self) -> str {
        let (A, B, C) = self;
        "(" + A.show() + "," + B.show() + "," + C.show() + "," + ")"
    }
}


fn show_generic<T: Show>(t: T) -> str { t.show() }

pub fn show_unit() -> str { ().show() }

pub fn show_pair(n: int, s: str) -> str { (n, s).show() }

pub fn show_generic_all(n: int, s: str) -> str {
    show_generic((n,)) + show_generic((n, s)) + show_generic((n, s, (n, ())))
}
