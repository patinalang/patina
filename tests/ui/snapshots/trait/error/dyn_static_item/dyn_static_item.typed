#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

trait Shape {
    const
    SIDES:
    int;

    fn new(size: int)
    -> Self;
}

fn make()
    ->
        dyn Shape ({
    ((<dyn Shape>::new as
            fn(int) -> dyn Shape {<dyn Shape as Shape>::new})((1 as int)) as
        dyn Shape)
} as dyn Shape)

fn make_inferred()
    ->
        dyn Shape ({
    let shape: dyn Shape =
        ((Shape::new as
                fn(int) -> dyn Shape {<dyn Shape as Shape>::new})((2 as int))
            as dyn Shape);
    (shape as dyn Shape)
} as dyn Shape)

fn sides() -> int ({ (<dyn Shape>::SIDES as int) } as int)

fn main() ({ } as ())
