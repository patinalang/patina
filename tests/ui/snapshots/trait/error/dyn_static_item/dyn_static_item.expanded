#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

trait Shape {
    const SIDES: int;

    fn new(size: int)
    -> Self;
}

pub fn make() -> dyn Shape { <dyn Shape>::new(1) }

pub fn make_inferred() -> dyn Shape {
    let shape: dyn Shape = Shape::new(2);
    shape
}

pub fn sides() -> int { <dyn Shape>::SIDES }

pub fn main() {}
