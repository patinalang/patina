#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn compare<T>(a: T, b: T) -> bool where
    T: PartialEq ({ ((a as T) == (b as T) as bool) } as bool)

fn main() ({
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)(((compare as
                                        fn(int, int) -> bool {compare::<int>})((1 as int),
                                    (1 as int)) as bool)) as term)] as [term])] as [[term]])) as
            term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
