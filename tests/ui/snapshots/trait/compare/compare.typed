#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn compare<T>(a: T, b: T) -> bool where
    T: PartialEq ({ ((a as T) == (b as T) as bool) } as bool)

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((compare as
                                        fn(int, int) -> bool {compare::<int>})((1 as int),
                                    (1 as int)) as bool)) as term)] as [term])] as [[term]])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
