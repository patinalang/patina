#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn compare<T: PartialEq>(a: T, b: T) -> bool { a == b }

pub fn main() {
    { io::put_chars([[patina_fmt::display(compare(1, 1))]]); io::nl(); };
}
