#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

fn compare<T: PartialEq>(a: T, b: T) -> bool { a == b }

pub fn main() {
    {
        ::core::io::put_chars([[::core::patina_fmt::display(compare(1, 1))]]);
        ::core::io::nl();
    };
}
