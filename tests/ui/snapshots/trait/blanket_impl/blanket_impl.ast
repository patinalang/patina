trait Show {
    fn show(self)
    -> str;
}

impl Show for int {
    fn show(self) -> str { "an int" }
}

impl Show for str {
    fn show(self) -> str { self }
}

trait Describe {
    fn describe(self)
    -> str;

    fn shout(self) -> str { self.describe() + "!" }
}

// Called from the host module, so it must be exported from this one.
fn wrap(s: str) -> str { "<" + s + ">" }

impl<T: Show> Describe for T {
    fn describe(self) -> str { wrap(self.show()) }
}

impl Describe for (int, str) {
    fn describe(self) -> str { self.0.show() + " and " + self.1.show() }
}

mod nested {
    pub trait Twice {
        fn twice(self)
        -> str;
    }

    impl<T: super::Describe> Twice for T {
        fn twice(self) -> str { self.describe() + self.describe() }
    }
}

use nested::Twice;

fn describe_generic<T: Describe>(t: T) -> str { t.describe() }

fn twice_generic<T: Twice>(t: T) -> str { t.twice() }

pub fn describe_int(n: int) -> str { n.describe() }

pub fn shout_str(s: str) -> str { s.shout() }

pub fn describe_generic_int(n: int) -> str { describe_generic(n) }

pub fn describe_pair(n: int, s: str) -> str { (n, s).describe() }

pub fn shout_pair_generic(n: int, s: str) -> str {
    describe_generic((n, s)) + (n, s).shout()
}

pub fn twice_str(s: str) -> str { s.twice() }

pub fn twice_generic_pair(n: int, s: str) -> str { twice_generic((n, s)) }
