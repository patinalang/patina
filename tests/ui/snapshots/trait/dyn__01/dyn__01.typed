#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait/dyn.md
// block: 1/1

struct Sheep {
}
struct Cow {
}

trait Animal {
    // Instance method signature
    fn noise(self)
    -> str;
}

// Implement the `Animal` trait for `Sheep`.
impl Animal for Sheep {
    fn noise(self) -> str ({ ("baaaaah!" as str) } as str)
}

// Implement the `Animal` trait for `Cow`.
impl Animal for Cow {
    fn noise(self) -> str ({ ("moooooo!" as str) } as str)
}

// Returns some struct that implements Animal, but we don't know which one at compile time.
fn random_animal(random_number: float)
    ->
        dyn Animal ({
    (if ((random_number as float) < (0.5 as float) as bool) {
        (Sheep {  } as Sheep)
    } else { (Cow {  } as Cow) } as {type error})
} as {type error})

fn main() ({
    let random_number = (0.234 as float);
    let animal =
        ((random_animal as
                fn(float) -> (dyn Animal + 'static) {random_animal})((random_number
                as float)) as dyn Animal);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("You\'ve randomly chosen an animal, and it says "
                                as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((animal as dyn Animal).noise() as str))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
