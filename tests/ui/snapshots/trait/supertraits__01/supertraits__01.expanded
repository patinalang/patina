#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait/supertraits.md
// block: 1/1

trait Person {
    fn name(self)
    -> str;
}

// Person is a supertrait of Student.
// Implementing Student requires you to also impl Person.
trait Student: Person {
    fn university(self)
    -> str;
}

trait Programmer {
    fn fav_language(self)
    -> str;
}

// CompSciStudent (computer science student) is a subtrait of both Programmer
// and Student. Implementing CompSciStudent requires you to impl both supertraits.
trait CompSciStudent: Programmer + Student {
    fn git_username(self)
    -> str;
}

fn comp_sci_student_greeting(student: dyn CompSciStudent) -> str {
    (/*ERROR*/)
}

struct CSStudent {
    name: str,
    university: str,
    fav_language: str,
    git_username: str,
}

impl Programmer for CSStudent {
    fn fav_language(self) -> str { self.fav_language }
}

impl Student for CSStudent {
    fn university(self) -> str { self.university }
}

impl Person for CSStudent {
    fn name(self) -> str { self.name }
}

impl CompSciStudent for CSStudent {
    fn git_username(self) -> str { self.git_username }
}

pub fn main() {
    let student =
        CSStudent {
            name: "Alice",
            university: "MIT",
            fav_language: "Rust",
            git_username: "alice_codes",
        };

    let greeting = comp_sci_student_greeting(student);
    { io::put_chars([[patina_fmt::display(greeting)]]); io::nl(); };
}
