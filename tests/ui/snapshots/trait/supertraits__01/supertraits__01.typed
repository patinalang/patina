#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/trait/supertraits.md
// block: 1/1

trait Person {
    fn name(self)
    -> str;
}

// Person is a supertrait of Student.
// Implementing Student requires you to also impl Person.
trait Student: Person {
    fn university(self)
    -> str;
}

trait Programmer {
    fn fav_language(self)
    -> str;
}

// CompSciStudent (computer science student) is a subtrait of both Programmer
// and Student. Implementing CompSciStudent requires you to impl both supertraits.
trait CompSciStudent: Programmer + Student {
    fn git_username(self)
    -> str;
}

fn comp_sci_student_greeting(student: dyn CompSciStudent)
    ->
        str ({







    (unsafe {
        (((::core::unicode::characters_to_binary as
                    fn(term) -> term)(([("My name is " as str),
                        ((::core::patina_fmt::display as
                                fn(term) -> term)(((student as dyn CompSciStudent).name() as
                                str)) as term), (" and I attend " as str),
                        ((::core::patina_fmt::display as
                                fn(term) -> term)(((student as
                                    dyn CompSciStudent).university() as str)) as term),
                        (". My favorite language is " as str),
                        ((::core::patina_fmt::display as
                                fn(term) -> term)(((student as
                                    dyn CompSciStudent).fav_language() as str)) as term),
                        (". My Git username is " as str),
                        ((::core::patina_fmt::display as
                                fn(term) -> term)(((student as
                                    dyn CompSciStudent).git_username() as str)) as term)] as
                    [term])) as term).cast_unchecked::<str>() as str)
    } as str)
} as str)
struct CSStudent {
    name: str,
    university: str,
    fav_language: str,
    git_username: str,
}
impl Programmer for CSStudent {
    fn fav_language(self)
        -> str ({ ((self as CSStudent).fav_language as str) } as str)
}
impl Student for CSStudent {
    fn university(self)
        -> str ({ ((self as CSStudent).university as str) } as str)
}
impl Person for CSStudent {
    fn name(self) -> str ({ ((self as CSStudent).name as str) } as str)
}
impl CompSciStudent for CSStudent {
    fn git_username(self)
        -> str ({ ((self as CSStudent).git_username as str) } as str)
}
fn main() ({
    let student =
        (CSStudent {
            name: ("Alice" as str),
            university: ("MIT" as str),
            fav_language: ("Rust" as str),
            git_username: ("alice_codes" as str) } as CSStudent);
    let greeting =
        ((comp_sci_student_greeting as
                fn((dyn CompSciStudent + 'static)) -> str {comp_sci_student_greeting})((student
                as CSStudent)) as str);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((greeting as str)) as term)] as [term])]
                as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
