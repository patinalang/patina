#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]




#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;
#[allow(unused)]
extern mod patina_fmt;

pub trait Same<Rhs> {
    fn same(self, other: Rhs)
    -> bool;
}

pub trait Scale {
    fn factor(self)
    -> int;
}

pub trait Shape: Same<Self> {
    const SIDES: int;

    fn new(size: int)
    -> Self;
    fn grow(self)
    -> Self;
    fn scaled<T: Scale>(self, by: T)
    -> int;
}

pub struct Two;

impl Scale for Two {
    fn factor(self) -> int { 2 }
}

pub fn use_dyn(shape: dyn Shape, other: dyn Shape) -> bool {
    let bigger = shape.grow();
    let _ = bigger.scaled(Two);
    bigger.same(other)
}

pub fn receiver_method_path(shape: dyn Shape) -> dyn Shape {
    Shape::grow(shape)
}

pub fn main() {}
