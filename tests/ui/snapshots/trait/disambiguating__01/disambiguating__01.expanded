#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait/disambiguating.md
// block: 1/1

trait UsernameWidget {
    // Get the selected username out of this widget
    fn get(self)
    -> str;
}

trait AgeWidget {
    // Get the selected age out of this widget
    fn get(self)
    -> int;
}

// A form with both a UsernameWidget and an AgeWidget
struct Form {
    username: str,
    age: int,
}

impl UsernameWidget for Form {
    fn get(self) -> str { self.username }
}

impl AgeWidget for Form {
    fn get(self) -> int { self.age }
}

pub fn main() {
    let form = Form { username: "rustacean", age: 28 };

    // If you uncomment this line, you'll get an error saying
    // "multiple `get` found". Because, after all, there are multiple methods
    // named `get`.
    // println!("{}", form.get());

    let username = <Form as UsernameWidget>::get(form);
    (/*ERROR*/);
    let age = <Form as AgeWidget>::get(form);
    (/*ERROR*/);
}
