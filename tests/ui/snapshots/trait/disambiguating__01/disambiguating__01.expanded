#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/trait/disambiguating.md
// block: 1/1

trait UsernameWidget {
    // Get the selected username out of this widget
    fn get(self)
    -> str;
}

trait AgeWidget {
    // Get the selected age out of this widget
    fn get(self)
    -> int;
}

// A form with both a UsernameWidget and an AgeWidget
struct Form {
    username: str,
    age: int,
}

impl UsernameWidget for Form {
    fn get(self) -> str { self.username }
}

impl AgeWidget for Form {
    fn get(self) -> int { self.age }
}

pub fn main() {
    let form = Form { username: "rustacean", age: 28 };

    // If you uncomment this line, you'll get an error saying
    // "multiple `get` found". Because, after all, there are multiple methods
    // named `get`.
    // println!("{}", form.get());

    let username = <Form as UsernameWidget>::get(form);
    match ("rustacean", username) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::Core::erlang::error(::Core::Panic::new(unsafe {
                                    ::Core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
    let age = <Form as AgeWidget>::get(form);
    match (28, age) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::Core::erlang::error(::Core::Panic::new(unsafe {
                                    ::Core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
}
