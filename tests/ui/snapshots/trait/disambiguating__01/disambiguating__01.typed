#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait/disambiguating.md
// block: 1/1

trait UsernameWidget {
    // Get the selected username out of this widget
    fn get(self)
    -> str;
}

trait AgeWidget {
    // Get the selected age out of this widget
    fn get(self)
    -> int;
}

// A form with both a UsernameWidget and an AgeWidget
struct Form {
    username: str,
    age: int,
}

impl UsernameWidget for Form {
    fn get(self) -> str ({ ((self as Form).username as str) } as str)
}

impl AgeWidget for Form {
    fn get(self) -> int ({ ((self as Form).age as int) } as int)
}

fn main() ({
    let form =
        (Form { username: ("rustacean" as str), age: (28 as int) } as Form);

    // If you uncomment this line, you'll get an error saying
    // "multiple `get` found". Because, after all, there are multiple methods
    // named `get`.
    // println!("{}", form.get());

    let username =
        ((<Form as UsernameWidget>::get as
                fn(Form) -> str {<Form as UsernameWidget>::get})((form as
                Form)) as str);
    ((/*ERROR*/) as {type error});
    let age =
        ((<Form as AgeWidget>::get as
                fn(Form) -> int {<Form as AgeWidget>::get})((form as Form)) as
            int);
    ((/*ERROR*/) as {type error});
} as ())
