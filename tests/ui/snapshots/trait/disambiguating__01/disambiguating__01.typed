#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/trait/disambiguating.md
// block: 1/1

trait UsernameWidget {
    // Get the selected username out of this widget
    fn get(self)
    -> str;
}

trait AgeWidget {
    // Get the selected age out of this widget
    fn get(self)
    -> int;
}

// A form with both a UsernameWidget and an AgeWidget
struct Form {
    username: str,
    age: int,
}

impl UsernameWidget for Form {
    fn get(self) -> str ({ ((self as Form).username as str) } as str)
}

impl AgeWidget for Form {
    fn get(self) -> int ({ ((self as Form).age as int) } as int)
}

fn main() ({
    let form =
        (Form { username: ("rustacean" as str), age: (28 as int) } as Form);

    // If you uncomment this line, you'll get an error saying
    // "multiple `get` found". Because, after all, there are multiple methods
    // named `get`.
    // println!("{}", form.get());

    let username =
        ((<Form as UsernameWidget>::get as
                fn(Form) -> str {<Form as UsernameWidget>::get})((form as
                Form)) as str);
    (match ((("rustacean" as str), (username as str)) as (str, str)) {
        (left_val, right_val) => {
            (if (!(((left_val as str) == (right_val as str) as bool)) as bool)
                {
                (unsafe {
                    (((::core::erlang::error as
                                fn(term, term, term) -> term)(((::core::Panic::new as
                                    fn(str) -> core::Panic {core::Panic::new})((unsafe {
                                    (((::core::unicode::characters_to_binary as
                                                fn(term) -> term)(([("assertion `left == right` failed" as
                                                        str),
                                                    ((patina_fmt::display as fn(term) -> term)(("" as str)) as
                                                        term), ("\n  left: " as str),
                                                    ((patina_fmt::debug as fn(term) -> term)((left_val as str))
                                                        as term), ("\n right: " as str),
                                                    ((patina_fmt::debug as fn(term) -> term)((right_val as str))
                                                        as term)] as [term])) as term).cast_unchecked::<str>() as
                                        str)
                                } as str)) as core::Panic), (a"none" as atom),
                            ([(((a"error_info" as atom),
                                        (#{(a"module" as atom) =>
                                                (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                                        as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                            as term).cast_unchecked::<!>() as !)
                } as ())
            } as ())
        }
    } as ());
    let age =
        ((<Form as AgeWidget>::get as
                fn(Form) -> int {<Form as AgeWidget>::get})((form as Form)) as
            int);
    (match (((28 as int), (age as int)) as (int, int)) {
        (left_val, right_val) => {
            (if (!(((left_val as int) == (right_val as int) as bool)) as bool)
                {
                (unsafe {
                    (((::core::erlang::error as
                                fn(term, term, term) -> term)(((::core::Panic::new as
                                    fn(str) -> core::Panic {core::Panic::new})((unsafe {
                                    (((::core::unicode::characters_to_binary as
                                                fn(term) -> term)(([("assertion `left == right` failed" as
                                                        str),
                                                    ((patina_fmt::display as fn(term) -> term)(("" as str)) as
                                                        term), ("\n  left: " as str),
                                                    ((patina_fmt::debug as fn(term) -> term)((left_val as int))
                                                        as term), ("\n right: " as str),
                                                    ((patina_fmt::debug as fn(term) -> term)((right_val as int))
                                                        as term)] as [term])) as term).cast_unchecked::<str>() as
                                        str)
                                } as str)) as core::Panic), (a"none" as atom),
                            ([(((a"error_info" as atom),
                                        (#{(a"module" as atom) =>
                                                (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                                        as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                            as term).cast_unchecked::<!>() as !)
                } as ())
            } as ())
        }
    } as ());
} as ())
