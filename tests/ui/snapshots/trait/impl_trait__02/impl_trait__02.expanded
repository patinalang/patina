#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait/impl_trait.md
// block: 2/3

fn parse_csv_document(src: impl Std::Io::BufRead)
    -> Std::Io::Result<[[str]]> {
    src.lines().map(
            // For each line in the source
            // If the line was read successfully, process it, if not, return the error
            // Split the line separated by commas
            // Remove leading and trailing whitespace
            // Collect all strings in a row into a [str]
            |line|
                {
                    line.map(|line|
                            { line.split(',').map(|entry| entry.trim()).collect() })
                }).collect() // Collect all lines into a [[str]]
}
