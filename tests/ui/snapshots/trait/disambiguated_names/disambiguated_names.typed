#![allow(internal_features)]




#![allow(non_local_definitions)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;
#[allow(unused)]
extern mod patina_fmt;

trait Show {
    fn show(self)
    -> str;
}

trait From<T> {
    fn from(t: T)
    -> Self;
}

struct Pair<T>(T);

struct Celsius;

struct Wrapper;

fn sibling_blocks() ({
    ({
        struct Foo;
        impl Pair<Foo> {
            fn value(self) -> int ({ (1 as int) } as int)
        }
        impl From<Foo> for Celsius {
            fn from(_foo: Foo) -> Self ({ (Celsius as Celsius) } as Celsius)
        }
        impl Show for Foo {
            fn show(self) -> str ({ ("a" as str) } as str)
        }
    } as ())
    ({
        struct Foo;
        impl Pair<Foo> {
            fn value(self) -> int ({ (2 as int) } as int)
        }
        impl From<Foo> for Celsius {
            fn from(_foo: Foo) -> Self ({ (Celsius as Celsius) } as Celsius)
        }
        impl Show for Foo {
            fn show(self) -> str ({ ("b" as str) } as str)
        }
    } as ())
} as ())

impl Wrapper {
    fn local_type(self) ({
        struct Local;
        impl Pair<Local> {
            fn value(self) -> int ({ (3 as int) } as int)
        }
        impl Show for Local {
            fn show(self) -> str ({ ("local" as str) } as str)
        }
    } as ())
}
