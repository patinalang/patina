#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait/derive.md
// block: 1/1

// `Centimeters`, a tuple struct that can be compared
#[derive(PartialEq, PartialOrd)]
struct Centimeters(float);

// `Inches`, a tuple struct that can be printed
#[derive(Debug)]
struct Inches(int);

impl Inches {
    fn to_centimeters(self) -> Centimeters {
        let Inches(inches) = self;

        Centimeters(inches as float * 2.54)
    }
}

// `Seconds`, a tuple struct with no additional attributes
struct Seconds(int);

pub fn main() {
    let _one_second = Seconds(1);

    // Error: `Seconds` can't be printed; it doesn't implement the `Debug` trait
    //println!("One second looks like: {:?}", _one_second);
    // TODO ^ Try uncommenting this line

    // Error: `Seconds` can't be compared; it doesn't implement the `PartialEq` trait
    //let _this_is_true = (_one_second == _one_second);
    // TODO ^ Try uncommenting this line

    let foot = Inches(12);
    {
        io::put_chars([["One foot equals ",
                            patina_fmt::debug(

                                foot)]]);
        io::nl();
    };

    let meter = Centimeters(100.0);

    let cmp =
        if foot.to_centimeters() < meter { "smaller" } else { "bigger" };
    {
        io::put_chars([["One foot is ",
                            patina_fmt::display(

                                cmp), " than one meter."]]);
        io::nl();
    };
}
