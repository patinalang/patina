use Std::Fmt::{Debug, Display};

fn compare_prints<T: Debug + Display>(t: T) {



    //compare_prints(list);
    // TODO ^ Try uncommenting this.

    {
        ::Core::io::put_chars([["Debug: `", patina_fmt::debug(t), "`"]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["Display: `", patina_fmt::display(t), "`"]]);
        ::Core::io::nl();
    };
}
fn compare_types<T: Debug, U: Debug>(t: T, u: U) {
    {
        ::Core::io::put_chars([["t: `", patina_fmt::debug(t), "`"]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["u: `", patina_fmt::debug(u), "`"]]);
        ::Core::io::nl();
    };
}
pub fn main() {
    let string = "words";
    let list = [1, 2, 3];
    let tuple = (1, 2, 3);
    compare_prints(string);
    compare_types(list, tuple);
}
