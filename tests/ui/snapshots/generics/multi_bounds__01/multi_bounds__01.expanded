#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/generics/multi_bounds.md
// block: 1/1

use Std::Fmt::{Debug, Display};

fn compare_prints<T: Debug + Display>(t: T) {
    { io::put_chars([["Debug: `", patina_fmt::debug(t), "`"]]); io::nl(); };
    {
        io::put_chars([["Display: `", patina_fmt::display(t), "`"]]);
        io::nl();
    };
}

fn compare_types<T: Debug, U: Debug>(t: T, u: U) {
    { io::put_chars([["t: `", patina_fmt::debug(t), "`"]]); io::nl(); };
    { io::put_chars([["u: `", patina_fmt::debug(u), "`"]]); io::nl(); };
}

pub fn main() {
    let string = "words";
    let list = [1, 2, 3];
    let tuple = (1, 2, 3);

    compare_prints(string);
    //compare_prints(list);
    // TODO ^ Try uncommenting this.

    compare_types(list, tuple);
}
