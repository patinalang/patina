struct Years(int);

fn main() ({
    let years = ((Years as fn(int) -> Years {Years})((42 as int)) as Years);
    let years_as_primitive_1: int = ((years as Years).0 as int); // Tuple
    let Years(years_as_primitive_2) = (years as Years); // Destructuring
} as ())
