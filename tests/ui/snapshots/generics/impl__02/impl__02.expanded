#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/generics/impl.md
// block: 2/2

struct Val {
    val: int,
}

struct GenVal<T> {
    gen_val: T,
}

// impl of Val
impl Val {
    fn value(self) -> int { self.val }
}

// impl of GenVal for a generic type `T`
impl<T> GenVal<T> {
    fn value(self) -> T { self.gen_val }
}

pub fn main() {
    let x = Val { val: 3 };
    let y = GenVal { gen_val: 42 };

    {
        ::core::io::put_chars([[::core::patina_fmt::display(x.value()), ", ",
                            ::core::patina_fmt::display(y.value())]]);
        ::core::io::nl();
    };
}
