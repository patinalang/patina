#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/generics/impl.md
// block: 2/2

struct Val {
    val: int,
}

struct GenVal<T> {
    gen_val: T,
}

// impl of Val
impl Val {
    fn value(self) -> int ({ ((self as Val).val as int) } as int)
}

// impl of GenVal for a generic type `T`
impl <T> GenVal<T> {
    fn value(self) -> T ({ ((self as GenVal<T>).gen_val as T) } as T)
}

fn main() ({
    let x = (Val { val: (3 as int) } as Val);
    let y = (GenVal { gen_val: (42 as int) } as GenVal<int>);

    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((x as Val).value() as int)) as term),
                            (", " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((y as GenVal<int>).value() as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
