#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/generics/new_types.md
// block: 1/2

struct Years(int);

struct Days(int);

impl Years {
    pub fn to_days(self) -> Days { Days(self.0 * 365) }
}

impl Days {
    /// truncates partial years
    pub fn to_years(self) -> Years { Years(self.0 / 365) }
}

fn is_adult(age: Years) -> bool { age.0 >= 18 }

pub fn main() {
    let age = Years(25);
    let age_days = age.to_days();
    // println!("Is an adult? {}", is_adult(age_days));
    {
        ::core::io::put_chars([["Is an adult? ",
                            ::core::patina_fmt::display(is_adult(age))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["Is an adult? ",
                            ::core::patina_fmt::display(is_adult(age_days.to_years()))]]);
        ::core::io::nl();
    };
}
