#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/generics/new_types.md
// block: 1/2

struct Years(int);

struct Days(int);

impl Years {
    fn to_days(self)
        ->
            Days ({
        ((Days as
                fn(int) -> Days {Days})((((self as Years).0 as int) *
                (365 as int) as int)) as Days)
    } as Days)
}

impl Days {
    /// truncates partial years
    fn to_years(self)
        ->
            Years ({
        ((Years as
                fn(int) -> Years {Years})((((self as Days).0 as int) /
                (365 as int) as int)) as Years)
    } as Years)
}

fn is_adult(age: Years)
    -> bool ({ (((age as Years).0 as int) >= (18 as int) as bool) } as bool)

fn main() ({
    let age = ((Years as fn(int) -> Years {Years})((25 as int)) as Years);
    let age_days = ((age as Years).to_days() as Days);
    // println!("Is an adult? {}", is_adult(age_days));
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Is an adult? " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((is_adult as
                                        fn(Years) -> bool {is_adult})((age as Years)) as bool)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Is an adult? " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((is_adult as
                                        fn(Years) -> bool {is_adult})(((age_days as Days).to_years()
                                        as Years)) as bool)) as term)] as [term])] as [[term]])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
