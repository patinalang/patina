#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]





#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;

struct Pair<T> {
    a: T,
    b: T,
}

impl<T> Pair<T> {
    fn len(self) -> int {

        {
            io::put_chars([["Pair::len(", patina_fmt::debug(self), ")"]]);
            io::nl();
        };
        2
    }
}
pub fn main() {
    let p = Pair { a: 1, b: 2 };
    { io::put_chars([[patina_fmt::display(p.len())]]); io::nl(); };
}
