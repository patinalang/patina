#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]




#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;
#[allow(unused)]
extern mod patina_fmt;

struct Pair<T> {
    a: T,
    b: T,
}

impl<T> Pair<T> {
    fn len(self) -> int {

        {
            ::core::io::put_chars([["Pair::len(", patina_fmt::debug(self),
                                ")"]]);
            ::core::io::nl();
        };
        2
    }
}
pub fn main() {
    let p = Pair { a: 1, b: 2 };
    {
        ::core::io::put_chars([[patina_fmt::display(p.len())]]);
        ::core::io::nl();
    };
}
