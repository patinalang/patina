#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]










#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct Pair<T> {
    a: T,
    b: T,
}

impl<T> Pair<T> {
    fn len(self) -> int {
        {
            io::put_chars([["Pair::len(", patina_fmt::debug(self), ")"]]);
            io::nl();
        };
        2
    }
}

pub fn main() {
    let p = Pair { a: 1, b: 2 };
    { io::put_chars([[patina_fmt::display(p.len())]]); io::nl(); };
}
