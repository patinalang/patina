extern crate core;
#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

struct Pair<T> {
    a: T,
    b: T,
}

impl <T> Pair<T> {
    fn len(self)
        ->
            int ({

        ({
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Pair::len(" as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((self as Pair<T>)) as term), (")" as str)]
                            as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        } as ());
        (2 as int)
    } as int)
}
fn main() ({
    let p = (Pair { a: (1 as int), b: (2 as int) } as Pair<int>);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)(((p as Pair<int>).len() as int)) as term)]
                        as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
