#![allow(internal_features)]










#![allow(dead_code)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct Pair<T> {
    a: T,
    b: T,
}

impl <T> Pair<T> {
    fn len(self)
        ->
            int ({
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Pair::len(" as str),
                                ((patina_fmt::debug as fn(term) -> term)((self as Pair<T>))
                                    as term), (")" as str)] as [term; 3])] as [[term; 3]; 1]))
                as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
        (2 as int)
    } as int)
}

fn main() ({
    let p = (Pair { a: (1 as int), b: (2 as int) } as Pair<int>);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((p as Pair<int>).len() as int)) as term)]
                        as [term; 1])] as [[term; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
