#![allow(internal_features)]





#![allow(dead_code)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;

trait Describe {
    fn describe(self)
    -> str;
}

trait Family {
    type
    Member<T>;
    fn member<T>(self, t: T)
    -> Self::Member<T>;
}

fn describe_member<F>(family: F) -> str where F: Family,
    F::Member<int>: Describe ({
    (((family as F).member((1 as int)) as
            <F as Family>::Member<int>).describe() as str)
} as str)
