#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]



#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

trait Describe {
    fn describe(self)
    -> str;
}

trait Family {
    type Member<T>;
    fn member<T>(self, t: T)
    -> Self::Member<T>;
}

fn describe_member<F: Family>(family: F) -> str where
    F::Member<int>: Describe {
    family.member(1).describe()
}
