#![allow(dead_code)]

trait Describe {
    fn describe(self)
    -> str;
}

struct Name(str);

impl Describe for Name {
    fn describe(self) -> str { self.0 }
}

fn make() -> impl Describe { Name("a") }

fn show<T: Describe>(t: T) -> str { t.describe() }

pub fn show_opaque_return() -> str { show(make()) }
