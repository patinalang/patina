#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// The witness function of an associated type gives the witnesses of its declared bounds.
// `Show for int` is an impl for a primitive type outside Core.

trait Show {
    fn show(self)
    -> str;
}

impl Show for int {
    fn show(self) -> str { "an int" }
}

trait Iter {
    type Item: Show;

    fn next(self)
    -> Self::Item;
}

struct Counter {
    n: int,
}

impl Iter for Counter {
    type Item = int;

    fn next(self) -> int { self.n }
}

fn first<I: Iter>(i: I) -> str { i.next().show() }

pub fn counter_first(n: int) -> str { first(Counter { n: n }) }
