#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]




#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;
#[allow(unused)]
extern mod patina_fmt;

struct S;

trait Priv {
    fn p(self);
}

impl Priv for S {
    fn p(self) {


        {
            ::Core::io::put_chars([["Priv::p(", patina_fmt::debug(self),
                                ")"]]);
            ::Core::io::nl();
        };
    }
}
impl S {
    fn q(self) { self.p() }
}
pub fn main() { S.q(); }
