#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// A `fnref` refers to a function statically, so it cannot capture the witnesses its function
// needs. A `fn` pointer can.

pub trait Animal {
    fn talk(self)
    -> str;
}

pub fn talk_through_pointer<T: Animal>(animal: T) -> str {
    let talk: fn(T) -> str = T::talk;
    talk(animal)
}

pub fn talk_through_fnref<T: Animal>(animal: T) -> str {
    let talk: fnref(T) -> str = T::talk;
    talk(animal)
}
