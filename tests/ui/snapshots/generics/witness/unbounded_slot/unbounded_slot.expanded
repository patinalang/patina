#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]




#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;
#[allow(unused)]
extern mod patina_fmt;

struct Holder<T> {
    value: T,
}

trait Tr {
    fn method(self);
}

impl<T> Tr for Holder<T> {
    fn method(self) {


        {
            ::core::io::put_chars([["Tr::method(", patina_fmt::debug(self),
                                ")"]]);
            ::core::io::nl();
        };
    }
}
fn call<T>(h: Holder<T>) { h.method() }
pub fn main() { let h = Holder { value: 1 }; call(h); }
