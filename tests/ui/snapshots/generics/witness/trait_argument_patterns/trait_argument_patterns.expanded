#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

struct UnboundContainer;
struct BoundContainer;
struct NestedContainer;
struct Marked {
    value: int,
}
struct Wrapped<T> {
    value: T,
}

trait Marker {
    fn value(self)
    -> int;
}

impl Marker for Marked {
    fn value(self) -> int {





        {
            ::core::io::put_chars([["Marker::value(",
                                ::core::patina_fmt::debug(self), ")"]]);
            ::core::io::nl();
        };
        self.value
    }
}
trait Contains<A, B> {
    fn contains(self, _: A, _: B)
    -> bool;
}
impl<T> Contains<int, T> for UnboundContainer {
    fn contains(self, a: int, b: T) -> bool {
        {
            ::core::io::put_chars([["UnboundContainer::contains(",
                                ::core::patina_fmt::debug(self), ", ",
                                ::core::patina_fmt::debug(a), ", ",
                                ::core::patina_fmt::debug(b), ")"]]);
            ::core::io::nl();
        };
        true
    }
}
impl<T: Marker> Contains<int, T> for BoundContainer {
    fn contains(self, a: int, value: T) -> bool {
        {
            ::core::io::put_chars([["BoundContainer::contains(",
                                ::core::patina_fmt::debug(self), ", ",
                                ::core::patina_fmt::debug(a), ", ",
                                ::core::patina_fmt::debug(value), ")"]]);
            ::core::io::nl();
        };
        value.value() > 0
    }
}
impl<T> Contains<int, Wrapped<T>> for NestedContainer {
    fn contains(self, a: int, wrapped: Wrapped<T>) -> bool {
        {
            ::core::io::put_chars([["NestedContainer::contains(",
                                ::core::patina_fmt::debug(self), ", ",
                                ::core::patina_fmt::debug(a), ", ",
                                ::core::patina_fmt::debug(wrapped), ")"]]);
            ::core::io::nl();
        };
        true
    }
}
pub fn main() {
    {
        ::core::io::put_chars([[::core::patina_fmt::display(UnboundContainer.contains(1,
                                    false))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(BoundContainer.contains(1,
                                    Marked { value: 2 }))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(NestedContainer.contains(1,
                                    Wrapped { value: false }))]]);
        ::core::io::nl();
    };
}
