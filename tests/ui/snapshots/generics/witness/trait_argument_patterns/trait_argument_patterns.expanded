#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct UnboundContainer;
struct BoundContainer;
struct NestedContainer;
struct Marked {
    value: int,
}
struct Wrapped<T> {
    value: T,
}

trait Marker {
    fn value(self)
    -> int;
}

impl Marker for Marked {
    fn value(self) -> int {
        {
            io::put_chars([["Marker::value(", patina_fmt::debug(self), ")"]]);
            io::nl();
        };
        self.value
    }
}

trait Contains<A, B> {
    fn contains(self, _: A, _: B)
    -> bool;
}

impl<T> Contains<int, T> for UnboundContainer {
    fn contains(self, a: int, b: T) -> bool {
        {
            io::put_chars([["UnboundContainer::contains(",
                                patina_fmt::debug(self), ", ", patina_fmt::debug(a), ", ",
                                patina_fmt::debug(b), ")"]]);
            io::nl();
        };
        true
    }
}

impl<T: Marker> Contains<int, T> for BoundContainer {
    fn contains(self, a: int, value: T) -> bool {
        {
            io::put_chars([["BoundContainer::contains(",
                                patina_fmt::debug(self), ", ", patina_fmt::debug(a), ", ",
                                patina_fmt::debug(value), ")"]]);
            io::nl();
        };
        value.value() > 0
    }
}

impl<T> Contains<int, Wrapped<T>> for NestedContainer {
    fn contains(self, a: int, wrapped: Wrapped<T>) -> bool {
        {
            io::put_chars([["NestedContainer::contains(",
                                patina_fmt::debug(self), ", ", patina_fmt::debug(a), ", ",
                                patina_fmt::debug(wrapped), ")"]]);
            io::nl();
        };
        true
    }
}

pub fn main() {
    {
        io::put_chars([[patina_fmt::display(UnboundContainer.contains(1,
                                    false))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(BoundContainer.contains(1,
                                    Marked { value: 2 }))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(NestedContainer.contains(1,
                                    Wrapped { value: false }))]]);
        io::nl();
    };
}
