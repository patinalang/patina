#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

struct Point {
    x: int,
    y: int,
}

trait Area {
    fn area(self)
    -> int;
}

impl Area for Point {
    fn area(self) -> int {


        {
            io::put_chars([["Area::area(", patina_fmt::debug(self), ")"]]);
            io::nl();
        };
        self.x * self.y
    }
}
fn total_area<T: Area>(t: T) -> int { t.area() }
pub fn main() {
    let p = Point { x: 3, y: 4 };
    { io::put_chars([[patina_fmt::display(total_area(p))]]); io::nl(); };
}
