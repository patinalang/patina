#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

struct Point {
    x: int,
    y: int,
}

trait Area {
    fn area(self)
    -> int;
}

impl Area for Point {
    fn area(self) -> int {


        {
            ::core::io::put_chars([["Area::area(",
                                ::core::patina_fmt::debug(self), ")"]]);
            ::core::io::nl();
        };
        self.x * self.y
    }
}
fn total_area<T: Area>(t: T) -> int { t.area() }
pub fn main() {
    let p = Point { x: 3, y: 4 };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(total_area(p))]]);
        ::core::io::nl();
    };
}
