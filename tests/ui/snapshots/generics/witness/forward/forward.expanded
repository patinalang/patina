#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

trait Tr {
    fn method(self);
}

struct S;

impl Tr for S {
    fn method(self) {



        {
            ::core::io::put_chars([["Tr::method(",
                                ::core::patina_fmt::debug(self), ")"]]);
            ::core::io::nl();
        };
    }
}
fn b<T: Tr>(x: T) { x.method() }
fn a<T: Tr>(x: T) { b(x) }
pub fn main() { a(S); }
