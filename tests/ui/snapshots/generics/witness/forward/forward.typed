#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

trait Tr {
    fn method(self);
}

struct S;

impl Tr for S {
    fn method(self) ({



        ({
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Tr::method(" as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((self as S)) as term), (")" as str)] as
                            [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        } as ());
    } as ())
}
fn b<T>(x: T) where T: Tr ({ ((x as T).method() as ()) } as ())
fn a<T>(x: T) where T: Tr ({ ((b as fn(T) {b::<T>})((x as T)) as ()) } as ())
fn main() ({ ((a as fn(S) {a::<S>})((S as S)) as ()); } as ())
