#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

trait Tr {
    fn method(self);
}

struct S;

impl Tr for S {
    fn method(self) ({
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Tr::method(" as str),
                                ((patina_fmt::debug as fn(term) -> term)((self as S)) as
                                    term), (")" as str)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
}

fn b<T>(x: T) where T: Tr ({ ((x as T).method() as ()) } as ())

fn a<T>(x: T) where T: Tr ({ ((b as fn(T) {b::<T>})((x as T)) as ()) } as ())

fn main() ({ ((a as fn(S) {a::<S>})((S as S)) as ()); } as ())
