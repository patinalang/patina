#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

pub trait Show {
    fn show(self)
    -> str;
}

pub trait Marker {}

pub trait Both: Show + Marker {}

pub trait EmptyBlanketImpl {}

impl<T> EmptyBlanketImpl for T {}

struct A;

impl Show for A {
    fn show(self) -> str { "a" }
}

impl Marker for A {}

impl Both for A {}

pub fn marker_bounds_only<T: Marker + EmptyBlanketImpl>(t: T) -> T { t }

pub fn subtrait_of_marker<T: Both>(t: T) -> str { t.show() }

pub fn a_both() -> str { subtrait_of_marker(A) }

pub fn a_marked() -> str { marker_bounds_only(A).show() }
