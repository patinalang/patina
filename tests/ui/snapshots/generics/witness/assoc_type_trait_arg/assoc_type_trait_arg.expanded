#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]





#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;

trait Container {
    type Item;
    fn get(self)
    -> Self::Item;
}

trait Wraps<T> {
    fn wrapped(self)
    -> int;
}

struct W<C>(C);

// The trait argument `C::Item` is only known at runtime, so it has no witness pattern.
impl<C: Container> Wraps<C::Item> for W<C> {
    fn wrapped(self) -> int { 0 }
}
