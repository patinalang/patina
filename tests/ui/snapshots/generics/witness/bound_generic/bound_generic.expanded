#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]





#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;

struct Holder<T> {
    value: T,
}

struct Number {
    n: int,
}

trait Bound {
    fn b(self)
    -> int;
}

impl Bound for Number {
    fn b(self) -> int {




        {
            io::put_chars([["Bound::b(", patina_fmt::debug(self), ")"]]);
            io::nl();
        };
        self.n
    }
}
trait Tr {
    fn method(self)
    -> int;
}
impl<T: Bound> Tr for Holder<T> {
    fn method(self) -> int {
        {
            io::put_chars([["Tr::method(", patina_fmt::debug(self), ")"]]);
            io::nl();
        };
        self.value.b()
    }
}
fn call<T: Bound>(h: Holder<T>) -> int { h.method() }
pub fn main() {
    let h = Holder { value: Number { n: 5 } };
    { io::put_chars([[patina_fmt::display(call(h))]]); io::nl(); };
}
