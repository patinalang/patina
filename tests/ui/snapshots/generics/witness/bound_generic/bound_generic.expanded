#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]



#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern pkg core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

struct Holder<T> {
    value: T,
}

struct Number {
    n: int,
}

trait Bound {
    fn b(self)
    -> int;
}

impl Bound for Number {
    fn b(self) -> int {




        {
            ::core::io::put_chars([["Bound::b(",
                                ::core::patina_fmt::debug(self), ")"]]);
            ::core::io::nl();
        };
        self.n
    }
}
trait Tr {
    fn method(self)
    -> int;
}
impl<T: Bound> Tr for Holder<T> {
    fn method(self) -> int {
        {
            ::core::io::put_chars([["Tr::method(",
                                ::core::patina_fmt::debug(self), ")"]]);
            ::core::io::nl();
        };
        self.value.b()
    }
}
fn call<T: Bound>(h: Holder<T>) -> int { h.method() }
pub fn main() {
    let h = Holder { value: Number { n: 5 } };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(call(h))]]);
        ::core::io::nl();
    };
}
