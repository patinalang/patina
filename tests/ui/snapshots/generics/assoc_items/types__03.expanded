#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/generics/assoc_items/types.md
// block: 3/3

struct Container(int, int);

// A trait which checks if 2 items are stored inside of container.
// Also retrieves first or last value.
trait Contains {
    // Define generic types here which methods will be able to utilize.
    type A;
    type B;

    fn contains(self, _: Self::A, _: Self::B)
    -> bool;
    fn first(self)
    -> int;
    fn last(self)
    -> int;
}

impl Contains for Container {
    // Specify what types `A` and `B` are. If the `input` type
    // is `Container(int, int)`, the `output` types are determined
    // as `int` and `int`.
    type A = int;
    type B = int;

    // `Self::A` and `Self::B` are also valid here.
    fn contains(self, number_1: int, number_2: int) -> bool {
        (self.0 == number_1) && (self.1 == number_2)
    }
    // Grab the first number.
    fn first(self) -> int { self.0 }

    // Grab the last number.
    fn last(self) -> int { self.1 }
}

fn difference<C: Contains>(container: C) -> int {
    container.last() - container.first()
}

pub fn main() {
    let number_1 = 3;
    let number_2 = 10;

    let container = Container(number_1, number_2);
    {
        io::put_chars([["Does container contain ",
                            patina_fmt::display(

                                number_1), " and ", patina_fmt::display(number_2), ": ",
                            patina_fmt::display(container.contains(number_1,
                                    number_2))]]);
        io::nl();
    };
    {
        io::put_chars([["First number: ",
                            patina_fmt::display(container.first())]]);
        io::nl();
    };
    {
        io::put_chars([["Last number: ",
                            patina_fmt::display(container.last())]]);
        io::nl();
    };
    {
        io::put_chars([["The difference is: ",
                            patina_fmt::display(

                                difference(container))]]);
        io::nl();
    };
}
