#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/generics/assoc_items/types.md
// block: 3/3

struct Container(int, int);

// A trait which checks if 2 items are stored inside of container.
// Also retrieves first or last value.
trait Contains {
    // Define generic types here which methods will be able to utilize.
    type A;
    type B;

    fn contains(self, _: Self::A, _: Self::B)
    -> bool;
    fn first(self)
    -> int;
    fn last(self)
    -> int;
}

impl Contains for Container {
    // Specify what types `A` and `B` are. If the `input` type
    // is `Container(int, int)`, the `output` types are determined
    // as `int` and `int`.
    type A = int;
    type B = int;

    // `Self::A` and `Self::B` are also valid here.
    fn contains(self, number_1: int, number_2: int) -> bool {
        (self.0 == number_1) && (self.1 == number_2)
    }
    // Grab the first number.
    fn first(self) -> int { self.0 }

    // Grab the last number.
    fn last(self) -> int { self.1 }
}

fn difference<C: Contains>(container: C) -> int {
    container.last() - container.first()
}

pub fn main() {
    let number_1 = 3;
    let number_2 = 10;

    let container = Container(number_1, number_2);


    {
        ::core::io::put_chars([["Does container contain ",
                            ::core::patina_fmt::display(number_1), " and ",
                            ::core::patina_fmt::display(number_2), ": ",
                            ::core::patina_fmt::display(container.contains(number_1,
                                    number_2))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["First number: ",
                            ::core::patina_fmt::display(container.first())]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["Last number: ",
                            ::core::patina_fmt::display(container.last())]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["The difference is: ",
                            ::core::patina_fmt::display(difference(container))]]);
        ::core::io::nl();
    };
}
