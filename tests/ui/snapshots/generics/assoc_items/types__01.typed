#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused)]
extern mod io;

#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println { ($s:literal) => {{ io::format("~s~n", [$s]); }}; }

// source: patina-by-example/src/generics/assoc_items/types.md
// block: 1/3

// `A` and `B` are defined in the trait via the `type` keyword.
// (Note: `type` in this context is different from `type` when used for
// aliases).
trait Contains {
    type
    A;
    type
    B;

    // Updated syntax to refer to these new types generically.
    fn contains(self, _: Self::A, _: Self::B)
    -> bool;
}
