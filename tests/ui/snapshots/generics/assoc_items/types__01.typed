#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/generics/assoc_items/types.md
// block: 1/3

// `A` and `B` are defined in the trait via the `type` keyword.
// (Note: `type` in this context is different from `type` when used for
// aliases).
trait Contains {
    type
    A;
    type
    B;

    // Updated syntax to refer to these new types generically.
    fn contains(self, _: Self::A, _: Self::B)
    -> bool;
}
