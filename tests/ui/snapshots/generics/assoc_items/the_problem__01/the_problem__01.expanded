#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/generics/assoc_items/the_problem.md
// block: 1/1

struct Container(int, int);

// A trait which checks if 2 items are stored inside of container.
// Also retrieves first or last value.
trait Contains<A, B> {
    fn contains(self, _: A, _: B)
    -> bool;
    // Explicitly requires `A` and `B`.
    fn first(self)
    -> int;
    // Doesn't explicitly require `A` or `B`.
    fn last(self)
    -> int; // Doesn't explicitly require `A` or `B`.
}

impl Contains<int, int> for Container {
    // True if the numbers stored are equal.
    fn contains(self, number_1: int, number_2: int) -> bool {
        (self.0 == number_1) && (self.1 == number_2)
    }

    // Grab the first number.
    fn first(self) -> int { self.0 }

    // Grab the last number.
    fn last(self) -> int { self.1 }
}

// `C` contains `A` and `B`. In light of that, having to express `A` and
// `B` again is a nuisance.
fn difference<A, B, C>(container: C) -> int where C: Contains<A, B> {
    container.last() - container.first()
}

pub fn main() {
    let number_1 = 3;
    let number_2 = 10;

    let container = Container(number_1, number_2);


    {
        ::Core::io::put_chars([["Does container contain ",
                            patina_fmt::display(number_1), " and ",
                            patina_fmt::display(number_2), ": ",
                            patina_fmt::display(container.contains(number_1,
                                    number_2))]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["First number: ",
                            patina_fmt::display(container.first())]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["Last number: ",
                            patina_fmt::display(container.last())]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["The difference is: ",
                            patina_fmt::display(difference(container))]]);
        ::Core::io::nl();
    };
}
