#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/generics/assoc_items/the_problem.md
// block: 1/1

struct Container(int, int);

// A trait which checks if 2 items are stored inside of container.
// Also retrieves first or last value.
trait Contains<A, B> {
    fn contains(self, _: A, _: B)
    -> bool;
    // Explicitly requires `A` and `B`.
    fn first(self)
    -> int;
    // Doesn't explicitly require `A` or `B`.
    fn last(self)
    -> int; // Doesn't explicitly require `A` or `B`.
}

impl Contains<int, int> for Container {
    // True if the numbers stored are equal.
    fn contains(self, number_1: int, number_2: int)
        ->
            bool ({
        ((((self as Container).0 as int) == (number_1 as int) as bool) &&
            (((self as Container).1 as int) == (number_2 as int) as bool) as
            bool)
    } as bool)

    // Grab the first number.
    fn first(self) -> int ({ ((self as Container).0 as int) } as int)

    // Grab the last number.
    fn last(self) -> int ({ ((self as Container).1 as int) } as int)
}

// `C` contains `A` and `B`. In light of that, having to express `A` and
// `B` again is a nuisance.
fn difference<A, B, C>(container: C) -> int where
    C: Contains<A,
    B> ({
    (((container as C).last() as int) - ((container as C).first() as int) as
        int)
} as int)

fn main() ({
    let number_1 = (3 as int);
    let number_2 = (10 as int);

    let container =
        ((Container as
                fn(int, int) -> Container {Container})((number_1 as int),
            (number_2 as int)) as Container);


    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("Does container contain " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((number_1 as int)) as term),
                            (" and " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((number_2 as int)) as term),
                            (": " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((container as
                                        Container).contains((number_1 as int), (number_2 as int)) as
                                    bool)) as term)] as [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("First number: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((container as Container).first() as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("Last number: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((container as Container).last() as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("The difference is: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((difference as
                                        fn(Container) -> int {difference::<int, int, Container>})((container
                                        as Container)) as int)) as term)] as [term])] as [[term]]))
            as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
