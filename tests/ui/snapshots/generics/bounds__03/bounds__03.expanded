#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/generics/bounds.md
// block: 3/3

// A trait which implements the print marker: `{:?}`.
use Std::Fmt::Debug;

trait HasArea {
    fn area(self)
    -> float;
}

impl HasArea for Rectangle {
    fn area(self) -> float { self.length * self.height }
}

#[derive(Debug)]
struct Rectangle {
    length: float,
    height: float,
}
#[allow(dead_code)]
struct Triangle {
    length: float,
    height: float,
}

// The generic `T` must implement `Debug`. Regardless
// of the type, this will work properly.
fn print_debug<T: Debug>(t: T) {
    { io::put_chars([[patina_fmt::debug(t)]]); io::nl(); };
}

// `T` must implement `HasArea`. Any type which meets
// the bound can access `HasArea`'s function `area`.
fn area<T: HasArea>(t: T) -> float { t.area() }

pub fn main() {
    let rectangle = Rectangle { length: 3.0, height: 4.0 };
    let _triangle = Triangle { length: 3.0, height: 4.0 };

    print_debug(rectangle);
    {
        io::put_chars([["Area: ", patina_fmt::display(area(rectangle))]]);
        io::nl();
    };

    //print_debug(_triangle);
    //println!("Area: {}", area(_triangle));
    // ^ TODO: Try uncommenting these.
    // | Error: Does not implement either `Debug` or `HasArea`.
}
