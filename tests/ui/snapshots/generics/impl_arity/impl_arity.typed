#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

struct GenVal<T> {
    gen_val: T,
}

impl GenVal<int> {
    fn value(self) -> int ({ ((self as GenVal<int>).gen_val as int) } as int)
}

impl GenVal<str> {
    fn value(self, _extra: int)
        -> str ({ ((self as GenVal<str>).gen_val as str) } as str)
}

fn main() ({
    let a = (GenVal { gen_val: (5 as int) } as GenVal<int>);
    let b = (GenVal { gen_val: ("hi" as str) } as GenVal<str>);

    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)(((a as GenVal<int>).value() as int)) as
                                term), (" " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((b as GenVal<str>).value((0 as int)) as
                                    str)) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
