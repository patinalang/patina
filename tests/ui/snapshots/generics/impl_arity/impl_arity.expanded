#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

struct GenVal<T> {
    gen_val: T,
}

impl GenVal<int> {
    fn value(self) -> int { self.gen_val }
}

impl GenVal<str> {
    fn value(self, _extra: int) -> str { self.gen_val }
}

pub fn main() {
    let a = GenVal { gen_val: 5 };
    let b = GenVal { gen_val: "hi" };

    {
        io::put_chars([[patina_fmt::display(a.value()), " ",
                            patina_fmt::display(b.value(0))]]);
        io::nl();
    };
}
