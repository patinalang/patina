#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

struct GenVal<T> {
    gen_val: T,
}

impl GenVal<int> {
    fn value(self) -> int { self.gen_val }
}

impl GenVal<str> {
    fn value(self, _extra: int) -> str { self.gen_val }
}

pub fn main() {
    let a = GenVal { gen_val: 5 };
    let b = GenVal { gen_val: "hi" };

    {
        ::core::io::put_chars([[::core::patina_fmt::display(a.value()), " ",
                            ::core::patina_fmt::display(b.value(0))]]);
        ::core::io::nl();
    };
}
