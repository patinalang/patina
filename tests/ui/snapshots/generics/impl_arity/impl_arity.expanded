#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct GenVal<T> {
    gen_val: T,
}

impl GenVal<int> {
    fn value(self) -> int { self.gen_val }
}

impl GenVal<str> {
    fn value(self, _extra: int) -> str { self.gen_val }
}

pub fn main() {
    let a = GenVal { gen_val: 5 };
    let b = GenVal { gen_val: "hi" };
    {
        io::put_chars([[patina_fmt::display(

                                a.value()), " ", patina_fmt::display(b.value(0))]]);
        io::nl();
    };
}
