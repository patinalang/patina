#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/generics/bounds/testcase_empty.md
// block: 1/1

struct Cardinal;
struct BlueJay;
struct Turkey;

trait Red { }
trait Blue { }

impl Red for Cardinal { }
impl Blue for BlueJay { }

// These functions are only valid for types which implement these
// traits. The fact that the traits are empty is irrelevant.
fn red<T>(_: T) -> str where T: Red ({ ("red" as str) } as str)
fn blue<T>(_: T) -> str where T: Blue ({ ("blue" as str) } as str)

fn main() ({
    let cardinal = (Cardinal as Cardinal);
    let blue_jay = (BlueJay as BlueJay);
    let _turkey = (Turkey as Turkey);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("A cardinal is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                // `red()` won't work on a blue jay nor vice versa
                                // because of the bounds.
                                ((red as
                                        fn(Cardinal) -> str {red::<Cardinal>})((cardinal as
                                        Cardinal)) as str)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("A blue jay is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((blue as
                                        fn(BlueJay) -> str {blue::<BlueJay>})((blue_jay as BlueJay))
                                    as str)) as term)] as [term; 2])] as [[term; 2]; 1])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    //println!("A turkey is {}", red(_turkey));
    // ^ TODO: Try uncommenting this line.
} as ())
