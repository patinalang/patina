#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/generics/bounds/testcase_empty.md
// block: 1/1

struct Cardinal;
struct BlueJay;
struct Turkey;

trait Red {}
trait Blue {}

impl Red for Cardinal {}
impl Blue for BlueJay {}

// These functions are only valid for types which implement these
// traits. The fact that the traits are empty is irrelevant.
fn red<T: Red>(_: T) -> str { "red" }
fn blue<T: Blue>(_: T) -> str { "blue" }

pub fn main() {
    let cardinal = Cardinal;
    let blue_jay = BlueJay;
    let _turkey = Turkey;

    // `red()` won't work on a blue jay nor vice versa
    // because of the bounds.
    //println!("A turkey is {}", red(_turkey));
    // ^ TODO: Try uncommenting this line.
    {
        io::put_chars([["A cardinal is ",
                            patina_fmt::display(red(cardinal))]]);
        io::nl();
    };
    {
        io::put_chars([["A blue jay is ",
                            patina_fmt::display(blue(blue_jay))]]);
        io::nl();
    };
}
