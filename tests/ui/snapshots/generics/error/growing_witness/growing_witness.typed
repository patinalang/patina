// The witness of `S<int>: Base` needs the witness of `S<S<int>>: Derived`, which needs the witness
// of `S<S<int>>: Base`, and so on. Each bound is larger than the one before.

trait Base {
    fn base(self)
    -> int;
}

trait Derived: Base {
    fn derived(self)
    -> int;
}

struct S<T> {
    t: T,
}

impl <T> Derived for S<T> {
    fn derived(self) -> int ({ (1 as int) } as int)
}

impl <T> Base for S<T> where S<S<T>>: Derived {
    fn base(self) -> int ({ (2 as int) } as int)
}

fn call<T>(t: T) -> int where T: Derived ({ ((t as T).base() as int) } as int)

fn main()
    ->
        int ({
    ((call as
            fn(S<int>) -> int {call::<S<int>>})((S { t: (1 as int) } as
            S<int>)) as int)
} as int)
