#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]




#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;
#[allow(unused)]
extern mod patina_fmt;

trait Describe {
    fn describe(self)
    -> str;
}

struct Name(str);

impl Describe for Name {
    fn describe(self) -> str { self.0 }
}

fn make() -> impl Describe { Name("a") }

fn show<T: Describe>(t: T) -> str { t.describe() }

// Calling `show` needs the witness of the opaque return type of `make`.
fn show_made() -> str { show(make()) }
