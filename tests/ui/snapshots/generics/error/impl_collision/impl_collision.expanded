#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]










#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct GenVal<T> {
    gen_val: T,
}

impl GenVal<int> {
    fn value(self) -> int { self.gen_val }
}

impl GenVal<str> {
    fn value(self) -> str { self.gen_val }
}
