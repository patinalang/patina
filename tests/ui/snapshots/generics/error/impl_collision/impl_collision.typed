extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;

struct GenVal<T> {
    gen_val: T,
}

impl GenVal<int> {
    fn value(self) -> int ({ ((self as GenVal<int>).gen_val as int) } as int)
}

impl GenVal<str> {
    fn value(self) -> str ({ ((self as GenVal<str>).gen_val as str) } as str)
}
