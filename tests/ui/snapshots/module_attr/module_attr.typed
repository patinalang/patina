#![allow(dead_code)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

#[attr = ErlModule("Elixir.ModuleAttr.Person")]
struct Person {
    name: str,
}

#[attr = ErlModule("module_attr_web_event")]
enum WebEvent {
    Click {
            x: int,
            y: int,
        },
}

#[attr = ErlModule("module_attr_helpers")]
mod Helpers {
    fn answer() -> int ({ (42 as int) } as int)
}

#[attr = ErlModule("future_trait_module")]
trait Named { }

fn main() ({
    let _person = (Person { name: ("Patina" as str) } as Person);
    let _event =
        (WebEvent::Click { x: (10 as int), y: (20 as int) } as WebEvent);
} as ())
