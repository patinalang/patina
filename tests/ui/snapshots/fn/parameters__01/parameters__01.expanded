// source: patina-by-example/src/fn/parameters.md
// block: 1/2

fn call_me_ref(f: fnref(int) -> int) { f(1); }

fn call_me(f: fn(int) -> int) { f(2); }

fn function(x: int) -> int { x + 1 }

pub fn main() {
    let closure = |x| x + 42;

    call_me(function);
    call_me(closure);

    call_me_ref(function);
    // call_me_ref(closure);
    // ^ ERROR! `fn(int) -> int` cannot be used as `fnref(int) -> int`
}
