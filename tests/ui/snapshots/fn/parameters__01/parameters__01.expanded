#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/fn/parameters.md
// block: 1/2

fn call_me_ref(f: fnref(int) -> int) { f(1); }

fn call_me(f: fn(int) -> int) { f(2); }

fn function(x: int) -> int { x + 1 }

pub fn main() {
    let closure = |x| x + 42;

    call_me(function);
    call_me(closure);

    call_me_ref(function);
    // call_me_ref(closure);
    // ^ ERROR! `fn(int) -> int` cannot be used as `fnref(int) -> int`
}
