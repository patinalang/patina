fn mutual(n: int)
    ->
        bool ({
    fn is_even(n: int)
        ->
            bool ({
        (if ((n as int) == (0 as int) as bool) {
            (true as bool)
        } else {
            ((is_odd as
                    fn(int) -> bool {mutual::is_odd})(((n as int) - (1 as int)
                    as int)) as bool)
        } as bool)
    } as bool)
    fn is_odd(n: int)
        ->
            bool ({
        (if ((n as int) == (0 as int) as bool) {
            (false as bool)
        } else {
            ((is_even as
                    fn(int) -> bool {mutual::is_even})(((n as int) - (1 as int)
                    as int)) as bool)
        } as bool)
    } as bool)
    ((is_even as fn(int) -> bool {mutual::is_even})((n as int)) as bool)
} as bool)

