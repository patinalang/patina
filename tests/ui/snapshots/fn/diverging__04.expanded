#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/fn/diverging.md
// block: 4/4

pub fn main() {
    fn sum_odd_numbers(up_to: int) -> int {
        let mut acc = 0;
        for i in 0..up_to {
            // Notice that the return type of this match expression must be int
            // because of the type of the "addition" variable.
            let addition: int =
                match i % 2 == 1 {

                        // The "i" variable is of type int, which is perfectly fine.
                        true => i,

                        // On the other hand, the "continue" expression does not return
                        // int, but it is still fine, because it never returns and therefore
                        // does not violate the type requirements of the match expression.
                        false => continue,
                };
            acc += addition;
        }
        acc
    }
    {
        io::put_chars([["Sum of odd numbers up to 9 (excluding): ",
                            patina_fmt::display(sum_odd_numbers(9))]]);
        io::nl();
    };
}
