#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/fn/diverging.md
// block: 4/4

fn main() ({
    fn sum_odd_numbers(up_to: int)
        ->
            int ({
        let mut acc = (0 as int);
        ({
            let _t =
                (match ((into_iter as
                            fn(core::Range<int>) -> <core::Range<int> as core::IntoIterator>::IntoIter {<core::Range<int> as core::IntoIterator>::into_iter})((Range {
                            start: (0 as int), end: (up_to as int) } as
                            core::Range<int>)) as core::Range<int>) {
                    mut iter =>
                        (loop {
                            (match ((next as
                                        fn(core::Range<int>) -> core::Option<(<core::Range<int> as core::Iterator>::Item, core::Range<int>)> {<core::Range<int> as core::Iterator>::next})((iter
                                        as core::Range<int>)) as
                                    core::Option<(int, core::Range<int>)>) {
                                None {} => (break as !),
                                Some {  0: (i, next) } => {
                                    (iter = (next as core::Range<int>) as core::Range<int>);
                                    ({
                                        // Notice that the return type of this match expression must be int
                                        // because of the type of the "addition" variable.
                                        let addition: int =
                                            (match (((i as int) % (2 as int) as int) == (1 as int) as
                                                    bool) {

                                                    // The "i" variable is of type int, which is perfectly fine.
                                                    true => (i as int),

                                                    // On the other hand, the "continue" expression does not return
                                                    // int, but it is still fine, because it never returns and therefore
                                                    // does not violate the type requirements of the match expression.
                                                    false => (continue as !),
                                            } as int);
                                        ((acc as int) += (addition as int) as int);
                                    } as ())
                                }
                            } as ())
                        } as ()),
                } as ());
            _t
        } as ());
        (acc as int)
    } as int)
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Sum of odd numbers up to 9 (excluding): "
                                as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((sum_odd_numbers as
                                        fn(int) -> int {main::sum_odd_numbers})((9 as int)) as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
