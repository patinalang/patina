#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

pub trait Shape {
    // A required method has no body to inline.
    #[inline]
    fn area(self)
    -> int;

    // A provided method can be inlined, where an impl doesn't override it.
    #[inline]
    fn double_area(self) -> int { self.area() * 2 }
}

pub struct Square(pub int);

impl Shape for Square {
    // An impl item can be inlined.
    #[inline]
    fn area(self) -> int { self.0 * self.0 }
}

impl Square {
    #[inline]
    pub fn side(self) -> int { self.0 }
}

#[inline(always)]
pub fn always(x: int) -> int { x }

#[inline(never)]
pub fn never(x: int) -> int { x }

#[inline]
pub struct NotAFunction;
