fn lazy_add(fx: fn() -> int, fy: fn() -> int)
    ->
        fn()
            ->
                int ({
    (||
        (((fx as fn() -> int)() as int) + ((fy as fn() -> int)() as int) as
            int) as {closure@tests/ui/src/fn/parameters__02.pt:5:5: 5:7})
} as fn() -> int)

fn add(x: int, y: int) -> int ({ ((x as int) + (y as int) as int) } as int)

fn mul(x: int, y: int) -> int ({ ((x as int) * (y as int) as int) } as int)

enum MathOp { Add, Mul, }

fn choose_op(op: MathOp)
    ->
        fn(int, int)
            ->
                int ({
    (match (op as MathOp) {
        MathOp::Add => (add as fn(int, int) -> int {add}),
        MathOp::Mul => (mul as fn(int, int) -> int {mul}),
    } as fnref(int, int) -> int)
} as fnref(int, int) -> int)

