fn lazy_add(fx: fn() -> int, fy: fn() -> int)
    ->
        fn()
            ->
                int ({
    (||
        (((fx as fn() -> int)() as int) + ((fy as fn() -> int)() as int) as
            int) as {closure@tests/ui/src/fn/parameters__02.pt:5:5: 5:7});
} as {type error})

fn add(x: int, y: int) -> int ({ ((x as int) + (y as int) as int) } as int)

fn mul(x: int, y: int) -> int ({ ((x as int) * (y as int) as int) } as int)

enum MathOp { Add, Mul, }

fn choose_op(op: MathOp)
    ->
        fnref(int, int) ->
        int ({
    (match (op as MathOp) {
        MathOp::Add => (add as fn(int, int) -> int {add}),
        MathOp::Mul => (mul as fn(int, int) -> int {mul}),
    } as {type error})
} as {type error})

fn main() ({
    let fx =
        (||
            ({
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("fx evaluated!" as str)] as
                                    [str; 1])] as [[str; 1]; 1])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
                (3 as int)
            } as int) as
            {closure@tests/ui/src/fn/parameters__02.pt:29:14: 29:16});
    let fy =
        (||
            ({
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("fy evaluated!" as str)] as
                                    [str; 1])] as [[str; 1]; 1])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
                (5 as int)
            } as int) as
            {closure@tests/ui/src/fn/parameters__02.pt:34:14: 34:16});
    // won't print anything
    let lazy_result =
        ((lazy_add as
                fn(fn() -> int, fn() -> int) -> fn() -> int {lazy_add})((fx as
                {closure@tests/ui/src/fn/parameters__02.pt:29:14: 29:16}),
            (fy as {closure@tests/ui/src/fn/parameters__02.pt:34:14: 34:16}))
            as fn() -> int);

    let op =
        ((choose_op as
                fn(MathOp) -> {type error} {choose_op})((MathOp::Add as
                MathOp)) as {type error});
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((3 as int)) as term), (" op " as str),
                            ((patina_fmt::display as fn(term) -> term)((5 as int)) as
                                term), (" = " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((op as
                                        {type error})((3 as int), (5 as int)) as {type error})) as
                                term)] as [term; 5])] as [[term; 5]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ())
} as ())
