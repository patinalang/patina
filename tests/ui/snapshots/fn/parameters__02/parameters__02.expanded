#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/fn/parameters.md
// block: 2/2

fn lazy_add(fx: fn() -> int, fy: fn() -> int) -> fn() -> int {
    || fx() + fy();
}

fn add(x: int, y: int) -> int { x + y }

fn mul(x: int, y: int) -> int { x * y }

enum MathOp { Add, Mul, }

fn choose_op(op: MathOp) -> fnref(int, int) -> int {
    match op { MathOp::Add => add, MathOp::Mul => mul, }
}

pub fn main() {
    let fx = || { { io::put_chars([["fx evaluated!"]]); io::nl(); }; 3 };

    let fy = || { { io::put_chars([["fy evaluated!"]]); io::nl(); }; 5 };

    // won't print anything
    let lazy_result = lazy_add(fx, fy);

    let op = choose_op(MathOp::Add);
    {
        io::put_chars([[patina_fmt::display(3), " op ",
                            patina_fmt::display(5), " = ",
                            patina_fmt::display(op(3, 5))]]);
        io::nl();
    }
}
