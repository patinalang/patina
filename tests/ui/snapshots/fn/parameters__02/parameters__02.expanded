#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/fn/parameters.md
// block: 2/2

fn lazy_add(fx: fn() -> int, fy: fn() -> int) -> fn() -> int {
    || fx() + fy()
}

fn add(x: int, y: int) -> int { x + y }

fn mul(x: int, y: int) -> int { x * y }

enum MathOp { Add, Mul, }

fn choose_op(op: MathOp) -> fnref(int, int) -> int {
    match op { MathOp::Add => add, MathOp::Mul => mul, }
}

pub fn main() {
    let fx =
        ||
            {


                // won't print anything

                {
                    ::Core::io::put_chars([["fx evaluated!"]]);
                    ::Core::io::nl();
                };
                3
            };
    let fy =
        ||
            {
                {
                    ::Core::io::put_chars([["fy evaluated!"]]);
                    ::Core::io::nl();
                };
                5
            };
    let lazy_result = lazy_add(fx, fy);
    let op = choose_op(MathOp::Add);
    {
        ::Core::io::put_chars([[patina_fmt::display(3), " op ",
                            patina_fmt::display(5), " = ",
                            patina_fmt::display(op(3, 5))]]);
        ::Core::io::nl();
    }
}
