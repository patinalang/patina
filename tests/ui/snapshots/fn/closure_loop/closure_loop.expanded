#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

pub fn closure_loop() -> int {
    let count =
        |x, y|
            {
                let mut i = x;

                loop { i += y; if i > 3 { break; } }

                i
            };

    count(1, 2)
}
