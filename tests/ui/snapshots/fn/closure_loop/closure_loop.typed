#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn closure_loop() ({
    let count =
        (|x, y|
            ({
                let mut i = (x as int);

                (loop {
                    ((i as int) += (y as int) as ());
                    (if ((i as int) > (3 as int) as bool) { (break as !); } as
                        ())
                } as ())

                (i as int)
            } as int) as
            {closure@tests/ui/src/fn/closure_loop.pt:2:17: 2:23});

    ((count as
            {closure@tests/ui/src/fn/closure_loop.pt:2:17: 2:23})((1 as int),
        (2 as int)) as int);
} as ())
