#[attr = Inline(Hint)]
fn sum_to(n: int)
    ->
        int ({
    let mut total = (0 as int);
    ({
        let _t =
            (match ((into_iter as
                        fn(Core::Range<int>) -> <Core::Range<int> as Core::IntoIterator>::IntoIter {<Core::Range<int> as Core::IntoIterator>::into_iter})((Range {
                        start: (0 as int), end: (n as int) } as Core::Range<int>))
                    as Core::Range<int>) {
                mut iter =>
                    (loop {
                        (match ((next as
                                    fn(Core::Range<int>) -> Core::Option<(<Core::Range<int> as Core::Iterator>::Item, Core::Range<int>)> {<Core::Range<int> as Core::Iterator>::next})((iter
                                    as Core::Range<int>)) as
                                Core::Option<(int, Core::Range<int>)>) {
                            None {} => (break as !),
                            Some {  0: (i, next) } => {
                                (iter = (next as Core::Range<int>) as Core::Range<int>);
                                ({ ((total as int) += (i as int) as int); } as ())
                            }
                        } as ())
                    } as ()),
            } as ());
        _t
    } as ());
    (total as int)
} as int)

