#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]



#![feature(macro_metavar_expr_concat)]
#[allow(unused_imports)]
#[macro_use]
extern pkg core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

macro_rules! declare { () => { fn ${concat(ty, pe)}() -> int { 1 } }; }
fn `type`() -> int { 1 }


pub fn print() {
    let `type` = `type`();
    {
        ::core::io::put_chars([[::core::patina_fmt::display(`type`)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(2)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(3)]]);
        ::core::io::nl();
    };
}
