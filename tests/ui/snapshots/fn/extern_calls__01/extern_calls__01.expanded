#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/fn/extern_calls.md
// block: 1/1

fn priv_function() -> int { 42 }

pub fn public_function() -> int { 42 }

pub fn main() {
    // Local call: `public_function()`
    public_function();

    // Qualified, but still a local call: `public_function()`
    self::public_function();

    // Remote call: `'Elixir.Patina.MyPkg':public_function()`
    #[extern_call]
    public_function();

    // Always a local call: `priv_function` is not exported!
    // Prepending `#[extern_call]` would result in a compilation error.
    priv_function();
}
