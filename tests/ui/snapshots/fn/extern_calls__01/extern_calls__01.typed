#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/fn/extern_calls.md
// block: 1/1

fn priv_function() -> int ({ (42 as int) } as int)

fn public_function() -> int ({ (42 as int) } as int)

fn main() ({
    // Local call: `public_function()`
    ((public_function as fn() -> int {public_function})() as int);

    // Qualified, but still a local call: `public_function()`
    ((self::public_function as fn() -> int {public_function})() as int);

    // Remote call: `'Elixir.Patina.MyPkg':public_function()`
    #[attr = ExternCall]
    ((public_function as fn() -> int {public_function})() as int);

    // Always a local call: `priv_function` is not exported!
    // Prepending `#[extern_call]` would result in a compilation error.
    ((priv_function as fn() -> int {priv_function})() as int);
} as ())
