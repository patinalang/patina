#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

use macros_and_items::{Describe, Plain, doubled, echo, plain};

pub struct Marker;
fn derived_value() -> int { 42 }

pub fn items() {
    let n = Plain { value: 5 };

    {
        ::core::io::put_chars([[::core::patina_fmt::display(n.describe()),
                            " ", ::core::patina_fmt::display(plain()), " ",
                            ::core::patina_fmt::display(derived_value())]]);
        ::core::io::nl();
    };
}
pub fn macros() {
    {
        ::core::io::put_chars([[::core::patina_fmt::display(5 + 5), " ",
                            ::core::patina_fmt::display(7)]]);
        ::core::io::nl();
    };
}
