use ::{};
use MacrosAndItems::Describe;
use MacrosAndItems::Plain;
use MacrosAndItems::doubled;
use MacrosAndItems::echo;
use MacrosAndItems::plain;

struct Marker;
fn derived_value() -> int ({ (42 as int) } as int)

fn items() ({
    let n = (Plain { value: (5 as int) } as MacrosAndItems::Plain);

    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((n as MacrosAndItems::Plain).describe()
                                    as int)) as term), (" " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((plain as
                                        fn() -> int {MacrosAndItems::plain})() as int)) as term),
                            (" " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((derived_value as
                                        fn() -> int {derived_value})() as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn macros() ({
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((5 as int) + (5 as int) as int)) as
                                term), (" " as str),
                            ((patina_fmt::display as fn(term) -> term)((7 as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
