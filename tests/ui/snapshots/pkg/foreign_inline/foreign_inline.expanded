#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

use inlines::{InlineImpl, Trait, calls_private_fn, generic_calls_method};

pub struct LocalImpl(pub int);

impl Trait for LocalImpl {
    fn method(self) -> int { self.0 }
}

pub fn copy_calls_private_fn() -> int { calls_private_fn(1) }

pub fn inlines_foreign_impl_method() -> int { InlineImpl(2).method() }

pub fn inlines_foreign_generic_with_foreign_impl() -> int {
    generic_calls_method(InlineImpl(2))
}

pub fn foreign_generic_calls_local_impl_statically() -> int {
    generic_calls_method(LocalImpl(5))
}
