#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

use ::{};
use inlines::InlineImpl;
use inlines::Trait;
use inlines::calls_private_fn;
use inlines::generic_calls_method;

struct LocalImpl(int);

impl Trait for LocalImpl {
    fn method(self) -> int ({ ((self as LocalImpl).0 as int) } as int)
}

fn copy_calls_private_fn()
    ->
        int ({
    ((calls_private_fn as
            fn(int) -> int {inlines::calls_private_fn})((1 as int)) as int)
} as int)

fn inlines_foreign_impl_method()
    ->
        int ({
    (((InlineImpl as
                fn(int) -> inlines::InlineImpl {inlines::InlineImpl})((2 as
                int)) as inlines::InlineImpl).method() as int)
} as int)

fn inlines_foreign_generic_with_foreign_impl()
    ->
        int ({
    ((generic_calls_method as
            fn(inlines::InlineImpl) -> int {inlines::generic_calls_method::<inlines::InlineImpl>})(((InlineImpl
                as
                fn(int) -> inlines::InlineImpl {inlines::InlineImpl})((2 as
                int)) as inlines::InlineImpl)) as int)
} as int)

fn foreign_generic_calls_local_impl_statically()
    ->
        int ({
    ((generic_calls_method as
            fn(LocalImpl) -> int {inlines::generic_calls_method::<LocalImpl>})(((LocalImpl
                as fn(int) -> LocalImpl {LocalImpl})((5 as int)) as
            LocalImpl)) as int)
} as int)
