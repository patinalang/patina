#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

use reexports::{Hello, Wrapper, identity};

pub struct Relayed {
    pub value: int,
}
pub fn hello_from_derive() -> int { 7 }

pub fn proc_macros() {
    let relayed = Relayed { value: 3 };

    {
        ::core::io::put_chars([[::core::patina_fmt::display(relayed.value +
                                    1), " ",
                            ::core::patina_fmt::display(hello_from_derive())]]);
        ::core::io::nl();
    };
}
pub fn wrapper() {
    let w = Wrapper(9);
    {
        ::core::io::put_chars([[::core::patina_fmt::display(w.0)]]);
        ::core::io::nl();
    };
}
