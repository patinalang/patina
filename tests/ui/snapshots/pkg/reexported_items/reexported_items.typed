#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

use ::{};
use reexports::Hello;
use reexports::Wrapper;
use reexports::identity;

struct Relayed {
    value: int,
}
fn hello_from_derive() -> int ({ (7 as int) } as int)

fn proc_macros() ({
    let relayed = (Relayed { value: (3 as int) } as Relayed);

    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((((relayed as Relayed).value as int) +
                                    (1 as int) as int)) as term), (" " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((hello_from_derive as
                                        fn() -> int {hello_from_derive})() as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn wrapper() ({
    let w =
        ((Wrapper as
                fn(int) -> reexports::Wrapper<int> {reexports::Wrapper::<int>})((9
                as int)) as reexports::Wrapper<int>);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)(((w as reexports::Wrapper<int>).0 as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
