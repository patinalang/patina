#![allow(internal_features)]



#![allow(private_interfaces)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;
#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

use core::PhantomData;
use ::{};
use wrappers::Nested;
use wrappers::PhantomRecord;
use wrappers::PhantomTuple;
use wrappers::Wrapper;

// `PhantomData` fields of structs from another package are left out too.

fn phantom_tuple(n: int)
    ->
        PhantomTuple<str> ({
    ((PhantomTuple as
            fn(int, core::PhantomData<str>) -> wrappers::PhantomTuple<str> {wrappers::PhantomTuple::<str>})((n
            as int), (PhantomData as core::PhantomData<str>)) as
        wrappers::PhantomTuple<str>)
} as wrappers::PhantomTuple<str>)

fn phantom_tuple_value(value: PhantomTuple<str>)
    ->
        int ({
    let PhantomTuple(n, _) = (value as wrappers::PhantomTuple<str>);
    (n as int)
} as int)

fn phantom_record(id: int, name: str)
    ->
        PhantomRecord<int> ({
    (PhantomRecord {
        (id as int),
        marker: (PhantomData as core::PhantomData<int>),
        (name as str) } as wrappers::PhantomRecord<int>)
} as wrappers::PhantomRecord<int>)

fn phantom_record_name(value: PhantomRecord<int>)
    -> str ({ ((value as wrappers::PhantomRecord<int>).name as str) } as str)

fn phantom_record_marker(value: PhantomRecord<int>)
    ->
        PhantomData<int> ({
    let PhantomRecord {  marker, .. } =
        (value as wrappers::PhantomRecord<int>);
    (marker as core::PhantomData<int>)
} as core::PhantomData<int>)

fn rename_phantom_record(value: PhantomRecord<int>)
    ->
        PhantomRecord<int> ({
    (PhantomRecord {
        name: ("renamed" as str), ..(value as wrappers::PhantomRecord<int>) }
        as wrappers::PhantomRecord<int>)
} as wrappers::PhantomRecord<int>)

// A local type nested in generic wrappers from another package.

enum Recursive { End(int), Next(Nested<Recursive>), }

fn recursive()
    ->
        Recursive ({
    ((Recursive::Next as
            fn(wrappers::Nested<Recursive>) -> Recursive {Recursive::Next})(((Nested
                as
                fn(wrappers::Wrapper<Recursive>) -> wrappers::Nested<Recursive> {wrappers::Nested::<Recursive>})(((Wrapper
                    as
                    fn(Recursive) -> wrappers::Wrapper<Recursive> {wrappers::Wrapper::<Recursive>})(((Recursive::End
                        as fn(int) -> Recursive {Recursive::End})((17 as int)) as
                    Recursive)) as wrappers::Wrapper<Recursive>)) as
            wrappers::Nested<Recursive>)) as Recursive)
} as Recursive)

fn unwrap_recursive(value: Recursive)
    ->
        int ({
    (match (value as Recursive) {
        Recursive::End(n) => (n as int),
        Recursive::Next(wrapper) =>
            ((unwrap_recursive as
                    fn(Recursive) -> int {unwrap_recursive})((((wrapper as
                            wrappers::Nested<Recursive>).0 as
                        wrappers::Wrapper<Recursive>).0 as Recursive)) as int),
    } as int)
} as int)
