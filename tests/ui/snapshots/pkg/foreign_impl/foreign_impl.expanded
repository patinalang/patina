#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// snapshot: app
use more_temperatures::{Kelvin, Rankine};
use temperatures::{Celsius, From};
use traits::{Label, Loud, Show};

// A local trait on a foreign type.
trait Size {
    fn size(self)
    -> int;
}

impl Size for Label {
    fn size(self) -> int { 5 }
}

fn size_of<T: Size>(t: T) -> int { t.size() }

// A foreign trait with a local argument, on a foreign type.
pub struct LocalDegrees(pub int);

impl From<LocalDegrees> for Celsius {
    fn from(d: LocalDegrees) -> Celsius { Celsius(d.0) }
}

pub fn label_size() -> int { size_of(Label("abcde")) }

pub fn local_to_celsius(n: int) -> int {
    temperatures::to_celsius(LocalDegrees(n))
}

pub fn fahrenheit_to_celsius(f: int) -> int {
    temperatures::to_celsius(temperatures::Fahrenheit(f))
}

pub fn kelvin_to_celsius(k: int) -> int {
    temperatures::to_celsius(Kelvin(k))
}

pub fn rankine_to_celsius(r: int) -> int {
    temperatures::to_celsius(Rankine(r))
}

// Two independent packages implement different traits for `traits::Label`.
pub fn label_shout() -> str { label_shout::shout(Label("x")) }

pub fn label_whisper() -> str { label_whisper::whisper(Label("x")) }

pub fn label_show() -> str { Label("shown").show() }

// A blanket impl from another package, on a foreign and on a local type.
struct Local;

impl Show for Local {
    fn show(self) -> str { "local" }
}

fn loud_generic<T: Loud>(t: T) -> str { t.loud() }

pub fn blanket_on_foreign_type(s: str) -> str { Label(s).loud() }

pub fn blanket_on_local_type() -> str { Local.loud() }

pub fn blanket_generic_both(s: str) -> str {
    loud_generic(Label(s)) + loud_generic(Local)
}
