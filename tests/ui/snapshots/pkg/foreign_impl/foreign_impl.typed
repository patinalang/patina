#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// snapshot: app
use ::{};
use more_temperatures::Kelvin;
use more_temperatures::Rankine;
use ::{};
use temperatures::Celsius;
use temperatures::From;
use ::{};
use traits::Label;
use traits::Loud;
use traits::Show;

// A local trait on a foreign type.
trait Size {
    fn size(self)
    -> int;
}

impl Size for Label {
    fn size(self) -> int ({ (5 as int) } as int)
}

fn size_of<T>(t: T) -> int where T: Size ({ ((t as T).size() as int) } as int)

// A foreign trait with a local argument, on a foreign type.
struct LocalDegrees(int);

impl From<LocalDegrees> for Celsius {
    fn from(d: LocalDegrees)
        ->
            Celsius ({
        ((Celsius as
                fn(int) -> temperatures::Celsius {temperatures::Celsius})(((d
                    as LocalDegrees).0 as int)) as temperatures::Celsius)
    } as temperatures::Celsius)
}

fn label_size()
    ->
        int ({
    ((size_of as
            fn(traits::Label) -> int {size_of::<traits::Label>})(((Label as
                fn(str) -> traits::Label {traits::Label})(("abcde" as str)) as
            traits::Label)) as int)
} as int)

fn local_to_celsius(n: int)
    ->
        int ({
    ((temperatures::to_celsius as
            fn(LocalDegrees) -> int {temperatures::to_celsius::<LocalDegrees>})(((LocalDegrees
                as fn(int) -> LocalDegrees {LocalDegrees})((n as int)) as
            LocalDegrees)) as int)
} as int)

fn fahrenheit_to_celsius(f: int)
    ->
        int ({
    ((temperatures::to_celsius as
            fn(temperatures::Fahrenheit) -> int {temperatures::to_celsius::<temperatures::Fahrenheit>})(((temperatures::Fahrenheit
                as
                fn(int) -> temperatures::Fahrenheit {temperatures::Fahrenheit})((f
                as int)) as temperatures::Fahrenheit)) as int)
} as int)

fn kelvin_to_celsius(k: int)
    ->
        int ({
    ((temperatures::to_celsius as
            fn(more_temperatures::Kelvin) -> int {temperatures::to_celsius::<more_temperatures::Kelvin>})(((Kelvin
                as
                fn(int) -> more_temperatures::Kelvin {more_temperatures::Kelvin})((k
                as int)) as more_temperatures::Kelvin)) as int)
} as int)

fn rankine_to_celsius(r: int)
    ->
        int ({
    ((temperatures::to_celsius as
            fn(more_temperatures::Rankine) -> int {temperatures::to_celsius::<more_temperatures::Rankine>})(((Rankine
                as
                fn(int) -> more_temperatures::Rankine {more_temperatures::Rankine})((r
                as int)) as more_temperatures::Rankine)) as int)
} as int)

// Two independent packages implement different traits for `traits::Label`.
fn label_shout()
    ->
        str ({
    ((label_shout::shout as
            fn(traits::Label) -> str {label_shout::shout::<traits::Label>})(((Label
                as fn(str) -> traits::Label {traits::Label})(("x" as str)) as
            traits::Label)) as str)
} as str)

fn label_whisper()
    ->
        str ({
    ((label_whisper::whisper as
            fn(traits::Label) -> str {label_whisper::whisper::<traits::Label>})(((Label
                as fn(str) -> traits::Label {traits::Label})(("x" as str)) as
            traits::Label)) as str)
} as str)

fn label_show()
    ->
        str ({
    (((Label as fn(str) -> traits::Label {traits::Label})(("shown" as str)) as
            traits::Label).show() as str)
} as str)

// A blanket impl from another package, on a foreign and on a local type.
struct Local;

impl Show for Local {
    fn show(self) -> str ({ ("local" as str) } as str)
}

fn loud_generic<T>(t: T) -> str where
    T: Loud ({ ((t as T).loud() as str) } as str)

fn blanket_on_foreign_type(s: str)
    ->
        str ({
    (((Label as fn(str) -> traits::Label {traits::Label})((s as str)) as
            traits::Label).loud() as str)
} as str)

fn blanket_on_local_type()
    -> str ({ ((Local as Local).loud() as str) } as str)

fn blanket_generic_both(s: str)
    ->
        str ({
    (((loud_generic as
                fn(traits::Label) -> str {loud_generic::<traits::Label>})(((Label
                    as fn(str) -> traits::Label {traits::Label})((s as str)) as
                traits::Label)) as str) +
        ((loud_generic as
                fn(Local) -> str {loud_generic::<Local>})((Local as Local)) as
            str) as str)
} as str)
