#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

use macros::{
    braces, call_site_by_set_span, call_site_ident, delimiters, escapes,
    forty_two, identity, identity_alias, literal_factories, negative,
    passthrough, raw_ident, rebuild, render, replace_with_answer, respan,
    stream_ops, untyped_literals, wrapped, Hello, TypeName,
};
use macros::nested::nested_identity;

// Macro kinds.

// Proc macros are macro-only downstream, so functions of the same names do not
// clash with them.
fn identity() -> int { 10 }
fn identity_alias() -> int { 20 }
fn nested_identity() -> int { 30 }

pub fn answer() -> int { 42 }

// Replaced by `pub fn from_attr() -> int { 40 + 2 }`.
pub fn from_attr() -> int { 40 + 2 }

#[repr(tagged, tag = "point")]
pub struct Point {
    #[helper]
    pub x: int,
    pub y: int,
}
pub fn hello_from_derive() -> int { 7 }
pub fn type_name() -> str { "Point" }

pub fn bang() {



    // Token streams.



    // A declarative macro forwards a captured expression into a proc macro, so the
    // input arrives wrapped in an invisible metavariable group.


    // Operators of three characters, split into one punct each on the wire
    // and glued back together on the way in.

    // Groups nested well past anything the other tests reach, in all three
    // delimiters.

    // Literal kinds beyond the integers and strings the other tests cover.

    // An inclusive range, for the `..=` operator.

    // A literal whose text is negative: one wire tree, two tokens.




    // `delimiters!()` is `([1, 2], <1 + 2> * 3)` with an invisible group.


    // Literals.


    // Byte literals are only decoded, never type-checked.


    // Hygiene.


    // `` `x` `` and `x` name the same binding.

    // A definition-site identifier moved to the call site with `set_span`.
    // Every variant keeps its payload when moved: an identifier, punctuation,
    // a literal and a group with its contents.
    {
        ::core::io::put_chars([[patina_fmt::display(1 + 2)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::display(4 + 1)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::display(5 + 2)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::display(identity()), " ",
                            patina_fmt::display(identity_alias()), " ",
                            patina_fmt::display(nested_identity())]]);
        ::core::io::nl();
    };
    { ::core::io::put_chars([[patina_fmt::display(42)]]); ::core::io::nl(); };
}
pub fn attribute() {
    {
        ::core::io::put_chars([[patina_fmt::display(answer()), " ",
                            patina_fmt::display(from_attr())]]);
        ::core::io::nl();
    };
}
pub fn derive() {
    let point = Point { x: 1, y: 2 };
    {
        ::core::io::put_chars([[patina_fmt::display(point.x + point.y), " ",
                            patina_fmt::display(hello_from_derive()), " ",
                            patina_fmt::display(type_name())]]);
        ::core::io::nl();
    };
}
#[doc =
" An outer doc comment reaches the macro as tokens, where it is a `#` punct"]
#[doc = " followed by a bracketed `doc` attribute."]
pub fn documented() -> int { 1 }
#[doc =
" An inner doc comment is a `#`, a `!` and the group, one tree more than an"]
#[doc = " outer one."]
pub mod documented {
    #![doc = " Inner documentation."]
    pub fn value() -> int { 2 }
}
macro_rules! forward { ($e:expr) => { identity!($e) }; }
pub fn round_trip() {
    let a = 1 + 2 * 3;
    let b = { let inner = 10; inner * 2 };
    let c = { 1 + 2 };
    {
        ::core::io::put_chars([[patina_fmt::display(a), " ",
                            patina_fmt::display(b), " ", patina_fmt::display(c)]]);
        ::core::io::nl();
    };
}
pub fn token_zoo() {
    let shifted = { let mut x = 1; x <<= 3; x >>= 1; x };
    let nested =
        {
            let deep = (1, (2, (3, (4, 5))));
            let lists = [[1, 2], [3, 4]];
            match deep { (a, (b, (c, (d, e)))) => a + b + c + d + e, }
        };
    let float = 2.5e-1;
    let text = "a \"quoted\" string";
    let raw = r#"no \escapes"#;
    let atom = a"atom";
    let raw_atom = ar#"raw \atom"#;
    let bits = 0b0011 & 0x0f;
    let ranged = match 3 { 1..=5 => true, _ => false, };
    let neg = -5;
    {
        ::core::io::put_chars([[patina_fmt::display(shifted), " ",
                            patina_fmt::display(nested), " ",
                            patina_fmt::display(float), " ", patina_fmt::display(text),
                            " ", patina_fmt::display(raw), " ",
                            patina_fmt::display(atom), " ",
                            patina_fmt::display(raw_atom), " ",
                            patina_fmt::display(bits), " ", patina_fmt::display(ranged),
                            " ", patina_fmt::display(neg)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::display(documented()), " ",
                            patina_fmt::display(documented::value())]]);
        ::core::io::nl();
    };
}
pub fn forwarded() {
    {
        ::core::io::put_chars([[patina_fmt::display(1 + 2)]]);
        ::core::io::nl();
    };
}
pub fn rebuilt() {
    {
        ::core::io::put_chars([[patina_fmt::display((1 + 2) * 3)]]);
        ::core::io::nl();
    };
}
pub fn built_streams() {
    {
        ::core::io::put_chars([[patina_fmt::display(1 + 2)]]);
        ::core::io::nl();
    };
    let (list, product) = ([1, 2], 1 + 2 * 3);
    match list {
        [a, b] => {
            ::core::io::put_chars([[patina_fmt::display(a), " ",
                                patina_fmt::display(b), " ",
                                patina_fmt::display(product)]]);
            ::core::io::nl();
        }
        _ => { ::core::io::put_chars([["unexpected"]]); ::core::io::nl(); }
    }
}
pub fn rendered() {
    {
        ::core::io::put_chars([[patina_fmt::display("`x` += f(1, \"q\\n\") r#\"raw\"# a\"at\" 'c' #[z] a.b if (y) m! (1) if ! w receive (v) `if`(u) fn(t)")]]);
        ::core::io::nl();
    };
}
macro_rules! discard { ($($t:tt)*) => {}; }
pub fn constructors() {
    let (c, i, big, f, s, a) =
        ('a', 1, 123456789012345678901234567890, 0.25, "s", a"a");
    {
        ::core::io::put_chars([[patina_fmt::display(c), " ",
                            patina_fmt::display(i), " ", patina_fmt::display(big), " ",
                            patina_fmt::display(f), " ", patina_fmt::display(s), " ",
                            patina_fmt::display(a)]]);
        ::core::io::nl();
    };
    ;
}
pub fn escaped() {
    let (s, quote, backslash, double, non_ascii, a) =
        ("a\"b\\c\nd'e", '\'', '\\', '"', 'ż', a"x \"y\"");
    {
        ::core::io::put_chars([[patina_fmt::display(s), " ",
                            patina_fmt::display(quote), " ",
                            patina_fmt::display(backslash), " ",
                            patina_fmt::display(double), " ",
                            patina_fmt::display(non_ascii), " ",
                            patina_fmt::display(a)]]);
        ::core::io::nl();
    };
}
pub fn call_site() {
    let local = 5;
    {
        ::core::io::put_chars([[patina_fmt::display(local)]]);
        ::core::io::nl();
    };
}
pub fn raw_identifier() {
    let x = 7;
    { ::core::io::put_chars([[patina_fmt::display(x)]]); ::core::io::nl(); };
}
pub fn set_span() {
    let local = 5;
    {
        ::core::io::put_chars([[patina_fmt::display(local)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::display(local + 1 -
                                    (local * 2))]]);
        ::core::io::nl();
    };
}
