#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/variable_bindings.md
// block: 1/1

fn main() ({
    let an_integer = (1 as int);
    let a_boolean = (true as bool);
    let unit = (() as ());

    // copy `an_integer` into `copied_integer`
    let copied_integer = (an_integer as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("An integer: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(

                                (copied_integer as int)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("A boolean: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((a_boolean as bool)) as term)] as
                        [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Meet the unit value: " as str),
                            ((patina_fmt::debug as fn(term) -> term)((unit as ())) as
                                term)] as [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // The compiler warns about unused variable bindings; these warnings can
    // be silenced by prefixing the variable name with an underscore
    let _unused_variable = (3 as int);

    let noisy_unused_variable = (2 as int);
    // FIXME ^ Prefix with an underscore to suppress the warning
} as ())
