fn skip_odd_until(xs: [int], limit: int)
    ->
        int ({
    let mut total = (0 as int);
    ({
        let _t =
            (match ((into_iter as
                        fn([int]) -> <[int] as Core::IntoIterator>::IntoIter {<[int] as Core::IntoIterator>::into_iter})((xs
                        as [int])) as Core::ListIter<int>) {
                mut iter =>
                    (loop {
                        (match ((next as
                                    fn(Core::ListIter<int>) -> Core::Option<(<Core::ListIter<int> as Core::Iterator>::Item, Core::ListIter<int>)> {<Core::ListIter<int> as Core::Iterator>::next})((iter
                                    as Core::ListIter<int>)) as
                                Core::Option<(int, Core::ListIter<int>)>) {
                            None {} => (break as !),
                            Some {  0: (x, next) } => {
                                (iter = (next as Core::ListIter<int>) as
                                    Core::ListIter<int>);
                                ({
                                    (if (((x as int) % (2 as int) as int) == (1 as int) as bool)
                                        {
                                        (continue as !);
                                    } as ())
                                    (if ((x as int) > (limit as int) as bool) { (break as !); }
                                        as ())
                                    ((total as int) += (x as int) as int);
                                } as ())
                            }
                        } as ())
                    } as ()),
            } as ());
        _t
    } as ());
    (total as int)
} as int)

fn find_index(xs: [int], target: int)
    ->
        int ({
    let mut index = (0 as int);
    ({
        let _t =
            (match ((into_iter as
                        fn([int]) -> <[int] as Core::IntoIterator>::IntoIter {<[int] as Core::IntoIterator>::into_iter})((xs
                        as [int])) as Core::ListIter<int>) {
                mut iter =>
                    (loop {
                        (match ((next as
                                    fn(Core::ListIter<int>) -> Core::Option<(<Core::ListIter<int> as Core::Iterator>::Item, Core::ListIter<int>)> {<Core::ListIter<int> as Core::Iterator>::next})((iter
                                    as Core::ListIter<int>)) as
                                Core::Option<(int, Core::ListIter<int>)>) {
                            None {} => (break as !),
                            Some {  0: (x, next) } => {
                                (iter = (next as Core::ListIter<int>) as
                                    Core::ListIter<int>);
                                ({
                                    (if ((x as int) == (target as int) as bool) {
                                        (return (index as int) as !);
                                    } as ())
                                    ((index as int) += (1 as int) as int);
                                } as ())
                            }
                        } as ())
                    } as ()),
            } as ());
        _t
    } as ());
    (-(1 as int) as int)
} as int)

fn first_pair_with_sum(xs: [int], sum: int)
    ->
        (int,
        int) ({
    let mut found = (((0 as int), (0 as int)) as (int, int));
    ({
        let _t =
            (match ((into_iter as
                        fn([int]) -> <[int] as Core::IntoIterator>::IntoIter {<[int] as Core::IntoIterator>::into_iter})((xs
                        as [int])) as Core::ListIter<int>) {
                mut iter =>
                    ('outer: loop {
                        (match ((next as
                                    fn(Core::ListIter<int>) -> Core::Option<(<Core::ListIter<int> as Core::Iterator>::Item, Core::ListIter<int>)> {<Core::ListIter<int> as Core::Iterator>::next})((iter
                                    as Core::ListIter<int>)) as
                                Core::Option<(int, Core::ListIter<int>)>) {
                            None {} => (break as !),
                            Some {  0: (a, next) } => {
                                (iter = (next as Core::ListIter<int>) as
                                    Core::ListIter<int>);
                                ({
                                    ({
                                        let _t =
                                            (match ((into_iter as
                                                        fn([int]) -> <[int] as Core::IntoIterator>::IntoIter {<[int] as Core::IntoIterator>::into_iter})((xs
                                                        as [int])) as Core::ListIter<int>) {
                                                mut iter =>
                                                    (loop {
                                                        (match ((next as
                                                                    fn(Core::ListIter<int>) -> Core::Option<(<Core::ListIter<int> as Core::Iterator>::Item, Core::ListIter<int>)> {<Core::ListIter<int> as Core::Iterator>::next})((iter
                                                                    as Core::ListIter<int>)) as
                                                                Core::Option<(int, Core::ListIter<int>)>) {
                                                            None {} => (break as !),
                                                            Some {  0: (b, next) } => {
                                                                (iter = (next as Core::ListIter<int>) as
                                                                    Core::ListIter<int>);
                                                                ({
                                                                    (if ((b as int) <= (a as int) as bool) { (continue as !); }
                                                                        as ())
                                                                    (if (((a as int) + (b as int) as int) == (sum as int) as
                                                                            bool) {
                                                                        (found = (((a as int), (b as int)) as (int, int)) as
                                                                            (int, int));
                                                                        (break 'outer as !);
                                                                    } as ())
                                                                } as ())
                                                            }
                                                        } as ())
                                                    } as ()),
                                            } as ());
                                        _t
                                    } as ())
                                } as ())
                            }
                        } as ())
                    } as ()),
            } as ());
        _t
    } as ());
    (found as (int, int))
} as (int, int))

fn count_skipping_rows(rows: [[int]])
    ->
        int ({
    let mut visited = (0 as int);
    ({
        let _t =
            (match ((into_iter as
                        fn([[int]]) -> <[[int]] as Core::IntoIterator>::IntoIter {<[[int]] as Core::IntoIterator>::into_iter})((rows
                        as [[int]])) as Core::ListIter<[int]>) {
                mut iter =>
                    ('rows: loop {
                        (match ((next as
                                    fn(Core::ListIter<[int]>) -> Core::Option<(<Core::ListIter<[int]> as Core::Iterator>::Item, Core::ListIter<[int]>)> {<Core::ListIter<[int]> as Core::Iterator>::next})((iter
                                    as Core::ListIter<[int]>)) as
                                Core::Option<([int], Core::ListIter<[int]>)>) {
                            None {} => (break as !),
                            Some {  0: (row, next) } => {
                                (iter = (next as Core::ListIter<[int]>) as
                                    Core::ListIter<[int]>);
                                ({
                                    ({
                                        let _t =
                                            (match ((into_iter as
                                                        fn([int]) -> <[int] as Core::IntoIterator>::IntoIter {<[int] as Core::IntoIterator>::into_iter})((row
                                                        as [int])) as Core::ListIter<int>) {
                                                mut iter =>
                                                    (loop {
                                                        (match ((next as
                                                                    fn(Core::ListIter<int>) -> Core::Option<(<Core::ListIter<int> as Core::Iterator>::Item, Core::ListIter<int>)> {<Core::ListIter<int> as Core::Iterator>::next})((iter
                                                                    as Core::ListIter<int>)) as
                                                                Core::Option<(int, Core::ListIter<int>)>) {
                                                            None {} => (break as !),
                                                            Some {  0: (x, next) } => {
                                                                (iter = (next as Core::ListIter<int>) as
                                                                    Core::ListIter<int>);
                                                                ({
                                                                    (if ((x as int) < (0 as int) as bool) {
                                                                        (continue 'rows as !);
                                                                    } as ())
                                                                    ((visited as int) += (1 as int) as int);
                                                                } as ())
                                                            }
                                                        } as ())
                                                    } as ()),
                                            } as ());
                                        _t
                                    } as ())
                                } as ())
                            }
                        } as ())
                    } as ()),
            } as ());
        _t
    } as ());
    (visited as int)
} as int)

struct Countdown {
    from: int,
}

impl Iterator for Countdown {
    type
    Item
    =
    int;

    fn next(self)
        ->
            Option<(int,
            Countdown)> ({
        (if (((self as Countdown).from as int) == (0 as int) as bool) {
            (None as Core::Option<(int, Countdown)>)
        } else {
            ((Some as
                    fn((int, Countdown)) -> Core::Option<(int, Countdown)> {Core::Option::<(int, Countdown)>::Some})(((((self
                            as Countdown).from as int),
                    (Countdown {
                        from:
                            (((self as Countdown).from as int) - (1 as int) as int) } as
                        Countdown)) as (int, Countdown))) as
                Core::Option<(int, Countdown)>)
        } as Core::Option<(int, Countdown)>)
    } as Core::Option<(int, Countdown)>)
}

fn countdown(from: int)
    ->
        [int] ({
    let mut seen = ([] as [int]);
    ({
        let _t =
            (match ((into_iter as
                        fn(Countdown) -> <Countdown as Core::IntoIterator>::IntoIter {<Countdown as Core::IntoIterator>::into_iter})((Countdown {
                        from: (from as int) } as Countdown)) as Countdown) {
                mut iter =>
                    (loop {
                        (match ((next as
                                    fn(Countdown) -> Core::Option<(<Countdown as Core::Iterator>::Item, Countdown)> {<Countdown as Core::Iterator>::next})((iter
                                    as Countdown)) as Core::Option<(int, Countdown)>) {
                            None {} => (break as !),
                            Some {  0: (n, next) } => {
                                (iter = (next as Countdown) as Countdown);
                                ({
                                    (seen = ([(n as int), ..(seen as [int])] as [int]) as
                                        [int]);
                                } as ())
                            }
                        } as ())
                    } as ()),
            } as ());
        _t
    } as ());
    (seen as [int])
} as [int])

struct Bag {
    items: [str],
}

impl IntoIterator for Bag {
    type
    Item
    =
    str;
    type
    IntoIter
    =
    Core::ListIter<str>;

    fn into_iter(self)
        ->
            Core::ListIter<str> ({
        (((self as Bag).items as [str]).iter() as Core::ListIter<str>)
    } as Core::ListIter<str>)
}

fn bag_count(items: [str])
    ->
        int ({
    ((count as
            fn(Bag) -> int {count::<Bag>})((Bag { items: (items as [str]) } as
            Bag)) as int)
} as int)
