#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/if_else.md
// block: 1/1

fn main() ({
    let n = (5 as int);

    (if ((n as int) < (0 as int) as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([((patina_fmt::display as
                                fn(term) -> term)((n as int)) as term),
                        (" is negative" as str)] as [term; 2])) as term);
        } as ());
    } else if ((n as int) > (0 as int) as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([((patina_fmt::display as
                                fn(term) -> term)((n as int)) as term),
                        (" is positive" as str)] as [term; 2])) as term);
        } as ());
    } else {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([((patina_fmt::display as
                                fn(term) -> term)((n as int)) as term), (" is zero" as str)]
                    as [term; 2])) as term);
        } as ());
    } as ())

    let big_n =
        (if (((n as int) < (10 as int) as bool) &&
                ((n as int) > (-(10 as int) as int) as bool) as bool) {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([(", and is a small number, increase ten-fold"
                                        as str)] as [str; 1])] as [[str; 1]; 1])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());

            // This expression returns an `int`.
            ((10 as int) * (n as int) as int)
        } else {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([(", and is a big number, halve the number"
                                        as str)] as [str; 1])] as [[str; 1]; 1])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());

            // This expression must return an `int` as well.
            ((n as int) / (2 as int) as int)
            // TODO ^ Try suppressing this expression with a semicolon.
        } as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(
                                //   ^ Don't forget to put a semicolon here! All `let` bindings need it.

                                (n as int)) as term), (" -> " as str),
                            ((patina_fmt::display as fn(term) -> term)((big_n as int))
                                as term)] as [term; 3])] as [[term; 3]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
