                    as [term])) as term);
        } as ());
    } as ())
    let big_n =
        (if (((n as int) < (10 as int) as bool) &&
                ((n as int) > (-(10 as int) as int) as bool) as bool) {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([(", and is a small number, increase ten-fold"
