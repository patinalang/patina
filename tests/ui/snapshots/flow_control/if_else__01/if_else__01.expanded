pub fn main() {
    let n = 5;

    if n < 0 {


        // This expression returns an `int`.

        // This expression must return an `int` as well.
        // TODO ^ Try suppressing this expression with a semicolon.
        //   ^ Don't forget to put a semicolon here! All `let` bindings need it.

        {
            ::core::io::put_chars([::core::patina_fmt::display(n),
                        " is negative"]);
        };
    } else if n > 0 {
        {
            ::core::io::put_chars([::core::patina_fmt::display(n),
                        " is positive"]);
        };
    } else {
        {
            ::core::io::put_chars([::core::patina_fmt::display(n),
                        " is zero"]);
        };
    }
    let big_n =
        if n < 10 && n > -10 {
            {
                ::core::io::put_chars([[", and is a small number, increase ten-fold"]]);
                ::core::io::nl();
            };
            10 * n
        } else {
            {
                ::core::io::put_chars([[", and is a big number, halve the number"]]);
                ::core::io::nl();
            };
            n / 2
        };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(n), " -> ",
                            ::core::patina_fmt::display(big_n)]]);
        ::core::io::nl();
    };
}
