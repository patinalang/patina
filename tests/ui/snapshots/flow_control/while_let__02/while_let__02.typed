#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/while_let.md
// block: 2/2

fn main() ({
    // Make `optional` of type `Option<int>`
    let mut optional =
        ((Some as
                fn(int) -> core::option::Option<int> {core::option::Option::<int>::Some})((0
                as int)) as core::option::Option<int>);

    // This reads: "while `let` destructures `optional` into
    // `Some(i)`, evaluate the block (`{}`). Else `break`.
    (loop {
        (if (let Some(i) = (optional as core::option::Option<int>) as bool) {
            (if ((i as int) > (9 as int) as bool) {
                // ^ Less rightward drift and doesn't require
                // explicitly handling the failing case.
                // ^ `if let` had additional optional `else`/`else if`
                // clauses. `while let` does not have these.
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([("Greater than 9, quit!" as str)] as
                                    [str])] as [[str]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
                (optional = (None as core::option::Option<int>) as
                    core::option::Option<int>);
            } else {
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([("`i` is `" as str),
                                        ((::core::patina_fmt::debug as fn(term) -> term)((i as int))
                                            as term), ("`. Try again." as str)] as [term])] as
                            [[term]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
                (optional =
                    ((Some as
                            fn(int) -> core::option::Option<int> {core::option::Option::<int>::Some})(((i
                                as int) + (1 as int) as int)) as core::option::Option<int>)
                    as core::option::Option<int>);
            } as ())
        } else { (break as !); } as ())
    } as ())
} as ())
