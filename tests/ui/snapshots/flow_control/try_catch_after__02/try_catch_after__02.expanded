#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/try_catch_after.md
// block: 2/2

extern mod erlang;

pub fn main() {
    let value =
        try { erlang::error((a"badmatch", 42)); 0 }
            catch {

                // Match a `badmatch` tuple with an `int` value.
                error((a"badmatch", int(n))) => n,
        };

    {
        ::core::io::put_chars([[patina_fmt::display(value)]]);
        ::core::io::nl();
    };
}
