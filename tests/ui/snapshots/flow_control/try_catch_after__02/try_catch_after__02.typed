extern mod erlang;

fn main() ({
    let value =
        (try ({
                ((erlang::error as
                        fn(term) -> term)((((a"badmatch" as atom), (42 as int)) as
                        (atom, int))) as term);
                (0 as int)
            } as int)
            catch {

                // Match a `badmatch` tuple with an `int` value.
                error((a"badmatch", int(n))) => (n as int),
        } as int);

    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((value as int)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
