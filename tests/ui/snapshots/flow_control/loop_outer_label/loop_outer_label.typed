#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn break_outer_loop()
    ->
        int ({
    let mut value = (0 as int);

    ('outer: loop {
        (loop {
            ((value as int) += (1 as int) as ());
            (break 'outer (value as int) as !);
        } as !)
    } as int)
} as int)

fn break_two_loops()
    ->
        int ({
    let mut value = (0 as int);

    ('outer: loop {
        (loop {
            (loop {
                ((value as int) += (1 as int) as ());

                (if ((value as int) == (3 as int) as bool) {
                    (break 'outer ((value as int) * (10 as int) as int) as !);
                } as ())
            } as !)
        } as !)
    } as int)
} as int)

fn outer_break_initializes()
    ->
        int ({
    let value;

    ('outer: loop {
        (loop { ((value as int) = (7 as int) as ()); (break 'outer as !); } as
            !)
    } as ())

    (value as int)
} as int)
