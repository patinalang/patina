#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// snapshot: core0, core

pub fn break_outer_loop() -> int {
    let mut value = 0;

    'outer: loop { loop { value += 1; break 'outer value; } }
}

pub fn break_two_loops() -> int {
    let mut value = 0;

    'outer: loop {
        loop {
            loop {
                value += 1;

                if value == 3 { break 'outer value * 10; }
            }
        }
    }
}

pub fn outer_break_initializes() -> int {
    let value;

    'outer: loop { loop { value = 7; break 'outer; } }

    value
}
