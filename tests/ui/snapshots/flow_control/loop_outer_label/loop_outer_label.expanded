#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn break_outer_loop() -> int {
    let mut value = 0;

    'outer: loop { loop { value += 1; break 'outer value; } }
}

pub fn break_two_loops() -> int {
    let mut value = 0;

    'outer: loop {
        loop {
            loop {
                value += 1;

                if value == 3 { break 'outer value * 10; }
            }
        }
    }
}

pub fn outer_break_initializes() -> int {
    let value;

    'outer: loop { loop { value = 7; break 'outer; } }

    value
}
