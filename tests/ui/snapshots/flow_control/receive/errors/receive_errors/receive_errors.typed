#![allow(internal_features)]










#![deny(unreachable_patterns)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct Value {
    number: int,
}

fn wrong_timeout()
    ->
        int ({
    (receive { int(n) => (n as int), } after (10 as int)
        ({ (-(1 as int) as int) } as int) as int)
} as int)

fn unsafe_pattern()
    ->
        int ({ (receive { Value {  number } => (number as int), } as int) } as
    int)

fn incompatible_arms()
    ->
        int ({
    (receive { int(n) => (n as int), atom(a) => (a as atom), } as
        {type error})
} as {type error})

fn incompatible_timeout()
    ->
        int ({
    (receive { int(n) => (n as int), }
        after ((Timeout::from_millis as
                fn(int) -> Core::Timeout {Core::Timeout::from_millis})((0 as
                int)) as Core::Timeout) ({ (a"bad" as atom) } as {type error})
        as {type error})
} as {type error})

fn range_pattern()
    -> int ({ (receive { 1...5 => (0 as int), } as int) } as int)

fn unreachable_arm()
    ->
        int ({ (receive { _ => (1 as int), int(n) => (n as int), } as int) }
    as int)
