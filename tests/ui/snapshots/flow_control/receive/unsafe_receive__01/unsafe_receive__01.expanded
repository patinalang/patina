#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/receive/unsafe_receive.md
// block: 1/1

#[repr(transparent)]
pub enum Option<T> {

    #[repr(dynamic_wrap, tag = "some")]
    Some(T),

    #[repr(atom, tag = "nil")]
    None,
}

pub fn main() {
    unsafe {
        receive {
            int(n) => {
                ::Core::io::put_chars([["got integer ",
                                    patina_fmt::debug(n)]]);
                ::Core::io::nl();
            }
            atom(a) => {
                ::Core::io::put_chars([["got atom ", patina_fmt::debug(a)]]);
                ::Core::io::nl();
            }
            Option::<str>::None => {
                ::Core::io::put_chars([["got an empty string option"]]);
                ::Core::io::nl();
            }
            Option::<int>::None => {
                ::Core::io::put_chars([["got an empty integer option"]]);
                ::Core::io::nl();
            }
            _ => {
                ::Core::io::put_chars([["got something else"]]);
                ::Core::io::nl();
            }
        } after Timeout::from_seconds(5)
            { { ::Core::io::put_chars([["timeout"]]); ::Core::io::nl(); } }
    }
}
