#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/receive/unsafe_receive.md
// block: 1/1

#[attr = Repr {reprs: [Transparent], modifiers: []}]
enum Option<T> {
    #[attr = Repr {reprs: [],
    modifiers: [DynamicWrap,
    Tag("some")]}]
    Some(T),
    #[attr = Repr {reprs: [Atom],
    modifiers: [Tag("nil")]}]
    None,
}

fn main() ({
    (unsafe {
        (receive {
            int(n) => {
                ((::core::io::put_chars as
                        fn(term) -> term)(([([("got integer " as str),
                                    ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                        as term)] as [term])] as [[term]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            }
            atom(a) => {
                ((::core::io::put_chars as
                        fn(term) -> term)(([([("got atom " as str),
                                    ((::core::patina_fmt::debug as
                                            fn(term) -> term)((a as atom)) as term)] as [term])] as
                        [[term]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            }
            Option::<str>::None => {
                ((::core::io::put_chars as
                        fn(term) -> term)(([([("got an empty string option" as str)]
                                as [str])] as [[str]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            }
            Option::<int>::None => {
                ((::core::io::put_chars as
                        fn(term) -> term)(([([("got an empty integer option" as
                                        str)] as [str])] as [[str]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            }
            _ => {
                ((::core::io::put_chars as
                        fn(term) -> term)(([([("got something else" as str)] as
                                [str])] as [[str]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            }
        }
            after ((Timeout::from_seconds as
                    fn(int) -> core::Timeout {core::Timeout::from_seconds})((5
                    as int)) as core::Timeout)
            ({
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([("timeout" as str)] as [str])] as
                            [[str]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ())
            } as ()) as ())
    } as ())
} as ())
