#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/if_let.md
// block: 3/4

// Our example enum
enum Foo { Bar, Baz, Qux(int), }

fn main() ({
    // Create example variables
    let a = (Foo::Bar as Foo);
    let b = (Foo::Baz as Foo);
    let c = ((Foo::Qux as fn(int) -> Foo {Foo::Qux})((100 as int)) as Foo);

    // Variable a matches Foo::Bar
    (if (let Foo::Bar = (a as Foo) as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("a is foobar" as str)] as [str; 1])]
                    as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())

    // Variable b does not match Foo::Bar
    // So this will print nothing
    (if (let Foo::Bar = (b as Foo) as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("b is foobar" as str)] as [str; 1])]
                    as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())

    // Variable c matches Foo::Qux which has a value
    // Similar to Some() in the previous example
    (if (let Foo::Qux(value) = (c as Foo) as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("c is " as str),
                                ((patina_fmt::display as fn(term) -> term)((value as int))
                                    as term)] as [term; 2])] as [[term; 2]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())

    // Binding also works with `if let`
    (if (let Foo::Qux(value@100) = (c as Foo) as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("c is one hundred" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
} as ())
