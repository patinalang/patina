#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn initialize_in_one_branch(take_then: bool) -> int {
    let value;

    if take_then { value = 30; }

    value
}
