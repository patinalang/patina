#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn branch_result(take_then: bool)
    ->
        int ({
    let mut value = (10 as int);

    let block_value =
        (if (take_then as bool) {
            ((value as int) += (1 as int) as int);
            (100 as int)
        } else { ((value as int) += (2 as int) as int); (200 as int) } as
            int);

    ((block_value as int) + (value as int) as int)
} as int)

fn latest_version_wins(take_then: bool)
    ->
        int ({
    let mut value = (1 as int);

    (if (take_then as bool) {
        (value = (2 as int) as int);
        (value = (3 as int) as int);
    } else { (value = (4 as int) as int); } as ())

    (value as int)
} as int)

fn initialize_in_branches(take_then: bool)
    ->
        int ({
    let value;

    (if (take_then as bool) {
        (value = (10 as int) as int);
    } else { (value = (20 as int) as int); } as ())

    (value as int)
} as int)

fn initialize_or_return(take_then: bool)
    ->
        int ({
    let value;

    (if (take_then as bool) {
        (value = (30 as int) as int);
    } else { (return (40 as int) as !); } as ())

    (value as int)
} as int)

fn nested_result()
    ->
        int ({
    let mut value = (10 as int);

    let block_value =
        ({
            let inner_value =
                ({ ((value as int) += (1 as int) as int); (100 as int) } as
                    int);
            ((value as int) += (2 as int) as int);
            ((inner_value as int) + (1000 as int) as int)
        } as int);

    ((block_value as int) + (value as int) as int)
} as int)

fn nested_branches(take_outer: bool, take_inner: bool)
    ->
        int ({
    let mut value = (0 as int);

    let block_value =
        (if (take_outer as bool) {
            let inner_value =
                (if (take_inner as bool) {
                    (value = (1 as int) as int);
                    (10 as int)
                } else { (value = (2 as int) as int); (20 as int) } as int);
            ((inner_value as int) + (100 as int) as int)
        } else { (value = (3 as int) as int); (300 as int) } as int);

    ((block_value as int) + (value as int) as int)
} as int)

fn nested_diverging_rebind(take_outer: bool, take_inner: bool)
    ->
        int ({
    let mut value = (0 as int);

    (if (take_outer as bool) {
        (if (take_inner as bool) {
            (value = (1 as int) as int);
            (return (value as int) as !);
        } else { (() as ()) } as ())
    } else { (() as ()) } as ())

    (10 as int)
} as int)

fn short_circuit_result(run_block: bool)
    ->
        int ({
    let mut value = (10 as int);

    let _result =
        ((run_block as bool) &&
            ({ ((value as int) += (5 as int) as int); (true as bool) } as
                bool) as bool);

    (value as int)
} as int)

fn short_circuit_or_result(skip_block: bool)
    ->
        int ({
    let mut value = (10 as int);

    let result =
        ((skip_block as bool) ||
            ({ ((value as int) += (5 as int) as int); (false as bool) } as
                bool) as bool);

    (if (result as bool) {
        ((value as int) + (100 as int) as int)
    } else { (value as int) } as int)
} as int)

fn nested_short_circuit_result(outer: bool, inner: bool)
    ->
        int ({
    let mut value = (10 as int);

    let result =
        ((outer as bool) &&
            (((inner as bool) ||
                ({ ((value as int) += (1 as int) as int); (true as bool) } as
                    bool) as bool)) as bool);

    (if (result as bool) {
        ((value as int) + (100 as int) as int)
    } else { (value as int) } as int)
} as int)

fn short_circuit_local_binding(run_block: bool, value: int)
    ->
        bool ({
    ((run_block as bool) &&
        ({
            let doubled = ((value as int) * (2 as int) as int);
            ((doubled as int) > (10 as int) as bool)
        } as bool) as bool)
} as bool)

enum Branch { First, Second, }

fn match_result(take_first: bool)
    ->
        int ({
    let mut value = (10 as int);
    let branch =
        (if (take_first as bool) {
            (Branch::First as Branch)
        } else { (Branch::Second as Branch) } as Branch);

    let block_value =
        (match (branch as Branch) {
            Branch::First => {
                ((value as int) += (1 as int) as int);
                (100 as int)
            }
            Branch::Second => {
                ((value as int) += (2 as int) as int);
                (200 as int)
            }
        } as int);

    ((block_value as int) + (value as int) as int)
} as int)

fn or_assign(a: bool, b: bool)
    ->
        int ({
    let mut y = (0 as int);
    let r =
        (if ((a as bool) ||
                ({ ((y as int) += (1 as int) as int); (b as bool) } as bool)
                as bool) {
            ((y as int) + (10 as int) as int)
        } else { ((y as int) + (20 as int) as int) } as int);
    (((r as int) * (100 as int) as int) + (y as int) as int)
} as int)

fn not_and_assign(a: bool, b: bool)
    ->
        int ({
    let mut y = (0 as int);
    let r =
        (if (!(((a as bool) &&
                    ({ ((y as int) += (1 as int) as int); (b as bool) } as bool)
                    as bool)) as bool) {
            ((y as int) + (10 as int) as int)
        } else { ((y as int) + (20 as int) as int) } as int);
    (((r as int) * (100 as int) as int) + (y as int) as int)
} as int)

fn and_or_right(a: bool, b: bool, c: bool)
    ->
        int ({
    let mut y = (0 as int);
    let r =
        (if ((a as bool) &&
                (((b as bool) ||
                    ({ ((y as int) += (1 as int) as int); (c as bool) } as bool)
                    as bool)) as bool) {
            ((y as int) + (10 as int) as int)
        } else { ((y as int) + (20 as int) as int) } as int);
    (((r as int) * (100 as int) as int) + (y as int) as int)
} as int)

fn or_then_and(a: bool, b: bool, c: bool)
    ->
        int ({
    let mut y = (0 as int);
    let r =
        (if ((((a as bool) ||
                    ({ ((y as int) += (1 as int) as int); (b as bool) } as bool)
                    as bool)) && (c as bool) as bool) {
            ((y as int) + (10 as int) as int)
        } else { ((y as int) + (20 as int) as int) } as int);
    (((r as int) * (100 as int) as int) + (y as int) as int)
} as int)

fn and_then_or(a: bool, b: bool, c: bool)
    ->
        int ({
    let mut y = (0 as int);
    let r =
        (if (((a as bool) &&
                    ({ ((y as int) += (1 as int) as int); (b as bool) } as bool)
                    as bool) || (c as bool) as bool) {
            ((y as int) + (10 as int) as int)
        } else { ((y as int) + (20 as int) as int) } as int);
    (((r as int) * (100 as int) as int) + (y as int) as int)
} as int)

fn while_or(n: int)
    ->
        int ({
    let mut i = (0 as int);
    let mut steps = (0 as int);
    (loop {
        (if (((i as int) < (3 as int) as bool) ||
                ({
                    ((steps as int) += (1 as int) as int);
                    ((i as int) < (n as int) as bool)
                } as bool) as bool) {
            ((i as int) += (1 as int) as int);
        } else { (break as !); } as ())
    } as ())
    (((i as int) * (100 as int) as int) + (steps as int) as int)
} as int)
