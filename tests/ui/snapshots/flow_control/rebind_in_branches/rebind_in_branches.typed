#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn branch_result(take_then: bool)
    ->
        int ({
    let mut value = (10 as int);

    let block_value =
        (if (take_then as bool) {
            ((value as int) += (1 as int) as ());
            (100 as int)
        } else { ((value as int) += (2 as int) as ()); (200 as int) } as int);

    ((block_value as int) + (value as int) as int)
} as int)

fn latest_version_wins(take_then: bool)
    ->
        int ({
    let mut value = (1 as int);

    (if (take_then as bool) {
        ((value as int) = (2 as int) as ());
        ((value as int) = (3 as int) as ());
    } else { ((value as int) = (4 as int) as ()); } as ())

    (value as int)
} as int)

fn initialize_in_branches(take_then: bool)
    ->
        int ({
    let value;

    (if (take_then as bool) {
        ((value as int) = (10 as int) as ());
    } else { ((value as int) = (20 as int) as ()); } as ())

    (value as int)
} as int)

fn initialize_or_return(take_then: bool)
    ->
        int ({
    let value;

    (if (take_then as bool) {
        ((value as int) = (30 as int) as ());
    } else { (return (40 as int) as !); } as ())

    (value as int)
} as int)

fn nested_result()
    ->
        int ({
    let mut value = (10 as int);

    let block_value =
        ({
            let inner_value =
                ({ ((value as int) += (1 as int) as ()); (100 as int) } as
                    int);
            ((value as int) += (2 as int) as ());
            ((inner_value as int) + (1000 as int) as int)
        } as int);

    ((block_value as int) + (value as int) as int)
} as int)

fn nested_branches(take_outer: bool, take_inner: bool)
    ->
        int ({
    let mut value = (0 as int);

    let block_value =
        (if (take_outer as bool) {
            let inner_value =
                (if (take_inner as bool) {
                    ((value as int) = (1 as int) as ());
                    (10 as int)
                } else { ((value as int) = (2 as int) as ()); (20 as int) } as
                    int);
            ((inner_value as int) + (100 as int) as int)
        } else { ((value as int) = (3 as int) as ()); (300 as int) } as int);

    ((block_value as int) + (value as int) as int)
} as int)

fn nested_diverging_rebind(take_outer: bool, take_inner: bool)
    ->
        int ({
    let mut value = (0 as int);

    (if (take_outer as bool) {
        (if (take_inner as bool) {
            ((value as int) = (1 as int) as ());
            (return (value as int) as !);
        } else { (() as ()) } as ())
    } else { (() as ()) } as ())

    (10 as int)
} as int)

fn short_circuit_result(run_block: bool)
    ->
        int ({
    let mut value = (10 as int);

    let _result =
        ((run_block as bool) &&
            ({ ((value as int) += (5 as int) as ()); (true as bool) } as bool)
            as bool);

    (value as int)
} as int)

enum Branch { First, Second, }

fn match_result(take_first: bool)
    ->
        int ({
    let mut value = (10 as int);
    let branch =
        (if (take_first as bool) {
            (Branch::First as Branch)
        } else { (Branch::Second as Branch) } as Branch);

    let block_value =
        (match (branch as Branch) {
            Branch::First => {
                ((value as int) += (1 as int) as ());
                (100 as int)
            }
            Branch::Second => {
                ((value as int) += (2 as int) as ());
                (200 as int)
            }
        } as int);

    ((block_value as int) + (value as int) as int)
} as int)
