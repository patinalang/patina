#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/for.md
// block: 3/3

pub fn main() {
    let names = ["Bob", "Frank", "Ferris"];

    for name in names.iter() {
        match name {
            "Ferris" =>
                {
                io::put_chars([["There is a rustacean among us!"]]);
                io::nl();
            }
            _ => {
                io::put_chars([["Hello ", patina_fmt::display(name)]]);
                io::nl();
            }
        }
    }
    { io::put_chars([["names: ", patina_fmt::debug(names)]]); io::nl(); };
}
