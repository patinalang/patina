#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/for.md
// block: 3/3

pub fn main() {
    let names = ["Bob", "Frank", "Ferris"];

    for name in names.iter() {
        match name {
            "Ferris" =>
                {
                ::Core::io::put_chars([["There is a rustacean among us!"]]);
                ::Core::io::nl();
            }
            _ => {
                ::Core::io::put_chars([["Hello ",
                                    patina_fmt::display(name)]]);
                ::Core::io::nl();
            }
        }
    }
    {
        ::Core::io::put_chars([["names: ", patina_fmt::debug(names)]]);
        ::Core::io::nl();
    };
}
