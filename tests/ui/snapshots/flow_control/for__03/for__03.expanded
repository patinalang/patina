#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/for.md
// block: 3/3

pub fn main() {
    let names = ["Bob", "Frank", "Ferris"];

    for name in names.iter() {
        match name {
            "Ferris" =>
                {
                ::core::io::put_chars([["There is a rustacean among us!"]]);
                ::core::io::nl();
            }
            _ => {
                ::core::io::put_chars([["Hello ",
                                    ::core::patina_fmt::display(name)]]);
                ::core::io::nl();
            }
        }
    }
    {
        ::core::io::put_chars([["names: ",
                            ::core::patina_fmt::debug(names)]]);
        ::core::io::nl();
    };
}
