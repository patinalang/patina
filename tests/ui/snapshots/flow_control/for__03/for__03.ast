// source: patina-by-example/src/flow_control/for.md
// block: 3/3

pub fn main() {
    let names = ["Bob", "Frank", "Ferris"];

    for name in names.iter() {
        match name {
            "Ferris" => println!("There is a rustacean among us!"),
            _ => println!("Hello {}", name),
        }
    }

    println!("names: {:?}", names);
}
