#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/if_let.md
// block: 3/4

// Our example enum
enum Foo { Bar, Baz, Qux(int), }

pub fn main() {
    // Create example variables
    let a = Foo::Bar;
    let b = Foo::Baz;
    let c = Foo::Qux(100);

    // Variable a matches Foo::Bar
    if let Foo::Bar = a {

        // Variable b does not match Foo::Bar
        // So this will print nothing

        // Variable c matches Foo::Qux which has a value
        // Similar to Some() in the previous example

        // Binding also works with `if let`
        { ::core::io::put_chars([["a is foobar"]]); ::core::io::nl(); };
    }
    if let Foo::Bar = b {
        { ::core::io::put_chars([["b is foobar"]]); ::core::io::nl(); };
    }
    if let Foo::Qux(value) = c {
        {
            ::core::io::put_chars([["c is ",
                                ::core::patina_fmt::display(value)]]);
            ::core::io::nl();
        };
    }
    if let Foo::Qux(value @ 100) = c {
        { ::core::io::put_chars([["c is one hundred"]]); ::core::io::nl(); };
    }
}
