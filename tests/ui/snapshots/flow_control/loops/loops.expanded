#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

extern mod erlang;

pub fn normal_continue(limit: int) -> int {
    let mut count = 0;
    let mut total = 0;

    loop {
        count += 1;

        if count % 2 == 0 { continue; }

        total += count;

        if count >= limit { break; }
    }

    total * 100 + count
}

pub fn loop_value(target: int) -> int {
    let mut counter = 0;

    let result =
        loop {
            counter += 1;

            if counter == target { break counter * 2; }
        };

    result * 10 + counter
}

pub fn zero_parameter_loop() -> int { loop { break 7; } }

pub fn initialize_in_loop() -> int {
    let value;

    loop { value = 7; break; }

    value
}

pub fn while_sum(start: int, limit: int) -> int {
    let mut n = start;
    let mut total = 0;

    while n < limit { total += n; n += 1; }

    total * 100 + n
}

pub fn nested(outer_limit: int, inner_limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    loop {
        outer += 1;
        let mut inner = 0;

        loop {
            inner += 1;

            if inner < inner_limit { continue; }

            visits += outer * 10 + inner;
            break;
        }

        if outer >= outer_limit { break; }
    }

    visits * 100 + outer
}

pub fn return_from_loop(stop_at: int) -> int {
    let mut n = 0;

    loop {
        n += 1;

        if n == stop_at { return n * 10; }

        if n >= 10 { break; }
    }

    -1
}

pub fn return_from_nested(outer_stop: int, inner_stop: int) -> int {
    let mut outer = 0;

    loop {
        outer += 1;
        let mut inner = 0;

        loop {
            inner += 1;

            if outer == outer_stop && inner == inner_stop {
                return outer * 100 + inner;
            }

            if inner >= 3 { break; }
        }

        if outer >= 3 { break; }
    }

    -1
}

pub fn return_from_nested_uneven_rebinds(outer_stop: int, inner_stop: int)
    -> int {
    let mut a = 0;
    let mut b = 0;

    loop {
        a += 1;
        b += 10;
        let mut inner = 0;

        loop {
            inner += 1;

            if a == outer_stop && inner == inner_stop {
                return a * 1000 + b * 10 + inner;
            }

            if inner >= 3 { break; }
        }

        if a >= 3 { break; }
    }

    -1
}

pub fn continue_outer(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            visits += 1;

            if outer < limit { continue 'outer; }

            break 'outer;
        }
    }

    visits * 100 + outer
}

pub fn continue_through_middle(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            loop {
                visits += 1;

                if outer < limit { continue 'outer; }

                break 'outer;
            }
        }
    }

    visits * 100 + outer
}

pub fn cast_loop_value() -> int {
    let value = loop { break 1; } as int;

    value
}

// Loop helpers are named after the function, numbering its loops from its top, nested or not.
pub fn helper_names(limit: int) -> int {
    let mut total = 0;
    let mut i = 0;
    while i < limit { total += 1; i += 1; }

    let mut j = 0;
    while j < limit {
        let mut k = 0;
        while k < limit { total += 10; k += 1; }
        let mut l = 0;
        while l < limit { total += 100; l += 1; }
        j += 1;
    }

    // A closure's loops are numbered among the function's loops.
    let f =
        |n: int| -> int { let mut m = 0; while m < n { m += 1; } m * 1000 };
    total + f(limit)
}

trait Count {
    fn count(self, limit: int)
    -> int;
}

struct Counter<T>(T);

// The impls' functions get the self type's arguments in their names, and so do the loop
// helpers of their methods.
impl Count for Counter<int> {
    fn count(self, limit: int) -> int {
        let mut n = 0;
        while n < limit { n += 1; }
        n
    }
}

impl Count for Counter<str> {
    fn count(self, limit: int) -> int {
        let mut n = 0;
        while n < limit { n += 2; }
        n
    }
}

pub fn trait_helper_names(limit: int) -> int {
    Counter(0).count(limit) + Counter("a").count(limit)
}

fn note(value: int) {
    let notes = unsafe { erlang::get(a"notes").cast_unchecked::<[int]>() };
    erlang::put(a"notes", [value, ..notes]);
}

pub fn continue_and_break_in_try(limit: int) -> int {
    let mut n = 0;
    loop {
        n += 1;
        try { if n < limit { continue; } if n >= limit { break n * 10; } }
            after { note(n); }
    }
}

pub fn break_in_catch(limit: int, f: fn(int) -> term) -> int {
    let mut n = 0;
    loop {
        n += 1;
        try { f(n); } catch { error(_) => { break n; } } after { note(n); }
        if n >= limit { break -1; }
    }
}

pub fn continue_in_catch(limit: int, f: fn(int) -> term) -> int {
    let mut n = 0;
    let mut passed = 0;
    loop {
        n += 1;
        if n > limit { break passed; }
        try { f(n); } catch { error(_) => { continue; } } after { note(n); }
        passed += 1;
    }
}

pub fn break_and_continue_in_after(limit: int) -> int {
    let mut n = 0;
    let mut odd = 0;
    loop {
        n += 1;
        try { note(n); }
            after {
            if n >= limit { break n * 10 + odd; }
            if n % 2 == 0 { continue; }
        }
        odd += 1;
    }
}

pub fn return_in_try_in_loop(stop: int) -> int {
    let mut n = 0;
    loop {
        n += 1;
        try { if n == stop { return n * 10; } } after { note(n); }
        if n >= 5 { break; }
    }
    -1
}

pub fn return_in_after_in_loop(stop: int) -> int {
    let mut n = 0;
    loop {
        n += 1;
        try { note(n); } after { if n == stop { return n * 10; } }
        if n >= 5 { break; }
    }
    -1
}

pub fn continue_outer_from_try(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            visits += 1;
            try {
                if outer < limit { continue 'outer; }
                if outer >= limit { break 'outer; }
            } after { note(outer); }
        }
    }

    visits * 100 + outer
}

pub fn loop_in_try(stop: int) -> int {
    let result =
        try {
            let mut n = 0;
            loop {
                n += 1;
                if n == stop { return n; }
                if n >= 5 { break n * 10; }
            }
        } after { note(0); };
    result + 1
}
