fn normal_continue(limit: int)
    ->
        int ({
    let mut count = (0 as int);
    let mut total = (0 as int);

    (loop {
        ((count as int) += (1 as int) as int);

        (if (((count as int) % (2 as int) as int) == (0 as int) as bool) {
            (continue as !);
        } as ())

        ((total as int) += (count as int) as int);

        (if ((count as int) >= (limit as int) as bool) { (break as !); } as
            ())
    } as ())

    (((total as int) * (100 as int) as int) + (count as int) as int)
} as int)

fn loop_value(target: int)
    ->
        int ({
    let mut counter = (0 as int);

    let result =
        (loop {
            ((counter as int) += (1 as int) as int);

            (if ((counter as int) == (target as int) as bool) {
                (break ((counter as int) * (2 as int) as int) as !);
            } as ())
        } as int);

    (((result as int) * (10 as int) as int) + (counter as int) as int)
} as int)

fn zero_parameter_loop()
    -> int ({ (loop { (break (7 as int) as !); } as int) } as int)

fn initialize_in_loop()
    ->
        int ({
    let value;

    (loop { ((value as int) = (7 as int) as int); (break as !); } as ())

    (value as int)
} as int)

fn while_sum(start: int, limit: int)
    ->
        int ({
    let mut n = (start as int);
    let mut total = (0 as int);

    (loop {
        (if ((n as int) < (limit as int) as bool) {
            ((total as int) += (n as int) as int);
            ((n as int) += (1 as int) as int);
        } else { (break as !); } as ())
    } as ())

    (((total as int) * (100 as int) as int) + (n as int) as int)
} as int)

fn nested(outer_limit: int, inner_limit: int)
    ->
        int ({
    let mut outer = (0 as int);
    let mut visits = (0 as int);

    (loop {
        ((outer as int) += (1 as int) as int);
        let mut inner = (0 as int);

        (loop {
            ((inner as int) += (1 as int) as int);

            (if ((inner as int) < (inner_limit as int) as bool) {
                (continue as !);
            } as ())

            ((visits as int) +=
                (((outer as int) * (10 as int) as int) + (inner as int) as
                    int) as int);
            (break as !);
        } as ())

        (if ((outer as int) >= (outer_limit as int) as bool) { (break as !); }
            as ())
    } as ())

    (((visits as int) * (100 as int) as int) + (outer as int) as int)
} as int)

fn return_from_loop(stop_at: int)
    ->
        int ({
    let mut n = (0 as int);

    (loop {
        ((n as int) += (1 as int) as int);

        (if ((n as int) == (stop_at as int) as bool) {
            (return ((n as int) * (10 as int) as int) as !);
        } as ())

        (if ((n as int) >= (10 as int) as bool) { (break as !); } as ())
    } as ())

    (-(1 as int) as int)
} as int)

fn return_from_nested(outer_stop: int, inner_stop: int)
    ->
        int ({
    let mut outer = (0 as int);

    (loop {
        ((outer as int) += (1 as int) as int);
        let mut inner = (0 as int);

        (loop {
            ((inner as int) += (1 as int) as int);

            (if (((outer as int) == (outer_stop as int) as bool) &&
                    ((inner as int) == (inner_stop as int) as bool) as bool) {
                (return (((outer as int) * (100 as int) as int) +
                        (inner as int) as int) as !);
            } as ())

            (if ((inner as int) >= (3 as int) as bool) { (break as !); } as
                ())
        } as ())

        (if ((outer as int) >= (3 as int) as bool) { (break as !); } as ())
    } as ())

    (-(1 as int) as int)
} as int)

fn return_from_nested_uneven_rebinds(outer_stop: int, inner_stop: int)
    ->
        int ({
    let mut a = (0 as int);
    let mut b = (0 as int);

    (loop {
        ((a as int) += (1 as int) as int);
        ((b as int) += (10 as int) as int);
        let mut inner = (0 as int);

        (loop {
            ((inner as int) += (1 as int) as int);

            (if (((a as int) == (outer_stop as int) as bool) &&
                    ((inner as int) == (inner_stop as int) as bool) as bool) {
                (return ((((a as int) * (1000 as int) as int) +
                            ((b as int) * (10 as int) as int) as int) + (inner as int)
                        as int) as !);
            } as ())

            (if ((inner as int) >= (3 as int) as bool) { (break as !); } as
                ())
        } as ())

        (if ((a as int) >= (3 as int) as bool) { (break as !); } as ())
    } as ())

    (-(1 as int) as int)
} as int)

fn continue_outer(limit: int)
    ->
        int ({
    let mut outer = (0 as int);
    let mut visits = (0 as int);

    ('outer: loop {
        ((outer as int) += (1 as int) as int);

        (loop {
            ((visits as int) += (1 as int) as int);

            (if ((outer as int) < (limit as int) as bool) {
                (continue 'outer as !);
            } as ())

            (break 'outer as !);
        } as !)
    } as ())

    (((visits as int) * (100 as int) as int) + (outer as int) as int)
} as int)

fn continue_through_middle(limit: int)
    ->
        int ({
    let mut outer = (0 as int);
    let mut visits = (0 as int);

    ('outer: loop {
        ((outer as int) += (1 as int) as int);

        (loop {
            (loop {
                ((visits as int) += (1 as int) as int);

                (if ((outer as int) < (limit as int) as bool) {
                    (continue 'outer as !);
                } as ())

                (break 'outer as !);
            } as !)
        } as !)
    } as ())

    (((visits as int) * (100 as int) as int) + (outer as int) as int)
} as int)

fn cast_loop_value()
    ->
        int ({
    let value = ((loop { (break (1 as int) as !); } as int) as int as int);

    (value as int)
} as int)

// Loop helpers are named after the function, numbering its loops from its top, nested or not.
fn helper_names(limit: int)
    ->
        int ({
    let mut total = (0 as int);
    let mut i = (0 as int);
    (loop {
        (if ((i as int) < (limit as int) as bool) {
            ((total as int) += (1 as int) as int);
            ((i as int) += (1 as int) as int);
        } else { (break as !); } as ())
    } as ())

    let mut j = (0 as int);
    (loop {
        (if ((j as int) < (limit as int) as bool) {
            let mut k = (0 as int);
            (loop {
                (if ((k as int) < (limit as int) as bool) {
                    ((total as int) += (10 as int) as int);
                    ((k as int) += (1 as int) as int);
                } else { (break as !); } as ())
            } as ())
            let mut l = (0 as int);
            (loop {
                (if ((l as int) < (limit as int) as bool) {
                    ((total as int) += (100 as int) as int);
                    ((l as int) += (1 as int) as int);
                } else { (break as !); } as ())
            } as ())
            ((j as int) += (1 as int) as int);
        } else { (break as !); } as ())
    } as ())

    // A closure's loops are numbered among the function's loops.
    let f =
        (|n: int| -> int
            ({
                let mut m = (0 as int);
                (loop {
                    (if ((m as int) < (n as int) as bool) {
                        ((m as int) += (1 as int) as int);
                    } else { (break as !); } as ())
                } as ())
                ((m as int) * (1000 as int) as int)
            } as int) as
            {closure@tests/ui/src/flow_control/loops.pt:243:13: 243:28});
    ((total as int) +
        ((f as
                {closure@tests/ui/src/flow_control/loops.pt:243:13: 243:28})((limit
                as int)) as int) as int)
} as int)

trait Count {
    fn count(self, limit: int)
    -> int;
}

struct Counter<T>(T);

// Impls of one trait method on the same type share an Erlang function, so their loop helpers
// include the impl's tag.
impl Count for Counter<int> {
    fn count(self, limit: int)
        ->
            int ({
        let mut n = (0 as int);
        (loop {
            (if ((n as int) < (limit as int) as bool) {
                ((n as int) += (1 as int) as int);
            } else { (break as !); } as ())
        } as ())
        (n as int)
    } as int)
}

impl Count for Counter<str> {
    fn count(self, limit: int)
        ->
            int ({
        let mut n = (0 as int);
        (loop {
            (if ((n as int) < (limit as int) as bool) {
                ((n as int) += (2 as int) as int);
            } else { (break as !); } as ())
        } as ())
        (n as int)
    } as int)
}

fn trait_helper_names(limit: int)
    ->
        int ({
    ((((Counter as fn(int) -> Counter<int> {Counter::<int>})((0 as int)) as
                Counter<int>).count((limit as int)) as int) +
        (((Counter as fn(str) -> Counter<str> {Counter::<str>})(("a" as str))
                as Counter<str>).count((limit as int)) as int) as int)
} as int)
