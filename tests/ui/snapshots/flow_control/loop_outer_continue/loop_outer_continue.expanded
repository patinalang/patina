#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// snapshot: core0, core

pub fn continue_outer_loop(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            visits += 1;

            if outer < limit { continue 'outer; }

            break 'outer visits * 100 + outer;
        }
    }
}

pub fn continue_two_loops(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            loop {
                visits += 1;

                if outer < limit { continue 'outer; }

                break 'outer visits * 100 + outer;
            }
        }
    }
}
