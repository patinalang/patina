#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn continue_outer_loop(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            visits += 1;

            if outer < limit { continue 'outer; }

            break 'outer visits * 100 + outer;
        }
    }
}

pub fn continue_two_loops(limit: int) -> int {
    let mut outer = 0;
    let mut visits = 0;

    'outer: loop {
        outer += 1;

        loop {
            loop {
                visits += 1;

                if outer < limit { continue 'outer; }

                break 'outer visits * 100 + outer;
            }
        }
    }
}
