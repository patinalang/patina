#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/for.md
// block: 1/3

pub fn main() {
    // `n` will take the values: 1, 2, ..., 100 in each iteration
    for n in 1..101 {
        if n % 15 == 0 {
            { io::put_chars([["fizzbuzz"]]); io::nl(); };
        } else if n % 3 == 0 {
            { io::put_chars([["fizz"]]); io::nl(); };
        } else if n % 5 == 0 {
            { io::put_chars([["buzz"]]); io::nl(); };
        } else { { io::put_chars([[patina_fmt::display(n)]]); io::nl(); }; }
    }
}
