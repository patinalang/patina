// source: patina-by-example/src/flow_control/for.md
// block: 1/3

pub fn main() {
    // `n` will take the values: 1, 2, ..., 100 in each iteration
    for n in 1..101 {
        if n % 15 == 0 {
            println!("fizzbuzz");
        } else if n % 3 == 0 {
            println!("fizz");
        } else if n % 5 == 0 { println!("buzz"); } else { println!("{}", n); }
    }
}
