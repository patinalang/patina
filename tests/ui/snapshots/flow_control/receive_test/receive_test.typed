#[attr = Repr {reprs: [Tagged], modifiers: [Tag("value")]}]
struct Value {
    number: int,
}

fn take_int() -> int ({ (receive { int(n) => (n as int), } as int) } as int)

fn take_int_or_timeout()
    ->
        int ({
    (receive { int(n) => (n as int), }
        after ((Timeout::from_millis as
                fn(int) -> core::Timeout {core::Timeout::from_millis})((10 as
                int)) as core::Timeout) ({ (-(1 as int) as int) } as int) as
        int)
} as int)

fn take_atom()
    -> atom ({ (receive { atom(a) => (a as atom), } as atom) } as atom)

fn echo() ({
    (receive {
        (a"ping", pid(from)) => {
            ((erlang::send as
                    fn(term, term) -> term)((from as pid), (a"pong" as atom)) as
                term);
        }
    } as ())
} as ())

fn sum_until_stop()
    ->
        int ({
    let mut total = (0 as int);
    (loop {
        (receive {
            int(n) => { ((total as int) += (n as int) as int); }
            a"stop" => (break as !),
        } as ())
    } as ())
    (total as int)
} as int)

fn unsafe_value()
    ->
        int ({
    (unsafe {
        (receive { Value {  number } => (number as int), }
            after ((Timeout::from_millis as
                    fn(int) -> core::Timeout {core::Timeout::from_millis})((0 as
                    int)) as core::Timeout) ({ (-(1 as int) as int) } as int) as
            int)
    } as int)
} as int)

fn only_timeout()
    ->
        int ({
    (receive { }
        after ((Timeout::from_millis as
                fn(int) -> core::Timeout {core::Timeout::from_millis})((0 as
                int)) as core::Timeout) ({ (7 as int) } as int) as int)
} as int)

fn guarded_or()
    ->
        int ({
    (receive {
        (a"left" | a"right", int(n)) if ((n as int) > (0 as int) as bool) =>
            (n as int),
    } as int)
} as int)

fn merge_timeout()
    ->
        int ({
    let mut value = (1 as int);
    (receive { int(n) => { (value = (n as int) as int); } }
        after ((Timeout::from_millis as
                fn(int) -> core::Timeout {core::Timeout::from_millis})((0 as
                int)) as core::Timeout)
        ({ (value = (2 as int) as int); } as ()) as ())
    (value as int)
} as int)

fn unchanged_timeout()
    ->
        int ({
    let mut value = (1 as int);
    (receive { int(n) => { (value = (n as int) as int); } }
        after ((Timeout::from_millis as
                fn(int) -> core::Timeout {core::Timeout::from_millis})((0 as
                int)) as core::Timeout) ({ } as ()) as ())
    (value as int)
} as int)

fn durations()
    ->
        (Timeout,
        Timeout) ({
    ((((Timeout::from_seconds as
                fn(int) -> core::Timeout {core::Timeout::from_seconds})((2 as
                int)) as core::Timeout),
        ((Timeout::from_minutes as
                fn(int) -> core::Timeout {core::Timeout::from_minutes})((3 as
                int)) as core::Timeout)) as (core::Timeout, core::Timeout))
} as (core::Timeout, core::Timeout))

fn contextual_after()
    -> int ({ let after = (4 as int); (after as int) } as int)

struct `receive` {
    after: int,
}

fn raw_identifiers()
    ->
        int ({
    let value = (`receive` { after: (9 as int) } as `receive`);
    ((value as `receive`).after as int)
} as int)

