fn diverging_timeout()
    ->
        int ({
    (receive { int(n) => (return (n as int) as !), }
        after ((Timeout::from_millis as
                fn(int) -> core::Timeout {core::Timeout::from_millis})((0 as
                int)) as core::Timeout)
        ({ (return (-(1 as int) as int) as !); } as !) as int)
} as int)
