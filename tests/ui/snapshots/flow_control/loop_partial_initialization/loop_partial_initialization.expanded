#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn partial_initialization(take_initialized: bool) -> int {
    let value;

    loop { if take_initialized { value = 10; break; } else { break; } }

    value
}
