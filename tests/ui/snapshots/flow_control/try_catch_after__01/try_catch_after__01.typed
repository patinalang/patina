#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/try_catch_after.md
// block: 1/1

fn open_resource() -> atom ({ (a"ok" as atom) } as atom)

fn main() ({
    (try ({ ((open_resource as fn() -> atom {open_resource})() as atom); } as
            ())
        catch {
        error(a"badarg") => {
            ((io::put_chars as
                    fn(term) -> term)(([([("badarg!" as str)] as [str])] as
                    [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            error(#{a"__struct__" => a"Elixir.ArithmeticError", ..}) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Elixir ArithmeticError" as str)] as
                            [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            // an Elixir exception is just a struct map in the reason position
            error(reason@#{a"__struct__" => a"Elixir.ArgumentError", ..}) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Elixir ArgumentError " as str),
                                ((patina_fmt::debug as fn(term) -> term)((reason as term))
                                    as term)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            // a second pattern after the comma binds the stacktrace
            error(reason), stacktrace => {
            ((io::put_chars as
                    fn(term) -> term)(([([("other error: " as str),
                                ((patina_fmt::debug as fn(term) -> term)((reason as term))
                                    as term), (" from " as str),
                                ((patina_fmt::debug as
                                        fn(term) -> term)((stacktrace as term)) as term)] as
                            [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            throw(value) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("thrown: " as str),
                                ((patina_fmt::debug as fn(term) -> term)((value as term)) as
                                    term)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            exit(reason) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("exit: " as str),
                                ((patina_fmt::debug as fn(term) -> term)((reason as term))
                                    as term)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    }
        after ({
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([("cleaning up" as str)] as [str])] as
                        [[str]])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());
        } as ()) as ());
} as ())
