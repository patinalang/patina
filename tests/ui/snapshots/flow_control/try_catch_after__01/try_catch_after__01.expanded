#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/try_catch_after.md
// block: 1/1

fn open_resource() -> atom { a"ok" }

pub fn main() {
    try { open_resource(); }
        catch {
        error(a"badarg") =>

            // an Elixir exception is just a struct map in the reason position

            // a second pattern after the comma binds the stacktrace


            {
            ::core::io::put_chars([["badarg!"]]);
            ::core::io::nl();
        }
        error(#{a"__struct__" => a"Elixir.ArithmeticError", ..}) => {
            ::core::io::put_chars([["Elixir ArithmeticError"]]);
            ::core::io::nl();
        }
        error(reason @ #{a"__struct__" => a"Elixir.ArgumentError", ..}) => {
            ::core::io::put_chars([["Elixir ArgumentError ",
                                ::core::patina_fmt::debug(reason)]]);
            ::core::io::nl();
        }
        error(reason), stacktrace => {
            ::core::io::put_chars([["other error: ",
                                ::core::patina_fmt::debug(reason), " from ",
                                ::core::patina_fmt::debug(stacktrace)]]);
            ::core::io::nl();
        }
        throw(value) => {
            ::core::io::put_chars([["thrown: ",
                                ::core::patina_fmt::debug(value)]]);
            ::core::io::nl();
        }
        exit(reason) => {
            ::core::io::put_chars([["exit: ",
                                ::core::patina_fmt::debug(reason)]]);
            ::core::io::nl();
        }
    }
        after {
        { ::core::io::put_chars([["cleaning up"]]); ::core::io::nl(); };
    };
}
