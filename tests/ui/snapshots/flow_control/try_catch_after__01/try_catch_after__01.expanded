#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/try_catch_after.md
// block: 1/1

fn open_resource() -> atom { a"ok" }

pub fn main() {
    try { open_resource(); }
        catch {
        error(a"badarg") => { io::put_chars([["badarg!"]]); io::nl(); }


            error(#{a"__struct__" => a"Elixir.ArithmeticError", ..}) => {
            io::put_chars([["Elixir ArithmeticError"]]);
            io::nl();
        }


            // an Elixir exception is just a struct map in the reason position
            error(reason @ #{a"__struct__" => a"Elixir.ArgumentError", ..}) =>
            {
            io::put_chars([["Elixir ArgumentError ",
                                patina_fmt::debug(reason)]]);
            io::nl();
        }


            // a second pattern after the comma binds the stacktrace
            error(reason), stacktrace => {
            io::put_chars([["other error: ", patina_fmt::debug(reason),
                                " from ", patina_fmt::debug(stacktrace)]]);
            io::nl();
        }


            throw(value) => {
            io::put_chars([["thrown: ", patina_fmt::debug(value)]]);
            io::nl();
        }


            exit(reason) => {
            io::put_chars([["exit: ", patina_fmt::debug(reason)]]);
            io::nl();
        }
    } after { { io::put_chars([["cleaning up"]]); io::nl(); }; };
}
