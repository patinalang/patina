#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/try_catch_after.md
// block: 1/1

fn open_resource() -> atom { a"ok" }

pub fn main() {
    try { open_resource(); }
        catch {
        error(a"badarg") =>

            // an Elixir exception is just a struct map in the reason position

            // a second pattern after the comma binds the stacktrace


            {
            io::put_chars([["badarg!"]]);
            io::nl();
        }
        error(#{a"__struct__" => a"Elixir.ArithmeticError", ..}) => {
            io::put_chars([["Elixir ArithmeticError"]]);
            io::nl();
        }
        error(reason @ #{a"__struct__" => a"Elixir.ArgumentError", ..}) => {
            io::put_chars([["Elixir ArgumentError ",
                                patina_fmt::debug(reason)]]);
            io::nl();
        }
        error(reason), stacktrace => {
            io::put_chars([["other error: ", patina_fmt::debug(reason),
                                " from ", patina_fmt::debug(stacktrace)]]);
            io::nl();
        }
        throw(value) => {
            io::put_chars([["thrown: ", patina_fmt::debug(value)]]);
            io::nl();
        }
        exit(reason) => {
            io::put_chars([["exit: ", patina_fmt::debug(reason)]]);
            io::nl();
        }
    } after { { io::put_chars([["cleaning up"]]); io::nl(); }; };
}
