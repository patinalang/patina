#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/while.md
// block: 1/1

pub fn main() {
    // A counter variable
    let mut n = 1;

    // Loop while `n` is less than 101
    while n < 101 {
        if n % 15 == 0 {

            // Increment counter
            { ::Core::io::put_chars([["fizzbuzz"]]); ::Core::io::nl(); };
        } else if n % 3 == 0 {
            { ::Core::io::put_chars([["fizz"]]); ::Core::io::nl(); };
        } else if n % 5 == 0 {
            { ::Core::io::put_chars([["buzz"]]); ::Core::io::nl(); };
        } else {
            {
                ::Core::io::put_chars([[patina_fmt::display(n)]]);
                ::Core::io::nl();
            };
        }
        n += 1;
    }
}
