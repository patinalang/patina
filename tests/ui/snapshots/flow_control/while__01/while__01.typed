#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/while.md
// block: 1/1

fn main() ({
    // A counter variable
    let mut n = (1 as int);

    // Loop while `n` is less than 101
    (loop {
        (if ((n as int) < (101 as int) as bool) {
            (if (((n as int) % (15 as int) as int) == (0 as int) as bool) {

                // Increment counter
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("fizzbuzz" as str)] as [str])] as
                            [[str]])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
            } else if (((n as int) % (3 as int) as int) == (0 as int) as bool)
                {
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("fizz" as str)] as [str])] as
                            [[str]])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
            } else if (((n as int) % (5 as int) as int) == (0 as int) as bool)
                {
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("buzz" as str)] as [str])] as
                            [[str]])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
            } else {
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([((patina_fmt::display as
                                                fn(term) -> term)((n as int)) as term)] as [term])] as
                            [[term]])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
            } as ())
            ((n as int) += (1 as int) as int);
        } else { (break as !); } as ())
    } as ())
} as ())
