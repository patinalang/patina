#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn tuple_pattern()
    ->
        int ({
    let (20, second) = (((20 as int), (22 as int)) as (int, int)) else
        { (return (0 as int) as !); };
    ((20 as int) + (second as int) as int)
} as int)

fn list_pattern(values: [int])
    ->
        int ({
    let [first, second, ..] = (values as [int]) else
        { (return (0 as int) as !); };
    ((first as int) + (second as int) as int)
} as int)
