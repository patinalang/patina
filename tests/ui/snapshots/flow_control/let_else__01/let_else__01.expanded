use str::FromStr;

fn get_count_item(s: str) -> (int, str) {
    let it = s.split(' ');
    let (it, first) = it.next();
    let (it, second) = it.next();

    let (Some(count_str), Some(item)) = (first, second) else { (/*ERROR*/); };
    let Ok(count) = int::from_str(count_str) else { (/*ERROR*/); };
    (count, item)
}

pub fn main() { (/*ERROR*/); }
