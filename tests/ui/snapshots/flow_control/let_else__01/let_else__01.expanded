#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/let_else.md
// block: 1/1

use str::FromStr;

fn get_count_item(s: str) -> (int, str) {
    let it = s.split(' ');
    let (it, first) = it.next();
    let (it, second) = it.next();

    let (Some(count_str), Some(item)) =
        (first,
            second) else {

            unsafe {
                ::core::erlang::error(::core::Panic::new("Can't segment count item pair: '{s}'"),
                        a"none",
                        [(a"error_info",
                                    #{a"module" =>
                                            a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
            };
        };
    let Ok(count) =
        int::from_str(count_str) else {
            unsafe {
                ::core::erlang::error(::core::Panic::new("Can't parse integer: '{count_str}'"),
                        a"none",
                        [(a"error_info",
                                    #{a"module" =>
                                            a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
            };
        };
    (count, item)
}
pub fn main() {
    match (get_count_item("3 chairs"), (3, "chairs")) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::core::erlang::error(::core::Panic::new(unsafe {
                                    ::core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    ::core::patina_fmt::display(""), "\n  left: ",
                                                    ::core::patina_fmt::debug(left_val), "\n right: ",
                                                    ::core::patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
}
