#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 4/6

pub fn main() {
    let text: str = "Patina!";
    let bytes: bin = <<b"PNG", '!', "rest">>;
    // For literals, types are optional unless you want to override a default.
    // Like with bindings, you set the type after a colon.
    let packet: bits = <<b"PT", '!', "ok", 5: int(size = 3)>>;

    match text {

            // Every segment before the rest is valid UTF-8, so `rest` is a `str`.
            <<"Pa", 't', rest @ ..>> =>

            // The shorthand form can also be used with literals. 
            {
            ::Core::io::put_chars([["text rest ", patina_fmt::debug(rest)]]);
            ::Core::io::nl();
        }
        _ => { ::Core::io::put_chars([["unknown text"]]); ::Core::io::nl(); }
    }
    match bytes {
        <<b"PNG", '!', rest @ ..>> => {
            ::Core::io::put_chars([["png data ", patina_fmt::debug(rest)]]);
            ::Core::io::nl();
        }
        _ => {
            ::Core::io::put_chars([["unknown binary"]]);
            ::Core::io::nl();
        }
    }
    match packet {
        <<b"PT", '!', "ok", 5: int(size = 3), rest @ ..>> => {
            ::Core::io::put_chars([["packet tail ",
                                patina_fmt::debug(rest)]]);
            ::Core::io::nl();
        }
        _ => {
            ::Core::io::put_chars([["unknown packet"]]);
            ::Core::io::nl();
        }
    }
}
