#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

struct Point {
    x: int,
    y: int,
}

unsafe fn match_point(value: term)
    ->
        int ({
    (match (value as term) {
        Point {  x,  y } => ((x as int) + (y as int) as int),
        _ => (0 as int),
    } as int)
} as int)
