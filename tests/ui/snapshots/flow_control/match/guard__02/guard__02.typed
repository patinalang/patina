#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/guard.md
// block: 2/2

fn main() ({
    let number: int = (4 as int);

    (match (number as int) {
        i if ((i as int) == (0 as int) as bool) =>
            // _ => unreachable!("Should never happen."),
            // TODO ^ uncomment to fix compilation
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Zero" as str)] as [str])] as
                    [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        i if ((i as int) > (0 as int) as bool) => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Greater than zero" as str)] as
                            [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
