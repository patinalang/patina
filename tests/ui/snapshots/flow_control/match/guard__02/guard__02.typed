#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/guard.md
// block: 2/2

fn main() ({
    let number: int = (4 as int);

    (match (number as int) {
        i if ((i as int) == (0 as int) as bool) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Zero" as str)] as [str; 1])] as
                    [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        i if ((i as int) > (0 as int) as bool) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Greater than zero" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
    // _ => unreachable!("Should never happen."),
    // TODO ^ uncomment to fix compilation
} as ())
