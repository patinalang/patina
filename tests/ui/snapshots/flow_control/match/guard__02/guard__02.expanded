pub fn main() {
    let number: int = 4;

    match number {
        i if i == 0 =>
            // _ => unreachable!("Should never happen."),
            // TODO ^ uncomment to fix compilation
            {
            ::Core::io::put_chars([["Zero"]]);
            ::Core::io::nl();
        }
        i if i > 0 => {
            ::Core::io::put_chars([["Greater than zero"]]);
            ::Core::io::nl();
        }
    }
}
