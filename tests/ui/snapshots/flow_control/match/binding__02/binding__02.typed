#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binding.md
// block: 2/2

fn some_number()
    ->
        Option<int> ({
    ((Some as
            fn(int) -> core::Option<int> {core::Option::<int>::Some})((42 as
            int)) as core::Option<int>)
} as core::Option<int>)

fn main() ({
    (match ((some_number as fn() -> core::Option<int> {some_number})() as
            core::Option<int>) {

            // Got `Some` variant, match if its value, bound to `n`,
            // is equal to 42.
            // Could also use `Some(42)` and print `"The Answer: 42!"`
            // but that would require changing `42` in 2 spots should
            // you ever wish to change it.
            // Could also use `Some(n) if n == 42` and print `"The Answer: {n}!"`
            // but that would not contribute to exhaustiveness checks.
            // (Although in this case that would not matter since
            // the next arm is a "catch-all" pattern)
            Some(n@42) =>
            // Match any other number.
            // Match anything else (`None` variant).
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("The Answer: " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((n as int)) as term), ("!" as str)] as
                            [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        Some(n) => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Not interesting... " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((n as int)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => (() as ()),
    } as ())
} as ())
