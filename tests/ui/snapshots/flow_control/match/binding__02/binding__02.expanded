#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/binding.md
// block: 2/2

fn some_number() -> Option<int> { Some(42) }

pub fn main() {
    match some_number() {

            // Got `Some` variant, match if its value, bound to `n`,
            // is equal to 42.
            // Could also use `Some(42)` and print `"The Answer: 42!"`
            // but that would require changing `42` in 2 spots should
            // you ever wish to change it.
            // Could also use `Some(n) if n == 42` and print `"The Answer: {n}!"`
            // but that would not contribute to exhaustiveness checks.
            // (Although in this case that would not matter since
            // the next arm is a "catch-all" pattern)
            Some(n @ 42) => {
            io::put_chars([["The Answer: ", patina_fmt::display(n), "!"]]);
            io::nl();
        }

            // Match any other number.
            Some(n) => {
            io::put_chars([["Not interesting... ", patina_fmt::display(n)]]);
            io::nl();
        }

            // Match anything else (`None` variant).
            _ => (),
    }
}
