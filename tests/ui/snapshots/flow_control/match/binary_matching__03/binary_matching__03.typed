#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 3/6

fn main() ({
    let bin = (<<(16 as int), (5 as int), (6 as int), (7 as int)>> as str);

    (match (bin as str) {

            // Bind `len`, then use it as the size of `payload`
            <<kind: int(size = (8 as int)), len: int(size = (8 as int)),
            payload: bin(size = (len as int)), rest @ ..>> =>
            // The size can also be a guard expression



            // The tail expands to match the whole rest of the binary.
            // Only the last segment can be unsized.
            // After an 8-bit header, the rest of a `bits` is a `bits`.

            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("kind = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((kind as int)) as term),
                                (", payload = " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((payload as bin)) as term),
                                (", rest = " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as bin)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        <<kind: int(size = (8 as int)), len: int(size = (8 as int)), payload:
            bin(size = ((len as int) / (2 as int) as int)), rest @ ..>> => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("kind = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((kind as int)) as term),
                                (", payload = " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((payload as bin)) as term),
                                (", rest = " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as bin)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("invalid packet" as str)] as [str])]
                    as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
    let packet: bits =
        (<<(3 as int): int(size = (4 as int)), (5 as int):
                int(size = (4 as int)), (7 as int): int(size = (3 as int))>>
            as bits);
    (match (packet as bits) {
        <<header: int(size = (8 as int)), tail @ ..>> => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("header = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((header as int)) as term),
                                (", tail = " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((tail as bits)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("did not match" as str)] as [str])]
                    as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
