#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 6/6

fn main() ({
    let name = ("Patina" as str);
    let version = (3 as int);

    // Every segment is valid UTF-8, so this is a `str`.
    let greeting: str =
        (<<("Hello, " as str), (name as str), ('!' as char)>> as str);

    // The size is a whole number of bytes, so this is a `bin`.
    let header: bin =
        (<<(b"PT" as bin), (version as int): int(size = (16 as int)),
                (1.5 as float): float(size = (32 as int)), ('\u{e9}' as char):
                char(utf16)>> as bin);

    // Anything else is a `bits`.
    let flags: bits =
        (<<(1 as int): int(size = (1 as int)), (0 as int):
                int(size = (1 as int)),
                (((version as int) + (1 as int) as int)):
                int(size = (3 as int))>> as bits);

    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((greeting as str)) as term), (" " as str),
                            ((patina_fmt::debug as fn(term) -> term)((header as bin)) as
                                term), (" " as str),
                            ((patina_fmt::debug as fn(term) -> term)((flags as bits)) as
                                term)] as [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
