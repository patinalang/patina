#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

enum Number { Value(int), }

fn classify_int(value: int)
    ->
        int ({
    (match (value as int) {
        ...-11 => (1 as int),
        -10..0 => (2 as int),
        0...10 => (3 as int),
        11... => (4 as int),
    } as int)
} as int)

fn classify_char(value: char)
    ->
        int ({
    (match (value as char) {
        ...'`' => (1 as int),
        'a'...'z' => (2 as int),
        '{'... => (3 as int),
    } as int)
} as int)

fn classify_float(value: float)
    ->
        int ({
    (match (value as float) {
        ...-1.5 => (1 as int),
        -1.5..1.5 => (2 as int),
        1.5... => (3 as int),
        _ => (4 as int),
    } as int)
} as int)

fn matches_either_range(value: int)
    ->
        bool ({
    (match (value as int) {
        1...3 | 7..9 | 11 => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn match_bound_range(value: int)
    ->
        int ({
    (match (value as int) {
        bound@-3...3 if
            (((bound as int) % (2 as int) as int) == (0 as int) as bool) =>
            ((bound as int) * (10 as int) as int),
        _ => (0 as int),
    } as int)
} as int)

fn match_nested_ranges(value: (int, char))
    ->
        bool ({
    (match (value as (int, char)) {
        (-2...2, 'm'...'p') => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn match_enum_range(value: int)
    ->
        bool ({
    (match ((Number::Value as
                fn(int) -> Number {Number::Value})((value as int)) as Number)
        {
        Number::Value(bound@40...44) if
            ((bound as int) != (41 as int) as bool) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn match_map_range(value: #{str => int})
    ->
        bool ({
    (match (value as #{str => int}) {
        #{"score" => 10..20, ..} => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn if_let_range(value: int)
    ->
        bool ({
    (if (let 2...4 = (value as int) as bool) {
        (true as bool)
    } else { (false as bool) } as bool)
} as bool)

fn let_else_range(value: int)
    ->
        bool ({
    let -1...1 = (value as int) else { (return (false as bool) as !); };
    (true as bool)
} as bool)
