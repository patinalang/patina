#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

enum Number { Value(int), }

pub fn classify_int(value: int) -> int {
    match value { ..=-11 => 1, -10..0 => 2, 0..=10 => 3, 11.. => 4, }
}

pub fn classify_char(value: char) -> int {
    match value { ..='`' => 1, 'a'..='z' => 2, '{'.. => 3, }
}

pub fn classify_float(value: float) -> int {
    match value { ..=-1.5 => 1, -1.5..1.5 => 2, 1.5.. => 3, _ => 4, }
}

pub fn matches_either_range(value: int) -> bool {
    match value { 1..=3 | 7..9 | 11 => true, _ => false, }
}

pub fn match_bound_range(value: int) -> int {
    match value { bound @ -3..=3 if bound % 2 == 0 => bound * 10, _ => 0, }
}

pub fn match_nested_ranges(value: (int, char)) -> bool {
    match value { (-2..=2, 'm'..='p') => true, _ => false, }
}

pub fn match_enum_range(value: int) -> bool {
    match Number::Value(value) {
        Number::Value(bound @ 40..=44) if bound != 41 => true,
        _ => false,
    }
}

pub fn match_map_range(value: #{str => int}) -> bool {
    match value { #{"score" => 10..20, ..} => true, _ => false, }
}

pub fn if_let_range(value: int) -> bool {
    if let 2..=4 = value { true } else { false }
}

pub fn let_else_range(value: int) -> bool {
    let -1..=1 = value else { return false; };
    true
}
