fn nested_in_tuple(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            (a"point", Point {  x,  y }) => ((x as int) + (y as int) as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn wrapped_term(value: term)
    ->
        bool ({
    (unsafe {
        (match (value as term) {
            Wrapper((int(_), atom(_))) => (true as bool),
            _ => (false as bool),
        } as bool)
    } as bool)
} as bool)

fn wrapped_int(value: term)
    ->
        bool ({
    (unsafe {
        (match (value as term) {
            Wrapper(int(_)) => (true as bool),
            _ => (false as bool),
        } as bool)
    } as bool)
} as bool)

fn literal_or_point(value: term)
    ->
        bool ({
    (unsafe {
        (match (value as term) {
            0 | Point {  x: 0,  y: _ } => (true as bool),
            _ => (false as bool),
        } as bool)
    } as bool)
} as bool)

fn raw_constructor(value: list)
    ->
        int ({
    (match (value as list) { list(inner) => (inner as int), } as int)
} as int)

fn qualified_constructor(value: list)
    ->
        int ({
    (match (value as list) { self::list(inner) => (inner as int), } as int)
} as int)
