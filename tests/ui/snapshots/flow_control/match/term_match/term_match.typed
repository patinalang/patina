#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

const ANSWER: int = (42 as int);

#[attr = Repr {reprs: [Transparent], modifiers: []}]
enum Option<T> {
    #[attr = Repr {reprs: [],
    modifiers: [DynamicWrap,
    Tag("some")]}]
    Some(T),
    #[attr = Repr {reprs: [Atom],
    modifiers: [Tag("nil")]}]
    None,
}

struct Point {
    x: int,
    y: int,
}
struct Celsius(float);

#[attr = Repr {reprs: [Tagged], modifiers: [Tag("tagged")]}]
struct Tagged {
    value: int,
    label: str,
}

#[attr = Repr {reprs: [Elixir], modifiers: []}]
struct ElixirPoint {
    x: int,
    y: int,
}

#[attr = Repr {reprs: [Tagged], modifiers: [Tag("wrapper")]}]
struct Wrapper(term);

struct list(int);

fn use_int(value: int)
    -> int ({ ((value as int) + (1 as int) as int) } as int)

fn literals(value: term)
    ->
        int ({
    (match (value as term) {
        a"nil" => (1 as int),
        1 => (2 as int),
        1.5 => (3 as int),
        "hello" => (4 as int),
        true => (5 as int),
        ANSWER => (6 as int),
        _ => (0 as int),
    } as int)
} as int)

fn tuple(value: term)
    ->
        int ({
    (match (value as term) {
        (a"some", (1, int(inner))) => (inner as int),
        _ => (0 as int),
    } as int)
} as int)

fn list_match(value: term)
    ->
        term ({
    (match (value as term) {
        [head, tail@_..] =>
            (((head as term), (tail as [term])) as (term, [term])),
        _ => (a"empty" as atom),
    } as term)
} as term)

fn map(value: term)
    ->
        term ({
    (match (value as term) {
        #{"k" => found, ..} => (found as term),
        _ => (a"missing" as atom),
    } as term)
} as term)

fn pinned(value: term, expected: int)
    ->
        bool ({
    (match (value as term) {
        ^expected => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn guarded(value: term)
    ->
        bool ({
    (match (value as term) {
        int(found) if ((found as int) == (42 as int) as bool) =>
            (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn inferred_class_scrutinee()
    ->
        bool ({
    let matcher =
        (|value|
            (match (value as term) {
                int(_) => (true as bool),
                _ => (false as bool),
            } as bool) as
            {closure@tests/ui/src/flow_control/match/term_match.pt:78:19: 78:26});
    ((matcher as
            {closure@tests/ui/src/flow_control/match/term_match.pt:78:19: 78:26})((1
            as int)) as bool)
} as bool)

fn if_let_term(value: term)
    ->
        bool ({
    (if (let (a"ok", _) = (value as term) as bool) {
        (true as bool)
    } else { (false as bool) } as bool)
} as bool)

fn let_else_term(value: term)
    ->
        bool ({
    let [_, ..] = (value as term) else { (return (false as bool) as !) };
    (true as bool)
} as bool)

fn closure_term(value: term)
    ->
        bool ({
    let matcher =
        (||
            (match (value as term) {
                [_, ..] => (true as bool),
                _ => (false as bool),
            } as bool) as
            {closure@tests/ui/src/flow_control/match/term_match.pt:92:19: 92:21});
    ((matcher as
            {closure@tests/ui/src/flow_control/match/term_match.pt:92:19: 92:21})()
        as bool)
} as bool)

fn literal_or(value: term)
    ->
        bool ({
    (match (value as term) {
        1 | 2 | a"ok" => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn nested_or(value: term)
    ->
        bool ({
    (match (value as term) {
        (a"ok" | a"error", int(1 | 2)) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn int_class(value: term)
    ->
        int ({
    (match (value as term) {
        int(n) => ((n as int) + (1 as int) as int),
        _ => (0 as int),
    } as int)
} as int)

fn float_class(value: term)
    ->
        float ({
    (match (value as term) {
        float(n) => ((n as float) + (1.0 as float) as float),
        _ => (0.0 as float),
    } as float)
} as float)

fn atom_class(value: term)
    ->
        atom ({
    (match (value as term) { atom(a) => (a as atom), _ => (a"no" as atom), }
        as atom)
} as atom)

fn list_class(value: term)
    ->
        bool ({
    (match (value as term) {
        list([_, ..]) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn map_class(value: term)
    ->
        bool ({
    (match (value as term) {
        map(#{"k" => _, ..}) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn tuple_class(value: term)
    ->
        bool ({
    (match (value as term) {
        tuple(_) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn fn_class(value: term)
    ->
        bool ({
    (match (value as term) { fn(_) => (true as bool), _ => (false as bool), }
        as bool)
} as bool)

fn bits_class(value: term)
    ->
        bool ({
    (match (value as term) {
        bits(_) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn bin_class(value: term)
    ->
        bool ({
    (match (value as term) { bin(_) => (true as bool), _ => (false as bool), }
        as bool)
} as bool)

fn pid_class(value: term)
    ->
        bool ({
    (match (value as term) { pid(_) => (true as bool), _ => (false as bool), }
        as bool)
} as bool)

fn port_class(value: term)
    ->
        bool ({
    (match (value as term) {
        port(_) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn ref_class(value: term)
    ->
        bool ({
    (match (value as term) { ref(_) => (true as bool), _ => (false as bool), }
        as bool)
} as bool)

fn number(value: term)
    ->
        bool ({
    (match (value as term) {
        int(_) | float(_) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn alias_list(value: term)
    ->
        term ({
    (match (value as term) {
        whole@list([head, tail@_..]) =>
            (((whole as term), (head as term), (tail as [term])) as
                (term, term, [term])),
        _ => (a"no" as atom),
    } as term)
} as term)

fn nested(value: term)
    ->
        bool ({
    (match (value as term) {
        (int(a), atom(b)) if
            (((a as int) > (0 as int) as bool) &&
                ((b as atom) == (a"ok" as atom) as bool) as bool) =>
            (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn nested_list(value: term)
    ->
        bool ({
    (match (value as term) {
        [int(head), ..] if ((head as int) > (0 as int) as bool) =>
            (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn nested_map(value: term)
    ->
        bool ({
    (match (value as term) {
        #{"k" => float(found), ..} if
            ((found as float) > (0.0 as float) as bool) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn tuple_terms(value: (term, term))
    ->
        bool ({
    (match (value as (term, term)) {
        (int(_), atom(_)) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn struct_term(value: Wrapper)
    ->
        bool ({
    (match (value as Wrapper) {
        Wrapper(int(_)) => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)

fn option_none(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Option::<str>::None => (1 as int),
            Option::<int>::None => (2 as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn option_some(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Option::<int>::Some(n) => (n as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn inferred_some(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Option::<int>::Some(n) =>
                ((use_int as fn(int) -> int {use_int})((n as int)) as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn nested_some(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Option::<Option<int>>::Some(Option::<int>::Some(n)) =>
                ((use_int as fn(int) -> int {use_int})((n as int)) as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn point(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Point {  x,  y } => ((x as int) + (y as int) as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn point_rest(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Point {  x, .. } => (x as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

fn point_range(value: term)
    ->
        bool ({
    (unsafe {
        (match (value as term) {
            Point {  x: 1...3, .. } => (true as bool),
            _ => (false as bool),
        } as bool)
    } as bool)
} as bool)

fn celsius(value: term)
    ->
        float ({
    (unsafe {
        (match (value as term) {
            Celsius(c) => (c as float),
            _ => (0.0 as float),
        } as float)
    } as float)
} as float)

fn celsius_any(value: term)
    ->
        bool ({
    (unsafe {
        (match (value as term) {
            Celsius(..) => (true as bool),
            _ => (false as bool),
        } as bool)
    } as bool)
} as bool)

fn tagged(value: term)
    ->
        int ({
    (unsafe {
        (match (value as term) {
            Tagged {  value, .. } => (value as int),
            _ => (0 as int),
        } as int)
    } as int)
} as int)

