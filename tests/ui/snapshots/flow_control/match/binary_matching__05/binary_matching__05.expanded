#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 5/6

pub fn main() {
    let png_prefix = "PNG";
    let jpg_prefix = "JPG";

    match "PNG!rest" {
        <<^png_prefix, rest @ ..>> =>

            // Like with literals, you can give the segment a type.
            // Or use the shorthand syntax.
            {
            ::core::io::put_chars([["png data ",
                                ::core::patina_fmt::debug(rest)]]);
            ::core::io::nl();
        }
        <<^jpg_prefix, rest @ ..>> => {
            ::core::io::put_chars([["jpg data ",
                                ::core::patina_fmt::debug(rest)]]);
            ::core::io::nl();
        }
        _ => { ::core::io::put_chars([["unknown data"]]); ::core::io::nl(); }
    }
    let bit_prefix = 7;
    match <<119>> {
        <<^bit_prefix: int(size = 16, little), rest @ ..>> => {
            ::core::io::put_chars([["expected ",
                                ::core::patina_fmt::debug(rest)]]);
            ::core::io::nl();
        }
        <<^bit_prefix: int(size = 4), rest @ ..>> => {
            ::core::io::put_chars([["expected ",
                                ::core::patina_fmt::debug(rest)]]);
            ::core::io::nl();
        }
        _ => {
            ::core::io::put_chars([["unexpected prefix"]]);
            ::core::io::nl();
        }
    }
}
