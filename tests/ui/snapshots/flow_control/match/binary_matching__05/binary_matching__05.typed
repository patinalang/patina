#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 5/6

fn main() ({
    let png_prefix = ("PNG" as str);
    let jpg_prefix = ("JPG" as str);

    (match ("PNG!rest" as str) {
        <<^png_prefix, rest @ ..>> =>

            // Like with literals, you can give the segment a type.
            // Or use the shorthand syntax.
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("png data " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as str)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        <<^jpg_prefix, rest @ ..>> => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("jpg data " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as str)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("unknown data" as str)] as [str])] as
                    [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
    let bit_prefix = (7 as int);
    (match (<<(119 as int)>> as str) {
        <<^bit_prefix: int(size = (16 as int), little), rest @ ..>> => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("expected " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as bin)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        <<^bit_prefix: int(size = (4 as int)), rest @ ..>> => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("expected " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as bits)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("unexpected prefix" as str)] as
                            [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
