#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binding.md
// block: 1/2

// A function `age` which returns an `int`.
fn age() -> int { 15 }

pub fn main() {

    // Could `match` 1 ..= 12 directly but then what age
    // would the child be?
    // Could `match` n and use an `if` guard, but would
    // not contribute to exhaustiveness checks.
    // (Although in this case that would not matter since
    // a "catch-all" pattern is present at the bottom)
    // Instead, bind to `n` for the sequence of 1 ..= 12.
    // Now the age can be reported.
    // A similar binding can be done when matching several values.
    // Nothing bound. Return the result.
    {
        ::core::io::put_chars([["Tell me what type of person you are"]]);
        ::core::io::nl();
    };
    match age() {
        0 => {
            ::core::io::put_chars([["I haven\'t celebrated my first birthday yet"]]);
            ::core::io::nl();
        }
        n @ 1..=12 => {
            ::core::io::put_chars([["I\'m a child of age ",
                                ::core::patina_fmt::debug(n)]]);
            ::core::io::nl();
        }
        n @ 13..=19 => {
            ::core::io::put_chars([["I\'m a teen of age ",
                                ::core::patina_fmt::debug(n)]]);
            ::core::io::nl();
        }
        n @ (1 | 7 | 15 | 13) => {
            ::core::io::put_chars([["I\'m a teen of age ",
                                ::core::patina_fmt::debug(n)]]);
            ::core::io::nl();
        }
        n => {
            ::core::io::put_chars([["I\'m an old person of age ",
                                ::core::patina_fmt::debug(n)]]);
            ::core::io::nl();
        }
    }
}
