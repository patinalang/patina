#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/binding.md
// block: 1/2

// A function `age` which returns an `int`.
fn age() -> int { 15 }

pub fn main() {
    { io::put_chars([["Tell me what type of person you are"]]); io::nl(); };

    match age() {
        0 => {
            io::put_chars([["I haven\'t celebrated my first birthday yet"]]);
            io::nl();
        }

            // Could `match` 1 ..= 12 directly but then what age
            // would the child be?
            // Could `match` n and use an `if` guard, but would
            // not contribute to exhaustiveness checks.
            // (Although in this case that would not matter since
            // a "catch-all" pattern is present at the bottom)
            // Instead, bind to `n` for the sequence of 1 ..= 12.
            // Now the age can be reported.
            n @ 1..=12 => {
            io::put_chars([["I\'m a child of age ", patina_fmt::debug(n)]]);
            io::nl();
        }
        n @ 13..=19 => {
            io::put_chars([["I\'m a teen of age ", patina_fmt::debug(n)]]);
            io::nl();
        }

            // A similar binding can be done when matching several values.
            n @ (1 | 7 | 15 | 13) => {
            io::put_chars([["I\'m a teen of age ", patina_fmt::debug(n)]]);
            io::nl();
        }

            // Nothing bound. Return the result.
            n => {
            io::put_chars([["I\'m an old person of age ",
                                patina_fmt::debug(n)]]);
            io::nl();
        }
    }
}
