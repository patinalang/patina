#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binding.md
// block: 1/2

// A function `age` which returns an `int`.
fn age() -> int ({ (15 as int) } as int)

fn main() ({

    // Could `match` 1 ..= 12 directly but then what age
    // would the child be?
    // Could `match` n and use an `if` guard, but would
    // not contribute to exhaustiveness checks.
    // (Although in this case that would not matter since
    // a "catch-all" pattern is present at the bottom)
    // Instead, bind to `n` for the sequence of 1 ..= 12.
    // Now the age can be reported.
    // A similar binding can be done when matching several values.
    // Nothing bound. Return the result.
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Tell me what type of person you are"
                                as str)] as [str])] as [[str]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    (match ((age as fn() -> int {age})() as int) {
        0 => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("I haven\'t celebrated my first birthday yet"
                                    as str)] as [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        n@1...12 => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("I\'m a child of age " as str),
                                ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                    as term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        n@13...19 => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("I\'m a teen of age " as str),
                                ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                    as term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        n@1 | 7 | 15 | 13 => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("I\'m a teen of age " as str),
                                ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                    as term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        n => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("I\'m an old person of age " as str),
                                ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                    as term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
