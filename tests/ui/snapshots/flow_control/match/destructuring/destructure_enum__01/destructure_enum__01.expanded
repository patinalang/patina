#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/destructuring/destructure_enum.md
// block: 1/1

// `allow` required to silence warnings because only
// one variant is used.
#[allow(dead_code)]
enum Color {

    // These 3 are specified solely by their name.
    Red,
    Blue,
    Green,

    // These likewise tie `int` tuples to different names: color models.
    RGB(int, int, int),
    HSV(int, int, int),
    HSL(int, int, int),
    CMY(int, int, int),
    CMYK(int, int, int, int),
}

pub fn main() {
    let color = Color::RGB(122, 17, 40);
    // TODO ^ Try different variants for `color`

    // An `enum` can be destructured using a `match`.
    // Don't need another arm because all variants have been examined
    { ::core::io::put_chars([["What color is it?"]]); ::core::io::nl(); };
    match color {
        Color::Red => {
            ::core::io::put_chars([["The color is Red!"]]);
            ::core::io::nl();
        }
        Color::Blue => {
            ::core::io::put_chars([["The color is Blue!"]]);
            ::core::io::nl();
        }
        Color::Green => {
            ::core::io::put_chars([["The color is Green!"]]);
            ::core::io::nl();
        }
        Color::RGB(r, g, b) => {
            ::core::io::put_chars([["Red: ", ::core::patina_fmt::display(r),
                                ", green: ", ::core::patina_fmt::display(g), ", and blue: ",
                                ::core::patina_fmt::display(b), "!"]]);
            ::core::io::nl();
        }
        Color::HSV(h, s, v) => {
            ::core::io::put_chars([["Hue: ", ::core::patina_fmt::display(h),
                                ", saturation: ", ::core::patina_fmt::display(s),
                                ", value: ", ::core::patina_fmt::display(v), "!"]]);
            ::core::io::nl();
        }
        Color::HSL(h, s, l) => {
            ::core::io::put_chars([["Hue: ", ::core::patina_fmt::display(h),
                                ", saturation: ", ::core::patina_fmt::display(s),
                                ", lightness: ", ::core::patina_fmt::display(l), "!"]]);
            ::core::io::nl();
        }
        Color::CMY(c, m, y) => {
            ::core::io::put_chars([["Cyan: ", ::core::patina_fmt::display(c),
                                ", magenta: ", ::core::patina_fmt::display(m), ", yellow: ",
                                ::core::patina_fmt::display(y), "!"]]);
            ::core::io::nl();
        }
        Color::CMYK(c, m, y, k) => {
            ::core::io::put_chars([["Cyan: ", ::core::patina_fmt::display(c),
                                ", magenta: ", ::core::patina_fmt::display(m), ", yellow: ",
                                ::core::patina_fmt::display(y), ", key (black): ",
                                ::core::patina_fmt::display(k), "!"]]);
            ::core::io::nl();
        }
    }
}
