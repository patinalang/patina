#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/match/destructuring/destructure_tuple.md
// block: 1/1

pub fn main() {
    let triple = (0, -2, 3);
    // TODO ^ Try different values for `triple`

    // Match can be used to destructure a tuple
    // Destructure the second and third elements
    // `..` can be used to ignore the rest of the tuple
    // `_` means don't bind the value to a variable
    {
        ::Core::io::put_chars([["Tell me about ",
                            patina_fmt::debug(triple)]]);
        ::Core::io::nl();
    };
    match triple {
        (0, y, z) => {
            ::Core::io::put_chars([["First is `0`, `y` is ",
                                patina_fmt::debug(y), ", and `z` is ",
                                patina_fmt::debug(z)]]);
            ::Core::io::nl();
        }
        (1, ..) => {
            ::Core::io::put_chars([["First is `1` and the rest doesn\'t matter"]]);
            ::Core::io::nl();
        }
        (.., 2) => {
            ::Core::io::put_chars([["last is `2` and the rest doesn\'t matter"]]);
            ::Core::io::nl();
        }
        (3, .., 4) => {
            ::Core::io::put_chars([["First is `3`, last is `4`, and the rest doesn\'t matter"]]);
            ::Core::io::nl();
        }
        _ => {
            ::Core::io::put_chars([["It doesn\'t matter what they are"]]);
            ::Core::io::nl();
        }
    }
}
