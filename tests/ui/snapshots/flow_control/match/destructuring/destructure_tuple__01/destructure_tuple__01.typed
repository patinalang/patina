#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/destructuring/destructure_tuple.md
// block: 1/1

fn main() ({
    let triple =
        (((0 as int), (-(2 as int) as int), (3 as int)) as (int, int, int));
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Tell me about " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(
                                // TODO ^ Try different values for `triple`

                                (triple as (int, int, int))) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // Match can be used to destructure a tuple
    (match (triple as (int, int, int)) {

            // Destructure the second and third elements
            (0, y, z) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("First is `0`, `y` is " as str),
                                ((patina_fmt::debug as fn(term) -> term)((y as int)) as
                                    term), (", and `z` is " as str),
                                ((patina_fmt::debug as fn(term) -> term)((z as int)) as
                                    term)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        (1, ..) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("First is `1` and the rest doesn\'t matter"
                                    as str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        (..,2) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("last is `2` and the rest doesn\'t matter"
                                    as str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        (3, ..,4) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("First is `3`, last is `4`, and the rest doesn\'t matter"
                                    as str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }

            // `..` can be used to ignore the rest of the tuple
            _ => {
            ((io::put_chars as
                    fn(term) -> term)(([([("It doesn\'t matter what they are" as
                                    str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
    // `_` means don't bind the value to a variable
} as ())
