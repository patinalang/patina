#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/destructuring/destructure_list.md
// block: 1/1

fn main() ({
    // Try changing the values in the list!
    let list = ([(1 as int), (-(2 as int) as int), (6 as int)] as [int]);

    (match (list as [int]) {

            // Binds the second and the third elements to the respective variables
            [0, second, third] => {
            ((io::put_chars as
                    fn(term) -> term)(([([("list[0] = 0, list[1] = " as str),
                                ((patina_fmt::display as fn(term) -> term)((second as int))
                                    as term), (", list[2] = " as str),
                                ((patina_fmt::display as fn(term) -> term)((third as int))
                                    as term)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            // Single values can be ignored with _
            [1, _, third] => {
            ((io::put_chars as
                    fn(term) -> term)(([([("list[0] = 1, list[2] = " as str),
                                ((patina_fmt::display as fn(term) -> term)((third as int))
                                    as term), (" and list[1] was ignored" as str)] as [term])]
                    as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            // You can also bind some and ignore the rest
            [-1, second, ..] => {
            ((io::put_chars as
                    fn(term) -> term)(([([("list[0] = -1, list[1] = " as str),
                                ((patina_fmt::display as fn(term) -> term)((second as int))
                                    as term), (" and all the other ones were ignored" as str)]
                            as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }

            // The code below would not compile
            // [-1, second] => ...

            // Or store them in another list (the type depends on
            // that of the value that is being matched against)
            [3, second, tail@_..] => {
            ((io::put_chars as
                    fn(term) -> term)(([([("list[0] = 3, list[1] = " as str),
                                ((patina_fmt::display as fn(term) -> term)((second as int))
                                    as term), (" and the other elements were " as str),
                                ((patina_fmt::debug as fn(term) -> term)((tail as [int])) as
                                    term)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            // We have to include a catch-all for match exhaustiveness.
            _ => {
            ((io::put_chars as
                    fn(term) -> term)(([([("no list pattern matched" as str)] as
                            [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
