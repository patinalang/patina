#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/destructuring/destructure_list.md
// block: 1/1

fn main() ({
    // Try changing the values in the list!
    let list = ([(1 as int), (-(2 as int) as int), (6 as int)] as [int]);

    (match (list as [int]) {

            // Binds the second and the third elements to the respective variables
            [0, second, third] =>
            // Single values can be ignored with _

            // You can also bind some and ignore the rest
            // The code below would not compile
            // [-1, second] => ...

            // Or store them in another list (the type depends on
            // that of the value that is being matched against)

            // We have to include a catch-all for match exhaustiveness.
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("list[0] = 0, list[1] = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((second as int)) as term),
                                (", list[2] = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((third as int)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        [1, _, third] => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("list[0] = 1, list[2] = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((third as int)) as term),
                                (" and list[1] was ignored" as str)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        [-1, second, ..] => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("list[0] = -1, list[1] = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((second as int)) as term),
                                (" and all the other ones were ignored" as str)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        [3, second, tail@_..] => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("list[0] = 3, list[1] = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((second as int)) as term),
                                (" and the other elements were " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((tail as [int])) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("no list pattern matched" as str)] as
                            [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
