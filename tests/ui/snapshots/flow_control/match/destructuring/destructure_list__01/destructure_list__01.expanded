#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/destructuring/destructure_list.md
// block: 1/1

pub fn main() {
    // Try changing the values in the list!
    let list = [1, -2, 6];

    match list {

            // Binds the second and the third elements to the respective variables
            [0, second, third] => {
            io::put_chars([["list[0] = 0, list[1] = ",
                                patina_fmt::display(second), ", list[2] = ",
                                patina_fmt::display(third)]]);
            io::nl();
        }


            // Single values can be ignored with _
            [1, _, third] => {
            io::put_chars([["list[0] = 1, list[2] = ",
                                patina_fmt::display(third), " and list[1] was ignored"]]);
            io::nl();
        }


            // You can also bind some and ignore the rest
            [-1, second, ..] => {
            io::put_chars([["list[0] = -1, list[1] = ",
                                patina_fmt::display(second),
                                " and all the other ones were ignored"]]);
            io::nl();
        }

            // The code below would not compile
            // [-1, second] => ...

            // Or store them in another list (the type depends on
            // that of the value that is being matched against)
            [3, second, tail @ ..] => {
            io::put_chars([["list[0] = 3, list[1] = ",
                                patina_fmt::display(second),
                                " and the other elements were ", patina_fmt::debug(tail)]]);
            io::nl();
        }


            // We have to include a catch-all for match exhaustiveness.
            _ => {
            io::put_chars([["no list pattern matched"]]);
            io::nl();
        }
    }
}
