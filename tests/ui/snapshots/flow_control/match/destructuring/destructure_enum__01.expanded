#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/destructuring/destructure_enum.md
// block: 1/1

// `allow` required to silence warnings because only
// one variant is used.
#[allow(dead_code)]
enum Color {

    // These 3 are specified solely by their name.
    Red,
    Blue,
    Green,

    // These likewise tie `int` tuples to different names: color models.
    RGB(int, int, int),
    HSV(int, int, int),
    HSL(int, int, int),
    CMY(int, int, int),
    CMYK(int, int, int, int),
}

pub fn main() {
    let color = Color::RGB(122, 17, 40);
    { io::put_chars([["What color is it?"]]); io::nl(); };
    // TODO ^ Try different variants for `color`

    // An `enum` can be destructured using a `match`.
    match color {
        Color::Red => { io::put_chars([["The color is Red!"]]); io::nl(); }
        Color::Blue => { io::put_chars([["The color is Blue!"]]); io::nl(); }
        Color::Green => {
            io::put_chars([["The color is Green!"]]);
            io::nl();
        }
        Color::RGB(r, g, b) => {
            io::put_chars([["Red: ", patina_fmt::display(r), ", green: ",
                                patina_fmt::display(g), ", and blue: ",
                                patina_fmt::display(b), "!"]]);
            io::nl();
        }
        Color::HSV(h, s, v) => {
            io::put_chars([["Hue: ", patina_fmt::display(h), ", saturation: ",
                                patina_fmt::display(s), ", value: ", patina_fmt::display(v),
                                "!"]]);
            io::nl();
        }
        Color::HSL(h, s, l) => {
            io::put_chars([["Hue: ", patina_fmt::display(h), ", saturation: ",
                                patina_fmt::display(s), ", lightness: ",
                                patina_fmt::display(l), "!"]]);
            io::nl();
        }
        Color::CMY(c, m, y) => {
            io::put_chars([["Cyan: ", patina_fmt::display(c), ", magenta: ",
                                patina_fmt::display(m), ", yellow: ",
                                patina_fmt::display(y), "!"]]);
            io::nl();
        }
        Color::CMYK(c, m, y, k) => {
            io::put_chars([["Cyan: ", patina_fmt::display(c), ", magenta: ",
                                patina_fmt::display(m), ", yellow: ",
                                patina_fmt::display(y), ", key (black): ",
                                patina_fmt::display(k), "!"]]);
            io::nl();
        }
    }
    // Don't need another arm because all variants have been examined
}
