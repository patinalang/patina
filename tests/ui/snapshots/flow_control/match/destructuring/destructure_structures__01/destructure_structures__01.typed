#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/destructuring/destructure_structures.md
// block: 1/1

fn main() ({
    struct Foo {
        x: (int, int),
        y: int,
    }

    // Try changing the values in the struct to see what happens
    let foo =
        (Foo { x: (((1 as int), (2 as int)) as (int, int)), y: (3 as int) } as
            main::Foo);
    (match (foo as main::Foo) {
        Foo {  x: (1, b),  y } => {
            ((io::put_chars as
                    fn(term) -> term)(([([("First of x is 1, b = " as str),
                                ((patina_fmt::display as fn(term) -> term)((b as int)) as
                                    term), (",  y = " as str),
                                ((patina_fmt::display as fn(term) -> term)((y as int)) as
                                    term), (" " as str)] as [term; 5])] as [[term; 5]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }


            // you can destructure structs and rename the variables,
            // the order is not important
            Foo {  y: 2,  x: i } => {
            ((io::put_chars as
                    fn(term) -> term)(([([("y is 2, i = " as str),
                                ((patina_fmt::debug as fn(term) -> term)((i as (int, int)))
                                    as term)] as [term; 2])] as [[term; 2]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }


            // and you can also ignore some variables:
            Foo {  y, .. } => {
            ((io::put_chars as
                    fn(term) -> term)(([([("y = " as str),
                                ((patina_fmt::display as fn(term) -> term)((y as int)) as
                                    term), (", we don\'t care about x" as str)] as [term; 3])]
                    as [[term; 3]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
    // this will give an error: pattern does not mention field `x`
    //Foo { y } => println!("y = {}", y),

    let faa =
        (Foo { x: (((1 as int), (2 as int)) as (int, int)), y: (3 as int) } as
            main::Foo);
    // You do not need a match block to destructure structs:
    let Foo {  x: x0,  y: y0 } = (faa as main::Foo);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Outside: x0 = " as str),
                            ((patina_fmt::debug as fn(term) -> term)((x0 as (int, int)))
                                as term), (", y0 = " as str),
                            ((patina_fmt::display as fn(term) -> term)((y0 as int)) as
                                term)] as [term; 4])] as [[term; 4]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // Destructuring works with nested structs as well:
    struct Bar {
        foo: Foo,
    }

    let bar = (Bar { foo: (faa as main::Foo) } as main::Bar);
    let Bar {  foo: Foo {  x: nested_x,  y: nested_y } } = (bar as main::Bar);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Nested: nested_x = " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((nested_x as (int, int))) as term),
                            (", nested_y = " as str),
                            ((patina_fmt::debug as fn(term) -> term)((nested_y as int))
                                as term)] as [term; 4])] as [[term; 4]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
