#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/destructuring/destructure_structures.md
// block: 1/1

pub fn main() {
    struct Foo {
        x: (int, int),
        y: int,
    }

    // Try changing the values in the struct to see what happens
    let foo = Foo { x: (1, 2), y: 3 };

    match foo {
        Foo { x: (1, b), y } =>
            // you can destructure structs and rename the variables,
            // the order is not important

            // and you can also ignore some variables:
            // this will give an error: pattern does not mention field `x`
            //Foo { y } => println!("y = {}", y),


            // You do not need a match block to destructure structs:

            // Destructuring works with nested structs as well:

            {
            ::core::io::put_chars([["First of x is 1, b = ",
                                ::core::patina_fmt::display(b), ",  y = ",
                                ::core::patina_fmt::display(y), " "]]);
            ::core::io::nl();
        }
        Foo { y: 2, x: i } => {
            ::core::io::put_chars([["y is 2, i = ",
                                ::core::patina_fmt::debug(i)]]);
            ::core::io::nl();
        }
        Foo { y, .. } => {
            ::core::io::put_chars([["y = ", ::core::patina_fmt::display(y),
                                ", we don\'t care about x"]]);
            ::core::io::nl();
        }
    }
    let faa = Foo { x: (1, 2), y: 3 };
    let Foo { x: x0, y: y0 } = faa;
    {
        ::core::io::put_chars([["Outside: x0 = ",
                            ::core::patina_fmt::debug(x0), ", y0 = ",
                            ::core::patina_fmt::display(y0)]]);
        ::core::io::nl();
    };
    struct Bar {
        foo: Foo,
    }
    let bar = Bar { foo: faa };
    let Bar { foo: Foo { x: nested_x, y: nested_y } } = bar;
    {
        ::core::io::put_chars([["Nested: nested_x = ",
                            ::core::patina_fmt::debug(nested_x), ", nested_y = ",
                            ::core::patina_fmt::debug(nested_y)]]);
        ::core::io::nl();
    };
}
