#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/destructuring/destructure_enum.md
// block: 1/1

// `allow` required to silence warnings because only
// one variant is used.
#[allow(dead_code)]
enum Color {

    // These 3 are specified solely by their name.
    Red,
    Blue,
    Green,

    // These likewise tie `int` tuples to different names: color models.
    RGB(int, int, int),
    HSV(int, int, int),
    HSL(int, int, int),
    CMY(int, int, int),
    CMYK(int, int, int, int),
}

fn main() ({
    let color =
        ((Color::RGB as
                fn(int, int, int) -> Color {Color::RGB})((122 as int),
            (17 as int), (40 as int)) as Color);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("What color is it?" as str)] as
                        [str; 1])] as [[str; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // TODO ^ Try different variants for `color`

    // An `enum` can be destructured using a `match`.
    (match (color as Color) {
        Color::Red => {
            ((io::put_chars as
                    fn(term) -> term)(([([("The color is Red!" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::Blue => {
            ((io::put_chars as
                    fn(term) -> term)(([([("The color is Blue!" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::Green => {
            ((io::put_chars as
                    fn(term) -> term)(([([("The color is Green!" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::RGB(r, g, b) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Red: " as str),
                                ((patina_fmt::display as fn(term) -> term)((r as int)) as
                                    term), (", green: " as str),
                                ((patina_fmt::display as fn(term) -> term)((g as int)) as
                                    term), (", and blue: " as str),
                                ((patina_fmt::display as fn(term) -> term)((b as int)) as
                                    term), ("!" as str)] as [term; 7])] as [[term; 7]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::HSV(h, s, v) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Hue: " as str),
                                ((patina_fmt::display as fn(term) -> term)((h as int)) as
                                    term), (", saturation: " as str),
                                ((patina_fmt::display as fn(term) -> term)((s as int)) as
                                    term), (", value: " as str),
                                ((patina_fmt::display as fn(term) -> term)((v as int)) as
                                    term), ("!" as str)] as [term; 7])] as [[term; 7]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::HSL(h, s, l) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Hue: " as str),
                                ((patina_fmt::display as fn(term) -> term)((h as int)) as
                                    term), (", saturation: " as str),
                                ((patina_fmt::display as fn(term) -> term)((s as int)) as
                                    term), (", lightness: " as str),
                                ((patina_fmt::display as fn(term) -> term)((l as int)) as
                                    term), ("!" as str)] as [term; 7])] as [[term; 7]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::CMY(c, m, y) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Cyan: " as str),
                                ((patina_fmt::display as fn(term) -> term)((c as int)) as
                                    term), (", magenta: " as str),
                                ((patina_fmt::display as fn(term) -> term)((m as int)) as
                                    term), (", yellow: " as str),
                                ((patina_fmt::display as fn(term) -> term)((y as int)) as
                                    term), ("!" as str)] as [term; 7])] as [[term; 7]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }
        Color::CMYK(c, m, y, k) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Cyan: " as str),
                                ((patina_fmt::display as fn(term) -> term)((c as int)) as
                                    term), (", magenta: " as str),
                                ((patina_fmt::display as fn(term) -> term)((m as int)) as
                                    term), (", yellow: " as str),
                                ((patina_fmt::display as fn(term) -> term)((y as int)) as
                                    term), (", key (black): " as str),
                                ((patina_fmt::display as fn(term) -> term)((k as int)) as
                                    term), ("!" as str)] as [term; 9])] as [[term; 9]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
    // Don't need another arm because all variants have been examined
} as ())
