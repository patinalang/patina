#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/guard.md
// block: 1/2

#[allow(dead_code)]
enum Temperature { Celsius(int), Fahrenheit(int), }

pub fn main() {
    let temperature = Temperature::Celsius(35);
    // ^ TODO try different values for `temperature`

    match temperature {
        Temperature::Celsius(t) if t > 30 =>
            // The `if condition` part ^ is a guard

            {
            ::core::io::put_chars([[::core::patina_fmt::display(t),
                                "C is above 30 Celsius"]]);
            ::core::io::nl();
        }
        Temperature::Celsius(t) => {
            ::core::io::put_chars([[::core::patina_fmt::display(t),
                                "C is equal to or below 30 Celsius"]]);
            ::core::io::nl();
        }
        Temperature::Fahrenheit(t) if t > 86 => {
            ::core::io::put_chars([[::core::patina_fmt::display(t),
                                "F is above 86 Fahrenheit"]]);
            ::core::io::nl();
        }
        Temperature::Fahrenheit(t) => {
            ::core::io::put_chars([[::core::patina_fmt::display(t),
                                "F is equal to or below 86 Fahrenheit"]]);
            ::core::io::nl();
        }
    }
}
