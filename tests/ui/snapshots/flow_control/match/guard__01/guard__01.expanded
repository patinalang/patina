#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match/guard.md
// block: 1/2

#[allow(dead_code)]
enum Temperature { Celsius(int), Fahrenheit(int), }

pub fn main() {
    let temperature = Temperature::Celsius(35);
    // ^ TODO try different values for `temperature`

    match temperature {
        Temperature::Celsius(t) if t > 30 => {
            io::put_chars([[patina_fmt::display(t),
                                "C is above 30 Celsius"]]);
            io::nl();
        }

            // The `if condition` part ^ is a guard
            Temperature::Celsius(t) => {
            io::put_chars([[patina_fmt::display(t),
                                "C is equal to or below 30 Celsius"]]);
            io::nl();
        }


            Temperature::Fahrenheit(t) if t > 86 => {
            io::put_chars([[patina_fmt::display(t),
                                "F is above 86 Fahrenheit"]]);
            io::nl();
        }
        Temperature::Fahrenheit(t) => {
            io::put_chars([[patina_fmt::display(t),
                                "F is equal to or below 86 Fahrenheit"]]);
            io::nl();
        }
    }
}
