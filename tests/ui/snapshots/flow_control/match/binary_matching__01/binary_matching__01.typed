#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 1/6

fn main() ({
    let payload =
        (<<(1 as int), (17 as int), (42 as int), (99 as int)>> as str);

    (match (payload as str) {
        <<prefix: int(size = (16 as int)), tag: int(size = (8 as int)), rest @
            ..>> =>
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("prefix = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((prefix as int)) as term),
                                (", tag = " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((tag as int)) as term),
                                (", rest = " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((rest as bin)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        _ => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("did not match" as str)] as [str])]
                    as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
