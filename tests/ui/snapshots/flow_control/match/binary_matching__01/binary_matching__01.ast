pub fn main() {
    let payload = <<1, 17, 42, 99>>;

    match payload {
        <<prefix: int(size = 16), tag: int(size = 8), rest @ ..>> =>
            println!("prefix = {}, tag = {}, rest = {:?}", prefix, tag, rest),


            _ => println!("did not match"),
    }
}
