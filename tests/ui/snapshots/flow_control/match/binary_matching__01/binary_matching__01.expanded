#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 1/6

pub fn main() {
    let payload = <<1, 17, 42, 99>>;

    match payload {
        <<prefix: int(size = 16), tag: int(size = 8), rest @ ..>> =>
            {
            ::core::io::put_chars([["prefix = ",
                                ::core::patina_fmt::display(prefix), ", tag = ",
                                ::core::patina_fmt::display(tag), ", rest = ",
                                ::core::patina_fmt::debug(rest)]]);
            ::core::io::nl();
        }
        _ => { ::core::io::put_chars([["did not match"]]); ::core::io::nl(); }
    }
}
