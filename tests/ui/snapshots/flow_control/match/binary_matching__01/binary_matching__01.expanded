#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/match/binary_matching.md
// block: 1/6

pub fn main() {
    let payload = <<1, 17, 42, 99>>;

    match payload {
        <<prefix: int(size = 16), tag: int(size = 8), rest @ ..>> =>
            {
            ::Core::io::put_chars([["prefix = ", patina_fmt::display(prefix),
                                ", tag = ", patina_fmt::display(tag), ", rest = ",
                                patina_fmt::debug(rest)]]);
            ::Core::io::nl();
        }
        _ => { ::Core::io::put_chars([["did not match"]]); ::Core::io::nl(); }
    }
}
