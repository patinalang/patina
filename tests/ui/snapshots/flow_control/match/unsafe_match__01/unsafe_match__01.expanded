#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/match/unsafe_match.md
// block: 1/1

pub fn main() {
    let v = Option::<int>::None as term;

    let safe_description =
        match v {
            a"nil" => "the atom nil",
            (a"some", val) => "some value (tagged?)",
            int(_) => "some integer value (untagged?)",
            val => "some value (untagged?)",
        };
    // Option<str>::None => "string option (none)",
    // ^ERROR - can't safely match by runtime representation!

    let unsafe_description =
        unsafe {
            match v {
                Option::<str>::None => "an empty string option",
                Option::<int>::None => "an empty integer option",
                a"nil" => "the atom nil",
                _ => "something else",
            }
        };

    // "the atom nil, an empty string option"
    {
        ::Core::io::put_chars([[patina_fmt::display(safe_description), ", ",
                            patina_fmt::display(unsafe_description)]]);
        ::Core::io::nl();
    };
}
