#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/match/unsafe_match.md
// block: 1/1

fn main() ({
    let v = ((Option::<int>::None as core::Option<int>) as term as term);

    let safe_description =
        (match (v as term) {
            a"nil" => ("the atom nil" as str),
            (a"some", val) => ("some value (tagged?)" as str),
            int(_) => ("some integer value (untagged?)" as str),
            val => ("some value (untagged?)" as str),
        } as str);
    // Option<str>::None => "string option (none)",
    // ^ERROR - can't safely match by runtime representation!

    let unsafe_description =
        (unsafe {
            (match (v as term) {
                Option::<str>::None => ("an empty string option" as str),
                Option::<int>::None => ("an empty integer option" as str),
                a"nil" => ("the atom nil" as str),
                _ => ("something else" as str),
            } as str)
        } as str);

    // "the atom nil, an empty string option"
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((safe_description as str)) as term),
                            (", " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((unsafe_description as str)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
