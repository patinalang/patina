#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn classify(number: int)
    ->
        int ({
    (match (number as int) {
        1 | 3 | 5 => (10 as int),
        2 | 4 => (20 as int),
        _ => (0 as int),
    } as int)
} as int)

fn classify_nested(pair: (int, int))
    ->
        int ({
    (match (pair as (int, int)) {
        (0 | 1, 2 | 3) => (10 as int),
        _ => (0 as int),
    } as int)
} as int)

fn classify_nested_map(map: #{str => int})
    ->
        int ({
    (match (map as #{str => int}) {
        #{("first" as str) => 0 | 1, ("second" as str) => 2 | 3, ..} =>
            (10 as int),
        _ => (0 as int),
    } as int)
} as int)

fn classify_if_let(number: int)
    ->
        int ({
    (if (let 1 | 3 | 5 = (number as int) as bool) {
        (10 as int)
    } else { (0 as int) } as int)
} as int)

fn unwrap_zero_pair_if_let(pair: (int, int))
    ->
        int ({
    (if (let (0, value) | (value, 0) = (pair as (int, int)) as bool) {
        (value as int)
    } else { (-(1 as int) as int) } as int)
} as int)

fn classify_let_else(number: int)
    ->
        int ({
    let 1 | 3 | 5 = (number as int) else { (return (0 as int) as !); };
    (10 as int)
} as int)
