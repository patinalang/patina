#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

pub fn classify(number: int) -> int {
    match number { 1 | 3 | 5 => 10, 2 | 4 => 20, _ => 0, }
}

pub fn classify_nested(pair: (int, int)) -> int {
    match pair { (0 | 1, 2 | 3) => 10, _ => 0, }
}

pub fn classify_nested_map(map: #{str => int}) -> int {
    match map { #{"first" => 0 | 1, "second" => 2 | 3, ..} => 10, _ => 0, }
}

pub fn classify_if_let(number: int) -> int {
    if let 1 | 3 | 5 = number { 10 } else { 0 }
}

pub fn unwrap_zero_pair_if_let(pair: (int, int)) -> int {
    if let (0, value) | (value, 0) = pair { value } else { -1 }
}

pub fn classify_let_else(number: int) -> int {
    let (1 | 3 | 5) = number else { return 0; };
    10
}
