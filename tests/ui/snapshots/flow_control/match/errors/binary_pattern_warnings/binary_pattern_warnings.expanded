#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// Literals that don't fit their binary pattern segments.

pub fn main() {
    let b: bin = <<1, 2>>;

    match b {

            // These segments can never match.
            <<256: int(size = 8), -1: int(size = 8)>> =>
            // These are truncated, or encoded as infinity.
            {
            ::Core::io::put_chars([["never"]]);
            ::Core::io::nl();
        }
        <<-1: int(size = 8, signed), 128: int(size = 8, signed), -129:
            int(size = 8, signed)>> => {}
        <<1.0e10: float(size = 16), 1.0e39: float(size = 32), 1.0e39: float>>
            => {}
        _ => {}
    }
    {
        ::Core::io::put_chars([[patina_fmt::debug(<<300: int(size = 8), -1:
                                        int(size = 8), 255: int(size = 8), 1.0e10: float(size = 16),
                                        b'\x80': int(size = 8, signed)>>)]]);
        ::Core::io::nl();
    };
}
