#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// Literals that don't fit their binary pattern segments.

fn main() ({
    let b: bin = (<<(1 as int), (2 as int)>> as str);

    (match (b as bin) {

            // These segments can never match.
            <<256: int(size = (8 as int)), -1: int(size = (8 as int))>> =>
            // These are truncated, or encoded as infinity.
            {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("never" as str)] as [str])] as
                    [[str]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
        <<-1: int(size = (8 as int), signed), 128:
            int(size = (8 as int), signed), -129:
            int(size = (8 as int), signed)>> => {
        }
        <<1.0e10: float(size = (16 as int)), 1.0e39:
            float(size = (32 as int)), 1.0e39: float>> => {
        }
        _ => { }
    } as ())
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((<<(300 as int): int(size = (8 as int)),
                                        (-(1 as int) as int): int(size = (8 as int)), (255 as int):
                                        int(size = (8 as int)), (1.0e10 as float):
                                        float(size = (16 as int)), (b'\x80' as int):
                                        int(size = (8 as int), signed)>> as bin)) as term)] as
                        [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
