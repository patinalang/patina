    // You can use the pin operator (^) to match against bound variables
    {
        io::put_chars([["Tell me about ", patina_fmt::display(number)]]);
        io::nl();
    };
    match number {
        1 => { io::put_chars([["One!"]]); io::nl(); }
        2 | 3 | 5 | 7 | 11 => {
            io::put_chars([["This is a prime"]]);
            io::nl();
        }
        13..=19 => { io::put_chars([["A teen"]]); io::nl(); }
        _ => { io::put_chars([["Ain\'t special"]]); io::nl(); }
    }
    let boolean = true;
    let binary = match boolean { false => 0, true => 1, };
    {
        io::put_chars([[patina_fmt::display(boolean), " -> ",
                            patina_fmt::display(binary)]]);
        io::nl();
    };
    let expected_value = 42;
    match 123 {
        ^expected_value => {
            io::put_chars([["found expected value"]]);
            io::nl();
        }
        value => {
            io::put_chars([["found unexpected value ",
                                patina_fmt::display(value)]]);
            io::nl();
        }
    }
}
