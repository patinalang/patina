#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/match.md
// block: 1/1

pub fn main() {
    let number = 13;
    {
        io::put_chars([["Tell me about ",
                            patina_fmt::display(
                                // TODO ^ Try different values for `number`

                                number)]]);
        io::nl();
    };
    match number {

            // Match a single value
            1 => {
            io::put_chars([["One!"]]);
            io::nl();
        }

            // Match several values
            2 | 3 | 5 | 7 | 11 => {
            io::put_chars([["This is a prime"]]);
            io::nl();
        }

            // TODO ^ Try adding 13 to the list of prime values
            // Match an inclusive range
            13..=19 => {
            io::put_chars([["A teen"]]);
            io::nl();
        }

            // Handle the rest of cases
            _ => {
            io::put_chars([["Ain\'t special"]]);
            io::nl();
        }
    }
    // TODO ^ Try commenting out this catch-all arm

    let boolean = true;
    // Match is an expression too
    let binary =
        match boolean {

                // The arms of a match must cover all the possible values
                false => 0,
            true => 1,
        };
    {
        io::put_chars([[patina_fmt::display(
                                // TODO ^ Try commenting out one of these arms

                                boolean), " -> ", patina_fmt::display(binary)]]);
        io::nl();
    };

    let expected_value = 42;
    match 123 {

            // You can use the pin operator (^) to match against bound variables
            ^expected_value => {
            io::put_chars([["found expected value"]]);
            io::nl();
        }
        value => {
            io::put_chars([["found unexpected value ",
                                patina_fmt::display(value)]]);
            io::nl();
        }
    }
}
