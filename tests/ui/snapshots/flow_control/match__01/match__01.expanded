    // You can use the pin operator (^) to match against bound variables
    {
        ::Core::io::put_chars([["Tell me about ",
                            patina_fmt::display(number)]]);
        ::Core::io::nl();
    };
    match number {
        1 => { ::Core::io::put_chars([["One!"]]); ::Core::io::nl(); }
        2 | 3 | 5 | 7 | 11 => {
            ::Core::io::put_chars([["This is a prime"]]);
            ::Core::io::nl();
        }
        13..=19 => { ::Core::io::put_chars([["A teen"]]); ::Core::io::nl(); }
        _ => {
            ::Core::io::put_chars([["Ain\'t special"]]);
            ::Core::io::nl();
        }
    }
    let boolean = true;
    let binary = match boolean { false => 0, true => 1, };
    {
        ::Core::io::put_chars([[patina_fmt::display(boolean), " -> ",
                            patina_fmt::display(binary)]]);
        ::Core::io::nl();
    };
    let expected_value = 42;
    match 123 {
        ^expected_value => {
            ::Core::io::put_chars([["found expected value"]]);
            ::Core::io::nl();
        }
        value => {
            ::Core::io::put_chars([["found unexpected value ",
                                patina_fmt::display(value)]]);
            ::Core::io::nl();
        }
    }
