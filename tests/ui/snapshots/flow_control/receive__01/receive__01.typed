#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/receive.md
// block: 1/1

fn main() ({
    (receive {
        int(n) =>
            // like in `match`, literals can also be used

            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("received integer " as str),
                                ((patina_fmt::debug as fn(term) -> term)((n as int)) as
                                    term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        a"ping" => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("received ping" as str)] as [str])]
                    as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        atom(a) => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("received atom " as str),
                                ((patina_fmt::debug as fn(term) -> term)((a as atom)) as
                                    term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    }
        after ((Timeout::from_seconds as
                fn(int) -> core::Timeout {core::Timeout::from_seconds})((5 as
                int)) as core::Timeout)
        ({
            ({
                ((::core::io::put_chars as
                        fn(term) -> term)(([([("timeout (5 seconds with no matching message)"
                                        as str)] as [str])] as [[str]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            } as ())
        } as ()) as ())
    (receive {
        val => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("received any message " as str),
                                ((patina_fmt::debug as fn(term) -> term)((val as term)) as
                                    term)] as [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
