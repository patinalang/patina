#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/receive.md
// block: 1/1

pub fn main() {
    receive {
        int(n) =>
            // like in `match`, literals can also be used

            {
            ::core::io::put_chars([["received integer ",
                                patina_fmt::debug(n)]]);
            ::core::io::nl();
        }
        a"ping" => {
            ::core::io::put_chars([["received ping"]]);
            ::core::io::nl();
        }
        atom(a) => {
            ::core::io::put_chars([["received atom ", patina_fmt::debug(a)]]);
            ::core::io::nl();
        }
    } after Timeout::from_seconds(5)
        {
        {
            ::core::io::put_chars([["timeout (5 seconds with no matching message)"]]);
            ::core::io::nl();
        }
    }
    receive {
        val => {
            ::core::io::put_chars([["received any message ",
                                patina_fmt::debug(val)]]);
            ::core::io::nl();
        }
    }
}
