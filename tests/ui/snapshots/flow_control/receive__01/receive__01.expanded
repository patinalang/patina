#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/receive.md
// block: 1/1

pub fn main() {
    receive {
        int(n) => {
            io::put_chars([["received integer ", patina_fmt::debug(n)]]);
            io::nl();
        }

            // like in `match`, literals can also be used
            a"ping" => {
            io::put_chars([["received ping"]]);
            io::nl();
        }
        atom(a) => {
            io::put_chars([["received atom ", patina_fmt::debug(a)]]);
            io::nl();
        }
    } after Timeout::from_seconds(5)
        {
        {
            io::put_chars([["timeout (5 seconds with no matching message)"]]);
            io::nl();
        }
    }

    receive {
        val => {
            io::put_chars([["received any message ",
                                patina_fmt::debug(val)]]);
            io::nl();
        }
    }
}
