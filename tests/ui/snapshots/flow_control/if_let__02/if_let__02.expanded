#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/if_let.md
// block: 2/4

pub fn main() {
    // All have type `Option<int>`
    let number = Some(7);
    let letter: Option<int> = None;
    let emoticon: Option<int> = None;

    // The `if let` construct reads: "if `let` destructures `number` into
    // `Some(i)`, evaluate the block (`{}`).
    if let Some(i) = number {

        // If you need to specify a failure, use an else:
        // Destructure failed. Change to the failure case.

        // Provide an altered failing condition.

        // Destructure failed. Evaluate an `else if` condition to see if the
        // alternate failure branch should be taken:
        // The condition evaluated false. This branch is the default:
        {
            ::Core::io::put_chars([["Matched ", patina_fmt::debug(i), "!"]]);
            ::Core::io::nl();
        };
    }
    if let Some(i) = letter {
        {
            ::Core::io::put_chars([["Matched ", patina_fmt::debug(i), "!"]]);
            ::Core::io::nl();
        };
    } else {
        {
            ::Core::io::put_chars([["Didn\'t match a number. Let\'s go with a letter!"]]);
            ::Core::io::nl();
        };
    }
    let i_like_letters = false;
    if let Some(i) = emoticon {
        {
            ::Core::io::put_chars([["Matched ", patina_fmt::debug(i), "!"]]);
            ::Core::io::nl();
        };
    } else if i_like_letters {
        {
            ::Core::io::put_chars([["Didn\'t match a number. Let\'s go with a letter!"]]);
            ::Core::io::nl();
        };
    } else {
        {
            ::Core::io::put_chars([["I don\'t like letters. Let\'s go with an emoticon :)!"]]);
            ::Core::io::nl();
        };
    }
}
