#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/if_let.md
// block: 2/4

fn main() ({
    // All have type `Option<int>`
    let number = ((Some as {type error})((7 as int)) as {type error});
    let letter: Option<int> = (None as {type error});
    let emoticon: Option<int> = (None as {type error});

    // The `if let` construct reads: "if `let` destructures `number` into
    // `Some(i)`, evaluate the block (`{}`).
    (if (let Some(i) = (number as {type error}) as {type error}) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Matched " as str),
                                ((patina_fmt::debug as
                                        fn(term) -> term)((i as {type error})) as term),
                                ("!" as str)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())

    // If you need to specify a failure, use an else:
    (if (let Some(i) = (letter as {type error}) as {type error}) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Matched " as str),
                                ((patina_fmt::debug as
                                        fn(term) -> term)((i as {type error})) as term),
                                ("!" as str)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } else {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Didn\'t match a number. Let\'s go with a letter!"
                                    as str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
        // Destructure failed. Change to the failure case.
    } as ())

    // Provide an altered failing condition.
    let i_like_letters = (false as bool);

    (if (let Some(i) = (emoticon as {type error}) as {type error}) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Matched " as str),
                                ((patina_fmt::debug as
                                        fn(term) -> term)((i as {type error})) as term),
                                ("!" as str)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
        // Destructure failed. Evaluate an `else if` condition to see if the
        // alternate failure branch should be taken:
    } else if (i_like_letters as bool) {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Didn\'t match a number. Let\'s go with a letter!"
                                    as str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } else {
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("I don\'t like letters. Let\'s go with an emoticon :)!"
                                    as str)] as [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
        // The condition evaluated false. This branch is the default:
    } as ())
} as ())
