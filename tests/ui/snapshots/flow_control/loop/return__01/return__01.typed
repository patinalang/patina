fn main() ({
    let mut counter = (0 as int);

    let result =
        (loop {
            ((counter as int) += (1 as int) as int);

            (if ((counter as int) == (10 as int) as bool) {
                (break ((counter as int) * (2 as int) as int) as !);
            } as ())
        } as int);

    (match (((result as int), (20 as int)) as (int, int)) {
        (left_val, right_val) => {
            (if (!(((left_val as int) == (right_val as int) as bool)) as bool)
                {
                (unsafe {
                    (((::core::erlang::error as
                                fn(term, term, term) -> term)(((::core::Panic::new as
                                    fn(str) -> core::Panic {core::Panic::new})((unsafe {
                                    (((::core::unicode::characters_to_binary as
                                                fn(term) -> term)(([("assertion `left == right` failed" as
                                                        str),
                                                    ((::core::patina_fmt::display as
                                                            fn(term) -> term)(("" as str)) as term),
                                                    ("\n  left: " as str),
                                                    ((::core::patina_fmt::debug as
                                                            fn(term) -> term)((left_val as int)) as term),
                                                    ("\n right: " as str),
                                                    ((::core::patina_fmt::debug as
                                                            fn(term) -> term)((right_val as int)) as term)] as [term]))
                                            as term).cast_unchecked::<str>() as str)
                                } as str)) as core::Panic), (a"none" as atom),
                            ([(((a"error_info" as atom),
                                        (#{(a"module" as atom) =>
                                                (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                                        as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                            as term).cast_unchecked::<!>() as !)
                } as ())
            } as ())
        }
    } as ());
} as ())
