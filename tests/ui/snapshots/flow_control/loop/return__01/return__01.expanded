#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control/loop/return.md
// block: 1/1

pub fn main() {
    let mut counter = 0;

    let result =
        loop {
            counter += 1;

            if counter == 10 { break counter * 2; }
        };

    match (result, 20) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::core::erlang::error(::core::Panic::new(unsafe {
                                    ::core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
}
