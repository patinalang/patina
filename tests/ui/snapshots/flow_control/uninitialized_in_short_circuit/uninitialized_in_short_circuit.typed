#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn initialize_in_short_circuit(run_rhs: bool)
    ->
        int ({
    let value;

    let _ =
        ((run_rhs as bool) &&
            ({ (value = (30 as int) as int); (true as bool) } as bool) as
            bool);

    (value as int)
} as int)

fn opt(x: int)
    ->
        Option<int> ({
    (if ((x as int) >= (0 as int) as bool) {
        ((Some as
                fn(int) -> core::option::Option<int> {core::option::Option::<int>::Some})((x
                as int)) as core::option::Option<int>)
    } else { (None as core::option::Option<int>) } as
        core::option::Option<int>)
} as core::option::Option<int>)

fn deferred_in_later_operand(a: int)
    ->
        int ({
    let mut x;
    (if ((let Some(v) =
                ((opt as
                        fn(int) -> core::option::Option<int> {opt})((a as int)) as
                    core::option::Option<int>) as bool) &&
            ({ (x = (v as int) as int); ((v as int) > (1 as int) as bool) } as
                bool) as bool) {
        (x as int)
    } else { (0 as int) } as int)
} as int)
