#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn initialize_in_short_circuit(run_rhs: bool)
    ->
        int ({
    let value;

    let _ =
        ((run_rhs as bool) &&
            ({ ((value as int) = (30 as int) as int); (true as bool) } as
                bool) as bool);

    (value as int)
} as int)
