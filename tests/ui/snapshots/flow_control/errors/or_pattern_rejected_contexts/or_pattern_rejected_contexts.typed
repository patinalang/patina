#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn reject_or_pattern_function_parameter(0 | 1: int) ({ } as ())

fn reject_or_pattern_plain_let(value:
        int) ({ let 0 | 1 = (value as int); } as ())

fn reject_or_pattern_map_key(map: #{int => int})
    ->
        int ({
    (match (map as #{int => int}) {
        #{((/*ERROR*/) as {type error}) => value, ..} => (value as int),
        _ => (0 as int),
    } as int)
} as int)
