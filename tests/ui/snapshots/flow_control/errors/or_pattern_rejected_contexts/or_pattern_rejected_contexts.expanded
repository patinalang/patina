#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

pub fn reject_or_pattern_function_parameter((0 | 1): int) {}

pub fn reject_or_pattern_plain_let(value: int) { let (0 | 1) = value; }

pub fn reject_or_pattern_map_key(map: #{int => int}) -> int {
    match map { #{(1 | 2) => value, ..} => value, _ => 0, }
}
