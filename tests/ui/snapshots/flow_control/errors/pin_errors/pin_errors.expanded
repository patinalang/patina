#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

const EXPECTED: int = 7;

pub fn pin_not_found(value: int) -> bool {
    match value { ^nosuch => true, _ => false, }
}

pub fn pin_self_resolution(first: int, second: int) -> int {
    match (first, second) { (a, ^a) => a, _ => -1, }
}

pub fn pin_const(value: int) -> bool {
    match value { ^EXPECTED => true, _ => false, }
}

pub fn pin_type_mismatch(value: int, expected: bool) -> bool {
    match value { ^expected => true, _ => false, }
}

pub fn closure_parameter(expected: int) -> int {
    let closure = |^expected: int| 0;
    closure(expected)
}

pub fn refutable_local(value: int, expected: int) { let ^expected = value; }
