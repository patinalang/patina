#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn pin_partial_initialization(value: int)
    ->
        bool ({
    let expected;
    (match (value as int) {
        ^expected => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)
