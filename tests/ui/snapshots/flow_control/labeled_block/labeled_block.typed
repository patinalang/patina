#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// snapshot: core0, core

fn labeled(x: int)
    ->
        int ({
    let mut y = (0 as int);
    let r =
        ('a:
            {
            ((y as int) += (1 as int) as int);
            (if ((x as int) > (5 as int) as bool) {
                (break 'a ((x as int) * (2 as int) as int) as !);
            } as ())
            ((y as int) += (10 as int) as int);
            ((x as int) + (y as int) as int)
        } as int);
    ((r as int) + (y as int) as int)
} as int)

fn nested(x: int)
    ->
        int ({
    let mut n = (0 as int);
    ('outer:
        {
        (loop {
            ((n as int) += (1 as int) as int);
            (if ((n as int) > (x as int) as bool) { (break 'outer as !); } as
                ())
        } as !)
    } as ())
    (n as int)
} as int)
