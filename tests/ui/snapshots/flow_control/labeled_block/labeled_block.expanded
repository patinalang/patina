#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// snapshot: core0, core

pub fn labeled(x: int) -> int {
    let mut y = 0;
    let r = 'a: { y += 1; if x > 5 { break 'a x * 2; } y += 10; x + y };
    r + y
}

pub fn nested(x: int) -> int {
    let mut n = 0;
    'outer: { loop { n += 1; if n > x { break 'outer; } } }
    n
}
