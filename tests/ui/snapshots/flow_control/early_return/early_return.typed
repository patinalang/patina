fn mark(value: int)
    ->
        int ({
    let marks =
        (unsafe {
            (((erlang::get as fn(term) -> term)((a"marks" as atom)) as
                    term).cast_unchecked::<[int]>() as [int])
        } as [int]);
    ((erlang::put as
            fn(term, term) -> term)((a"marks" as atom),
        ([(value as int), ..(marks as [int])] as [int])) as term);
    (value as int)
} as int)

enum Choice { Stop, Continue, }

fn match_value(choice: Choice)
    ->
        int ({
    let value =
        (match (choice as Choice) {
            Choice::Stop => (return (10 as int) as !),
            Choice::Continue => (20 as int),
        } as int);
    ((value as int) + (1 as int) as int)
} as int)

fn is_negative(x: int)
    ->
        bool ({
    (if ((x as int) >= (0 as int) as bool) { (return (false as bool) as !); }
        as ())
    (return (true as bool) as !);
} as !)

