#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn mark(value: int) -> int {














    { io::put_chars([[patina_fmt::display(value)]]); io::nl(); };
    value
}
enum Choice { Stop, Continue, }
fn match_value(choice: Choice) -> int {
    let value =
        match choice { Choice::Stop => return 10, Choice::Continue => 20, };
    value + 1
}
pub fn is_negative(x: int) -> bool {
    if x >= 0 { return false; }
    return true;
}
pub fn is_negative_implicit(x: int) -> bool {
    if x >= 0 { return false; }
    true
}
pub fn closure_value(stop: bool) -> int {
    let _closure = || -> int { if stop { return 4; } 5 };
    10
}
pub fn expression_value(stop: bool) -> int {
    mark(1) + { if stop { return mark(2); } mark(3) }
}
pub fn match_stopped() -> int { match_value(Choice::Stop) }
pub fn match_continued() -> int { match_value(Choice::Continue) }
pub fn match_scrutinee_value(stop: bool) -> int {
    match { if stop { return 40; } Choice::Continue } {
        Choice::Stop => 50,
        Choice::Continue => 60,
    }
}
pub fn nested_value(x: int) -> int {
    let result = { if x == 0 { return 10; } { if x == 1 { return 20; } 30 } };
    result + 1
}
pub fn if_condition_value(stop: bool) -> int {
    if { if stop { return 10; } true } { 20 } else { 30 }
}
