pub fn main() {
    let mut count = 0;


    // Infinite loop


    // Skip the rest of this iteration



    // Exit this loop
    { io::put_chars([["Let\'s count until infinity!"]]); io::nl(); };
    loop {
        count += 1;
        if count == 3 { { io::put_chars([["three"]]); io::nl(); }; continue; }
        { io::put_chars([[patina_fmt::display(count)]]); io::nl(); };
        if count == 5 {
            { io::put_chars([["OK, that\'s enough"]]); io::nl(); };
            break;
        }
    }
}
