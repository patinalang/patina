pub fn main() {
    let mut count = 0;


    // Infinite loop


    // Skip the rest of this iteration



    // Exit this loop
    {
        ::Core::io::put_chars([["Let\'s count until infinity!"]]);
        ::Core::io::nl();
    };
    loop {
        count += 1;
        if count == 3 {
            { ::Core::io::put_chars([["three"]]); ::Core::io::nl(); };
            continue;
        }
        {
            ::Core::io::put_chars([[patina_fmt::display(count)]]);
