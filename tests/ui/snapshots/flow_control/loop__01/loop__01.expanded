#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/loop.md
// block: 1/1

pub fn main() {
    let mut count = 0;
    { io::put_chars([["Let\'s count until infinity!"]]); io::nl(); };


    // Infinite loop
    loop {
        count += 1;

        if count == 3 {
            { io::put_chars([["three"]]); io::nl(); };

            // Skip the rest of this iteration
            continue;
        }
        {
            io::put_chars([[patina_fmt::display(

                                    count)]]);
            io::nl();
        };

        if count == 5 {
            { io::put_chars([["OK, that\'s enough"]]); io::nl(); };

            // Exit this loop
            break;
        }
    }
}
