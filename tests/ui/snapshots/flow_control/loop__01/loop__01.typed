#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/flow_control/loop.md
// block: 1/1

fn main() ({
    let mut count = (0 as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Let\'s count until infinity!" as str)]
                        as [str])] as [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());


    // Infinite loop
    (loop {
        ((count as int) += (1 as int) as ());

        (if ((count as int) == (3 as int) as bool) {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([("three" as str)] as [str])] as
                        [[str]])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());

            // Skip the rest of this iteration
            (continue as !);
        } as ())
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([((patina_fmt::display as
                                        fn(term) -> term)(

                                    (count as int)) as term)] as [term])] as [[term]])) as
                term);
            ((io::nl as fn() -> term)() as term);
        } as ());

        (if ((count as int) == (5 as int) as bool) {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([("OK, that\'s enough" as str)] as
                                [str])] as [[str]])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());

            // Exit this loop
            (break as !);
        } as ())
    } as ())
} as ())
