#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

struct Years(int);

impl Years {
    fn new(years: int)
        ->
            Years ({
        ((Years as fn(int) -> Years {Years})((years as int)) as Years)
    } as Years)
}

fn get_age(age: Years) -> int ({ ((age as Years).0 as int) } as int)

fn main() ({
    let age =
        ((Years::new as fn(int) -> Years {Years::new})((25 as int)) as Years);
    let age_value =
        ((get_age as fn(Years) -> int {get_age})((age as Years)) as int);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Age " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((age as Years)) as term), (" is " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)((age_value as int)) as term)] as [term])]
                as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
