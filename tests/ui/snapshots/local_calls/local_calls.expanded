#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

struct Years(int);

impl Years {
    pub fn new(years: int) -> Years { Years(years) }
}

fn get_age(age: Years) -> int { age.0 }

pub fn main() {
    let age = Years::new(25);
    let age_value = get_age(age);
    {
        ::Core::io::put_chars([["Age ", patina_fmt::debug(age), " is ",
                            patina_fmt::display(age_value)]]);
        ::Core::io::nl();
    };
}
