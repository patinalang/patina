#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/macros.md
// block: 1/1

// This is a simple macro named `say_hello`.
macro_rules! say_hello {
    () =>
    {
        println!("Hello!")
        // `()` indicates that the macro takes no argument.
        // The macro will expand into the contents of this block.
    };
}

fn main() ({

    // This call will expand into `println!("Hello!")`
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Hello!" as str)] as [str])] as
                [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ())
} as ())
