#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

use core::proc_macro::*;

fn main() ({
    let _literal =
        (((Literal::int as
                    fn(int) -> core::proc_macro::Literal {core::proc_macro::Literal::int})((1
                    as int)) as core::proc_macro::Literal).0 as {type error});
    let _group =
        (((Group::new as
                    fn(core::proc_macro::Delimiter, core::proc_macro::TokenStream) -> core::proc_macro::Group {core::proc_macro::Group::new})((Delimiter::Brace
                    as core::proc_macro::Delimiter),
                ((TokenStream::new as
                        fn() -> core::proc_macro::TokenStream {core::proc_macro::TokenStream::new})()
                    as core::proc_macro::TokenStream)) as
                core::proc_macro::Group).0 as {type error});
    let _ident =
        (((Ident::new as
                    fn(str, core::proc_macro::Span) -> core::proc_macro::Ident {core::proc_macro::Ident::new})(("x"
                    as str),
                ((Span::call_site as
                        fn() -> core::proc_macro::Span {core::proc_macro::Span::call_site})()
                    as core::proc_macro::Span)) as core::proc_macro::Ident).0 as
            {type error});
    let _punct =
        (((Punct::new as
                    fn(char, core::proc_macro::Spacing) -> core::proc_macro::Punct {core::proc_macro::Punct::new})(('+'
                    as char), (Spacing::Alone as core::proc_macro::Spacing)) as
                core::proc_macro::Punct).0 as {type error});
    let _kind =
        (core::proc_macro::bridge::LitKind::Integer as
            core::proc_macro::bridge::LitKind);
} as ())
