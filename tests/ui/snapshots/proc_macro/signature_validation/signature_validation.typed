#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

use core::proc_macro::TokenStream;

#[attr = ProcMacro]
fn wrong_argument_count()
    ->
        TokenStream ({
    ((TokenStream::new as
            fn() -> core::proc_macro::TokenStream {core::proc_macro::TokenStream::new})()
        as core::proc_macro::TokenStream)
} as core::proc_macro::TokenStream)

#[attr = ProcMacro]
fn wrong_argument_type(_input: bool)
    ->
        TokenStream ({
    ((TokenStream::new as
            fn() -> core::proc_macro::TokenStream {core::proc_macro::TokenStream::new})()
        as core::proc_macro::TokenStream)
} as core::proc_macro::TokenStream)

#[attr = ProcMacro]
fn wrong_result_type(_input: TokenStream) -> bool ({ (true as bool) } as bool)

#[attr = ProcMacroAttribute]
fn wrong_attribute_argument_count(_input: TokenStream)
    ->
        TokenStream ({
    ((TokenStream::new as
            fn() -> core::proc_macro::TokenStream {core::proc_macro::TokenStream::new})()
        as core::proc_macro::TokenStream)
} as core::proc_macro::TokenStream)
