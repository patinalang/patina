#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

use core::proc_macro::TokenStream;

#[proc_macro]
pub fn wrong_argument_count() -> TokenStream { TokenStream::new() }

#[proc_macro]
pub fn wrong_argument_type(_input: bool) -> TokenStream { TokenStream::new() }

#[proc_macro]
pub fn wrong_result_type(_input: TokenStream) -> bool { true }

#[proc_macro_attribute]
pub fn wrong_attribute_argument_count(_input: TokenStream) -> TokenStream {
    TokenStream::new()
}
