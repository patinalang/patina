#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/trait.md
// block: 1/1

struct Sheep {
    naked: bool,
    name: str,
}

trait Animal {
    // Associated function signature; `Self` refers to the implementor type.
    fn new(name: str)
    -> Self;

    // Method signatures; these will return a string.
    fn name(self)
    -> str;
    fn noise(self)
    -> str;

    // Traits can provide default method definitions.
    fn talk(self) ({
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([((patina_fmt::display as
                                        fn(term) -> term)(((self as Self).name() as str)) as term),
                                (" says " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)(((self as Self).noise() as str)) as term)]
                            as [term; 3])] as [[term; 3]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
}

impl Sheep {
    fn is_naked(self) -> bool ({ ((self as Sheep).naked as bool) } as bool)

    fn shear(self)
        ->
            Self ({
        (if ((self as Sheep).is_naked() as bool) {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([((patina_fmt::display as
                                            fn(term) -> term)(
                                        // Implementor methods can use the implementor's trait methods.
                                        ((self as Sheep).name() as str)) as term),
                                    (" is already naked..." as str)] as [term; 2])] as
                        [[term; 2]; 1])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());
            (self as Sheep)
        } else {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([((patina_fmt::display as
                                            fn(term) -> term)(((self as Sheep).name as str)) as term),
                                    (" gets a haircut!" as str)] as [term; 2])] as
                        [[term; 2]; 1])) as term);
                ((io::nl as fn() -> term)() as term);
            } as ());
            (Sheep { naked: (true as bool), ..(self as Sheep) } as Sheep)
        } as Sheep)
    } as Sheep)
}

// Implement the `Animal` trait for `Sheep`.
impl Animal for Sheep {
    // `Self` is the implementor type: `Sheep`.
    fn new(name: str)
        ->
            Sheep ({
        (Sheep { name: (name as str), naked: (false as bool) } as Sheep)
    } as Sheep)

    fn name(self) -> str ({ ((self as Sheep).name as str) } as str)

    fn noise(self)
        ->
            str ({
        (if ((self as Sheep).is_naked() as bool) {
            ("baaaaah?" as str)
        } else { ("baaaaah!" as str) } as str)
    } as str)

    // Default trait methods can be overridden.
    fn talk(self) ({
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([((patina_fmt::display as
                                        fn(term) -> term)(
                                    // For example, we can add some quiet contemplation.
                                    ((self as Sheep).name as str)) as term),
                                (" pauses briefly... " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)(((self as Sheep).noise() as str)) as
                                    term)] as [term; 3])] as [[term; 3]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
}

fn main() ({
    // Type annotation is necessary in this case.
    let dolly: Sheep =
        ((Animal::new as
                fn(str) -> Sheep {<Sheep as Animal>::new})(("Dolly" as str))
            as Sheep);
    // TODO ^ Try removing the type annotations.

    ((dolly as Sheep).talk() as ());
    ((dolly as Sheep).shear() as Sheep);
    ((dolly as Sheep).talk() as ());
} as ())
