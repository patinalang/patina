use core::prelude::*;

// source: patina-by-example/src/trait.md
// block: 1/1

struct Sheep {
    naked: bool,
    name: str,
}

trait Animal {
    // Associated function signature; `Self` refers to the implementor type.
    fn new(name: str)
    -> Self;

    // Method signatures; these will return a string.
    fn name(self)
    -> str;
    fn noise(self)
    -> str;

    // Traits can provide default method definitions.
    fn talk(self) {


        // Implementor methods can use the implementor's trait methods.

        // Implement the `Animal` trait for `Sheep`.
        // `Self` is the implementor type: `Sheep`.



        // Default trait methods can be overridden.
        // For example, we can add some quiet contemplation.

        // Type annotation is necessary in this case.
        // TODO ^ Try removing the type annotations.

        {
            ::core::io::put_chars([[::core::patina_fmt::display(self.name()),
                                " says ", ::core::patina_fmt::display(self.noise())]]);
            ::core::io::nl();
        };
    }
}
impl Sheep {
    fn is_naked(self) -> bool { self.naked }
    fn shear(self) -> Self {
        if self.is_naked() {
            {
                ::core::io::put_chars([[::core::patina_fmt::display(self.name()),
                                    " is already naked..."]]);
                ::core::io::nl();
            };
            self
        } else {
            {
                ::core::io::put_chars([[::core::patina_fmt::display(self.name),
                                    " gets a haircut!"]]);
                ::core::io::nl();
            };
            Sheep { naked: true, ..self }
        }
    }
}
impl Animal for Sheep {
    fn new(name: str) -> Sheep { Sheep { name: name, naked: false } }
    fn name(self) -> str { self.name }
    fn noise(self) -> str {
        if self.is_naked() { "baaaaah?" } else { "baaaaah!" }
    }
    fn talk(self) {
        {
            ::core::io::put_chars([[::core::patina_fmt::display(self.name),
                                " pauses briefly... ",
                                ::core::patina_fmt::display(self.noise())]]);
            ::core::io::nl();
        };
    }
}
pub fn main() {
    let dolly: Sheep = Animal::new("Dolly");
    dolly.talk();
    dolly.shear();
    dolly.talk();
}
