#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/conversion/try_from_try_into.md
// block: 1/1

use Std::Convert::TryFrom;
use Std::Convert::TryInto;

struct EvenNumber(int);

impl TryFrom<int> for EvenNumber {
    type Error = ();

    fn try_from(value: int) -> Result<Self, Self::Error> {
        if value % 2 == 0 { Ok(EvenNumber(value)) } else { Err(()) }
    }
}

pub fn main() {
    // TryFrom


    // TryInto

    match (EvenNumber::try_from(8), Ok(EvenNumber(8))) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::Core::erlang::error(::Core::Panic::new(unsafe {
                                    ::Core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
    match (EvenNumber::try_from(5), Err(())) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::Core::erlang::error(::Core::Panic::new(unsafe {
                                    ::Core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
    let result: Result<EvenNumber, ()> = 8.try_into();
    match (result, Ok(EvenNumber(8))) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::Core::erlang::error(::Core::Panic::new(unsafe {
                                    ::Core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
    let result: Result<EvenNumber, ()> = 5.try_into();
    match (result, Err(())) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::Core::erlang::error(::Core::Panic::new(unsafe {
                                    ::Core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    patina_fmt::display(""), "\n  left: ",
                                                    patina_fmt::debug(left_val), "\n right: ",
                                                    patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
}
