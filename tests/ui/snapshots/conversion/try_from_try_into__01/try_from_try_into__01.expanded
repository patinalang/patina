#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/conversion/try_from_try_into.md
// block: 1/1

use Std::Convert::TryFrom;
use Std::Convert::TryInto;

#[derive(Debug, PartialEq)]
struct EvenNumber(int);

impl TryFrom<int> for EvenNumber {
    type Error = ();

    fn try_from(value: int) -> Result<Self, Self::Error> {
        if value % 2 == 0 { Ok(EvenNumber(value)) } else { Err(()) }
    }
}

pub fn main() {
    // TryFrom

    (/*ERROR*/);
    (/*ERROR*/);

    // TryInto

    let result: Result<EvenNumber, ()> = 8.try_into();
    (/*ERROR*/);
    let result: Result<EvenNumber, ()> = 5.try_into();
    (/*ERROR*/);
}
