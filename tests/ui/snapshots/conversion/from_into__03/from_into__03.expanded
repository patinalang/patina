#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/conversion/from_into.md
// block: 3/4

use Std::Convert::Into;

struct Number {
    value: int,
}

impl Into<Number> for int {
    fn into(self) -> Number { Number { value: self } }
}

pub fn main() {
    let integer = 5;
    // Try removing the type annotation
    let num: Number = integer.into();
    { io::put_chars([["My number is ", patina_fmt::debug(num)]]); io::nl(); };
}
