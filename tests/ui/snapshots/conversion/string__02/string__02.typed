#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/conversion/string.md
// block: 2/3

fn main() ({
    let parsed: int =
        ((("5" as str).parse() as {type error}).unwrap() as {type error});
    let turbo_parsed =
        ((("10" as str).parse::<int>() as {type error}).unwrap() as
            {type error});
    let sum =
        ((parsed as {type error}) + (turbo_parsed as {type error}) as
            {type error});
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Sum: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((sum as {type error})) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
