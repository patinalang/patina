#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/conversion/string.md
// block: 2/3

pub fn main() {
    let parsed: int = "5".parse().unwrap();
    let turbo_parsed = "10".parse::<int>().unwrap();

    let sum = parsed + turbo_parsed;
    {
        ::core::io::put_chars([["Sum: ", patina_fmt::debug(sum)]]);
        ::core::io::nl();
    };
}
