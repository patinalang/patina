#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/conversion/from_into.md
// block: 2/4

use Std::Convert::From;

struct Number {
    value: int,
}

impl From<int> for Number {
    fn from(item: int) -> Self { Number { value: item } }
}

pub fn main() {
    let num = Number::from(30);
    {
        ::core::io::put_chars([["My number is ", patina_fmt::debug(num)]]);
        ::core::io::nl();
    };
}
