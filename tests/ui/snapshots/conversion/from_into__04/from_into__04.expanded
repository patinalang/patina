#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/conversion/from_into.md
// block: 4/4

use Std::Convert::From;

struct Number {
    value: int,
}

// Define `From`
impl From<int> for Number {
    fn from(item: int) -> Self { Number { value: item } }
}

pub fn main() {
    let integer = 5;
    // use `Into`
    let num: Number = integer.into();
    { io::put_chars([["My number is ", patina_fmt::debug(num)]]); io::nl(); };
}
