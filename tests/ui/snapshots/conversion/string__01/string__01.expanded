#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/conversion/string.md
// block: 1/3

use Std::Fmt;

struct Circle {
    radius: int,
}

impl Fmt::Display for Circle {
    fn fmt(self, f: Fmt::Formatter) -> Fmt::Result { (/*ERROR*/) }
}

pub fn main() {
    let circle = Circle { radius: 6 };
    { io::put_chars([[patina_fmt::display(circle.to_str())]]); io::nl(); };
}
