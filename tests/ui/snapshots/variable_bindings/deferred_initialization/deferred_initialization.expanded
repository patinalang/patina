#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn initialized_in_branches(condition: bool) -> int {
    let value;

    if condition { value = 1; } else { value = 2; }

    value
}

fn initialized_after_diverging_branch(condition: bool) -> int {
    let value;

    if condition { value = 1; return value; }

    value = 2;
    value
}

fn initialized_on_every_loop_exit(condition: bool) -> int {
    let value;

    loop { if condition { value = 1; break; } else { value = 2; break; } }

    value
}

pub fn main() {
    {
        io::put_chars([[patina_fmt::display(initialized_in_branches(true))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(initialized_after_diverging_branch(false))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(initialized_on_every_loop_exit(true))]]);
        io::nl();
    };
}
