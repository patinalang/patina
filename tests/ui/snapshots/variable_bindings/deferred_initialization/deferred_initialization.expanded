#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

fn initialized_in_branches(condition: bool) -> int {
    let value;

    if condition { value = 1; } else { value = 2; }

    value
}

fn initialized_after_diverging_branch(condition: bool) -> int {
    let value;

    if condition { value = 1; return value; }

    value = 2;
    value
}

fn initialized_on_every_loop_exit(condition: bool) -> int {
    let value;

    loop { if condition { value = 1; break; } else { value = 2; break; } }

    value
}

pub fn main() {
    {
        ::core::io::put_chars([[::core::patina_fmt::display(initialized_in_branches(true))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(initialized_after_diverging_branch(false))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(initialized_on_every_loop_exit(true))]]);
        ::core::io::nl();
    };
}
