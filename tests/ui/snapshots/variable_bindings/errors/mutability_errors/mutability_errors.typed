fn assign_to_immutable_binding() ({
    let value = (1 as int);
    (value = (2 as int) as int);
} as ())

fn assign_to_immutable_parameter(value:
        int) ({ (value = (2 as int) as int); } as ())

fn assign_to_multiple_bindings() ({
    let first = (1 as int);
    let second = (2 as int);

    (first = (3 as int) as int);
    (second = (4 as int) as int);
} as ())

fn assign_deferred_binding_twice() ({
    let value;
    (value = (1 as int) as int);
    (value = (2 as int) as int);
} as ())

fn assign_after_branches(condition:
        bool) ({
    let value;

    (if (condition as bool) {
        (value = (1 as int) as int);
    } else { (value = (2 as int) as int); } as ())

    (value = (3 as int) as int);
} as ())

fn assign_after_partial_branch(condition:
        bool) ({
    let value;

    (if (condition as bool) { (value = (1 as int) as int); } as ())
} as ())

