    field: int,
}

fn assign_to_field() ({
    let value = (Value { field: (1 as int) } as Value);
    ((/*ERROR*/) = (2 as int) as int);
} as ())

fn read_in_compound_assignment() ({
    let mut value: int;
    ((value as int) += (1 as int) as int);
} as ())

