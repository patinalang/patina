#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

pub fn main() {
    // Declare a variable binding
    let a_binding;

    {
        let x = 2;

        // Initialize the binding
        a_binding = x * x;
    }




    {
        io::put_chars([["a binding: ", patina_fmt::display(a_binding)]]);
        io::nl();
    };
    let another_binding;
    another_binding = 1;
    {
        io::put_chars([["another binding: ",
                            patina_fmt::display(another_binding)]]);
        io::nl();
    };
}
