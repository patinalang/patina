#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/variable_bindings/declare.md
// block: 1/1

fn main() ({
    // Declare a variable binding
    let a_binding;

    ({
        let x = (2 as int);

        // Initialize the binding
        ((a_binding as int) = ((x as int) * (x as int) as int) as ());
    } as ())
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("a binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                (a_binding as int)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    let another_binding;
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("another binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                // Error! Use of uninitialized binding
                                (another_binding as term)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // FIXME ^ Comment out this line

    ((another_binding as term) = (1 as int) as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("another binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                (another_binding as term)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
