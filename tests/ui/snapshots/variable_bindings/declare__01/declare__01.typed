#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/variable_bindings/declare.md
// block: 1/1

fn main() ({
    // Declare a variable binding
    let a_binding;

    ({
        let x = (2 as int);

        // Initialize the binding
        (a_binding = ((x as int) * (x as int) as int) as int);
    } as ())



    // Error! Use of uninitialized binding
    // FIXME ^ Comment out this line


    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("a binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((a_binding as int)) as term)] as [term])]
                as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    let another_binding;
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("another binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((another_binding as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    (another_binding = (1 as int) as term);
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("another binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((another_binding as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
