    };
    let another_binding;
    {
        ::core::io::put_chars([["another binding: ",
                            ::core::patina_fmt::display(another_binding)]]);
        ::core::io::nl();
    };
    another_binding = 1;
    {
        ::core::io::put_chars([["another binding: ",
                            ::core::patina_fmt::display(another_binding)]]);
        ::core::io::nl();
    };
}
