#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/variable_bindings/scope.md
// block: 2/2

pub fn main() {
    let shadowed_binding = 1;

    {
        {
            io::put_chars([["before being shadowed: ",
                                patina_fmt::display(shadowed_binding)]]);
            io::nl();
        };

        // This binding *shadows* the outer one
        let shadowed_binding = "abc";
        {
            io::put_chars([["shadowed in inner block: ",
                                patina_fmt::display(

                                    shadowed_binding)]]);
            io::nl();
        };
    }
    {
        io::put_chars([["outside inner block: ",
                            patina_fmt::display(shadowed_binding)]]);
        io::nl();
    };

    // This binding *shadows* the previous binding
    let shadowed_binding = 2;
    {
        io::put_chars([["shadowed in outer block: ",
                            patina_fmt::display(shadowed_binding)]]);
        io::nl();
    };
}
