#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/variable_bindings/scope.md
// block: 2/2

pub fn main() {
    let shadowed_binding = 1;

    {

        // This binding *shadows* the outer one


        // This binding *shadows* the previous binding
        {
            ::Core::io::put_chars([["before being shadowed: ",
                                patina_fmt::display(shadowed_binding)]]);
            ::Core::io::nl();
        };
        let shadowed_binding = "abc";
        {
            ::Core::io::put_chars([["shadowed in inner block: ",
                                patina_fmt::display(shadowed_binding)]]);
            ::Core::io::nl();
        };
    }
    {
        ::Core::io::put_chars([["outside inner block: ",
                            patina_fmt::display(shadowed_binding)]]);
        ::Core::io::nl();
    };
    let shadowed_binding = 2;
    {
        ::Core::io::put_chars([["shadowed in outer block: ",
                            patina_fmt::display(shadowed_binding)]]);
        ::Core::io::nl();
    };
}
