#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/variable_bindings/scope.md
// block: 1/2

fn main() ({
    // This binding lives in the main function
    let long_lived_binding = (1 as int);

    // This is a block, and has a smaller scope than the main function
    ({
        // This binding only exists in this block
        let short_lived_binding = (2 as int);

        // End of the block

        // Error! `short_lived_binding` doesn't exist in this scope
        // FIXME ^ Comment out this line

        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("inner short: " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((short_lived_binding as int)) as term)] as
                            [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("outer short: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((short_lived_binding as {type error})) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("outer long: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((long_lived_binding as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
