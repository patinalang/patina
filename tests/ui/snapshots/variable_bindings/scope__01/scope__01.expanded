#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/variable_bindings/scope.md
// block: 1/2

pub fn main() {
    // This binding lives in the main function
    let long_lived_binding = 1;

    // This is a block, and has a smaller scope than the main function
    {
        // This binding only exists in this block
        let short_lived_binding = 2;

        // End of the block

        // Error! `short_lived_binding` doesn't exist in this scope
        // FIXME ^ Comment out this line

        {
            ::core::io::put_chars([["inner short: ",
                                patina_fmt::display(short_lived_binding)]]);
            ::core::io::nl();
        };
    }
    {
        ::core::io::put_chars([["outer short: ",
                            patina_fmt::display(short_lived_binding)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["outer long: ",
                            patina_fmt::display(long_lived_binding)]]);
        ::core::io::nl();
    };
}
