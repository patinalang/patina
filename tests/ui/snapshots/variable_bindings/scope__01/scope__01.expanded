#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/variable_bindings/scope.md
// block: 1/2

pub fn main() {
    // This binding lives in the main function
    let long_lived_binding = 1;

    // This is a block, and has a smaller scope than the main function
    {
        // This binding only exists in this block
        let short_lived_binding = 2;
        {
            io::put_chars([["inner short: ",
                                patina_fmt::display(

                                    short_lived_binding)]]);
            io::nl();
        };
    }
    {
        io::put_chars([["outer short: ",
                            patina_fmt::display(
                                // End of the block

                                // Error! `short_lived_binding` doesn't exist in this scope
                                short_lived_binding)]]);
        io::nl();
    };
    {
        io::put_chars([["outer long: ",
                            patina_fmt::display(
                                // FIXME ^ Comment out this line

                                long_lived_binding)]]);
        io::nl();
    };
}
