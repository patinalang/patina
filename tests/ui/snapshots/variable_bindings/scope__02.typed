#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/variable_bindings/scope.md
// block: 2/2

fn main() ({
    let shadowed_binding = (1 as int);

    ({
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("before being shadowed: " as &str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((shadowed_binding as int)) as term)] as
                            [term; 2])] as [[term; 2]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());

        // This binding *shadows* the outer one
        let shadowed_binding = ("abc" as &str);
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("shadowed in inner block: " as &str),
                                ((patina_fmt::display as
                                        fn(term) -> term)(

                                    (shadowed_binding as &str)) as term)] as [term; 2])] as
                    [[term; 2]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("outside inner block: " as &str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((shadowed_binding as int)) as term)] as
                        [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // This binding *shadows* the previous binding
    let shadowed_binding = (2 as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("shadowed in outer block: " as &str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((shadowed_binding as int)) as term)] as
                        [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
