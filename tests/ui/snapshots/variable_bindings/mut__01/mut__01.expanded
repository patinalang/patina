#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/variable_bindings/mut.md
// block: 1/1

pub fn main() {
    let _immutable_binding = 1;
    let mut mutable_binding = 1;


    // Ok


    // Error! Cannot assign a new value to an immutable variable

    // Inside closures (lambda functions) and `try` blocks, `let mut` variables
    // defined in outer scopes lose their `mut` modifier
    // Error! Cannot assign a new value to a variable defined outside closure

    // You must define a new variable to modify it inside your closure
    {
        ::core::io::put_chars([["Before mutating the binding: ",
                            patina_fmt::display(mutable_binding)]]);
        ::core::io::nl();
    };
    mutable_binding += 1;
    {
        ::core::io::put_chars([["After mutating the binding: ",
                            patina_fmt::display(mutable_binding)]]);
        ::core::io::nl();
    };
    _immutable_binding += 1;
    let my_fun =
        ||
            {
                mutable_binding += 1;
                let mut inner_mutable_binding = mutable_binding;
                inner_mutable_binding += 1;
                {
                    ::core::io::put_chars([[patina_fmt::display(inner_mutable_binding),
                                        " == ", patina_fmt::display(mutable_binding), " + 1"]]);
                    ::core::io::nl();
                };
            };
}
