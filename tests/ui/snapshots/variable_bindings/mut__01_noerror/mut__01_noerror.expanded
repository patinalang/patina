#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn main() {
    let _immutable_binding = 1;
    let mut mutable_binding = 1;


    // Ok


    // Inside closures (lambda functions) and `try` blocks, `let mut` variables
    // defined in outer scopes lose their `mut` modifier
    // You must define a new variable to modify it inside your closure
    {
        ::core::io::put_chars([["Before mutating the binding: ",
                            ::core::patina_fmt::display(mutable_binding)]]);
        ::core::io::nl();
    };
    mutable_binding += 1;
    {
        ::core::io::put_chars([["After mutating the binding: ",
                            ::core::patina_fmt::display(mutable_binding)]]);
        ::core::io::nl();
    };
    let my_fun =
        ||
            {
                let mut inner_mutable_binding = mutable_binding;
                inner_mutable_binding += 1;
                {
                    ::core::io::put_chars([[::core::patina_fmt::display(inner_mutable_binding),
                                        " == ", ::core::patina_fmt::display(mutable_binding),
                                        " + 1"]]);
                    ::core::io::nl();
                };
            };
}
