#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn main() {
    let _immutable_binding = 1;
    let mut mutable_binding = 1;
    {
        io::put_chars([["Before mutating the binding: ",
                            patina_fmt::display(

                                mutable_binding)]]);
        io::nl();
    };

    // Ok
    mutable_binding += 1;
    {
        io::put_chars([["After mutating the binding: ",
                            patina_fmt::display(

                                mutable_binding)]]);
        io::nl();
    };

    // Inside closures (lambda functions) and `try` blocks, `let mut` variables
    // defined in outer scopes lose their `mut` modifier
    let my_fun =
        ||
            {
                // You must define a new variable to modify it inside your closure
                let mut inner_mutable_binding = mutable_binding;
                inner_mutable_binding += 1;
                {
                    io::put_chars([[patina_fmt::display(inner_mutable_binding),
                                        " == ", patina_fmt::display(mutable_binding), " + 1"]]);
                    io::nl();
                };
            };
}
