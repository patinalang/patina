#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn main() ({
    let _immutable_binding = (1 as int);
    let mut mutable_binding = (1 as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Before mutating the binding: " as
                                str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                (mutable_binding as int)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // Ok
    ((mutable_binding as int) += (1 as int) as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("After mutating the binding: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                (mutable_binding as int)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // Error! Cannot assign a new value to an immutable variable
    ((_immutable_binding as int) += (1 as int) as ());

    // Inside closures (lambda functions) and `try` blocks, `let mut` variables
    // defined in outer scopes lose their `mut` modifier
    let my_fun =
        (||
            ({
                // You must define a new variable to modify it inside your closure
                let mut inner_mutable_binding = (mutable_binding as int);
                ((inner_mutable_binding as int) += (1 as int) as ());
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([((patina_fmt::display as
                                                fn(term) -> term)((inner_mutable_binding as int)) as term),
                                        (" == " as str),
                                        ((patina_fmt::display as
                                                fn(term) -> term)((mutable_binding as int)) as term),
                                        (" + 1" as str)] as [term; 4])] as [[term; 4]; 1])) as
                        term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
            } as ()) as
            {closure@tests/ui/src/variable_bindings/mut__01_noerror.pt:17:18: 17:20});
} as ())
