#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn main() ({
    let _immutable_binding = (1 as int);
    let mut mutable_binding = (1 as int);


    // Ok


    // Inside closures (lambda functions) and `try` blocks, `let mut` variables
    // defined in outer scopes lose their `mut` modifier
    // You must define a new variable to modify it inside your closure
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Before mutating the binding: " as
                                str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)((mutable_binding as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ((mutable_binding as int) += (1 as int) as int);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("After mutating the binding: " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)((mutable_binding as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let my_fun =
        (||
            ({
                let mut inner_mutable_binding = (mutable_binding as int);
                ((inner_mutable_binding as int) += (1 as int) as int);
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([((::core::patina_fmt::display as
                                                fn(term) -> term)((inner_mutable_binding as int)) as term),
                                        (" == " as str),
                                        ((::core::patina_fmt::display as
                                                fn(term) -> term)((mutable_binding as int)) as term),
                                        (" + 1" as str)] as [term])] as [[term]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
            } as ()) as
            {closure@tests/ui/src/variable_bindings/mut__01_noerror.pt:14:18: 14:20});
} as ())
