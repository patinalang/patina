#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/variable_bindings.md
// block: 1/1

pub fn main() {
    let an_integer = 1;
    let a_boolean = true;
    let unit = ();

    // copy `an_integer` into `copied_integer`
    let copied_integer = an_integer;
    {
        io::put_chars([["An integer: ",
                            patina_fmt::debug(

                                copied_integer)]]);
        io::nl();
    };
    {
        io::put_chars([["A boolean: ", patina_fmt::debug(a_boolean)]]);
        io::nl();
    };
    {
        io::put_chars([["Meet the unit value: ", patina_fmt::debug(unit)]]);
        io::nl();
    };

    // The compiler warns about unused variable bindings; these warnings can
    // be silenced by prefixing the variable name with an underscore
    let _unused_variable = 3;

    let noisy_unused_variable = 2;
    // FIXME ^ Prefix with an underscore to suppress the warning
}
