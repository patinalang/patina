#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/variable_bindings.md
// block: 1/1

pub fn main() {
    let an_integer = 1;
    let a_boolean = true;
    let unit = ();

    // copy `an_integer` into `copied_integer`
    let copied_integer = an_integer;


    // The compiler warns about unused variable bindings; these warnings can
    // be silenced by prefixing the variable name with an underscore

    // FIXME ^ Prefix with an underscore to suppress the warning
    {
        ::Core::io::put_chars([["An integer: ",
                            patina_fmt::debug(copied_integer)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["A boolean: ",
                            patina_fmt::debug(a_boolean)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["Meet the unit value: ",
                            patina_fmt::debug(unit)]]);
        ::Core::io::nl();
    };
    let _unused_variable = 3;
    let noisy_unused_variable = 2;
}
