#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros.md
// block: 1/1

// This is a simple macro named `say_hello`.
macro_rules! say_hello {
    () =>
    {
        println!("Hello!")
        // `()` indicates that the macro takes no argument.
        // The macro will expand into the contents of this block.
    };
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Hello!" as str)] as [str; 1])] as
                [[str; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ())
    // This call will expand into `println!("Hello!")`
} as ())
