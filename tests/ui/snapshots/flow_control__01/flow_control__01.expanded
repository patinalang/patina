pub fn main() {
    // only `mut` bindings can be rebound
    let mut n = 5;

    if n > 4 { n = 4; }

    // 4
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(n)]]);
        ::core::io::nl();
    };
}
