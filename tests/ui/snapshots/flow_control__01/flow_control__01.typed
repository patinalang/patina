#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/flow_control.md
// block: 1/1

fn main() ({
    // only `mut` bindings can be rebound
    let mut n = (5 as int);

    (if ((n as int) > (4 as int) as bool) { (n = (4 as int) as int); } as ())

    // 4
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)((n as int)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
