#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/flow_control.md
// block: 1/1

fn main() ({
    // only `mut` bindings can be rebound
    let mut n = (5 as int);

    (if ((n as int) > (4 as int) as bool) {
        ((n as int) = (4 as int) as int);
    } as ())

    // 4
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((n as int)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
