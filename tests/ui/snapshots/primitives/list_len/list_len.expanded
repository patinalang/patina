#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn main() {
    let xs: [int] = [1, 2, 3];
    {
        ::core::io::put_chars([[::core::patina_fmt::display(xs.len())]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(<[int]>::len([1,
                                            2]))]]);
        ::core::io::nl();
    };
}
