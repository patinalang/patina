#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

fn lookup_name(map: #{str => int})
    ->
        int ({
    (match (map as #{str => int}) {
        #{"name" => name, ..} => (name as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn lookup_name_in_term_keyed_map(map: #{term => int})
    ->
        int ({
    (match (map as #{term => int}) {
        #{"name" => name, ..} => (name as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn nested_lookup(map: #{str => #{str => int}})
    ->
        int ({
    (match (map as #{str => #{str => int}}) {
        #{"outer" => #{"inner" => value, ..}, ..} => (value as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn is_map(map: #{str => int})
    ->
        bool ({
    (match (map as #{str => int}) { #{..} => (true as bool), } as bool)
} as bool)
