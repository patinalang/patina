#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn lookup_name(map: #{str => int})
    ->
        int ({
    (match (map as #{str => int}) {
        #{"name" => name, ..} => (name as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn lookup_name_in_term_keyed_map(map: #{term => int})
    ->
        int ({
    (match (map as #{term => int}) {
        #{"name" => name, ..} => (name as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn nested_lookup(map: #{str => #{str => int}})
    ->
        int ({
    (match (map as #{str => #{str => int}}) {
        #{"outer" => #{"inner" => value, ..}, ..} => (value as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn is_map(map: #{str => int})
    ->
        bool ({
    (match (map as #{str => int}) { #{..} => (true as bool), } as bool)
} as bool)
