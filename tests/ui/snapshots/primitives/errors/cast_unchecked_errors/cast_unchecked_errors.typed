#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn without_unsafe(value: term)
    -> int ({ ((value as term).cast_unchecked() as int) } as int)

fn uninferred(value:
        term) ({
    let _ =
        (unsafe { ((value as term).cast_unchecked() as {type error}) } as
            {type error});
} as ())
