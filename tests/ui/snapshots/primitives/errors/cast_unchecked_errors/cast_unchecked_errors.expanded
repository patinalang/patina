#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn without_unsafe(value: term) -> int { value.cast_unchecked() }

pub fn uninferred(value: term) { let _ = unsafe { value.cast_unchecked() }; }
