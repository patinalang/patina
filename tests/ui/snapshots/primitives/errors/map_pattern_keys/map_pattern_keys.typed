#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

const NAME_KEY: str = ("name" as str);

fn length(s: str) -> int ({ (0 as int) } as int)

fn unpinned_local(map: #{str => int}, key: str)
    ->
        int ({
    (match (map as #{str => int}) {
        #{((/*ERROR*/) as {type error}) => value, ..} => (value as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

fn nested_local(map: #{(int, str) => int}, key: str)
    ->
        int ({
    (match (map as #{(int, str) => int}) {
        #{((/*ERROR*/) as {type error}) => value, ..} => (value as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)

