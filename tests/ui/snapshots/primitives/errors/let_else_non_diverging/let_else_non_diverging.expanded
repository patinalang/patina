#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn main() {
    let [first, ..] = [1] else {};
    {
        ::core::io::put_chars([[::core::patina_fmt::display(first)]]);
        ::core::io::nl();
    };
}
