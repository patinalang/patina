#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// Whether `Some` wraps its value depends on the value, so it isn't an Erlang guard expression.
pub fn generic_option_key<T>(map: #{Option<T> => int}, value: T) -> int {
    match map { #{Some(^value) => found, ..} => found, _ => -1, }
}
