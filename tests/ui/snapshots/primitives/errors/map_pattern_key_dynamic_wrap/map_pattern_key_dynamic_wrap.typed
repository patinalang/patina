#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// Whether `Some` wraps its value depends on the value, so it isn't an Erlang guard expression.
fn generic_option_key<T>(map: #{Option<T> => int}, value: T)
    ->
        int ({
    (match (map as #{core::Option<T> => int}) {
        #{((Some as
                    fn(T) -> core::Option<T> {core::Option::<T>::Some})((value
                    as T)) as core::Option<T>) => found, ..} => (found as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)
