#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

const NAME_KEY: str = ("name" as str);

const MAP: #{str => int} =
    (#{(NAME_KEY as str) => (1 as int)} as #{str => int});

fn const_map_pattern(map: #{str => int})
    ->
        bool ({
    (match (map as #{str => int}) {
        MAP => (true as bool),
        _ => (false as bool),
    } as bool)
} as bool)
