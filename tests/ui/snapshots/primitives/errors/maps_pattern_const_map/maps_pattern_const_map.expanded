#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

const NAME_KEY: str = "name";

const MAP: #{str => int} = #{NAME_KEY => 1};

pub fn const_map_pattern(map: #{str => int}) -> bool {
    match map { MAP => true, _ => false, }
}
