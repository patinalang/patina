#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn bad_base(base: int)
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ..(base as int)} as #{str => int})
} as #{str => int})

#[allow(unreachable_code)]
fn diverging_base(base: #{str => int})
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ..(return (base as #{str => int}) as !)} as
        #{str => int})
} as #{str => int})

fn bad_keys()
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), (2 as int) => (3 as int)} as
        #{{type error} => int})
} as {type error})

fn bad_values()
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ("b" as str) => ("x" as str)} as
        #{str => {type error}})
} as {type error})

fn functional_update(map: #{str => int},
    rest:
        #{str => int}) ({ ({ let #{..} = (map as #{str => int}); } as ()); }
    as ())

fn destructuring_missing_rest(map:
        #{str => int}) ({ ({ let #{..} = (map as #{str => int}); } as ()); }
    as ())

fn computed_key(map: #{int => int})
    ->
        int ({
    (match (map as #{int => int}) {
        #{<bad-literal> => value, ..} => (value as int),
        _ => (0 as int),
    } as int)
} as int)

fn unconstrained() ({ let value = (#{} as {type error}); } as ())
