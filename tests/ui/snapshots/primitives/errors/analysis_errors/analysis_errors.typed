#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn bad_base(base: int)
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ..(base as int)} as #{str => int})
} as #{str => int})

#[allow(unreachable_code)]
fn diverging_base(base: #{str => int})
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ..(return (base as #{str => int}) as !)} as
        #{str => int})
} as #{str => int})

fn bad_keys()
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), (2 as int) => (3 as int)} as
        #{{type error} => int})
} as {type error})

fn bad_values()
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ("b" as str) => ("x" as str)} as
        #{str => {type error}})
} as {type error})

fn functional_update(map: #{str => int},
    rest:
        #{str => int}) ({ (#{..} = (map as #{str => int}) as #{str => int}); }
    as ())

fn destructuring_missing_rest(map:
        #{str => int}) ({ (#{..} = (map as #{str => int}) as #{str => int}); }
    as ())

fn computed_key(map: #{int => int})
    ->
        int ({
    (match (map as #{int => int}) {
        #{((/*ERROR*/) as {type error}) => value, ..} => (value as int),
        _ => (0 as int),
    } as int)
} as int)

fn unconstrained() ({ let value = (#{} as {type error}); } as ())
