#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn bad_base(base: int) -> #{str => int} { #{"a" => 1, ..base} }

#[allow(unreachable_code)]
pub fn diverging_base(base: #{str => int}) -> #{str => int} {
    #{"a" => 1, ..return base}
}

pub fn bad_keys() -> #{str => int} { #{"a" => 1, 2 => 3} }

pub fn bad_values() -> #{str => int} { #{"a" => 1, "b" => "x"} }

pub fn functional_update(map: #{str => int}, rest: #{str => int}) {
    #{..rest} = map;
}

pub fn destructuring_missing_rest(map: #{str => int}) { #{} = map; }

pub fn computed_key(map: #{int => int}) -> int {
    match map { #{1 + 1 => value, ..} => value, _ => 0, }
}

pub fn unconstrained() { let value = #{}; }
