#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

struct Point {
    x: int,
    y: int,
}

// A native record isn't constructed with an Erlang guard expression.
fn record_key(map: #{Point => int})
    ->
        int ({
    (match (map as #{Point => int}) {
        #{(Point { x: (1 as int), y: (2 as int) } as Point) => value, ..} =>
            (value as int),
        _ => (-(1 as int) as int),
    } as int)
} as int)
