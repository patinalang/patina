pub fn base_trailing_comma(base: #{str => int}) -> #{str => int} { #{..base} }

pub fn ellipsis_base(base: #{str => int}) -> #{str => int} { #{..base} }

pub fn entry_after_rest(base: #{str => int}) -> #{str => int} {
    #{"a" => 1, ..base}
}

pub fn entry_after_rest_without_comma(base: #{str => int}) -> #{str => int} {
    #{..base}
}

pub fn pattern_entry_after_rest(map: #{str => int}) -> int {
    match map {
        #{"b" => value, ../* recovered parse error */} => value,
        _ => 0,
    }
}

pub fn invalid_base() -> #{str => int} { #{} }

pub fn colon_separator() -> #{str => int} { #{"a" => 1} }

pub fn equals_separator() -> #{str => int} { #{"a" => 1} }

pub fn arrow_separator() -> #{str => int} { #{"a" => 1} }

pub fn missing_arrow() -> #{str => int} { #{"a" => 1} }

pub fn missing_arrow_with_base(base: #{str => int}) -> #{str => int} {
    #{"a" => 1, ..base}
}

pub fn nonempty_pattern_missing_rest(map: #{str => int}) -> int {
    match map {
        #{"name" => value, ../* recovered parse error */} => value,
        _ => 0,
    }
}

pub fn empty_pattern_missing_rest(map: #{str => int}) -> bool {
    match map { #{../* recovered parse error */} => true, _ => false, }
}

pub fn rest_binding(map: #{str => int}) -> int {
    match map {
        #{"name" => value, ../* recovered parse error */} => value,
        _ => 0,
    }
}

pub fn pattern_ellipsis(map: #{str => int}) -> bool {
    match map { #{..} => true, _ => false, }
}

pub fn pattern_underscore(map: #{str => int}) -> bool {
    match map { #{..} => true, _ => false, }
}

pub fn repeated_rest(a: #{str => int}, b: #{str => int}) -> #{str => int} {
    #{..a}
}

pub fn repeated_bare_rest() -> #{str => int} { #{} }

pub fn repeated_pattern_rest(map: #{str => int}) -> bool {
    match map { #{../* recovered parse error */} => true, _ => false, }
}

pub fn destructuring_rest_trailing_comma(map: #{str => int}) { #{} = map; }

pub fn pattern_rest_trailing_comma(map: #{str => int}) -> bool {
    match map { #{../* recovered parse error */} => true, _ => false, }
}
