#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

fn one() -> int { 1 }

pub struct Num(int);

impl Num {
    fn get(self) -> int { self.0 }
}

const CALL: int = one();
const METHOD_CALL: int = Num(1).get();
const FN_REFERENCE: fnref() -> int = one;
const CLOSURE: fn() -> int = || 1;
const CALL_IN_SEGMENT_SIZE: bits = <<1: int(size = one())>>;

const TUPLE_STRUCT_VALUE: Num = Num(1);

impl Num {
    const CALL: int = one();
}

pub trait Konst {
    const K: int;
}

impl Konst for Num {
    const K: int = one();
}

pub fn values()
    -> (int, int, fnref() -> int, fn() -> int, bits, Num, int, int) {
    (CALL, METHOD_CALL, FN_REFERENCE, CLOSURE, CALL_IN_SEGMENT_SIZE,
        TUPLE_STRUCT_VALUE, Num::CALL, Num::K)
}

// A range pattern (currently) needs the values of its endpoints, which only a literal constant has.
const LIMIT: int = { let limit = 10; limit };

pub fn below_limit(n: int) -> bool {
    match n { 0..LIMIT => true, _ => false, }
}
