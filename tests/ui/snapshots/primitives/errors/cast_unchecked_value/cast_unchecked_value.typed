#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn as_value(value: term)
    ->
        int ({
    let cast =
        (term::cast_unchecked::<int> as
            unsafe fn(term) -> int {core::<impl term>::cast_unchecked::<int>});
    (unsafe {
        ((cast as
                unsafe fn(term) -> int {core::<impl term>::cast_unchecked::<int>})((value
                as term)) as int)
    } as int)
} as int)
