#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

pub fn as_value(value: term) -> int {
    let cast = term::cast_unchecked::<int>;
    unsafe { cast(value) }
}
