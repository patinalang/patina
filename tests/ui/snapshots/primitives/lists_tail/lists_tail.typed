#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

fn prepend(xs: [int])
    ->
        [int] ({
    ([(-(1 as int) as int), (0 as int), ..(xs as [int])] as [int])
} as [int])

fn match_tail(xs: [int])
    ->
        [int] ({
    let more_xs =
        ([(-(1 as int) as int), (0 as int), ..(xs as [int])] as [int]);
    (match (more_xs as [int]) {
        [-1, 0, tail@_..] => (tail as [int]),
        _ => ([] as [int]),
    } as [int])
} as [int])

fn let_else_tail(xs: [int])
    ->
        [int] ({
    let more_xs =
        ([(-(1 as int) as int), (0 as int), ..(xs as [int])] as [int]);
    let [-1, 0, tail@_..] = (more_xs as [int]) else
        { (return ([] as [int]) as !); };
    (tail as [int])
} as [int])
