#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

pub fn prepend(xs: [int]) -> [int] { [-1, 0, ..xs] }

pub fn match_tail(xs: [int]) -> [int] {
    let more_xs = [-1, 0, ..xs];
    match more_xs { [-1, 0, tail @ ..] => tail, _ => [], }
}

pub fn let_else_tail(xs: [int]) -> [int] {
    let more_xs = [-1, 0, ..xs];
    let [-1, 0, tail @ ..] = more_xs else { return []; };
    tail
}
