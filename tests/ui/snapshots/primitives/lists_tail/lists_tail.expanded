#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn prepend(xs: [int]) -> [int] { [-1, 0, ..xs] }

pub fn match_tail(xs: [int]) -> [int] {
    let more_xs = [-1, 0, ..xs];
    match more_xs { [-1, 0, tail @ ..] => tail, _ => [], }
}

pub fn let_else_tail(xs: [int]) -> [int] {
    let more_xs = [-1, 0, ..xs];
    let [-1, 0, tail @ ..] = more_xs else { return []; };
    tail
}
