#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

const NAME_KEY: str = "name";

const MAP: #{str => int} = #{NAME_KEY => 1};

pub fn const_key(map: #{str => int}) -> int {
    match map { #{NAME_KEY => value, ..} => value, _ => 0, }
}

pub fn named_const(map: #{str => int}) -> #{str => int} {
    match map { #{NAME_KEY => value, ..} => #{"hi" => value}, _ => MAP, }
}
