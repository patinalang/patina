#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

const NAME_KEY: str = ("name" as str);

const MAP: #{str => int} =
    (#{(NAME_KEY as str) => (1 as int)} as #{str => int});

fn const_key(map: #{str => int})
    ->
        int ({
    (match (map as #{str => int}) {
        #{(NAME_KEY as str) => value, ..} => (value as int),
        _ => (0 as int),
    } as int)
} as int)

fn named_const(map: #{str => int})
    ->
        #{str => int} ({
    (match (map as #{str => int}) {
        #{(NAME_KEY as str) => value, ..} =>
            (#{("hi" as str) => (value as int)} as #{str => int}),
        _ => (MAP as #{str => int}),
    } as #{str => int})
} as #{str => int})
