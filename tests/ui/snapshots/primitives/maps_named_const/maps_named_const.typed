#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

const NAME_KEY: str = ("name" as str);

const MAP: #{str => int} =
    (#{(NAME_KEY as str) => (1 as int)} as #{str => int});

fn const_key(map: #{str => int})
    ->
        int ({
    (match (map as #{str => int}) {
        #{NAME_KEY => value, ..} => (value as int),
        _ => (0 as int),
    } as int)
} as int)

fn named_const(map: #{str => int})
    ->
        #{str => int} ({
    (match (map as #{str => int}) {
        #{NAME_KEY => value, ..} =>
            (#{("hi" as str) => (value as int)} as #{str => int}),
        _ => (MAP as #{str => int}),
    } as #{str => int})
} as #{str => int})
