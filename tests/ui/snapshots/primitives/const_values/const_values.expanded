#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

const KEY: str = "answer";
const NUMBERS: [int] = [1, 2, 3];
const PAIR: ([int], #{str => int}) = (NUMBERS, #{KEY => 42});
const ALIAS: ([int], #{str => int}) = PAIR;

pub fn const_values() -> ([int], #{str => int}) { ALIAS }

const VERSION: int = 2;
const HEADER: bin =
    <<b"PT", VERSION: int(size = 16), 'ł': char(utf16), 1.5:
            float(size = 32)>>;
const FLAGS: bits = <<1: int(size = 1), 0: int(size = 2)>>;

pub fn binary_pattern_values() -> (bin, [bits]) {
    (HEADER, [FLAGS, <<1: int(size = 3)>>])
}
