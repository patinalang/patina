#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

const KEY: str = ("answer" as str);
const NUMBERS: [int] = ([(1 as int), (2 as int), (3 as int)] as [int]);
const PAIR: ([int], #{str => int}) =
    (((NUMBERS as [int]), (#{(KEY as str) => (42 as int)} as #{str => int}))
        as ([int], #{str => int}));
const ALIAS: ([int], #{str => int}) = (PAIR as ([int], #{str => int}));

fn const_values()
    ->
        ([int],
        #{str => int}) ({ (ALIAS as ([int], #{str => int})) } as
    ([int], #{str => int}))

const VERSION: int = (2 as int);
const HEADER: bin =
    (<<(b"PT" as bin), (VERSION as int): int(size = (16 as int)),
            ('\u{142}' as char): char(utf16), (1.5 as float):
            float(size = (32 as int))>> as bin);
const FLAGS: bits =
    (<<(1 as int): int(size = (1 as int)), (0 as int):
            int(size = (2 as int))>> as bits);

fn binary_pattern_values()
    ->
        (bin,
        [bits]) ({
    (((HEADER as bin),
        ([(FLAGS as bits), (<<(1 as int): int(size = (3 as int))>> as bits)]
            as [bits])) as (bin, [bits]))
} as (bin, [bits]))
