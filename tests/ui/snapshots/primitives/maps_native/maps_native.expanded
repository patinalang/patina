#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn create() -> #{str => int} { #{"a" => 1, "b" => 2} }

pub fn empty() -> #{str => int} { #{} }

pub fn param_and_return(map: #{str => int}) -> #{str => int} { map }

fn erase_map_type(map: #{str => int}) -> term { map }

pub fn infer_empty_by_usage() -> term { let map = #{}; erase_map_type(map) }

pub fn infer_from_base(base: #{str => int}) -> term { #{..base} }

pub fn update(base: #{str => int}) -> #{str => int} {
    #{"a" => 10, "c" => 3, ..base}
}

pub fn update_identity(base: #{str => int}) -> #{str => int} { #{..base} }

pub fn duplicate() -> #{str => int} { #{"a" => 1, "a" => 2} }
