#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn create()
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ("b" as str) => (2 as int)} as
        #{str => int})
} as #{str => int})

fn empty() -> #{str => int} ({ (#{} as #{str => int}) } as #{str => int})

fn param_and_return(map: #{str => int})
    -> #{str => int} ({ (map as #{str => int}) } as #{str => int})

fn erase_map_type(map: #{str => int})
    -> term ({ (map as #{str => int}) } as term)

fn infer_empty_by_usage()
    ->
        term ({
    let map = (#{} as #{str => int});
    ((erase_map_type as
            fn(#{str => int}) -> term {erase_map_type})((map as
            #{str => int})) as term)
} as term)

fn infer_from_base(base: #{str => int})
    -> term ({ (#{..(base as #{str => int})} as #{str => int}) } as term)

fn update(base: #{str => int})
    ->
        #{str => int} ({
    (#{("a" as str) => (10 as int), ("c" as str) => (3 as int),
            ..(base as #{str => int})} as #{str => int})
} as #{str => int})

fn update_identity(base: #{str => int})
    ->
        #{str => int} ({ (#{..(base as #{str => int})} as #{str => int}) } as
    #{str => int})

fn duplicate()
    ->
        #{str => int} ({
    (#{("a" as str) => (1 as int), ("a" as str) => (2 as int)} as
        #{str => int})
} as #{str => int})
