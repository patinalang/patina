#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/primitives/lists.md
// block: 1/1

pub fn main() {
    // List (type signature is superfluous).
    let xs: [int] = [1, 2, 3, 4, 5];

    // Indexing starts at 0.
    // `.get(n)` can be used to traverse to and return the nth element of the list
    // as an `Option`.
    match xs.get(0) {
        Some(xval) =>
            // `count` returns the count of elements in the list.
            // Internally, it does that by traversing the list and counting all elements,
            // and this behaviour is why it has a different name than the usual `len()`.

            // The head and tail of a list can be retrieved with `head` and `tail`
            // `head` is an `Option`, and is None for empty lists; `tail` always succeeds.

            // Lists can be prepended in constant time using the following syntax:
            // This creates a new list, but the tail is not duplicated - `xs`
            // and `more_xs.tail().tail()` are internally the same VM object.

            // Lists can also be destructured using a similar syntax
            {
            ::core::io::put_chars([["elem 0: ",
                                ::core::patina_fmt::display(xval)]]);
            ::core::io::nl();
        }
        None => {
            ::core::io::put_chars([["the list is empty!"]]);
            ::core::io::nl();
        }
    }
    {
        ::core::io::put_chars([["Number of elements in array: ",
                            ::core::patina_fmt::display(xs.count())]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["First element of the list: ",
                            ::core::patina_fmt::display(xs.head())]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["Rest of the list: ",
                            ::core::patina_fmt::debug(xs.tail())]]);
        ::core::io::nl();
    };
    let more_xs = [-1, 0, ..xs];
    {
        ::core::io::put_chars([["more_xs.tail().tail() is equal to xs: ",
                            ::core::patina_fmt::display(more_xs.tail().tail() == xs)]]);
        ::core::io::nl();
    };
    let [first, second, third, rest @ ..] = more_xs else { return };
    {
        ::core::io::put_chars([["Sum of first three elements is ",
                            ::core::patina_fmt::display(first + second + third)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["...and the rest: ",
                            ::core::patina_fmt::debug(rest)]]);
        ::core::io::nl();
    };
}
