#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/primitives/lists.md
// block: 1/1

fn main() ({
    // List (type signature is superfluous).
    let xs: [int] =
        ([(1 as int), (2 as int), (3 as int), (4 as int), (5 as int)] as
            [int]);
    // Indexing starts at 0.
    // `.get(n)` can be used to traverse to and return the nth element of the list
    // as an `Option`.
    (match ((xs as [int]).get((0 as int)) as core::option::Option<int>) {
        Some(xval) =>
            // `len` returns the count of elements in the list.
            // Internally, it does that by traversing the list and counting all elements.

            // The head and tail of a list can be retrieved with `head` and `tail`
            // `head` is an `Option`, and is None for empty lists; `tail` always succeeds.

            // Lists can be prepended in constant time using the following syntax:
            // This creates a new list, but the tail is not duplicated - `xs`
            // and `more_xs.tail().tail()` are internally the same VM object.

            // Lists can also be destructured using a similar syntax
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("elem 0: " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((xval as int)) as term)] as [term])] as
                    [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        None => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("the list is empty!" as str)] as
                            [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Number of elements in array: " as
                                str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((xs as [int]).len() as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("First element of the list: " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((xs as [int]).head() as
                                    core::option::Option<int>)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Rest of the list: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)(((xs as [int]).tail() as [int])) as term)]
                        as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let more_xs =
        ([(-(1 as int) as int), (0 as int), ..(xs as [int])] as [int]);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("more_xs.tail().tail() is equal to xs: "
                                as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((((more_xs as [int]).tail() as
                                            [int]).tail() as [int]) == (xs as [int]) as bool)) as term)]
                        as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let [first, second, third, rest@_..] = (more_xs as [int]) else
        { (return as !) };
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Sum of first three elements is " as
                                str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)((((first as int) + (second as int) as int)
                                    + (third as int) as int)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("...and the rest: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((rest as [int])) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
