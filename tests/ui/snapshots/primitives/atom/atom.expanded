#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

const NAMED: atom = a"named";

pub fn annotated() -> atom { let value: atom = a"hello"; value }

pub fn named() -> atom { NAMED }

pub fn escaped() -> atom { a"line\nbreak" }

pub fn raw() -> atom { ar#"no \escapes"# }

pub fn unicode() -> atom { a"zażółć" }

pub fn equal(left: atom, right: atom) -> bool { left == right }

pub fn less_than(left: atom, right: atom) -> bool { left < right }

pub fn classify(value: atom) -> atom {
    match value {
        a"hello" => a"greeting",
        a"goodbye" => a"farewell",
        _ => a"unknown",
    }
}
