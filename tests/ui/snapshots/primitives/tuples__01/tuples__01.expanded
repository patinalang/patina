#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/primitives/tuples.md
// block: 1/1

// Tuples can be used as function arguments and as return values.
fn reverse(pair: (int, bool)) -> (bool, int) {
    // `let` can be used to bind the members of a tuple to variables.
    let (int_param, bool_param) = pair;

    (bool_param, int_param)
}

// The following struct is for the activity.
#[derive(Debug)]
struct Matrix(float, float, float, float);

pub fn main() {
    // A tuple with a bunch of different types.
    let long_tuple = (1, 0.1, 'a', true, "hello", b"world");
    {
        io::put_chars([["Long tuple first value: ",
                            patina_fmt::display(

                                // Values can be extracted from the tuple using tuple indexing.
                                long_tuple.0)]]);
        io::nl();
    };
    {
        io::put_chars([["Long tuple second value: ",
                            patina_fmt::display(long_tuple.1)]]);
        io::nl();
    };

    // Tuples can be tuple members.
    let tuple_of_tuples = ((1, 2, 3), (4.0, -1), -2);
    {
        io::put_chars([["tuple of tuples: ",
                            patina_fmt::debug(

                                // Tuples are printable.
                                tuple_of_tuples)]]);
        io::nl();
    };

    let pair = (1, true);
    { io::put_chars([["Pair is ", patina_fmt::debug(pair)]]); io::nl(); };
    {
        io::put_chars([["The reversed pair is ",
                            patina_fmt::debug(

                                reverse(pair))]]);
        io::nl();
    };
    {
        io::put_chars([["One element tuple: ",
                            patina_fmt::debug(

                                // To create one element tuples, the comma is required to tell them apart
                                // from a literal surrounded by parentheses.
                                (5,))]]);
        io::nl();
    };
    {
        io::put_chars([["Just an integer: ", patina_fmt::debug((5))]]);
        io::nl();
    };

    // Tuples can be destructured to create bindings.
    let tuple = (1, "hello", 4.5, true);

    let (a, b, c, d) = tuple;
    {
        io::put_chars([[patina_fmt::debug(a), ", ", patina_fmt::debug(b),
                            ", ", patina_fmt::debug(c), ", ", patina_fmt::debug(d)]]);
        io::nl();
    };

    let matrix = Matrix(1.1, 1.2, 2.1, 2.2);
    { io::put_chars([[patina_fmt::debug(matrix)]]); io::nl(); };
}
