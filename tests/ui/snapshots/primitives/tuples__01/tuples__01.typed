// Tuples can be used as function arguments and as return values.
fn reverse(pair: (int, bool))
    ->
        (bool,
        int) ({
    // `let` can be used to bind the members of a tuple to variables.
    let (int_param, bool_param) = (pair as (int, bool));

    (((bool_param as bool), (int_param as int)) as (bool, int))
} as (bool, int))

// The following struct is for the activity.
struct Matrix(float, float, float, float);

fn main() ({
    // A tuple with a bunch of different types.
    let long_tuple =
        (((1 as int), (0.1 as float), ('a' as char), (true as bool),
            ("hello" as str), (b"world" as bin)) as
            (int, float, char, bool, str, bin));
    // Values can be extracted from the tuple using tuple indexing.

    // Tuples can be tuple members.

    // Tuples are printable.



    // To create one element tuples, the comma is required to tell them apart
    // from a literal surrounded by parentheses.

    // Tuples can be destructured to create bindings.


    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Long tuple first value: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((long_tuple as
                                        (int, float, char, bool, str, bin)).0 as int)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Long tuple second value: " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(((long_tuple as
                                        (int, float, char, bool, str, bin)).1 as float)) as term)]
                        as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let tuple_of_tuples =
        (((((1 as int), (2 as int), (3 as int)) as (int, int, int)),
            (((4.0 as float), (-(1 as int) as int)) as (float, int)),
            (-(2 as int) as int)) as ((int, int, int), (float, int), int));
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("tuple of tuples: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((tuple_of_tuples as
                                    ((int, int, int), (float, int), int))) as term)] as [term])]
                as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let pair = (((1 as int), (true as bool)) as (int, bool));
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Pair is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((pair as (int, bool))) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("The reversed pair is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(((reverse as
                                        fn((int, bool)) -> (bool, int) {reverse})((pair as
                                        (int, bool))) as (bool, int))) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("One element tuple: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((((5 as int),) as (int,))) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("Just an integer: " as str),
                            ((patina_fmt::debug as fn(term) -> term)((5 as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let tuple =
        (((1 as int), ("hello" as str), (4.5 as float), (true as bool)) as
            (int, str, float, bool));
    let (a, b, c, d) = (tuple as (int, str, float, bool));
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((a as int)) as term), (", " as str),
                            ((patina_fmt::debug as fn(term) -> term)((b as str)) as
                                term), (", " as str),
                            ((patina_fmt::debug as fn(term) -> term)((c as float)) as
                                term), (", " as str),
                            ((patina_fmt::debug as fn(term) -> term)((d as bool)) as
                                term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    let matrix =
        ((Matrix as
                fn(float, float, float, float) -> Matrix {Matrix})((1.1 as
                float), (1.2 as float), (2.1 as float), (2.2 as float)) as
            Matrix);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((matrix as Matrix)) as term)] as [term])]
                as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
