#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// Operators.

fn equal(left: term, right: term)
    -> bool ({ ((left as term) == (right as term) as bool) } as bool)

fn not_equal(left: term, right: term)
    -> bool ({ ((left as term) != (right as term) as bool) } as bool)

fn generic_equal<T>(left: T, right: T) -> bool where
    T: PartialEq ({ ((left as T) == (right as T) as bool) } as bool)

fn partial_eq_equal(left: term, right: term)
    ->
        bool ({
    ((generic_equal as
            fn(term, term) -> bool {generic_equal::<term>})((left as term),
        (right as term)) as bool)
} as bool)
