#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// Operators.

pub fn equal(left: term, right: term) -> bool { left == right }

pub fn not_equal(left: term, right: term) -> bool { left != right }

fn generic_equal<T: PartialEq>(left: T, right: T) -> bool { left == right }

pub fn partial_eq_equal(left: term, right: term) -> bool {
    generic_equal(left, right)
}
