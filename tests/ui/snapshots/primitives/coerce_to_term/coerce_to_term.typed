#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

fn coerce(base: int) -> term ({ (base as int) } as term)

fn coerce_map_value(base: #{str => int})
    -> #{str => term} ({ (base as #{str => int}) } as #{str => term})

fn coerce_map_key(base: #{int => str})
    -> #{term => str} ({ (base as #{int => str}) } as #{term => str})

fn update_map(base: #{str => int})
    ->
        #{str => term} ({
    (#{("enabled" as str) => (true as bool), ..(base as #{str => int})} as
        #{str => term})
} as #{str => term})

fn coerce_slice(values: [int]) -> [term] ({ (values as [int]) } as [term])

fn coerce_tuple(value: (int, bool))
    -> (term, term) ({ (value as (int, bool)) } as (term, term))

fn coerce_nested_map(base: #{str => #{str => int}})
    ->
        #{str => #{str => term}} ({ (base as #{str => #{str => int}}) } as
    #{str => #{str => term}})
