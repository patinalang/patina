#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

fn coerce(base: int) -> term ({ (base as int) } as term)

fn coerce_map_value(base: #{str => int})
    -> #{str => term} ({ (base as #{str => int}) } as #{str => term})

fn coerce_map_key(base: #{int => str})
    -> #{term => str} ({ (base as #{int => str}) } as #{term => str})

fn update_map(base: #{str => int})
    ->
        #{str => term} ({
    (#{("enabled" as str) => (true as bool), ..(base as #{str => int})} as
        #{str => term})
} as #{str => term})

fn coerce_slice(values: [int]) -> [term] ({ (values as [int]) } as [term])

fn coerce_tuple(value: (int, bool))
    -> (term, term) ({ (value as (int, bool)) } as (term, term))

fn coerce_nested_map(base: #{str => #{str => int}})
    ->
        #{str => #{str => term}} ({ (base as #{str => #{str => int}}) } as
    #{str => #{str => term}})
