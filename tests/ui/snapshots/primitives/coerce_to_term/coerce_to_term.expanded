#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn coerce(base: int) -> term { base }

pub fn coerce_map_value(base: #{str => int}) -> #{str => term} { base }

pub fn coerce_map_key(base: #{int => str}) -> #{term => str} { base }

pub fn update_map(base: #{str => int}) -> #{str => term} {
    #{"enabled" => true, ..base}
}

pub fn coerce_slice(values: [int]) -> [term] { values }

pub fn coerce_array(values: [int; 2]) -> [term; 2] { values }

pub fn coerce_tuple(value: (int, bool)) -> (term, term) { value }

pub fn coerce_nested_map(base: #{str => #{str => int}})
    -> #{str => #{str => term}} {
    base
}
