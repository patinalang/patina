#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn coerce(base: int) -> term { base }

pub fn coerce_map_value(base: #{str => int}) -> #{str => term} { base }

pub fn coerce_map_key(base: #{int => str}) -> #{term => str} { base }

pub fn update_map(base: #{str => int}) -> #{str => term} {
    #{"enabled" => true, ..base}
}

pub fn coerce_slice(values: [int]) -> [term] { values }

pub fn coerce_tuple(value: (int, bool)) -> (term, term) { value }

pub fn coerce_nested_map(base: #{str => #{str => int}})
    -> #{str => #{str => term}} {
    base
}
