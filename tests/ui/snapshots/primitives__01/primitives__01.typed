#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/primitives.md
// block: 1/1

fn main() ({
    // Variables can be type annotated.
    let logical: bool = (true as bool);
    let a_float: float = (1.0 as float);
    let an_atom: atom = (a"hello" as atom);

    // A type can also be inferred from context.
    let inferred_type; // Type float is inferred from another line.
    (inferred_type =
        ((add_floats as
                fn(float, float) -> float {add_floats})((12.0 as float),
            (3.14 as float)) as float) as float);

    // A mutable variable's value can be changed - rebound to a new value.
    let mut mutable = (12 as int); // Mutable `int`
    (mutable = (21 as int) as int);

    // Error! The type of a variable can't be changed.
    // mutable = true;

    // Variables can be overwritten with shadowing.
    let mutable = (true as bool);

    /* Compound types - List, Tuple and Maps */

    // List's signature consists of type T as [T].
    let my_list: [int] =
        ([(1 as int), (2 as int), (3 as int), (4 as int), (5 as int)] as
            [int]);
    // Tuple is a collection of values of different types
    // and is constructed using parentheses ().
    let my_tuple =
        (((5 as int), (true as bool), (-(5.04 as float) as float)) as
            (int, bool, float));
    // Map's signature consists of Key type K and Value type V as #{K => V}
    let my_map: #{float => str} =
        (#{(3.14 as float) => ("pi" as str), (0.0 as float) =>
                ("zero" as str)} as #{float => str});

    /* Function types */

    let add_ref: fn(float, float) -> float =
        (add_floats as fn(float, float) -> float {add_floats});
    // fnref is implicitly convertible to fn
    let add_fn: fn(float, float) -> float =
        (add_ref as fnref(float, float) -> float);
} as ())

fn add_floats(a: float, b: float)
    -> float ({ ((a as float) + (b as float) as float) } as float)
