#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/primitives.md
// block: 1/1

pub fn main() {
    // Variables can be type annotated.
    let logical: bool = true;
    let a_float: float = 1.0;
    let an_atom: atom = a"hello";

    // A type can also be inferred from context.
    let inferred_type; // Type float is inferred from another line.
    inferred_type = add_floats(12.0, 3.14);

    // A mutable variable's value can be changed - rebound to a new value.
    let mut mutable = 12; // Mutable `int`
    mutable = 21;

    // Error! The type of a variable can't be changed.
    // mutable = true;

    // Variables can be overwritten with shadowing.
    let mutable = true;

    /* Compound types - List, Tuple and Maps */

    // List's signature consists of type T as [T].
    let my_list: [int] = [1, 2, 3, 4, 5];

    // Tuple is a collection of values of different types
    // and is constructed using parentheses ().
    let my_tuple = (5, true, -5.04);

    // Map's signature consists of Key type K and Value type V as #{K => V}
    let my_map: #{float => str} = #{3.14 => "pi", 0.0 => "zero"};

    /* Function types */

    let add_ref: fnref(float, float) -> float = add_floats;
    // fnref is implicitly convertible to fn
    let add_fn: fn(float, float) -> float = add_ref;
}

fn add_floats(a: float, b: float) -> float { a + b }
