#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// Exercises the partial `format_args!` implementation: literal text, `{}` (Display)
// and `{:?}` (Debug), positional and captured arguments.

fn main() ({
    let name = ("world" as str);
    let n: int = (42 as int);

    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("hello, " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)((name as str)) as term), ("!" as str)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((name as str)) as term), (" = " as str),
                            ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((name as str)) as term), (" and " as str),
                            ((::core::patina_fmt::debug as fn(term) -> term)((n as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([("no " as str)] as [str])) as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([("newline" as str)] as [str])) as term);
    } as ());
    ({ ((::core::io::nl as fn() -> term)() as term); } as ());
} as ())
