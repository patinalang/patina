#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// Exercises the partial `format_args!` implementation: literal text, `{}` (Display)
// and `{:?}` (Debug), positional and captured arguments.

fn main() ({
    let name = ("world" as str);
    let n: int = (42 as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("hello, " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                (name as str)) as term), ("!" as str)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((name as str)) as term), (" = " as str),
                            ((patina_fmt::debug as fn(term) -> term)((n as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((name as str)) as term), (" and " as str),
                            ((patina_fmt::debug as fn(term) -> term)((n as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as fn(term) -> term)(([("no " as str)] as [str])) as
            term);
    } as ());
    ({
        ((io::put_chars as fn(term) -> term)(([("newline" as str)] as [str]))
            as term);
    } as ());
    ({ ((io::nl as fn() -> term)() as term); } as ());
} as ())
