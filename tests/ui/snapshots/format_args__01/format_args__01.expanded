#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// Exercises the partial `format_args!` implementation: literal text, `{}` (Display)
// and `{:?}` (Debug), positional and captured arguments.

pub fn main() {
    let name = "world";
    let n: int = 42;
    {
        io::put_chars([["hello, ",
                            patina_fmt::display(

                                name), "!"]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(name), " = ",
                            patina_fmt::debug(n)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(name), " and ",
                            patina_fmt::debug(n)]]);
        io::nl();
    };
    { io::put_chars(["no "]); };
    { io::put_chars(["newline"]); };
    { io::nl(); };
}
