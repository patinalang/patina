#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// Exercises the partial `format_args!` implementation: literal text, `{}` (Display)
// and `{:?}` (Debug), positional and captured arguments.

pub fn main() {
    let name = "world";
    let n: int = 42;

    {
        ::core::io::put_chars([["hello, ", ::core::patina_fmt::display(name),
                            "!"]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(name), " = ",
                            ::core::patina_fmt::debug(n)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(name), " and ",
                            ::core::patina_fmt::debug(n)]]);
        ::core::io::nl();
    };
    { ::core::io::put_chars(["no "]); };
    { ::core::io::put_chars(["newline"]); };
    { ::core::io::nl(); };
}
