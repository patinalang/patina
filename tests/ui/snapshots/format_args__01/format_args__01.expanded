#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// Exercises the partial `format_args!` implementation: literal text, `{}` (Display)
// and `{:?}` (Debug), positional and captured arguments.

pub fn main() {
    let name = "world";
    let n: int = 42;

    {
        ::Core::io::put_chars([["hello, ", patina_fmt::display(name), "!"]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::display(name), " = ",
                            patina_fmt::debug(n)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::display(name), " and ",
                            patina_fmt::debug(n)]]);
        ::Core::io::nl();
    };
    { ::Core::io::put_chars(["no "]); };
    { ::Core::io::put_chars(["newline"]); };
    { ::Core::io::nl(); };
}
