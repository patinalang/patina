#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/multiple_error_types/option_result.md
// block: 2/2

use Std::Num::ParseIntError;

fn double_first(list: [str]) -> Result<Option<int>, ParseIntError> {
    let opt =
        list.first().map(|first| { first.parse::<int>().map(|n| 2 * n) });

    opt.transpose()
}

pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];

    {
        ::core::io::put_chars([["The first doubled is ",
                            ::core::patina_fmt::debug(double_first(numbers))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["The first doubled is ",
                            ::core::patina_fmt::debug(double_first(empty))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["The first doubled is ",
                            ::core::patina_fmt::debug(double_first(strings))]]);
        ::core::io::nl();
    };
}
