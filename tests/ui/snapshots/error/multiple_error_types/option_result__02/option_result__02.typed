use Std::Num::ParseIntError;

fn double_first(list: [str])
    ->
        Result<Option<int>,
        ParseIntError> ({
    let opt =
        (((list as [str]).first() as
                {type error}).map((|first|
                ({
                    (((first as {type error}).parse::<int>() as
                            {type error}).map((|n|
                            ((2 as int) * (n as {type error}) as {type error}) as
                            {closure@tests/ui/src/error/multiple_error_types/option_result__02.pt:8:34: 8:37}))
                        as {type error})
                } as {type error}) as
                {closure@tests/ui/src/error/multiple_error_types/option_result__02.pt:7:32: 7:39}))
            as {type error});

    ((opt as {type error}).transpose() as {type error})
} as {type error})

fn main() ({
    let numbers = ([("42" as str), ("93" as str), ("18" as str)] as [str; 3]);
    let empty = ([] as [str; 0]);
    let strings =
        ([("tofu" as str), ("93" as str), ("18" as str)] as [str; 3]);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(

                                ((double_first as
                                        fn([str]) -> {type error} {double_first})((numbers as
                                        [str; 3])) as {type error})) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(((double_first as
                                        fn([str]) -> {type error} {double_first})((empty as
                                        [str; 0])) as {type error})) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(((double_first as
                                        fn([str]) -> {type error} {double_first})((strings as
                                        [str; 3])) as {type error})) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
