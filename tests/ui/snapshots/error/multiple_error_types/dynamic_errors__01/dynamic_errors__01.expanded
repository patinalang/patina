#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/error/multiple_error_types/dynamic_errors.md
// block: 1/1

use Std::Error;
use Std::Fmt;

// Change the alias to use `dyn Error::Error`.
type Result<T> = Std::Result::Result<T, dyn Error::Error>;

struct EmptyList;

impl Fmt::Display for EmptyList {
    fn fmt(self, f: Fmt::Formatter) -> Fmt::Result { (/*ERROR*/) }
}

impl Error::Error for EmptyList {}

fn double_first(list: [str]) -> Result<int> {
    list.first().ok_or_else(||
                EmptyList).and_then(|s| { s.parse::<int>().map(|i| 2 * i) })
}

fn print(result: Result<int>) {
    match result {
        Ok(n) =>

            {
            ::Core::io::put_chars([["The first doubled is ",
                                patina_fmt::display(n)]]);
            ::Core::io::nl();
        }
        Err(e) => {
            ::Core::io::put_chars([["Error: ", patina_fmt::display(e)]]);
            ::Core::io::nl();
        }
    }
}
pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];
    print(double_first(numbers));
    print(double_first(empty));
    print(double_first(strings));
}
