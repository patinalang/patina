#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/multiple_error_types/option_result.md
// block: 1/2

use Std::Num::ParseIntError;

fn double_first(list: [str]) -> Option<Result<int, ParseIntError>> {
    list.first().map(|first| { first.parse::<int>().map(|n| 2 * n) })
}

pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];
    {
        io::put_chars([["The first doubled is ",
                            patina_fmt::debug(

                                double_first(numbers))]]);
        io::nl();
    };
    {
        io::put_chars([["The first doubled is ",
                            patina_fmt::debug(

                                double_first(empty))]]);
        io::nl();
    };
    {
        io::put_chars([["The first doubled is ",
                            patina_fmt::debug(
                                // Error 1: the input list is empty

                                double_first(strings))]]);
        io::nl();
    };
    // Error 2: the element doesn't parse to a number
}
