#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/error/multiple_error_types/option_result.md
// block: 1/2

use Std::Num::ParseIntError;

fn double_first(list: [str]) -> Option<Result<int, ParseIntError>> {
    list.first().map(|first| { first.parse::<int>().map(|n| 2 * n) })
}

pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];


    // Error 1: the input list is empty

    // Error 2: the element doesn't parse to a number
    {
        ::Core::io::put_chars([["The first doubled is ",
                            patina_fmt::debug(double_first(numbers))]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["The first doubled is ",
                            patina_fmt::debug(double_first(empty))]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["The first doubled is ",
                            patina_fmt::debug(double_first(strings))]]);
        ::Core::io::nl();
    };
}
