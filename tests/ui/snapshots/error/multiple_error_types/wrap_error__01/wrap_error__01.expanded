#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/multiple_error_types/wrap_error.md
// block: 1/1

use Std::Error;
use Std::Error::Error;
use Std::Num::ParseIntError;
use Std::Fmt;

type Result<T> = Std::Result::Result<T, DoubleError>;

enum DoubleError {
    EmptyList,

    // We will defer to the parse error implementation for their error.
    // Supplying extra info requires adding more data to the type.
    Parse(ParseIntError),
}

impl Fmt::Display for DoubleError {
    fn fmt(self, f: Fmt::Formatter) -> Fmt::Result {
        match self {
            DoubleError::EmptyList => (/*ERROR*/),

                // The wrapped error contains additional information and is available
                // via the source() method.
                DoubleError::Parse(..) => (/*ERROR*/),
        }
    }
}

impl Error::Error for DoubleError {
    fn source(self) -> Option<dyn Error::Error> {
        match self {
            DoubleError::EmptyList => None,

                // The cause is the underlying implementation error type. Is implicitly
                // cast to the trait object `Error::Error`. This works because the
                // underlying type already implements the `Error` trait.
                DoubleError::Parse(ref e) => Some(e),
        }
    }
}

// Implement the conversion from `ParseIntError` to `DoubleError`.
// This will be automatically called by `?` if a `ParseIntError`
// needs to be converted into a `DoubleError`.
impl From<ParseIntError> for DoubleError {
    fn from(err: ParseIntError) -> DoubleError { DoubleError::Parse(err) }
}

fn double_first(list: [str]) -> Result<int> {
    let first = list.first().ok_or(DoubleError::EmptyList)?;
    // Here we implicitly use the `ParseIntError` implementation of `From` (which
    // we defined above) in order to create a `DoubleError`.
    let parsed = first.parse::<int>()?;

    Ok(2 * parsed)
}

fn print(result: Result<int>) {
    match result {
        Ok(n) =>

            {
            ::core::io::put_chars([["The first doubled is ",
                                ::core::patina_fmt::display(n)]]);
            ::core::io::nl();
        }
        Err(e) => {
            {
                ::core::io::put_chars([["Error: ",
                                    ::core::patina_fmt::display(e)]]);
                ::core::io::nl();
            };
            if let Some(source) = e.source() {
                {
                    ::core::io::put_chars([["  Caused by: ",
                                        ::core::patina_fmt::display(source)]]);
                    ::core::io::nl();
                };
            }
        }
    }
}
pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];
    print(double_first(numbers));
    print(double_first(empty));
    print(double_first(strings));
}
