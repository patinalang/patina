#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/result.md
// block: 3/3

use Std::Num::ParseIntError;

pub fn main() -> Result<(), ParseIntError> {
    let number_str = "10";
    let number =
        match number_str.parse::<int>() {
            Ok(number) => number,
            Err(e) => return Err(e),
        };
    {
        ::core::io::put_chars([[::core::patina_fmt::display(number)]]);
        ::core::io::nl();
    };
    Ok(())
}
