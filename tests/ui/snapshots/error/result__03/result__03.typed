#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/error/result.md
// block: 3/3

use Std::Num::ParseIntError;

fn main()
    ->
        Result<(),
        ParseIntError> ({
    let number_str = ("10" as str);
    let number =
        (match ((number_str as str).parse::<int>() as {type error}) {
            Ok(number) => (number as {type error}),
            Err(e) =>
                (return ((Err as {type error})((e as {type error})) as
                        {type error}) as !),
        } as {type error});
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((number as {type error})) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ((Ok as {type error})((() as ())) as {type error})
} as {type error})
