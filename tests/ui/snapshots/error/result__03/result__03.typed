#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/error/result.md
// block: 3/3

use Std::Num::ParseIntError;

fn main()
    ->
        Result<(),
        ParseIntError> ({
    let number_str = ("10" as str);
    let number =
        (match ((number_str as str).parse::<int>() as {type error}) {
            Ok(number) => (number as term),
            Err(e) =>
                (return ((Err as
                            fn({type error}) -> core::result::Result<{type error}, {type error}> {core::result::Result::<{type error}, {type error}>::Err})((e
                            as {type error})) as
                        core::result::Result<{type error}, {type error}>) as !),
        } as term);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((number as term)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ((Ok as
            fn(()) -> core::result::Result<(), {type error}> {core::result::Result::<(), {type error}>::Ok})((()
            as ())) as core::result::Result<(), {type error}>)
} as {type error})
