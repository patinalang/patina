#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/error/multiple_error_types.md
// block: 1/1

fn double_first(list: [str])
    ->
        int ({
    let first =
        (((list as [str]).first() as {type error}).unwrap() as
            {type error}); // Generate error 1
    ((2 as int) *
        (((first as {type error}).parse::<int>() as {type error}).unwrap() as
            {type error}) as int) // Generate error 2
} as int)

fn main() ({
    let numbers = ([("42" as str), ("93" as str), ("18" as str)] as [str]);
    let empty = ([] as [str]);
    let strings = ([("tofu" as str), ("93" as str), ("18" as str)] as [str]);


    // Error 1: the input list is empty

    // Error 2: the element doesn't parse to a number
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((double_first as
                                        fn([str]) -> int {double_first})((numbers as [str])) as
                                    int)) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((double_first as
                                        fn([str]) -> int {double_first})((empty as [str])) as int))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((double_first as
                                        fn([str]) -> int {double_first})((strings as [str])) as
                                    int)) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
