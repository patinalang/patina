#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/multiple_error_types.md
// block: 1/1

fn double_first(list: [str])
    ->
        int ({
    let first =
        (((list as [str]).first() as {type error}).unwrap() as
            {type error}); // Generate error 1
    ((2 as int) *
        (((first as {type error}).parse::<int>() as {type error}).unwrap() as
            {type error}) as int) // Generate error 2
} as int)

fn main() ({
    let numbers = ([("42" as str), ("93" as str), ("18" as str)] as [str; 3]);
    let empty = ([] as [str; 0]);
    let strings =
        ([("tofu" as str), ("93" as str), ("18" as str)] as [str; 3]);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                ((double_first as
                                        fn([str]) -> int {double_first})((numbers as [str; 3])) as
                                    int)) as term)] as [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                ((double_first as
                                        fn([str]) -> int {double_first})((empty as [str; 0])) as
                                    int)) as term)] as [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The first doubled is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(
                                // Error 1: the input list is empty

                                ((double_first as
                                        fn([str]) -> int {double_first})((strings as [str; 3])) as
                                    int)) as term)] as [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // Error 2: the element doesn't parse to a number
} as ())
