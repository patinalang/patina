#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/multiple_error_types.md
// block: 1/1

fn double_first(list: [str]) -> int {
    let first = list.first().unwrap(); // Generate error 1
    2 * first.parse::<int>().unwrap() // Generate error 2
}

pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];


    // Error 1: the input list is empty

    // Error 2: the element doesn't parse to a number
    {
        ::core::io::put_chars([["The first doubled is ",
                            ::core::patina_fmt::display(double_first(numbers))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["The first doubled is ",
                            ::core::patina_fmt::display(double_first(empty))]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["The first doubled is ",
                            ::core::patina_fmt::display(double_first(strings))]]);
        ::core::io::nl();
    };
}
