#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/result.md
// block: 1/3

fn multiply(first_number_str: str, second_number_str: str) -> int {
    // Let's try using `unwrap()` to get the number out. Will it bite us?
    let first_number = first_number_str.parse::<int>().unwrap();
    let second_number = second_number_str.parse::<int>().unwrap();
    first_number * second_number
}

pub fn main() {
    let twenty = multiply("10", "2");

    {
        ::core::io::put_chars([["double is ",
                            ::core::patina_fmt::display(twenty)]]);
        ::core::io::nl();
    };
    let tt = multiply("t", "2");
    {
        ::core::io::put_chars([["double is ",
                            ::core::patina_fmt::display(tt)]]);
        ::core::io::nl();
    };
}
