#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/result.md
// block: 1/3

fn multiply(first_number_str: str, second_number_str: str)
    ->
        int ({
    // Let's try using `unwrap()` to get the number out. Will it bite us?
    let first_number =
        (((first_number_str as str).parse::<int>() as {type error}).unwrap()
            as {type error});
    let second_number =
        (((second_number_str as str).parse::<int>() as {type error}).unwrap()
            as {type error});
    ((first_number as {type error}) * (second_number as {type error}) as
        {type error})
} as {type error})

fn main() ({
    let twenty =
        ((multiply as
                fn(str, str) -> int {multiply})(("10" as str), ("2" as str))
            as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("double is " as str),
                            ((patina_fmt::display as fn(term) -> term)((twenty as int))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    let tt =
        ((multiply as
                fn(str, str) -> int {multiply})(("t" as str), ("2" as str)) as
            int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("double is " as str),
                            ((patina_fmt::display as fn(term) -> term)((tt as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
