#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/error/iter_result.md
// block: 5/5

pub fn main() {
    let strings = ["tofu", "93", "18"];
    let (numbers, errors): ([_], [_]) =
        strings.into_iter().map(|s|
                    s.parse::<int>()).partition(Result::is_ok);
    let numbers: [_] = numbers.into_iter().map(Result::unwrap).collect();
    let errors: [_] = errors.into_iter().map(Result::unwrap_err).collect();
    { io::put_chars([["Numbers: ", patina_fmt::debug(numbers)]]); io::nl(); };
    { io::put_chars([["Errors: ", patina_fmt::debug(errors)]]); io::nl(); };
}
