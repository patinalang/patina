fn drink(beverage:
        str) ({
    // You shouldn't drink too many sugary beverages.
    (if ((beverage as str) == ("lemonade" as str) as bool) {
        ((/*ERROR*/) as {type error});
    } as ())


    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([("Some refreshing " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((beverage as str)) as term),
                            (" is all I need." as str)] as [term])] as [[term]])) as
            term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn main() ({
    ((drink as fn(str) {drink})(("water" as str)) as ());
    ((drink as fn(str) {drink})(("lemonade" as str)) as ());
    ((drink as fn(str) {drink})(("still water" as str)) as ());
} as ())
