fn drink(beverage: str) {
    // You shouldn't drink too many sugary beverages.
    if beverage == "lemonade" {


        unsafe {
            ::core::erlang::error(::core::Panic::new("AAAaaaaa!!!!"), a"none",
                    [(a"error_info",
                                #{a"module" =>
                                        a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
        };
    }
    {
        ::core::io::put_chars([["Some refreshing ",
                            ::core::patina_fmt::display(beverage), " is all I need."]]);
        ::core::io::nl();
    };
}
pub fn main() { drink("water"); drink("lemonade"); drink("still water"); }
