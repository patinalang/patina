use Std::Num::ParseIntError;

// As with `Option`, we can use combinators such as `map()`.
// This function is otherwise identical to the one above and reads:
// Multiply if both values can be parsed from str, otherwise pass on the error.
fn multiply(first_number_str: str, second_number_str: str)
    ->
        Result<int,
        ParseIntError> ({
    (((first_number_str as str).parse::<int>() as
            {type error}).and_then((|first_number|
            ({
                (((second_number_str as str).parse::<int>() as
                        {type error}).map((|second_number|
                        ((first_number as {type error}) *
                            (second_number as {type error}) as {type error}) as
                        {closure@tests/ui/src/error/result/result_map__02.pt:11:46: 11:61}))
                    as {type error})
            } as {type error}) as
            {closure@tests/ui/src/error/result/result_map__02.pt:10:46: 10:60}))
        as {type error})
} as {type error})

fn print(result:
        Result<int,
        ParseIntError>) ({
    (match (result as {type error}) {
        Ok(n) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("n is " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((n as {type error})) as term)] as
                            [term; 2])] as [[term; 2]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Err(e) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Error: " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((e as {type error})) as term)] as
                            [term; 2])] as [[term; 2]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())

fn main() ({
    // This still presents a reasonable answer.
    let twenty =
        ((multiply as
                fn(str, str) -> {type error} {multiply})(("10" as str),
            ("2" as str)) as {type error});
    ((print as fn({type error}) {print})((twenty as {type error})) as ());

    // The following now provides a much more helpful error message.
    let tt =
        ((multiply as
                fn(str, str) -> {type error} {multiply})(("t" as str),
            ("2" as str)) as {type error});
    ((print as fn({type error}) {print})((tt as {type error})) as ());
} as ())
