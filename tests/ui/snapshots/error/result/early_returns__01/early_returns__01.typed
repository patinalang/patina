use Std::Num::ParseIntError;

fn multiply(first_number_str: str, second_number_str: str)
    ->
        Result<int,
        ParseIntError> ({
    let first_number =
        (match ((first_number_str as str).parse::<int>() as {type error}) {
            Ok(first_number) => (first_number as {type error}),
            Err(e) =>
                (return ((Err as {type error})((e as {type error})) as
                        {type error}) as !),
        } as {type error});

    let second_number =
        (match ((second_number_str as str).parse::<int>() as {type error}) {
            Ok(second_number) => (second_number as {type error}),
            Err(e) =>
                (return ((Err as {type error})((e as {type error})) as
                        {type error}) as !),
        } as {type error});

    ((Ok as
            {type error})(((first_number as {type error}) *
            (second_number as {type error}) as {type error})) as {type error})
} as {type error})

fn print(result:
        Result<int,
        ParseIntError>) ({
    (match (result as {type error}) {
        Ok(n) =>
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("n is " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((n as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        Err(e) => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Error: " as str),
                                ((::core::patina_fmt::display as
                                        fn(term) -> term)((e as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
fn main() ({
    ((print as
            fn({type error}) {print})(((multiply as
                fn(str, str) -> {type error} {multiply})(("10" as str),
            ("2" as str)) as {type error})) as ());
    ((print as
            fn({type error}) {print})(((multiply as
                fn(str, str) -> {type error} {multiply})(("t" as str),
            ("2" as str)) as {type error})) as ());
} as ())
