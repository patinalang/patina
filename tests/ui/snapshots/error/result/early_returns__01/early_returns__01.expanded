#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/result/early_returns.md
// block: 1/1

use Std::Num::ParseIntError;

fn multiply(first_number_str: str, second_number_str: str)
    -> Result<int, ParseIntError> {
    let first_number =
        match first_number_str.parse::<int>() {
            Ok(first_number) => first_number,
            Err(e) => return Err(e),
        };

    let second_number =
        match second_number_str.parse::<int>() {
            Ok(second_number) => second_number,
            Err(e) => return Err(e),
        };

    Ok(first_number * second_number)
}

fn print(result: Result<int, ParseIntError>) {
    match result {
        Ok(n) =>
            {
            ::core::io::put_chars([["n is ",
                                ::core::patina_fmt::display(n)]]);
            ::core::io::nl();
        }
        Err(e) => {
            ::core::io::put_chars([["Error: ",
                                ::core::patina_fmt::display(e)]]);
            ::core::io::nl();
        }
    }
}
pub fn main() { print(multiply("10", "2")); print(multiply("t", "2")); }
