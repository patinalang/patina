#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/error/result/enter_question_mark.md
// block: 1/1

use Std::Num::ParseIntError;

fn multiply(first_number_str: str, second_number_str: str)
    -> Result<int, ParseIntError> {
    let first_number = first_number_str.parse::<int>()?;
    let second_number = second_number_str.parse::<int>()?;

    Ok(first_number * second_number)
}

fn print(result: Result<int, ParseIntError>) {
    match result {
        Ok(n) =>
            {
            io::put_chars([["n is ", patina_fmt::display(n)]]);
            io::nl();
        }
        Err(e) => {
            io::put_chars([["Error: ", patina_fmt::display(e)]]);
            io::nl();
        }
    }
}
pub fn main() { print(multiply("10", "2")); print(multiply("t", "2")); }
