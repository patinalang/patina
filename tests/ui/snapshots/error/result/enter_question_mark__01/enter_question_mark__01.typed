use Std::Num::ParseIntError;

fn multiply(first_number_str: str, second_number_str: str)
    ->
        Result<int,
        ParseIntError> ({
    let first_number =
        (match ((branch as
                    fn({type error}) -> Core::ControlFlow<<{type error} as Core::Try>::Residual, <{type error} as Core::Try>::Output> {<{type error} as Core::Try>::branch})(((first_number_str
                        as str).parse::<int>() as {type error})) as
                Core::ControlFlow<{type error}, {type error}>) {
            Break {  0: residual } => #[allow(unreachable_code)]
                (return ((from_residual as
                            fn({type error}) -> {type error} {<{type error} as Core::FromResidual<{type error}>>::from_residual})((residual
                            as {type error})) as {type error}) as !),
            Continue {  0: val } => #[allow(unreachable_code)]
                (val as {type error}),
        } as {type error});
    let second_number =
        (match ((branch as
                    fn({type error}) -> Core::ControlFlow<<{type error} as Core::Try>::Residual, <{type error} as Core::Try>::Output> {<{type error} as Core::Try>::branch})(((second_number_str
                        as str).parse::<int>() as {type error})) as
                Core::ControlFlow<{type error}, {type error}>) {
            Break {  0: residual } => #[allow(unreachable_code)]
                (return ((from_residual as
                            fn({type error}) -> {type error} {<{type error} as Core::FromResidual<{type error}>>::from_residual})((residual
                            as {type error})) as {type error}) as !),
            Continue {  0: val } => #[allow(unreachable_code)]
                (val as {type error}),
        } as {type error});

    ((Ok as
            {type error})(((first_number as {type error}) *
            (second_number as {type error}) as {type error})) as {type error})
} as {type error})

fn print(result:
        Result<int,
        ParseIntError>) ({
    (match (result as {type error}) {
        Ok(n) =>
            {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("n is " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((n as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
        Err(e) => {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("Error: " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((e as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
fn main() ({
    ((print as
            fn({type error}) {print})(((multiply as
                fn(str, str) -> {type error} {multiply})(("10" as str),
            ("2" as str)) as {type error})) as ());
    ((print as
            fn({type error}) {print})(((multiply as
                fn(str, str) -> {type error} {multiply})(("t" as str),
            ("2" as str)) as {type error})) as ());
} as ())
