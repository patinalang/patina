use Std::Num::ParseIntError;

// Define a generic alias for a `Result` with the error type `ParseIntError`.
type AliasedResult<T> = Result<T, ParseIntError>;

// Use the above alias to refer to our specific `Result` type.
fn multiply(first_number_str: str, second_number_str: str)
    ->
        AliasedResult<int> ({
    (((first_number_str as str).parse::<int>() as
            {type error}).and_then((|first_number|
            ({
                (((second_number_str as str).parse::<int>() as
                        {type error}).map((|second_number|
                        ((first_number as {type error}) *
                            (second_number as {type error}) as {type error}) as
                        {closure@tests/ui/src/error/result/result_alias__01.pt:12:46: 12:61}))
                    as {type error})
            } as {type error}) as
            {closure@tests/ui/src/error/result/result_alias__01.pt:11:46: 11:60}))
        as {type error})
} as {type error})

// Here, the alias again allows us to save some space.
fn print(result:
        AliasedResult<int>) ({
    (match (result as {type error}) {
        Ok(n) =>
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("n is " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((n as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        Err(e) => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Error: " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((e as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
fn main() ({
    ((print as
            fn({type error}) {print})(((multiply as
                fn(str, str) -> {type error} {multiply})(("10" as str),
            ("2" as str)) as {type error})) as ());
    ((print as
            fn({type error}) {print})(((multiply as
                fn(str, str) -> {type error} {multiply})(("t" as str),
            ("2" as str)) as {type error})) as ());
} as ())
