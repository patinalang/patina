use Std::Num::ParseIntError;

// With the return type rewritten, we use pattern matching without `unwrap()`.
fn multiply(first_number_str: str, second_number_str: str)
    ->
        Result<int,
        ParseIntError> ({
    (match ((first_number_str as str).parse::<int>() as {type error}) {
        Ok(first_number) => {
            (match ((second_number_str as str).parse::<int>() as {type error})
                {
                Ok(second_number) => {
                    ((Ok as
                            {type error})(((first_number as {type error}) *
                            (second_number as {type error}) as {type error})) as
                        {type error})
                }
                Err(e) =>
                    ((Err as {type error})((e as {type error})) as
                        {type error}),
            } as {type error})
        }
        Err(e) =>
            ((Err as {type error})((e as {type error})) as {type error}),
    } as {type error})
} as {type error})

fn print(result:
        Result<int,
        ParseIntError>) ({
    (match (result as {type error}) {
        Ok(n) =>
            // This still presents a reasonable answer.

            // The following now provides a much more helpful error message.
            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("n is " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((n as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        Err(e) => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Error: " as str),
                                ((patina_fmt::display as
                                        fn(term) -> term)((e as {type error})) as term)] as [term])]
                    as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
fn main() ({
    let twenty =
        ((multiply as
                fn(str, str) -> {type error} {multiply})(("10" as str),
            ("2" as str)) as {type error});
    ((print as fn({type error}) {print})((twenty as {type error})) as ());
    let tt =
        ((multiply as
                fn(str, str) -> {type error} {multiply})(("t" as str),
            ("2" as str)) as {type error});
    ((print as fn({type error}) {print})((tt as {type error})) as ());
} as ())
