#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 1/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

fn main() ({
    let apple =
        ((Some as {type error})((Fruit::Apple as Fruit)) as {type error});
    let orange =
        ((Some as {type error})((Fruit::Orange as Fruit)) as {type error});
    let no_fruit: Option<Fruit> = (None as {type error});

    let first_available_fruit =
        (((no_fruit as {type error}).or((orange as {type error})) as
                {type error}).or((apple as {type error})) as {type error});
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("first_available_fruit: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((first_available_fruit as {type error}))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // first_available_fruit: Some(Orange)

    // `or` moves its argument.
    // In the example above, `or(orange)` returned a `Some`, so `or(apple)` was not invoked.
    // But the variable named `apple` has been moved regardless, and cannot be used anymore.
    // println!("Variable apple was moved, so this line won't compile: {:?}", apple);
    // TODO: uncomment the line above to see the compiler error
} as ())
