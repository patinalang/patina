#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 1/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

fn main() ({
    let apple =
        ((Some as
                fn(Fruit) -> core::option::Option<Fruit> {core::option::Option::<Fruit>::Some})((Fruit::Apple
                as Fruit)) as core::option::Option<Fruit>);
    let orange =
        ((Some as
                fn(Fruit) -> core::option::Option<Fruit> {core::option::Option::<Fruit>::Some})((Fruit::Orange
                as Fruit)) as core::option::Option<Fruit>);
    let no_fruit: Option<Fruit> = (None as core::option::Option<Fruit>);

    let first_available_fruit =
        (((no_fruit as
                    core::option::Option<Fruit>).or((orange as
                    core::option::Option<Fruit>)) as
                {type error}).or((apple as core::option::Option<Fruit>)) as
            {type error});
    // first_available_fruit: Some(Orange)

    // `or` moves its argument.
    // In the example above, `or(orange)` returned a `Some`, so `or(apple)` was not invoked.
    // But the variable named `apple` has been moved regardless, and cannot be used anymore.
    // println!("Variable apple was moved, so this line won't compile: {:?}", apple);
    // TODO: uncomment the line above to see the compiler error
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("first_available_fruit: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((first_available_fruit as {type error}))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
