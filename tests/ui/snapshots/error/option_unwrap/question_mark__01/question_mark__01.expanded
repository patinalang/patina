#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/option_unwrap/question_mark.md
// block: 1/2

fn next_birthday(current_age: Option<int>) -> Option<str> {
    // If `current_age` is `None`, this returns `None`.
    // If `current_age` is `Some`, the inner `int` value + 1
    // gets assigned to `next_age`
    let next_age: int = current_age? + 1;
    Some(unsafe {
            ::core::unicode::characters_to_binary(["Next year I will be ",
                            ::core::patina_fmt::display(next_age)]).cast_unchecked::<str>()
        })
}
