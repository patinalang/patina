#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 3/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

fn main() ({
    let mut my_fruit: Option<Fruit> = (None as core::option::Option<Fruit>);
    let apple = (Fruit::Apple as Fruit);
    let first_available_fruit =
        ((my_fruit as
                core::option::Option<Fruit>).get_or_insert((apple as Fruit))
            as {type error});
    // first_available_fruit is: Apple
    // my_fruit is: Some(Apple)
    //println!("Variable named `apple` is moved: {:?}", apple);
    // TODO: uncomment the line above to see the compiler error
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("first_available_fruit is: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((first_available_fruit as {type error}))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("my_fruit is: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((my_fruit as core::option::Option<Fruit>))
                                as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
