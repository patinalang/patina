#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 3/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

fn main() ({
    let mut my_fruit: Option<Fruit> = (None as {type error});
    let apple = (Fruit::Apple as Fruit);
    let first_available_fruit =
        ((my_fruit as {type error}).get_or_insert((apple as Fruit)) as
            {type error});
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("first_available_fruit is: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((first_available_fruit as {type error}))
                                as term)] as [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("my_fruit is: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((my_fruit as {type error})) as term)] as
                        [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // first_available_fruit is: Apple
    // my_fruit is: Some(Apple)
    //println!("Variable named `apple` is moved: {:?}", apple);
    // TODO: uncomment the line above to see the compiler error
} as ())
