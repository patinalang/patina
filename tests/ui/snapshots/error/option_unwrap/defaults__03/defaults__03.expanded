#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 3/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

pub fn main() {
    let mut my_fruit: Option<Fruit> = None;
    let apple = Fruit::Apple;
    let first_available_fruit = my_fruit.get_or_insert(apple);
    // first_available_fruit is: Apple
    // my_fruit is: Some(Apple)
    //println!("Variable named `apple` is moved: {:?}", apple);
    // TODO: uncomment the line above to see the compiler error
    {
        ::core::io::put_chars([["first_available_fruit is: ",
                            ::core::patina_fmt::debug(first_available_fruit)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["my_fruit is: ",
                            ::core::patina_fmt::debug(my_fruit)]]);
        ::core::io::nl();
    };
}
