#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 2/4

#[derive(Debug)]
enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

pub fn main() {
    let no_fruit: Option<Fruit> = None;
    let get_kiwi_as_fallback =
        ||
            {
                {
                    io::put_chars([["Providing kiwi as fallback"]]);
                    io::nl();
                };
                Some(Fruit::Kiwi)
            };
    let get_lemon_as_fallback =
        ||
            {
                {
                    io::put_chars([["Providing lemon as fallback"]]);
                    io::nl();
                };
                Some(Fruit::Lemon)
            };

    let first_available_fruit =
        no_fruit.or_else(get_kiwi_as_fallback).or_else(get_lemon_as_fallback);
    {
        io::put_chars([["first_available_fruit: ",
                            patina_fmt::debug(first_available_fruit)]]);
        io::nl();
    };
    // Providing kiwi as fallback
    // first_available_fruit: Some(Kiwi)
}
