#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 2/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

pub fn main() {
    let no_fruit: Option<Fruit> = None;
    let get_kiwi_as_fallback =
        ||
            {

                // Providing kiwi as fallback
                // first_available_fruit: Some(Kiwi)
                {
                    ::core::io::put_chars([["Providing kiwi as fallback"]]);
                    ::core::io::nl();
                };
                Some(Fruit::Kiwi)
            };
    let get_lemon_as_fallback =
        ||
            {
                {
                    ::core::io::put_chars([["Providing lemon as fallback"]]);
                    ::core::io::nl();
                };
                Some(Fruit::Lemon)
            };
    let first_available_fruit =
        no_fruit.or_else(get_kiwi_as_fallback).or_else(get_lemon_as_fallback);
    {
        ::core::io::put_chars([["first_available_fruit: ",
                            patina_fmt::debug(first_available_fruit)]]);
        ::core::io::nl();
    };
}
