enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

fn main() ({
    let no_fruit: Option<Fruit> = (None as core::option::Option<Fruit>);
    let get_kiwi_as_fallback =
        (||
            ({

                // Providing kiwi as fallback
                // first_available_fruit: Some(Kiwi)
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([("Providing kiwi as fallback" as str)]
                                    as [str])] as [[str]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
                ((Some as
                        fn(Fruit) -> core::option::Option<Fruit> {core::option::Option::<Fruit>::Some})((Fruit::Kiwi
                        as Fruit)) as core::option::Option<Fruit>)
            } as core::option::Option<Fruit>) as
            {closure@tests/ui/src/error/option_unwrap/defaults__02.pt:9:32: 9:34});
    let get_lemon_as_fallback =
        (||
            ({
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([("Providing lemon as fallback" as
                                            str)] as [str])] as [[str]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
                ((Some as
                        fn(Fruit) -> core::option::Option<Fruit> {core::option::Option::<Fruit>::Some})((Fruit::Lemon
                        as Fruit)) as core::option::Option<Fruit>)
            } as core::option::Option<Fruit>) as
            {closure@tests/ui/src/error/option_unwrap/defaults__02.pt:13:33: 13:35});
    let first_available_fruit =
        (((no_fruit as
                    core::option::Option<Fruit>).or_else((get_kiwi_as_fallback
                    as
                    {closure@tests/ui/src/error/option_unwrap/defaults__02.pt:9:32: 9:34}))
                as
                core::option::Option<Fruit>).or_else((get_lemon_as_fallback as
                {closure@tests/ui/src/error/option_unwrap/defaults__02.pt:13:33: 13:35}))
            as core::option::Option<Fruit>);
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("first_available_fruit: " as str),
                            ((::core::patina_fmt::debug as
                                    fn(term) -> term)((first_available_fruit as
                                    core::option::Option<Fruit>)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
