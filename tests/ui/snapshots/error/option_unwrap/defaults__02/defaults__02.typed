#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/option_unwrap/defaults.md
// block: 2/4

enum Fruit { Apple, Orange, Banana, Kiwi, Lemon, }

fn main() ({
    let no_fruit: Option<Fruit> = (None as {type error});
    let get_kiwi_as_fallback =
        (||
            ({
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("Providing kiwi as fallback" as str)]
                                    as [str; 1])] as [[str; 1]; 1])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
                ((Some as {type error})((Fruit::Kiwi as Fruit)) as
                    {type error})
            } as {type error}) as
            {closure@tests/ui/src/error/option_unwrap/defaults__02.pt:9:32: 9:34});
    let get_lemon_as_fallback =
        (||
            ({
                ({
                    ((io::put_chars as
                            fn(term) -> term)(([([("Providing lemon as fallback" as
                                            str)] as [str; 1])] as [[str; 1]; 1])) as term);
                    ((io::nl as fn() -> term)() as term);
                } as ());
                ((Some as {type error})((Fruit::Lemon as Fruit)) as
                    {type error})
            } as {type error}) as
            {closure@tests/ui/src/error/option_unwrap/defaults__02.pt:13:33: 13:35});
    let first_available_fruit =
        (((no_fruit as
                    {type error}).or_else((get_kiwi_as_fallback as
                    {type error})) as
                {type error}).or_else((get_lemon_as_fallback as {type error}))
            as {type error});
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("first_available_fruit: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((first_available_fruit as {type error}))
                                as term)] as [term; 2])] as [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // Providing kiwi as fallback
    // first_available_fruit: Some(Kiwi)
} as ())
