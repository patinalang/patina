#![allow(dead_code)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;
#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

enum Food { CordonBleu, Steak, Sushi, }
enum Day { Monday, Tuesday, Wednesday, }

// We don't have the ingredients to make Sushi.
fn have_ingredients(food: Food)
    ->
        Option<Food> ({
    (match (food as Food) {
        Food::Sushi => (None as core::option::Option<Food>),
        _ =>
            ((Some as
                    fn(Food) -> core::option::Option<Food> {core::option::Option::<Food>::Some})((food
                    as Food)) as core::option::Option<Food>),
    } as core::option::Option<Food>)
} as core::option::Option<Food>)

// We have the recipe for everything except Cordon Bleu.
fn have_recipe(food: Food)
    ->
        Option<Food> ({
    (match (food as Food) {
        Food::CordonBleu => (None as core::option::Option<Food>),
        _ =>
            ((Some as
                    fn(Food) -> core::option::Option<Food> {core::option::Option::<Food>::Some})((food
                    as Food)) as core::option::Option<Food>),
    } as core::option::Option<Food>)
} as core::option::Option<Food>)

// To make a dish, we need both the recipe and the ingredients.
// We can represent the logic with a chain of `match`es:
fn cookable_v1(food: Food)
    ->
        Option<Food> ({
    (match ((have_recipe as
                fn(Food) -> core::option::Option<Food> {have_recipe})((food as
                Food)) as core::option::Option<Food>) {
        None => (None as core::option::Option<Food>),
        Some(food) =>
            ((have_ingredients as
                    fn(Food) -> core::option::Option<Food> {have_ingredients})((food
                    as Food)) as core::option::Option<Food>),
    } as core::option::Option<Food>)
} as core::option::Option<Food>)

// This can conveniently be rewritten more compactly with `and_then()`:
fn cookable_v3(food: Food)
    ->
        Option<Food> ({
    (((have_recipe as
                fn(Food) -> core::option::Option<Food> {have_recipe})((food as
                Food)) as
            core::option::Option<Food>).and_then((have_ingredients as
            fn(Food) -> core::option::Option<Food> {have_ingredients})) as
        core::option::Option<Food>)
} as core::option::Option<Food>)

// Otherwise we'd need to `flatten()` an `Option<Option<Food>>`
// to get an `Option<Food>`:
fn cookable_v2(food: Food)
    ->
        Option<Food> ({
    ((((have_recipe as
                    fn(Food) -> core::option::Option<Food> {have_recipe})((food
                    as Food)) as
                core::option::Option<Food>).map((have_ingredients as
                fn(Food) -> core::option::Option<Food> {have_ingredients})) as
            core::option::Option<core::option::Option<Food>>).flatten() as
        core::option::Option<Food>)
} as core::option::Option<Food>)

fn eat(food: Food,
    day:
        Day) ({
    (match ((cookable_v3 as
                fn(Food) -> core::option::Option<Food> {cookable_v3})((food as
                Food)) as core::option::Option<Food>) {
        Some(food) =>

            {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Yay! On " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((day as Day)) as term),
                                (" we get to eat " as str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((food as Food)) as term), ("." as str)] as
                            [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
        None => {
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("Oh no. We don\'t get to eat on " as
                                    str),
                                ((::core::patina_fmt::debug as
                                        fn(term) -> term)((day as Day)) as term), ("?" as str)] as
                            [term])] as [[term]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
fn main() ({
    let (cordon_bleu, steak, sushi) =
        (((Food::CordonBleu as Food), (Food::Steak as Food),
            (Food::Sushi as Food)) as (Food, Food, Food));
    ((eat as fn(Food, Day) {eat})((cordon_bleu as Food), (Day::Monday as Day))
        as ());
    ((eat as fn(Food, Day) {eat})((steak as Food), (Day::Tuesday as Day)) as
        ());
    ((eat as fn(Food, Day) {eat})((sushi as Food), (Day::Wednesday as Day)) as
        ());
} as ())
