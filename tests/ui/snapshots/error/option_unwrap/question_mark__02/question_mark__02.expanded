#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/option_unwrap/question_mark.md
// block: 2/2

struct Person {
    job: Option<Job>,
}

struct Job {
    phone_number: Option<PhoneNumber>,
}

#[allow(dead_code)]
struct PhoneNumber {
    area_code: Option<int>,
    number: int,
}

impl Person {
    // Gets the area code of the phone number of the person's job, if it exists.
    fn work_phone_area_code(self) -> Option<int> {
        // This would need many nested `match` statements without the `?` operator.
        // It would take a lot more code - try writing it yourself and see which
        // is easier.
        self.job?.phone_number?.area_code
    }
}

pub fn main() {
    let p =
        Person {
            job: Some(Job {
                    phone_number: Some(PhoneNumber {
                            area_code: Some(61),
                            number: 439222222,
                        }),
                }),
        };

    match (p.work_phone_area_code(), Some(61)) {
        (left_val, right_val) => {
            if !(left_val == right_val) {
                unsafe {
                    ::core::erlang::error(::core::Panic::new(unsafe {
                                    ::core::unicode::characters_to_binary(["assertion `left == right` failed",
                                                    ::core::patina_fmt::display(""), "\n  left: ",
                                                    ::core::patina_fmt::debug(left_val), "\n right: ",
                                                    ::core::patina_fmt::debug(right_val)]).cast_unchecked::<str>()
                                }), a"none",
                            [(a"error_info",
                                        #{a"module" =>
                                                a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
                }
            }
        }
    };
}
