// The adult has seen it all, and can handle any drink well.
// All drinks are handled explicitly using `match`.
fn give_adult(drink: Option<str>) {
    // Specify a course of action for each case.
    match drink {
        Some("lemonade") =>
            // Others will `panic` before drinking sugary drinks.
            // All drinks are handled implicitly using `unwrap`.
            // `unwrap` returns a `panic` when it receives a `None`.





            {
            ::core::io::put_chars([["Yuck! Too sugary."]]);
            ::core::io::nl();
        }
        Some(inner) => {
            ::core::io::put_chars([[patina_fmt::display(inner),
                                "? How nice."]]);
            ::core::io::nl();
        }
        None => {
            ::core::io::put_chars([["No drink? Oh well."]]);
            ::core::io::nl();
        }
    }
}
fn drink(drink: Option<str>) {
    let inside = drink.unwrap();
    if inside == "lemonade" {
        unsafe {
            ::core::erlang::error(::core::Panic::new("AAAaaaaa!!!!"), a"none",
                    [(a"error_info",
                                #{a"module" =>
                                        a"Elixir.Patina.Core.Panic"})]).cast_unchecked::<!>()
        };
    }
    {
        ::core::io::put_chars([["I love ", patina_fmt::display(inside),
                            "s!!!!!"]]);
        ::core::io::nl();
    };
}
pub fn main() {
    let water = Some("water");
    let lemonade = Some("lemonade");
    let void = None;
    give_adult(water);
    give_adult(lemonade);
    give_adult(void);
    let coffee = Some("coffee");
    let nothing = None;
    drink(coffee);
    drink(nothing);
}
