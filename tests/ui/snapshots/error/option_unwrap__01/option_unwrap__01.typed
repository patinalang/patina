// The adult has seen it all, and can handle any drink well.
// All drinks are handled explicitly using `match`.
fn give_adult(drink:
        Option<str>) ({

    // Specify a course of action for each case.
    (match (drink as Core::Option<str>) {
        Some("lemonade") =>
            // Others will `panic` before drinking sugary drinks.
            // All drinks are handled implicitly using `unwrap`.
            // `unwrap` returns a `panic` when it receives a `None`.





            {
            ((io::put_chars as
                    fn(term) -> term)(([([("Yuck! Too sugary." as str)] as
                            [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Some(inner) => {
            ((io::put_chars as
                    fn(term) -> term)(([([((patina_fmt::display as
                                        fn(term) -> term)((inner as str)) as term),
                                ("? How nice." as str)] as [term])] as [[term]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        None => {
            ((io::put_chars as
                    fn(term) -> term)(([([("No drink? Oh well." as str)] as
                            [str])] as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
fn drink(drink:
        Option<str>) ({
    let inside = ((drink as Core::Option<str>).unwrap() as {type error});
    (if ((inside as {type error}) == ("lemonade" as str) as bool) {
        ((/*ERROR*/) as {type error});
    } as ())
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("I love " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((inside as {type error})) as term),
                            ("s!!!!!" as str)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn main() ({
    let water =
        ((Some as
                fn(str) -> Core::Option<str> {Core::Option::<str>::Some})(("water"
                as str)) as Core::Option<str>);
    let lemonade =
        ((Some as
                fn(str) -> Core::Option<str> {Core::Option::<str>::Some})(("lemonade"
                as str)) as Core::Option<str>);
    let void = (None as Core::Option<str>);
    ((give_adult as
            fn(Core::Option<str>) {give_adult})((water as Core::Option<str>))
        as ());
    ((give_adult as
            fn(Core::Option<str>) {give_adult})((lemonade as
            Core::Option<str>)) as ());
    ((give_adult as
            fn(Core::Option<str>) {give_adult})((void as Core::Option<str>))
        as ());
    let coffee =
        ((Some as
                fn(str) -> Core::Option<str> {Core::Option::<str>::Some})(("coffee"
                as str)) as Core::Option<str>);
    let nothing = (None as Core::Option<str>);
    ((drink as fn(Core::Option<str>) {drink})((coffee as Core::Option<str>))
        as ());
    ((drink as fn(Core::Option<str>) {drink})((nothing as Core::Option<str>))
        as ());
} as ())
