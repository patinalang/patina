#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/iter_result.md
// block: 4/5

pub fn main() {
    let strings = ["tofu", "93", "18"];
    let (numbers, errors): ([_], [_]) =
        strings.into_iter().map(|s|
                    s.parse::<int>()).partition(Result::is_ok);
    {
        ::core::io::put_chars([["Numbers: ",
                            ::core::patina_fmt::debug(numbers)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([["Errors: ",
                            ::core::patina_fmt::debug(errors)]]);
        ::core::io::nl();
    };
}
