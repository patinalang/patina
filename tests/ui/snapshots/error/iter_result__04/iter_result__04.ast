// source: patina-by-example/src/error/iter_result.md
// block: 4/5

pub fn main() {
    let strings = ["tofu", "93", "18"];
    let (numbers, errors): ([_], [_]) =
        strings.into_iter().map(|s|
                    s.parse::<int>()).partition(Result::is_ok);
    println!("Numbers: {:?}", numbers);
    println!("Errors: {:?}", errors);
}
