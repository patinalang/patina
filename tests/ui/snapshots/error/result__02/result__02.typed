fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Hello World!" as str)] as [str; 1])]
                as [[str; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
