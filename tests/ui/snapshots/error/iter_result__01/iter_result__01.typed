fn main() ({
    let strings = ([("tofu" as str), ("93" as str), ("18" as str)] as [str]);
    let numbers: [_] =
        ((((strings as [str]).into_iter() as
                    {type error}).map((|s|
                    ((s as {type error}).parse::<int>() as {type error}) as
                    {closure@tests/ui/src/error/iter_result__01.pt:8:14: 8:17}))
                as {type error}).collect() as {type error});
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Results: " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((numbers as {type error})) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
