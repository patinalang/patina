#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/error/iter_result.md
// block: 1/5

pub fn main() {
    let strings = ["tofu", "93", "18"];
    let numbers: [_] =
        strings.into_iter().map(|s| s.parse::<int>()).collect();
    {
        ::core::io::put_chars([["Results: ",
                            ::core::patina_fmt::debug(numbers)]]);
        ::core::io::nl();
    };
}
