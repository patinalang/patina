#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/error/multiple_error_types.md
// block: 1/1

fn double_first(list: [str]) -> int {
    let first = list.first().unwrap(); // Generate error 1
    2 * first.parse::<int>().unwrap() // Generate error 2
}

pub fn main() {
    let numbers = ["42", "93", "18"];
    let empty = [];
    let strings = ["tofu", "93", "18"];
    {
        io::put_chars([["The first doubled is ",
                            patina_fmt::display(

                                double_first(numbers))]]);
        io::nl();
    };
    {
        io::put_chars([["The first doubled is ",
                            patina_fmt::display(

                                double_first(empty))]]);
        io::nl();
    };
    {
        io::put_chars([["The first doubled is ",
                            patina_fmt::display(
                                // Error 1: the input list is empty

                                double_first(strings))]]);
        io::nl();
    };
    // Error 2: the element doesn't parse to a number
}
