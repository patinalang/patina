fn fibonacci(n: int)
    ->
        int ({
    let mut current = (0 as int);
    let mut next = (1 as int);
    let mut i = (0 as int);
    (loop {
        (if ((i as int) < (n as int) as bool) {
            ((current, next) =
                (((next as int), ((current as int) + (next as int) as int)) as
                    (int, int)) as (int, int));
            ((i as int) += (1 as int) as int);
        } else { (break as !); } as ())
    } as ())
    (current as int)
} as int)

