#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

pub fn assign() -> int { let mut value = 0; value = 42 }

pub fn assign_op() -> int { let mut value = 40; value += 2 }

pub fn chained_assign() -> int {
    let mut first = 0;
    let mut second = 0;
    first = second = 21
}

fn identity(value: int) -> int { value }

pub fn assign_as_argument() -> int { let mut value = 0; identity(value = 42) }

pub fn assign_as_match_scrutinee() -> int {
    let mut value = 0;
    match value = 42 { 42 => value, _ => 0, }
}

pub fn destructuring_assign() -> int {
    let first;
    let second;
    (first, second) = (40, 2);
    first + second
}

pub fn destructuring_assign_value() -> (int, int) {
    let first;
    let second;
    (first, second) = (40, 2)
}

pub fn swap() -> (int, int) {
    let mut first = 1;
    let mut second = 2;
    (first, second) = (second, first);
    (first, second)
}

pub fn nested(value: ((int, int), (int, int))) -> int {
    let first;
    let second;
    let third;
    ((first, second), (third, _)) = value;
    first + second + third
}

struct Point {
    x: int,
    y: int,
}

pub fn struct_fields() -> int {
    let x;
    let y;
    Point { x, y } = Point { x: 40, y: 2 };
    x + y
}

pub fn assign_coerces_to_var_type() -> (term, int) {
    let first: term;
    let second;
    (first, second) = (40, 2);
    (first, second)
}

pub fn fibonacci(n: int) -> int {
    let mut current = 0;
    let mut next = 1;
    let mut i = 0;
    while i < n { (current, next) = (next, current + next); i += 1; }
    current
}

pub fn discard() -> int { _ = 42 }

pub fn parenthesized_struct_in_scrutinee() -> int {
    let x;
    let y;
    match (Point { x, y } = Point { x: 1, y: 2 }) {
        Point { x: 1, .. } => x + y,
        _ => 0,
    }
}

pub fn assign_in_boolean_context() -> bool {
    let mut value = false;
    if value = true { value } else { false }
}

pub fn empty_block() {}

pub fn block_ending_in_let() { let _value = 42; }

pub fn block_ending_in_uninitialized_let() { let _value: int; }

pub fn block_ending_in_let_else(value: int) {
    let 42 = value else { return; };
}

pub fn block_ending_in_unit_expr() { (); }

pub fn block_ending_in_assignment() { let mut value = 0; value = 42; }

pub fn block_ending_in_destructuring_assignment() {
    let _first;
    (_first, _) = (1, 2);
}
