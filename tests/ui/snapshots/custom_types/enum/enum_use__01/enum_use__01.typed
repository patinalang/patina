// source: patina-by-example/src/custom_types/enum/enum_use.md
// block: 1/1

// An attribute to hide warnings for unused code.
#![allow(dead_code)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;
#[allow(unused)]
extern mod patina_fmt;

enum Stage { Beginner, Advanced, }

enum Role { Student, Teacher, }

fn main() ({
    // Explicitly `use` each name so they are available without
    // manual scoping.
    use ::{};
    use Stage::Beginner;
    use Stage::Advanced;
    // Automatically `use` each name inside `Role`.
    use Role::*;

    // Equivalent to `Stage::Beginner`.
    let stage = (Beginner as Stage);
    // Equivalent to `Role::Student`.
    let role = (Student as Role);

    (match (stage as Stage) {

            // Note the lack of scoping because of the explicit `use` above.
            Beginner =>
            // Note again the lack of scoping.
            {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("Beginners are starting their learning journey!"
                                    as str)] as [str])] as [[str]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
        Advanced => {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("Advanced learners are mastering their subjects..."
                                    as str)] as [str])] as [[str]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
    } as ())
    (match (role as Role) {
        Student => {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("Students are acquiring knowledge!"
                                    as str)] as [str])] as [[str]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
        Teacher => {
            ((::Core::io::put_chars as
                    fn(term) -> term)(([([("Teachers are spreading knowledge!"
                                    as str)] as [str])] as [[str]])) as term);
            ((::Core::io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
