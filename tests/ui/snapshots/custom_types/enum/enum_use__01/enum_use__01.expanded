// An attribute to hide warnings for unused code.
#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

enum Stage { Beginner, Advanced, }

enum Role { Student, Teacher, }

pub fn main() {
    // Explicitly `use` each name so they are available without
    // manual scoping.
    use Stage::{Beginner, Advanced};
    // Automatically `use` each name inside `Role`.
    use Role::*;
    // Equivalent to `Stage::Beginner`.
    let stage = Beginner;
    // Equivalent to `Role::Student`.
    let role = Student;

    match stage {

            // Note the lack of scoping because of the explicit `use` above.
            Beginner => {
            io::put_chars([["Beginners are starting their learning journey!"]]);
            io::nl();
        }
        Advanced => {
            io::put_chars([["Advanced learners are mastering their subjects..."]]);
            io::nl();
        }
    }

    match role {

            // Note again the lack of scoping.
            Student => {
            io::put_chars([["Students are acquiring knowledge!"]]);
            io::nl();
        }
        Teacher => {
            io::put_chars([["Teachers are spreading knowledge!"]]);
            io::nl();
        }
    }
}
