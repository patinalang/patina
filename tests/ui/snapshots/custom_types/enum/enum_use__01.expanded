// An attribute to hide warnings for unused code.
#![allow(dead_code)]
#[lang = "pointee_sized"]
pub trait PointeeSized { }
#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }
#[lang = "sized"]
pub trait Sized: MetaSized { }
#[lang = "copy"]
pub trait Copy { }
#[allow(unused)]
extern mod io;
#[macro_export]
macro_rules! println { ($s:literal) => {{ io::format("~s~n", [$s]); }}; }

enum Stage { Beginner, Advanced, }

enum Role { Student, Teacher, }

pub fn main() {
    // Explicitly `use` each name so they are available without
    // manual scoping.
    use Stage::{Beginner, Advanced};
    // Automatically `use` each name inside `Role`.
    use Role::*;
    // Equivalent to `Stage::Beginner`.
    let stage = Beginner;
    // Equivalent to `Role::Student`.
    let role = Student;

    match stage {

            // Note the lack of scoping because of the explicit `use` above.
            Beginner => {
            io::format("~s~n",
                ["Beginners are starting their learning journey!"]);
        }
        Advanced => {
            io::format("~s~n",
                ["Advanced learners are mastering their subjects..."]);
        }
    }

    match role {

            // Note again the lack of scoping.
            Student => {
            io::format("~s~n", ["Students are acquiring knowledge!"]);
        }
        Teacher => {
            io::format("~s~n", ["Teachers are spreading knowledge!"]);
        }
    }
}
