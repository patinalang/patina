#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/enum/literal_enums.md
// block: 1/2

enum AtomEnum { Foo = (a"hello_foo" as atom), Bar = (a"hello_bar" as atom), }

enum IntEnum { Ok = (200 as int), NotFound = (404 as int), }

enum StrEnum { Peter = ("Peter" as str), Paul = ("Paul" as str), }

fn main() ({
    // literal enums can be safely cast to their underlying type
    // a"hello_foo"

    // 404

    // "Peter"
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((AtomEnum::Foo as AtomEnum) as atom as
                                    atom)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((IntEnum::NotFound as IntEnum) as int as
                                    int)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((StrEnum::Peter as StrEnum) as str as
                                    str)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
