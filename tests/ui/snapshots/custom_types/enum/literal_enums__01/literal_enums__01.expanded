#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/enum/literal_enums.md
// block: 1/2

enum AtomEnum { Foo = a"hello_foo", Bar = a"hello_bar", }

enum IntEnum { Ok = 200, NotFound = 404, }

enum StrEnum { Peter = "Peter", Paul = "Paul", }

pub fn main() {
    {
        io::put_chars([[patina_fmt::debug(
                                // literal enums can be safely cast to their underlying type
                                AtomEnum::Foo as atom)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"hello_foo"

                                IntEnum::NotFound as int)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // 404

                                StrEnum::Peter as str)]]);
        io::nl();
    };
    // "Peter"
}
