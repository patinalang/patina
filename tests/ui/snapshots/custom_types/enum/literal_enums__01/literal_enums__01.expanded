#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/custom_types/enum/literal_enums.md
// block: 1/2

enum AtomEnum { Foo = a"hello_foo", Bar = a"hello_bar", }

enum IntEnum { Ok = 200, NotFound = 404, }

enum StrEnum { Peter = "Peter", Paul = "Paul", }

pub fn main() {
    // literal enums can be safely cast to their underlying type
    // a"hello_foo"

    // 404

    // "Peter"
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(AtomEnum::Foo as
                                    atom)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(IntEnum::NotFound as
                                    int)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(StrEnum::Peter as
                                    str)]]);
        ::core::io::nl();
    };
}
