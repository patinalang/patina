// An attribute to hide warnings for unused code.
#![allow(dead_code)]
#![attr = Feature([no_core#0, lang_items#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]
#[attr = Lang(PointeeSized)]
trait PointeeSized { }
#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }
#[attr = Lang(Sized)]
trait Sized: MetaSized { }
#[attr = Lang(Copy)]
trait Copy { }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

enum Stage { Beginner, Advanced, }

enum Role { Student, Teacher, }

fn main() ({
    // Explicitly `use` each name so they are available without
    // manual scoping.
    use ::{};
    use Stage::Beginner;
    use Stage::Advanced;
    // Automatically `use` each name inside `Role`.
    use Role::*;

    // Equivalent to `Stage::Beginner`.
    let stage = (Beginner as Stage);
    // Equivalent to `Role::Student`.
    let role = (Student as Role);

    (match (stage as Stage) {

            // Note the lack of scoping because of the explicit `use` above.
            Beginner => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Beginners are starting their learning journey!"
                                    as str)] as [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Advanced => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Advanced learners are mastering their subjects..."
                                    as str)] as [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())

    (match (role as Role) {

            // Note again the lack of scoping.
            Student => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Students are acquiring knowledge!"
                                    as str)] as [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        Teacher => {
            ((io::put_chars as
                    fn(term) -> term)(([([("Teachers are spreading knowledge!"
                                    as str)] as [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
    } as ())
} as ())
