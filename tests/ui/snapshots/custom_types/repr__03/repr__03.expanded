#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/custom_types/repr.md
// block: 3/14

struct Unit;

#[repr(atom, tag = "custom_name")]
struct CustomNameUnit;

// repr settings on an enum are inherited by variants
#[repr(tag_style = "snake_case")]
enum NotJustUnits {
    VariantA,

    #[repr(tag = "variantB")]
    VariantB,
    VariantC(int),
}

// Explicitly setting `#[repr(atom)]` will ensure that only unit variants
// are ever added to an enum.
#[repr(atom, tag_style = "snake_case")]
enum OnlyUnits { VariantA, VariantB, VariantC, }

pub fn main() {
    // a"Elixir.Patina.ByExample.Unit"

    // a"custom_name"

    // a"variant_a"

    // a"variantB"
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(Unit as term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(CustomNameUnit as
                                    term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(NotJustUnits::VariantA
                                    as term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(NotJustUnits::VariantB
                                    as term)]]);
        ::core::io::nl();
    };
}
