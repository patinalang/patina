#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 3/12

#[repr(tagged)]
enum TaggedEnum {
    Unit,
    TupleStyle(str),
    StructStyle {
        x: int,
        y: int,
    },

    WithUnitElem((), int),
    WithOneUnitElem(()),

    #[repr(name = "custom_tag")]
    WithCustomTag(int),
}

pub fn main() {
    {
        io::put_chars([[patina_fmt::debug(
                                // In every representation, unit variants with are always encoded
                                // directly as atoms.
                                TaggedEnum::Unit as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"Elixir.Patina.ByExample.TaggedEnum.Unit"

                                // Both tuple- and struct-style variants are represented as tagged tuples.
                                TaggedEnum::TupleStyle("hello") as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.TupleStyle", "hello")

                                TaggedEnum::StructStyle { x: 1, y: 2 } as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.StructStyle", 1, 2)

                                // Unit elements are omitted in the runtime representation. If all elements
                                // of the variant are unit type, the variant is represented directly
                                // as an atom.
                                TaggedEnum::WithUnitElem((), 42) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.WithUnitElem", 42)

                                TaggedEnum::WithOneUnitElem(()) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"Elixir.Patina.ByExample.TaggedEnum.WithOneUnitElem"

                                // You can set a custom tag by specifying it with `#[repr(name = "...")]`.
                                TaggedEnum::WithCustomTag(42) as term)]]);
        io::nl();
    };
    // (a"my_tag", 42)
}
