#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 3/14

struct Unit;

#[attr = Repr {reprs: [Atom], modifiers: [Tag("custom_name")]}]
struct CustomNameUnit;

// repr settings on an enum are inherited by variants
#[attr = Repr {reprs: [], modifiers: [TagStyle(SnakeCase)]}]
enum NotJustUnits {
    VariantA,
    #[attr = Repr {reprs: [],
    modifiers: [Tag("variantB")]}]
    VariantB,
    VariantC(int),
}

// Explicitly setting `#[repr(atom)]` will ensure that only unit variants
// are ever added to an enum.
#[attr = Repr {reprs: [Atom], modifiers: [TagStyle(SnakeCase)]}]
enum OnlyUnits { VariantA, VariantB, VariantC, }

fn main() ({
    // a"Elixir.Patina.ByExample.Unit"

    // a"custom_name"

    // a"variant_a"

    // a"variantB"
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((Unit as Unit) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((CustomNameUnit as CustomNameUnit) as
                                    term as term)) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((NotJustUnits::VariantA as NotJustUnits)
                                    as term as term)) as term)] as [term])] as [[term]])) as
            term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((NotJustUnits::VariantB as NotJustUnits)
                                    as term as term)) as term)] as [term])] as [[term]])) as
            term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
