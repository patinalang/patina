#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 3/12

#[attr = Repr {reprs: []}]
enum TaggedEnum {
    Unit,
    TupleStyle(str),
    StructStyle {
            x: int,
            y: int,
        },

    WithUnitElem((), int),
    WithOneUnitElem(()),

    #[attr = Repr {reprs: []}]
    WithCustomTag(int),
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // In every representation, unit variants with are always encoded
                                // directly as atoms.
                                ((TaggedEnum::Unit as TaggedEnum) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // a"Elixir.Patina.ByExample.TaggedEnum.Unit"

                                // Both tuple- and struct-style variants are represented as tagged tuples.
                                (((TaggedEnum::TupleStyle as
                                            fn(str) -> TaggedEnum {TaggedEnum::TupleStyle})(("hello" as
                                            str)) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.TupleStyle", "hello")

                                ((TaggedEnum::StructStyle { x: (1 as int), y: (2 as int) }
                                        as TaggedEnum) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.StructStyle", 1, 2)

                                // Unit elements are omitted in the runtime representation. If all elements
                                // of the variant are unit type, the variant is represented directly
                                // as an atom.
                                (((TaggedEnum::WithUnitElem as
                                            fn((), int) -> TaggedEnum {TaggedEnum::WithUnitElem})((() as
                                            ()), (42 as int)) as TaggedEnum) as term as term)) as term)]
                        as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.WithUnitElem", 42)

                                (((TaggedEnum::WithOneUnitElem as
                                            fn(()) -> TaggedEnum {TaggedEnum::WithOneUnitElem})((() as
                                            ())) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // a"Elixir.Patina.ByExample.TaggedEnum.WithOneUnitElem"

                                // You can set a custom tag by specifying it with `#[repr(name = "...")]`.
                                (((TaggedEnum::WithCustomTag as
                                            fn(int) -> TaggedEnum {TaggedEnum::WithCustomTag})((42 as
                                            int)) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // (a"my_tag", 42)
} as ())
