#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 5/14

#[repr(tagged)]
enum TaggedEnum {
    Unit,
    TupleStyle(str),
    StructStyle {
        x: int,
        y: int,
    },

    #[repr(atom)]
    UnitWithAtomOverride,

    #[repr(tag = "custom_tag")]
    WithCustomTag(int),
}

pub fn main() {
    use TaggedEnum::*;
    // Unit inherits #[repr(tagged)] from the enum setting.
    // (a"Elixir.Patina.ByExample.TaggedEnum.Unit")

    // UnitWithAtomOverride overrides the enum repr.
    // a"Elixir.Patina.ByExample.TaggedEnum.UnitWithAtomOverride"

    // Both tuple- and struct-style variants are represented as tagged tuples.
    // (a"Elixir.Patina.ByExample.TaggedEnum.TupleStyle", "hello")

    // (a"Elixir.Patina.ByExample.TaggedEnum.StructStyle", 1, 2)

    // You can set a custom tag by specifying it with `#[repr(tag = "...")]`.
    // (a"custom_tag", 42)
    {
        ::core::io::put_chars([[patina_fmt::debug(Unit as term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::debug(UnitWithAtomOverride as
                                    term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::debug(TaggedEnum::TupleStyle("hello")
                                    as term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::debug(TaggedEnum::StructStyle {
                                        x: 1,
                                        y: 2,
                                    } as term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[patina_fmt::debug(TaggedEnum::WithCustomTag(42)
                                    as term)]]);
        ::core::io::nl();
    };
}
