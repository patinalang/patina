#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 5/14

#[attr = Repr {reprs: [Tagged]}]
enum TaggedEnum {
    Unit,
    TupleStyle(str),
    StructStyle {
            x: int,
            y: int,
        },

    #[attr = Repr {reprs: [Atom]}]
    UnitWithAtomOverride,

    #[attr = Repr {reprs: [Tag("custom_tag")]}]
    WithCustomTag(int),
}

fn main() ({
    use TaggedEnum::*;
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(

                                // Unit inherits #[repr(tagged)] from the enum setting.
                                ((Unit as TaggedEnum) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.Unit")

                                // UnitWithAtomOverride overrides the enum repr.
                                ((UnitWithAtomOverride as TaggedEnum) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // a"Elixir.Patina.ByExample.TaggedEnum.UnitWithAtomOverride"

                                // Both tuple- and struct-style variants are represented as tagged tuples.
                                (((TaggedEnum::TupleStyle as
                                            fn(str) -> TaggedEnum {TaggedEnum::TupleStyle})(("hello" as
                                            str)) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.TupleStyle", "hello")

                                ((TaggedEnum::StructStyle { x: (1 as int), y: (2 as int) }
                                        as TaggedEnum) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"Elixir.Patina.ByExample.TaggedEnum.StructStyle", 1, 2)

                                // You can set a custom tag by specifying it with `#[repr(tag = "...")]`.
                                (((TaggedEnum::WithCustomTag as
                                            fn(int) -> TaggedEnum {TaggedEnum::WithCustomTag})((42 as
                                            int)) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // (a"custom_tag", 42)
} as ())
