#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 5/14

#[attr = Repr {reprs: [Tagged], modifiers: []}]
enum TaggedEnum {
    Unit,
    TupleStyle(str),
    StructStyle {
            x: int,
            y: int,
        },

    #[attr = Repr {reprs: [Atom],
    modifiers: []}]
    UnitWithAtomOverride,

    #[attr = Repr {reprs: [],
    modifiers: [Tag("custom_tag")]}]
    WithCustomTag(int),
}

fn main() ({
    use TaggedEnum::*;

    // Unit inherits #[repr(tagged)] from the enum setting.
    // (a"Elixir.Patina.ByExample.TaggedEnum.Unit")

    // UnitWithAtomOverride overrides the enum repr.
    // a"Elixir.Patina.ByExample.TaggedEnum.UnitWithAtomOverride"

    // Both tuple- and struct-style variants are represented as tagged tuples.
    // (a"Elixir.Patina.ByExample.TaggedEnum.TupleStyle", "hello")

    // (a"Elixir.Patina.ByExample.TaggedEnum.StructStyle", 1, 2)

    // You can set a custom tag by specifying it with `#[repr(tag = "...")]`.
    // (a"custom_tag", 42)
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((Unit as TaggedEnum) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((UnitWithAtomOverride as TaggedEnum) as
                                    term as term)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((TaggedEnum::TupleStyle as
                                            fn(str) -> TaggedEnum {TaggedEnum::TupleStyle})(("hello" as
                                            str)) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((TaggedEnum::StructStyle {
                                        x: (1 as int), y: (2 as int) } as TaggedEnum) as term as
                                    term)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((TaggedEnum::WithCustomTag as
                                            fn(int) -> TaggedEnum {TaggedEnum::WithCustomTag})((42 as
                                            int)) as TaggedEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
