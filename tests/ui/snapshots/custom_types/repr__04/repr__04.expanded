#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/custom_types/repr.md
// block: 4/14

#[repr(tagged)]
struct Pair(int, float);

#[repr(tagged, tag = "Elixir.BarBar")]
struct Bar;

pub fn main() {
    // (a"Elixir.Patina.ByExample.Pair", 42, 3.14)

    // (a"Elixir.BarBar")
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(Pair(42, 3.14) as
                                    term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(Bar as term)]]);
        ::core::io::nl();
    };
}
