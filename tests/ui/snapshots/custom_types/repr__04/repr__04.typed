#[attr = Repr {reprs: [Tagged], modifiers: [Tag("Elixir.BarBar")]}]
struct Bar;

fn main() ({
    // (a"Elixir.Patina.ByExample.Pair", 42, 3.14)

    // (a"Elixir.BarBar")
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)((((Pair as
                                            fn(int, float) -> Pair {Pair})((42 as int), (3.14 as float))
                                        as Pair) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)(((Bar as Bar) as term as term)) as term)]
                        as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
