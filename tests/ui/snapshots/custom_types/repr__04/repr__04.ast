// source: patina-by-example/src/custom_types/repr.md
// block: 4/12

#[repr(tagged, style = "snake_case")]
enum SnakeCaseEnum {
    UnitVariant,
    StructHTTPStyle {
        code: int,
        body: str,
    },
}

pub fn main() {
    println!("{:?}", SnakeCaseEnum::UnitVariant as term);
    // a"unit_variant"

    println!("{:?}", SnakeCaseEnum::StructHTTPStyle{code: 200, body: "hi"} as
    term);
    // (a"struct_http_style", 200, "hi")
}
