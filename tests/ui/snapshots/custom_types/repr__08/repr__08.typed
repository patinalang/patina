#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 8/14

#[attr = Repr {reprs: [Elixir], modifiers: []}]
struct Point {
    x: int,
    y: int,
}

#[attr = Repr {reprs: [Transparent], modifiers: []}]
enum TransparentEnum {
    IntVariant(int),
    PointVariant {
            point: Point,
        },
}

// Compiling this enum will result in an error, as the variants
// are not uniquely distinguishable at runtime:
//
// #[repr(transparent)]
// enum InvalidTransparentEnum {
//     MyName,
//     OrAtom(atom)
// }

fn main() ({
    use TransparentEnum::*;

    // 200

    // #{ a"__struct__" => a"Elixir.Patina.ByExample.Point", a"x" => 1, a"y" => 2 }
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((IntVariant as
                                            fn(int) -> TransparentEnum {TransparentEnum::IntVariant})((200
                                            as int)) as TransparentEnum) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((PointVariant {
                                        point: (Point { x: (1 as int), y: (2 as int) } as Point) }
                                        as TransparentEnum) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
