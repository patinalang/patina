#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 8/14

#[repr(Elixir)]
struct Point {
    x: int,
    y: int,
}

#[repr(transparent)]
enum TransparentEnum {
    IntVariant(int),
    PointVariant {
        point: Point,
    },
}

// Compiling this enum will result in an error, as the variants
// are not uniquely distinguishable at runtime:
//
// #[repr(transparent)]
// enum InvalidTransparentEnum {
//     MyName,
//     OrAtom(atom)
// }

pub fn main() {
    use TransparentEnum::*;
    // 200

    // #{ a"__struct__" => a"Elixir.Patina.ByExample.Point", a"x" => 1, a"y" => 2 }
    {
        ::Core::io::put_chars([[patina_fmt::debug(IntVariant(200) as term)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::debug(PointVariant {
                                        point: Point { x: 1, y: 2 },
                                    } as term)]]);
        ::Core::io::nl();
    };
}
