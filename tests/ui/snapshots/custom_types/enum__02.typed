#![allow(internal_features)]
#![attr = Feature([no_core#0, lang_items#0])]
#![attr = NoStd]
#![attr = NoCore]

#[attr = Lang(PointeeSized)]
trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused)]
extern mod io;

#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println { ($s:literal) => { io::format("~s~n", [$s]) }; }

// source: patina-by-example/src/custom_types/enum.md
// block: 2/3

enum VeryVerboseEnumOfThingsToDoWithNumbers { Add, Subtract, }

// Creates a type alias
type Operations = VeryVerboseEnumOfThingsToDoWithNumbers;

fn main() ({
    // We can refer to each variant via its alias, not its long and inconvenient
    // name.
    let x = (Operations::Add as VeryVerboseEnumOfThingsToDoWithNumbers);
} as ())
