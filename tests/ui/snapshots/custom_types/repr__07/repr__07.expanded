#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 7/14

// Omitting repr is equivalent to `#[repr(Patina)]`.
// In a special case of a single-element struct, it's also equivalent to `#[repr(transparent)]`.
struct Celsius(float);

pub fn main() {
    // 2.345
    {
        io::put_chars([[patina_fmt::debug(Celsius(2.345) as term)]]);
        io::nl();
    };
}
