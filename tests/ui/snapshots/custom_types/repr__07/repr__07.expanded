#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/custom_types/repr.md
// block: 7/14

// Omitting repr is equivalent to `#[repr(Patina)]`.
// In a special case of a single-element struct, it's also equivalent to `#[repr(transparent)]`.
struct Celsius(float);

pub fn main() {
    // 2.345
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(Celsius(2.345) as
                                    term)]]);
        ::core::io::nl();
    };
}
