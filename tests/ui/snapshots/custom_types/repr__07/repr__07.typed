// source: patina-by-example/src/custom_types/repr.md
// block: 7/14

// Omitting repr is equivalent to `#[repr(Patina)]`.
// In a special case of a single-element struct, it's also equivalent to `#[repr(transparent)]`.
struct Celsius(float);

fn main() ({
    // 2.345
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Celsius as
                                            fn(float) -> Celsius {Celsius})((2.345 as float)) as
                                        Celsius) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
