// An attribute to hide warnings for unused code.
#![allow(dead_code)]
#[lang = "pointee_sized"]
pub trait PointeeSized { }
#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }
#[lang = "sized"]
pub trait Sized: MetaSized { }
#[lang = "copy"]
pub trait Copy { }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }
#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// TODO: Uncomment this once we have a way to derive Debug for structs
// #[derive(Debug)]
struct Person {
    name: str,
    age: int,
}

// A unit struct
struct Unit;

// A tuple struct
struct Pair(int, float);

// A struct with two fields
struct Point {
    x: float,
    y: float,
}

// Structs can be reused as fields of another struct
struct Rectangle {
    // A rectangle can be specified by where the top left and bottom right
    // corners are in space.
    top_left: Point,
    bottom_right: Point,
}

pub fn main() {
    // Create struct with field init shorthand
    let name = "Peter";
    let age = 27;
    let peter = Person { name, age };
    {
        io::put_chars([[patina_fmt::debug(

                                // Print debug struct
                                peter)]]);
        io::nl();
    };

    // Instantiate a `Point`
    let point: Point = Point { x: 5.2, y: 0.4 };
    let another_point: Point = Point { x: 10.3, y: 0.2 };
    {
        io::put_chars([["point coordinates: (",
                            patina_fmt::display(

                                // Access the fields of the point
                                point.x), ", ", patina_fmt::display(point.y), ")"]]);
        io::nl();
    };

    // Make a new point by using struct update syntax to use the fields of our
    // other one
    let bottom_right = Point { x: 10.3, ..another_point };
    {
        io::put_chars([["second point: (",
                            patina_fmt::display(

                                // `bottom_right.y` will be the same as `another_point.y` because we used that field
                                // from `another_point`
                                bottom_right.x), ", ", patina_fmt::display(bottom_right.y),
                            ")"]]);
        io::nl();
    };

    // Destructure the point using a `let` binding
    let Point { x: left_edge, y: top_edge } = point;

    let _rectangle =
        Rectangle {
            // struct instantiation is an expression too
            top_left: Point { x: left_edge, y: top_edge },
            bottom_right,
        };

    // Instantiate a unit struct
    let _unit = Unit;

    // Instantiate a tuple struct
    let pair = Pair(1, 0.1);
    {
        io::put_chars([["pair contains ",
                            patina_fmt::debug(

                                // Access the fields of a tuple struct
                                pair.0), " and ", patina_fmt::debug(pair.1)]]);
        io::nl();
    };

    // Destructure a tuple struct
    let Pair(integer, decimal) = pair;
    {
        io::put_chars([["pair contains ",
                            patina_fmt::debug(

                                integer), " and ", patina_fmt::debug(decimal)]]);
        io::nl();
    };
}
