#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 10/14

#[attr = Repr {reprs: [NativeRecord]}]
enum NativeRecordEnum {
    Point(int, int),

    #[attr = Repr {reprs: [Tag("custom_name")]}]
    WithCustomName(float),
}

// For structs (not enums!) you can reference an existing, external native record.
// The record's existence and fields will be checked on module load.
// Note that `#[repr(record_module = "...")]` does *not* influence the name of the
// module that will hold the struct's implementation.
// For that, use `#[module = "..."]`.
#[attr = Repr {reprs: [NativeRecord, RecordModule("external_module"),
Tag("custom_name")]}]
struct NativeRecordStruct {
    foo: str,
}

extern mod records;
fn main() ({
    let point =
        ((NativeRecordEnum::Point as
                fn(int, int) -> NativeRecordEnum {NativeRecordEnum::Point})((1
                as int), (2 as int)) as NativeRecordEnum);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // The field names of a tuple-structs and -variants are atomized integers.
                                ((records::get_field_names as
                                        fn(term) -> term)((point as NativeRecordEnum)) as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // [a"0", a"1"]

    let rect =
        (NativeRecordStruct { foo: ("bar" as str) } as NativeRecordStruct);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((records::get_field_names as
                                        fn(term) -> term)((rect as NativeRecordStruct)) as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // [a"foo"]
} as ())
