#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 10/12

#[repr(tagged)]
pub enum Result<T, E> {

    #[repr(name = "ok")]
    Ok(T),

    #[repr(name = "error")]
    Err(E),
}

pub fn main() {
    {
        io::put_chars([[patina_fmt::debug(Result::<int, str>::Ok(42)), "    ",
                            patina_fmt::debug(Result::<int, str>::Err("reason"))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"ok", 42)    (a"error", "reason")

                                // The unit elision rule lets us directly represent `:ok | {:error, reason}`
                                Result::<(), str>::Ok(())), "    ",
                            patina_fmt::debug(Result::<(), str>::Err("reason"))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"ok"    (a"error", "reason")

                                // Elixir's `Map.fetch` result `{:ok, val} | :error` can also be represented
                                Result::<int, ()>::Ok(42)), "    ",
                            patina_fmt::debug(Result < int)]]);
        io::nl();
    };
    // (a"ok", 42)    a"error"
}
