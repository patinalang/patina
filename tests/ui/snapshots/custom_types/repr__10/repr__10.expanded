#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 10/14

#[repr(native_record)]
enum NativeRecordEnum {
    Point(int, int),

    #[repr(tag = "custom_name")]
    WithCustomName(float),
}

// For structs (not enums!) you can reference an existing, external native record.
// The record's existence and fields will be checked on module load.
// Note that `#[repr(record_module = "...")]` does *not* influence the name of the
// module that will hold the struct's implementation.
// For that, use `#[module = "..."]`.
#[repr(native_record, record_module = "external_module", tag = "custom_name")]
struct NativeRecordStruct {
    foo: str,
}

extern mod records;
pub fn main() {
    let point = NativeRecordEnum::Point(1, 2);
    {
        io::put_chars([[patina_fmt::debug(
                                // The field names of a tuple-structs and -variants are atomized integers.
                                records::get_field_names(point))]]);
        io::nl();
    };
    // [a"0", a"1"]

    let rect = NativeRecordStruct { foo: "bar" };
    {
        io::put_chars([[patina_fmt::debug(records::get_field_names(rect))]]);
        io::nl();
    };
    // [a"foo"]
}
