// source: patina-by-example/src/custom_types/repr.md
// block: 10/12

#[repr(tagged)]
pub enum Result<T, E> {

    #[repr(name = "ok")]
    Ok(T),

    #[repr(name = "error")]
    Err(E),
}

pub fn main() {
    println!("{:?}    {:?}", Result::<int, str>::Ok(42), Result::<int,
    str>::Err("reason"));
    // (a"ok", 42)    (a"error", "reason")

    // The unit elision rule lets us directly represent `:ok | {:error, reason}`
    println!("{:?}    {:?}", Result::<(), str>::Ok(()), Result::<(),
    str>::Err("reason"));
    // a"ok"    (a"error", "reason")

    // Elixir's `Map.fetch` result `{:ok, val} | :error` can also be represented
    println!("{:?}    {:?}", Result::<int, ()>::Ok(42), Result<int,
    ()>::Err(()));
    // (a"ok", 42)    a"error"
}
