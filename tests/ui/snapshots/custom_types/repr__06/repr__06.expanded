#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 6/14

#[repr(tagged, tag_style = "snake_case")]
enum SnakeCaseEnum {

    #[repr(atom)]
    UnitVariant,
    StructHTTPStyle {
        code: int,
        body: str,
    },
}

pub fn main() {
    // a"unit_variant"

    // (a"struct_http_style", 200, "hi")
    {
        ::Core::io::put_chars([[patina_fmt::debug(SnakeCaseEnum::UnitVariant
                                    as term)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::debug(SnakeCaseEnum::StructHTTPStyle {
                                        code: 200,
                                        body: "hi",
                                    } as term)]]);
        ::Core::io::nl();
    };
}
