#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 6/14

#[attr = Repr {reprs: [Tagged], modifiers: [TagStyle(SnakeCase)]}]
enum SnakeCaseEnum {
    #[attr = Repr {reprs: [Atom],
    modifiers: []}]
    UnitVariant,
    StructHTTPStyle {
            code: int,
            body: str,
        },
}

fn main() ({
    // a"unit_variant"

    // (a"struct_http_style", 200, "hi")
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((SnakeCaseEnum::UnitVariant as
                                        SnakeCaseEnum) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((SnakeCaseEnum::StructHTTPStyle {
                                        code: (200 as int), body: ("hi" as str) } as SnakeCaseEnum)
                                    as term as term)) as term)] as [term])] as [[term]])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
