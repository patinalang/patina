#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 6/14

#[attr = Repr {reprs: [Tagged, TagStyle(SnakeCase)]}]
enum SnakeCaseEnum {
    #[attr = Repr {reprs: [Atom]}]
    UnitVariant,
    StructHTTPStyle {
            code: int,
            body: str,
        },
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((SnakeCaseEnum::UnitVariant as
                                        SnakeCaseEnum) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // a"unit_variant"

                                ((SnakeCaseEnum::StructHTTPStyle {
                                        code: (200 as int), body: ("hi" as str) } as SnakeCaseEnum)
                                    as term as term)) as term)] as [term])] as [[term]])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // (a"struct_http_style", 200, "hi")
} as ())
