#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

enum BasicEnum {
    Unit,
    Tuple(int, str),
    Struct {
        x: int,
        y: str,
    },
}

pub fn main() {
    let x = BasicEnum::Unit;
    let y = BasicEnum::Tuple(1, "hello");
    let z = BasicEnum::Struct { x: 1, y: "hello" };
    {
        io::put_chars([[patina_fmt::debug(

                                x), "\n", patina_fmt::debug(y), "\n",
                            patina_fmt::debug(z)]]);
        io::nl();
    };
}
