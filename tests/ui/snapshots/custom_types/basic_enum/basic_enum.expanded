#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

enum BasicEnum {
    Unit,
    Tuple(int, str),
    Struct {
        x: int,
        y: str,
    },
}

pub fn main() {
    let x = BasicEnum::Unit;
    let y = BasicEnum::Tuple(1, "hello");
    let z = BasicEnum::Struct { x: 1, y: "hello" };

    {
        ::core::io::put_chars([[::core::patina_fmt::debug(x), "\n",
                            ::core::patina_fmt::debug(y), "\n",
                            ::core::patina_fmt::debug(z)]]);
        ::core::io::nl();
    };
}
