#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

enum BasicEnum {
    Unit,
    Tuple(int, str),
    Struct {
        x: int,
        y: str,
    },
}

pub fn main() {
    let x = BasicEnum::Unit;
    let y = BasicEnum::Tuple(1, "hello");
    let z = BasicEnum::Struct { x: 1, y: "hello" };

    {
        io::put_chars([[patina_fmt::debug(x), "\n", patina_fmt::debug(y),
                            "\n", patina_fmt::debug(z)]]);
        io::nl();
    };
}
