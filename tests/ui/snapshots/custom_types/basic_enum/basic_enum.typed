#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

enum BasicEnum {
    Unit,
    Tuple(int, str),
    Struct {
            x: int,
            y: str,
        },
}

fn main() ({
    let x = (BasicEnum::Unit as BasicEnum);
    let y =
        ((BasicEnum::Tuple as
                fn(int, str) -> BasicEnum {BasicEnum::Tuple})((1 as int),
            ("hello" as str)) as BasicEnum);
    let z =
        (BasicEnum::Struct { x: (1 as int), y: ("hello" as str) } as
            BasicEnum);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((x as BasicEnum)) as term), ("\n" as str),
                            ((patina_fmt::debug as fn(term) -> term)((y as BasicEnum))
                                as term), ("\n" as str),
                            ((patina_fmt::debug as fn(term) -> term)((z as BasicEnum))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
