#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]



#![allow(dead_code)]
#[allow(unused_imports)]
#[macro_use]
extern crate core;
#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

extern mod erlang;

// Every call reports an event so the Elixir tests can check multiplicity.
// Evaluation order is undefined; the tests compare the events as a multiset.
fn effect<T>(event: atom, value: T) -> T {
    erlang::send(erlang::self(), (a"side_effect", event));
    value
}

macro_rules! record_cases {
    ($record:ident, $repr:meta) =>
    {
        #[$repr] pub struct $record { x: int, y: int, z: int, } impl $record
        {
            pub fn fields() -> term
            {
                $record
                {
                    z: effect(a"z", 30), x: effect(a"x", 10), y:
                    effect(a"y", 20),

                } as term
            } pub fn base() -> term
            {
                $record
                {
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                        // More than one field is inherited from the same base call.
                    })
                } as term
            } pub fn update() -> term
            {
                $record
                {
                    x: 10,
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                    })
                } as term
            } pub fn mixed() -> term
            {
                $record
                {
                    z: effect(a"z", 30), x: effect(a"x", 10),
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                    })
                } as term
            } pub fn replace() -> term
            {
                $record
                {
                    z: effect(a"z", 30), x: effect(a"x", 10), y:
                    effect(a"y", 20),
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                        // The base call still has effects when none of its fields are inherited.
                    })
                } as term
            }
        }
    };
}
#[

repr(Patina)]
pub struct PatinaRecord {
    x: int,
    y: int,
    z: int,
}
impl PatinaRecord {
    pub fn fields() -> term {
        PatinaRecord {
                z: effect(a"z", 30),
                x: effect(a"x", 10),
                y: effect(a"y", 20),
            } as term
    }
    pub fn base() -> term {
        PatinaRecord { ..effect(a"base", PatinaRecord { x: 1, y: 2, z: 3 }) }
            as term
    }
    pub fn update() -> term {
        PatinaRecord {
                x: 10,
                ..effect(a"base", PatinaRecord { x: 1, y: 2, z: 3 })
            } as term
    }
    pub fn mixed() -> term {
        PatinaRecord {
                z: effect(a"z", 30),
                x: effect(a"x", 10),
                ..effect(a"base", PatinaRecord { x: 1, y: 2, z: 3 })
            } as term
    }
    pub fn replace() -> term {
        PatinaRecord {
                z: effect(a"z", 30),
                x: effect(a"x", 10),
                y: effect(a"y", 20),
                ..effect(a"base", PatinaRecord { x: 1, y: 2, z: 3 })
            } as term
    }
}
