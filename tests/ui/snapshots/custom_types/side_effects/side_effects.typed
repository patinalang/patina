#[attr = Repr {reprs: [Transparent], modifiers: []}]
struct Transparent {
    value: int,
}

impl Transparent {
    fn fields()
        ->
            term ({
        ((Transparent {
                value:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"field" as atom),
                        (10 as int)) as int) } as Transparent) as term as term)
    } as term)

    fn base()
        ->
            term ({
        ((Transparent {
                ..((effect as
                            fn(atom, Transparent) -> Transparent {effect::<Transparent>})((a"base"
                            as atom),
                        (Transparent { value: (1 as int) } as Transparent)) as
                        Transparent) } as Transparent) as term as term)
    } as term)

    fn update()
        ->
            term ({
        ((Transparent {
                value:
                    (10 as
                        int),
                    ..((effect as
                            fn(atom, Transparent) -> Transparent {effect::<Transparent>})((a"base"
                            as atom),
                        (Transparent { value: (1 as int) } as Transparent)) as
                        Transparent) } as Transparent) as term as term)
    } as term)

    fn mixed()
        ->
            term ({
        ((Transparent {
                value:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"field" as atom),
                        (10 as int)) as
                        int),
                    ..((effect as
                            fn(atom, Transparent) -> Transparent {effect::<Transparent>})((a"base"
                            as atom),
                        (Transparent { value: (1 as int) } as Transparent)) as
                        Transparent) } as Transparent) as term as term)
    } as term)
}

// An atom has no fields, but its base expression must still be evaluated.
#[attr = Repr {reprs: [Atom], modifiers: []}]
struct AtomUnit {
}

impl AtomUnit {
    fn base()
        ->
            term ({
        ((AtomUnit {
                ..((effect as
                            fn(atom, AtomUnit) -> AtomUnit {effect::<AtomUnit>})((a"base"
                            as atom), (AtomUnit {  } as AtomUnit)) as AtomUnit) } as
                AtomUnit) as term as term)
    } as term)
}

#[attr = Repr {reprs: [Transparent], modifiers: []}]
enum Dynamic {
    #[attr = Repr {reprs: [],
    modifiers: [DynamicWrap,
    Tag("dynamic")]}]
    Value {
            value: term,
        },
    Text(str),
}

// Enum variants have field expressions but do not support struct updates.
impl Dynamic {
    fn fields(value: term)
        ->
            term ({
        ((Dynamic::Value {
                value:
                    ((effect as
                            fn(atom, term) -> term {effect::<term>})((a"field" as atom),
                        (value as term)) as term) } as Dynamic) as term as term)
    } as term)
}

mod Tuples {
    use super::effect;

    fn fields()
        ->
            (int, int,
            int) ({
        ((((effect as
                    fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                (10 as int)) as int),
            ((effect as
                    fn(atom, int) -> int {effect::<int>})((a"y" as atom),
                (20 as int)) as int),
            ((effect as
                    fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                (30 as int)) as int)) as (int, int, int))
    } as (int, int, int))

    // Tuples have no update syntax; a call can be the base of field access.
    fn base()
        ->
            int ({
        (((effect as
                    fn(atom, (int, int, int)) -> (int, int, int) {effect::<(int, int, int)>})((a"base"
                    as atom),
                (((1 as int), (2 as int), (3 as int)) as (int, int, int))) as
                (int, int, int)).1 as int)
    } as int)

    fn mixed()
        ->
            (int, int,
            int) ({
        ((((effect as
                    fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                (10 as int)) as int),
            (((effect as
                        fn(atom, (int, int, int)) -> (int, int, int) {effect::<(int, int, int)>})((a"base"
                        as atom),
                    (((1 as int), (2 as int), (3 as int)) as (int, int, int)))
                    as (int, int, int)).1 as int),
            ((effect as
                    fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                (30 as int)) as int)) as (int, int, int))
    } as (int, int, int))
}

mod Maps {
    use super::effect;

    fn fields()
        ->
            #{atom => int} ({
        (#{((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"x_key" as atom),
                    (a"x" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                    (10 as int)) as int),
                ((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"y_key" as atom),
                    (a"y" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"y" as atom),
                    (20 as int)) as int),
                ((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"z_key" as atom),
                    (a"z" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                    (30 as int)) as int)} as #{atom => int})
    } as #{atom => int})

    fn base()
        ->
            #{atom => int} ({
        (#{..((effect as
                        fn(atom, #{atom => int}) -> #{atom => int} {effect::<#{atom => int}>})((a"base"
                        as atom),
                    (#{(a"x" as atom) => (1 as int), (a"y" as atom) =>
                            (2 as int), (a"z" as atom) => (3 as int)} as
                        #{atom => int})) as #{atom => int})} as #{atom => int})
    } as #{atom => int})

    fn update()
        ->
            #{atom => int} ({
        (#{(a"x" as atom) => (10 as int),
                ..((effect as
                        fn(atom, #{atom => int}) -> #{atom => int} {effect::<#{atom => int}>})((a"base"
                        as atom),
                    (#{(a"x" as atom) => (1 as int), (a"y" as atom) =>
                            (2 as int), (a"z" as atom) => (3 as int)} as
                        #{atom => int})) as #{atom => int})} as #{atom => int})
    } as #{atom => int})

    fn mixed()
        ->
            #{atom => int} ({
        (#{((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"z_key" as atom),
                    (a"z" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                    (30 as int)) as int),
                ((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"x_key" as atom),
                    (a"x" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                    (10 as int)) as int),
                ..((effect as
                        fn(atom, #{atom => int}) -> #{atom => int} {effect::<#{atom => int}>})((a"base"
                        as atom),
                    (#{(a"x" as atom) => (1 as int), (a"y" as atom) =>
                            (2 as int), (a"z" as atom) => (3 as int)} as
                        #{atom => int})) as #{atom => int})} as #{atom => int})
    } as #{atom => int})

    fn replace()
        ->
            #{atom => int} ({
        (#{((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"z_key" as atom),
                    (a"z" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                    (30 as int)) as int),
                ((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"x_key" as atom),
                    (a"x" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                    (10 as int)) as int),
                ((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"y_key" as atom),
                    (a"y" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"y" as atom),
                    (20 as int)) as int),
                ..((effect as
                        fn(atom, #{atom => int}) -> #{atom => int} {effect::<#{atom => int}>})((a"base"
                        as atom),
                    (#{(a"x" as atom) => (1 as int), (a"y" as atom) =>
                            (2 as int), (a"z" as atom) => (3 as int)} as
                        #{atom => int})) as #{atom => int})} as #{atom => int})
    } as #{atom => int})

    fn duplicate()
        ->
            #{atom => int} ({
        (#{((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"key" as atom),
                    (a"x" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"value" as atom),
                    (10 as int)) as int),
                ((effect as
                        fn(atom, atom) -> atom {effect::<atom>})((a"key" as atom),
                    (a"x" as atom)) as atom) =>
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"value" as atom),
                    (20 as int)) as int)} as #{atom => int})
    } as #{atom => int})
}

