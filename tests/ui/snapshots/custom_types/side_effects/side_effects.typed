// Every call reports an event so the Elixir tests can check multiplicity.
// Evaluation order is undefined; the tests compare the events as a multiset.
fn effect<T>(event: atom, value: T)
    ->
        T ({
    ((erlang::send as
            fn(term, term) -> term)(((erlang::self as fn() -> term)() as
            term),
        (((a"side_effect" as atom), (event as atom)) as (atom, atom))) as
        term);
    (value as T)
} as T)

macro_rules! record_cases {
    ($record:ident, $repr:meta) =>
    {
        #[$repr] pub struct $record { x: int, y: int, z: int, } impl $record
        {
            pub fn fields() -> term
            {
                $record
                {
                    z: effect(a"z", 30), x: effect(a"x", 10), y:
                    effect(a"y", 20),

                } as term
            } pub fn base() -> term
            {
                $record
                {
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                        // More than one field is inherited from the same base call.
                    })
                } as term
            } pub fn update() -> term
            {
                $record
                {
                    x: 10,
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                    })
                } as term
            } pub fn mixed() -> term
            {
                $record
                {
                    z: effect(a"z", 30), x: effect(a"x", 10),
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                    })
                } as term
            } pub fn replace() -> term
            {
                $record
                {
                    z: effect(a"z", 30), x: effect(a"x", 10), y:
                    effect(a"y", 20),
                    ..effect(a"base", $record
                    {
                        x: 1, y: 2, z: 3

                        // The base call still has effects when none of its fields are inherited.
                    })
                } as term
            }
        }
    };
}
#[attr = Repr {reprs: [Patina], modifiers: []}]
struct PatinaRecord {
    x: int,
    y: int,
    z: int,
}
impl PatinaRecord {
    fn fields()
        ->
            term ({
        ((PatinaRecord {
                z:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                        (30 as int)) as int),
                x:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                        (10 as int)) as int),
                y:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"y" as atom),
                        (20 as int)) as int) } as PatinaRecord) as term as term)
    } as term)
    fn base()
        ->
            term ({
        ((PatinaRecord {
                ..((effect as
                            fn(atom, PatinaRecord) -> PatinaRecord {effect::<PatinaRecord>})((a"base"
                            as atom),
                        (PatinaRecord { x: (1 as int), y: (2 as int), z: (3 as int)
                            } as PatinaRecord)) as PatinaRecord) } as PatinaRecord) as
            term as term)
    } as term)
    fn update()
        ->
            term ({
        ((PatinaRecord {
                x:
                    (10 as
                        int),
                    ..((effect as
                            fn(atom, PatinaRecord) -> PatinaRecord {effect::<PatinaRecord>})((a"base"
                            as atom),
                        (PatinaRecord { x: (1 as int), y: (2 as int), z: (3 as int)
                            } as PatinaRecord)) as PatinaRecord) } as PatinaRecord) as
            term as term)
    } as term)
    fn mixed()
        ->
            term ({
        ((PatinaRecord {
                z:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                        (30 as int)) as int),
                x:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                        (10 as int)) as
                        int),
                    ..((effect as
                            fn(atom, PatinaRecord) -> PatinaRecord {effect::<PatinaRecord>})((a"base"
                            as atom),
                        (PatinaRecord { x: (1 as int), y: (2 as int), z: (3 as int)
                            } as PatinaRecord)) as PatinaRecord) } as PatinaRecord) as
            term as term)
    } as term)
    fn replace()
        ->
            term ({
        ((PatinaRecord {
                z:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                        (30 as int)) as int),
                x:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                        (10 as int)) as int),
                y:
                    ((effect as
                            fn(atom, int) -> int {effect::<int>})((a"y" as atom),
                        (20 as int)) as
                        int),
                    ..((effect as
                            fn(atom, PatinaRecord) -> PatinaRecord {effect::<PatinaRecord>})((a"base"
                            as atom),
                        (PatinaRecord { x: (1 as int), y: (2 as int), z: (3 as int)
                            } as PatinaRecord)) as PatinaRecord) } as PatinaRecord) as
            term as term)
    } as term)
}
