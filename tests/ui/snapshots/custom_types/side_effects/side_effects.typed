                    (20 as int)) as int),
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"z" as atom),
                    (30 as int)) as int)] as [int])
    } as [int])

    fn base()
        ->
            [int] ({
        ([(0 as int),
                ..((effect as
                        fn(atom, [int]) -> [int] {effect::<[int]>})((a"base" as
                        atom), ([(1 as int), (2 as int), (3 as int)] as [int])) as
                    [int])] as [int])
    } as [int])

    fn mixed()
        ->
            [int] ({
        ([((effect as
                        fn(atom, int) -> int {effect::<int>})((a"x" as atom),
                    (10 as int)) as int),
                ((effect as
                        fn(atom, int) -> int {effect::<int>})((a"y" as atom),
                    (20 as int)) as int),
                ..((effect as
                        fn(atom, [int]) -> [int] {effect::<[int]>})((a"base" as
                        atom), ([(3 as int), (4 as int)] as [int])) as [int])] as
            [int])
    } as [int])

    fn empty_tail()
        ->
            [int] ({
        ([((effect as
                        fn(atom, int) -> int {effect::<int>})((a"field" as atom),
                    (10 as int)) as int),
                ..((effect as
                        fn(atom, [int]) -> [int] {effect::<[int]>})((a"base" as
                        atom), ([] as [int])) as [int])] as [int])
    } as [int])
}
