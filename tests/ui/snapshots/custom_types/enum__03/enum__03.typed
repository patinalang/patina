// source: patina-by-example/src/custom_types/enum.md
// block: 3/3

enum VeryVerboseEnumOfThingsToDoWithNumbers { Add, Subtract, }

impl VeryVerboseEnumOfThingsToDoWithNumbers {
    fn run(self, x: int, y: int)
        ->
            int ({
        (match (self as VeryVerboseEnumOfThingsToDoWithNumbers) {
            Self::Add => ((x as int) + (y as int) as int),
            Self::Subtract => ((x as int) - (y as int) as int),
        } as int)
    } as int)
}
