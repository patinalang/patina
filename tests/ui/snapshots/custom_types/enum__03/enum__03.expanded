#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/custom_types/enum.md
// block: 3/3

enum VeryVerboseEnumOfThingsToDoWithNumbers { Add, Subtract, }

impl VeryVerboseEnumOfThingsToDoWithNumbers {
    fn run(self, x: int, y: int) -> int {
        match self { Self::Add => x + y, Self::Subtract => x - y, }
    }
}
