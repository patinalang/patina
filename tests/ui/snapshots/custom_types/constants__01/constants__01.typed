// Globals are declared outside all other scopes.
const THRESHOLD: int = (10 as int);

fn is_big(n: int)
    ->
        bool ({

    // Access constant in some function
    ((n as int) > (THRESHOLD as int) as bool)
} as bool)

fn main() ({
    let n = (16 as int);


    // Error! Cannot modify a `const`.
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The threshold is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((THRESHOLD as int)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((n as int)) as term), (" is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((if ((is_big as
                                            fn(int) -> bool {is_big})((n as int)) as bool) {
                                    ("big" as str)
                                } else { ("small" as str) } as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ((THRESHOLD as int) = (5 as int) as int);
} as ())
