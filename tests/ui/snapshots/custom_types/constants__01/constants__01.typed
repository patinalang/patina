#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/constants.md
// block: 1/1

// Globals are declared outside all other scopes.
const THRESHOLD: int = (10 as int);

fn is_big(n: int)
    ->
        bool ({

    // Access constant in some function
    ((n as int) > (THRESHOLD as int) as bool)
} as bool)

fn main() ({
    let n = (16 as int);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("The threshold is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)(

                                (THRESHOLD as int)) as term)] as [term; 2])] as
                [[term; 2]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((n as int)) as term), (" is " as str),
                            ((patina_fmt::display as
                                    fn(term) -> term)((if ((is_big as
                                            fn(int) -> bool {is_big})((n as int)) as bool) {
                                    ("big" as str)
                                } else { ("small" as str) } as term)) as term)] as
                        [term; 3])] as [[term; 3]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    // Error! Cannot modify a `const`.
    ((THRESHOLD as int) = (5 as int) as ());
} as ())
