#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/constants.md
// block: 1/1

// Globals are declared outside all other scopes.
const THRESHOLD: int = 10;

fn is_big(n: int) -> bool {
    // Access constant in some function
    n > THRESHOLD
}

pub fn main() {
    let n = 16;


    // Error! Cannot modify a `const`.
    {
        io::put_chars([["The threshold is ",
                            patina_fmt::display(THRESHOLD)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(n), " is ",
                            patina_fmt::display(if is_big(n) {
                                    "big"
                                } else { "small" })]]);
        io::nl();
    };
    THRESHOLD = 5;
}
