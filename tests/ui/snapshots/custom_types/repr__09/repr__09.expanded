#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 9/14

#[repr(transparent)]
enum TransparentWithTags<T> {
    Untagged(str),

    // `MaybeUntagged(T)` values are represented as themselves, except
    // for values that could be mistaken for another variant.
    #[repr(dynamic_wrap, tag = "othertag")]
    MaybeUntagged(T),

    // Individual enum variants can have their own representation set.
    // Tagged(int) will always be tagged with `(a"mytag", _)`.
    #[repr(tagged, tag = "mytag")]
    Tagged(int),
}

pub fn main() {
    use TransparentWithTags::*;
    // A `str` payload could be mistaken for Untagged, so it's wrapped.
    // (a"othertag", "hello")

    // An int payload cannot be mistaken for anything - it stays transparent.
    // 42

    // The decision is per-value, not per-type. Most terms stay transparent...
    // a"hi"

    // ...but a term that looks like another variant is wrapped, too.
    // (a"othertag", (a"othertag", 1))
    {
        ::Core::io::put_chars([[patina_fmt::debug(MaybeUntagged("hello") as
                                    term)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::debug(MaybeUntagged(42) as
                                    term)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::debug(MaybeUntagged(a"hi" as term)
                                    as term)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([[patina_fmt::debug(MaybeUntagged((a"othertag",
                                                1) as term) as term)]]);
        ::Core::io::nl();
    };
}
