#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 9/14

#[repr(transparent)]
enum TransparentWithTags<T> {
    Untagged(str),

    // `MaybeUntagged(T)` values are represented as themselves, except
    // for values that could be mistaken for another variant.
    #[repr(tag = "othertag")]
    MaybeUntagged(T),

    // Individual enum variants can have their own representation set.
    // Tagged(int) will always be tagged with `(a"mytag", _)`.
    #[repr(tagged, tag = "mytag")]
    Tagged(int),
}

pub fn main() {
    use TransparentWithTags::*;
    {
        io::put_chars([[patina_fmt::debug(

                                // A `str` payload could be mistaken for Untagged, so it's wrapped.
                                MaybeUntagged("hello") as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"othertag", "hello")

                                // An int payload cannot be mistaken for anything - it stays transparent.
                                MaybeUntagged(42) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // 42

                                // The decision is per-value, not per-type. Most terms stay transparent...
                                MaybeUntagged(a"hi" as term) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"hi"

                                // ...but a term that looks like another variant is wrapped, too.
                                MaybeUntagged((a"othertag", 1) as term) as term)]]);
        io::nl();
    };
    // (a"othertag", (a"othertag", 1))
}
