#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 9/14

#[attr = Repr {reprs: [Transparent], modifiers: []}]
enum TransparentWithTags<T> {
    Untagged(str),

    // `MaybeUntagged(T)` values are represented as themselves, except
    // for values that could be mistaken for another variant.
    #[attr = Repr {reprs: [],
    modifiers: [DynamicWrap,
    Tag("othertag")]}]
    MaybeUntagged(T),

    // Individual enum variants can have their own representation set.
    // Tagged(int) will always be tagged with `(a"mytag", _)`.
    #[attr = Repr {reprs: [Tagged],
    modifiers: [Tag("mytag")]}]
    Tagged(int),
}

fn main() ({
    use TransparentWithTags::*;

    // A `str` payload could be mistaken for Untagged, so it's wrapped.
    // (a"othertag", "hello")

    // An int payload cannot be mistaken for anything - it stays transparent.
    // 42

    // The decision is per-value, not per-type. Most terms stay transparent...
    // a"hi"

    // ...but a term that looks like another variant is wrapped, too.
    // (a"othertag", (a"othertag", 1))
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((MaybeUntagged as
                                            fn(str) -> TransparentWithTags<str> {TransparentWithTags::<str>::MaybeUntagged})(("hello"
                                            as str)) as TransparentWithTags<str>) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((MaybeUntagged as
                                            fn(int) -> TransparentWithTags<int> {TransparentWithTags::<int>::MaybeUntagged})((42
                                            as int)) as TransparentWithTags<int>) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((MaybeUntagged as
                                            fn(term) -> TransparentWithTags<term> {TransparentWithTags::<term>::MaybeUntagged})(((a"hi"
                                                as atom) as term as term)) as TransparentWithTags<term>) as
                                    term as term)) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((MaybeUntagged as
                                            fn(term) -> TransparentWithTags<term> {TransparentWithTags::<term>::MaybeUntagged})(((((a"othertag"
                                                    as atom), (1 as int)) as (atom, int)) as term as term)) as
                                        TransparentWithTags<term>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
