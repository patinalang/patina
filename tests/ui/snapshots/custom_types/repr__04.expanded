#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 4/12

#[repr(tagged, style = snake_case)]
enum SnakeCaseEnum {
    UnitVariant,
    StructHTTPStyle {
        code: int,
        body: str,
    },
}

pub fn main() {
    {
        io::put_chars([[patina_fmt::debug(SnakeCaseEnum::UnitVariant as
                                    term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"unit_variant"

                                SnakeCaseEnum::StructHTTPStyle { code: 200, body: "hi" } as
                                    term)]]);
        io::nl();
    };
    // (a"struct_http_style", 200, "hi")
}
