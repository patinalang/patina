#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/enum.md
// block: 2/3

enum VeryVerboseEnumOfThingsToDoWithNumbers { Add, Subtract, }

// Creates a type alias
type Operations = VeryVerboseEnumOfThingsToDoWithNumbers;

pub fn main() {
    // We can refer to each variant via its alias, not its long and inconvenient
    // name.
    let x = Operations::Add;
}
