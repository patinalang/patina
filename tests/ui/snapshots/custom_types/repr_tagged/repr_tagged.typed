#![allow(internal_features)]










#![allow(dead_code)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]
#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;
#[allow(unused_imports)]
use Core::*;
#[allow(unused)]
extern mod io;
#[allow(unused)]
extern mod patina_fmt;
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }
#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }
#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}
#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

#[attr = Repr {reprs: [Tagged, TagStyle(SnakeCase)]}]
struct StructHTTPStyle {
    code: int,
    body: str,
}

#[attr = Repr {reprs: [Tagged, Tag("custom_unit")]}]
struct Unit;

#[attr = Repr {reprs: [Tagged]}]
enum TaggedEnum {
    Unit,
    TupleValue(int),
    RecordValue {
            x: int,
            y: int,
        },
    #[attr = Repr {reprs: [Atom]}]
    AtomOverride,
}

#[attr = Repr {reprs: [Tagged]}]
enum ResultShape<T, E> {
    #[attr = Repr {reprs: [Tag("ok")]}]
    Ok(T),
    #[attr = Repr {reprs: [Tag("error")]}]
    Err(E),
}

fn struct_value()
    ->
        StructHTTPStyle ({
    (StructHTTPStyle { body: ("ok" as str), code: (200 as int) } as
        StructHTTPStyle)
} as StructHTTPStyle)

fn struct_code(value: StructHTTPStyle)
    -> int ({ ((value as StructHTTPStyle).code as int) } as int)

fn update_code(value: StructHTTPStyle)
    ->
        StructHTTPStyle ({
    (StructHTTPStyle { code: (201 as int), ..(value as StructHTTPStyle) } as
        StructHTTPStyle)
} as StructHTTPStyle)

fn update_fields(value: StructHTTPStyle)
    ->
        StructHTTPStyle ({
    (StructHTTPStyle {
        body: ("updated" as str),
        code: (202 as int), ..(value as StructHTTPStyle) } as StructHTTPStyle)
} as StructHTTPStyle)

fn destructure_struct(value: StructHTTPStyle)
    ->
        int ({
    let StructHTTPStyle {  code,  body: _ } = (value as StructHTTPStyle);
    (code as int)
} as int)

fn unit_value() -> Unit ({ (Unit as Unit) } as Unit)

fn enum_values()
    ->
        [TaggedEnum] ({
    ([(TaggedEnum::Unit as TaggedEnum),
            ((TaggedEnum::TupleValue as
                    fn(int) -> TaggedEnum {TaggedEnum::TupleValue})((10 as int))
                as TaggedEnum),
            (TaggedEnum::RecordValue { y: (30 as int), x: (20 as int) } as
                TaggedEnum), (TaggedEnum::AtomOverride as TaggedEnum)] as
        [TaggedEnum])
} as [TaggedEnum])

fn enum_payload(value: TaggedEnum)
    ->
        int ({
    (match (value as TaggedEnum) {
        TaggedEnum::Unit => (0 as int),
        TaggedEnum::TupleValue(value) => (value as int),
        TaggedEnum::RecordValue {  x,  y: _ } => (x as int),
        TaggedEnum::AtomOverride => (-(1 as int) as int),
    } as int)
} as int)

fn result_values()
    ->
        [ResultShape<int,
        str>] ({
    ([((ResultShape::<int, str>::Ok as
                    fn(int) -> ResultShape<int, str> {ResultShape::<int, str>::Ok})((42
                    as int)) as ResultShape<int, str>),
            ((ResultShape::<int, str>::Err as
                    fn(str) -> ResultShape<int, str> {ResultShape::<int, str>::Err})(("reason"
                    as str)) as ResultShape<int, str>)] as
        [ResultShape<int, str>])
} as [ResultShape<int, str>])

fn result_payload(value: ResultShape<int, str>)
    ->
        int ({
    (match (value as ResultShape<int, str>) {
        ResultShape::Ok(value) => (value as int),
        ResultShape::Err(_) => (-(1 as int) as int),
    } as int)
} as int)

fn main() ({ } as ())
