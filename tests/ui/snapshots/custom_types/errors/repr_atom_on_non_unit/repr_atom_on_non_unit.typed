#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[attr = Repr {reprs: [Atom], modifiers: []}]
struct NonUnitStruct(int);

enum AtomVariant {
    #[attr = Repr {reprs: [Atom],
    modifiers: []}]
    NonUnit(int),
}

#[attr = Repr {reprs: [Atom], modifiers: []}]
enum InheritedAtom { Unit, NonUnit(int), }

// `PhantomData` fields don't count.
use core::PhantomData;

#[attr = Repr {reprs: [Atom], modifiers: []}]
struct PhantomAtom<T>(PhantomData<T>);

#[attr = Repr {reprs: [Atom], modifiers: []}]
struct PhantomAndValue<T>(PhantomData<T>, int);

fn main() ({ } as ())
