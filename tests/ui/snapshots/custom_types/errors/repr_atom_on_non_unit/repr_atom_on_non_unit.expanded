#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[repr(atom)]
struct NonUnitStruct(int);

enum AtomVariant {

    #[repr(atom)]
    NonUnit(int),
}

#[repr(atom)]
enum InheritedAtom { Unit, NonUnit(int), }

// `PhantomData` fields don't count.
use core::PhantomData;

#[repr(atom)]
struct PhantomAtom<T>(PhantomData<T>);

#[repr(atom)]
struct PhantomAndValue<T>(PhantomData<T>, int);

pub fn main() {}
