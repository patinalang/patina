#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[attr = Repr {reprs: [NativeRecord],
modifiers: [RecordModule("external_records")]}]
enum EnumLevel { Value(int), }

enum InvalidVariant {
    #[attr = Repr {reprs: [Tagged],
    modifiers: [RecordModule("external_records")]}]
    Value(int),
}

#[attr = Repr {reprs: [Elixir],
modifiers: [RecordModule("external_records")]}]
struct NotNativeRecord {
    value: int,
}

fn main() ({ } as ())
