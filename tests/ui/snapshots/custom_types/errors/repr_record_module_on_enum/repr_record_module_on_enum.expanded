#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[repr(native_record, record_module = "external_records")]
enum EnumLevel { Value(int), }

enum InvalidVariant {

    #[repr(tagged, record_module = "external_records")]
    Value(int),
}

#[repr(Elixir, record_module = "external_records")]
struct NotNativeRecord {
    value: int,
}

pub fn main() {}
