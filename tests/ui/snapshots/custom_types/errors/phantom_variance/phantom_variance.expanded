#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// The other direction of each conversion is rejected, and so is a parameter with no use.

use core::PhantomData;

pub struct Source<T>(term, PhantomData<T>);

pub struct Sink<T>(term, PhantomData<fn(T)>);

pub struct Invariant<T>(term, PhantomData<fn(T) -> T>);

pub struct Unused<T>(term);

pub fn narrow_source(source: Source<bin>) -> Source<str> { source }

pub fn widen_sink(sink: Sink<str>) -> Sink<bin> { sink }

pub fn widen_invariant(value: Invariant<str>) -> Invariant<bin> { value }
