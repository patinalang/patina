#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

#[attr = Repr {reprs: [Transparent]}]
struct Unit;

#[attr = Repr {reprs: [Transparent]}]
struct Pair(int, int);

enum InvalidVariants {
    #[attr = Repr {reprs: [Transparent]}]
    Unit,
    #[attr = Repr {reprs: [Transparent]}]
    Pair(int, int),
}

#[attr = Repr {reprs: [Transparent]}]
enum InvalidInheritedVariants { Unit, Pair(int, int), }

#[attr = Repr {reprs: [Transparent]}]
enum SamePrimitiveShape { First(int), Second(int), }

enum OverlappingAtomShapes {
    #[attr = Repr {reprs: [Transparent]}]
    AnyAtom(atom),
    #[attr = Repr {reprs: [Transparent]}]
    Boolean(bool),
}

#[attr = Repr {reprs: [Transparent]}]
enum MultipleOpenShapes<T, U, V> {
    #[attr = Repr {reprs: [DynamicWrap]}]
    First(T),
    #[attr = Repr {reprs: [DynamicWrap]}]
    Second(U),
    #[attr = Repr {reprs: [DynamicWrap]}]
    Third(V),
}

#[attr = Repr {reprs: [Transparent]}]
enum Inner<T> {
    #[attr = Repr {reprs: [DynamicWrap]}]
    Value(T),
}

#[attr = Repr {reprs: [Transparent]}]
enum MultipleNestedOpenShapes<T, U> {
    #[attr = Repr {reprs: [DynamicWrap]}]
    First(Inner<T>),
    #[attr = Repr {reprs: [DynamicWrap]}]
    Second(Inner<U>),
}

#[attr = Repr {reprs: [Transparent]}]
enum MissingDynamicWrap { Open(term), Text(str), }

#[attr = Repr {reprs: [Transparent]}]
enum DynamicWrapOnClosed {
    #[attr = Repr {reprs: [DynamicWrap]}]
    Integer(int),
    Text(str),
}

#[attr = Repr {reprs: [DynamicWrap]}]
enum DynamicWrapOnEnum { Value(int), }

fn main() ({ } as ())
