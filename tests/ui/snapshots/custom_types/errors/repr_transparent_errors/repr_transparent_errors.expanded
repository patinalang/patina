#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

#[repr(transparent)]
struct Unit;

#[repr(transparent)]
struct Pair(int, int);

// `PhantomData` fields don't count: one other field is fine, none is not.
use core::PhantomData;

#[repr(transparent)]
struct PhantomNewtype<T>(int, PhantomData<T>);

#[repr(transparent)]
struct OnlyPhantom<T>(PhantomData<T>);

#[repr(transparent)]
struct PhantomPair<T>(int, PhantomData<T>, int);

#[repr(Patina)]
enum InvalidVariants {

    #[repr(transparent)]
    Unit,

    #[repr(transparent)]
    Pair(int, int),
    Value(int),
}

#[repr(transparent)]
enum InvalidInheritedVariants { Unit, Pair(int, int), }

#[repr(transparent)]
enum SamePrimitiveShape { First(int), Second(int), }

enum OverlappingAtomShapes {

    #[repr(transparent)]
    AnyAtom(atom),

    #[repr(transparent)]
    Boolean(bool),
}

enum DuplicateTaggedShape {

    #[repr(tagged, tag = "same")]
    First(int),

    #[repr(tagged, tag = "same")]
    Second(str),
}

enum OpenWrapperOverlap<T> {

    #[repr(tagged, tag = "same")]
    Tagged(int),

    #[repr(transparent, dynamic_wrap, tag = "same")]
    Open(T),
}

enum DuplicateOpenWrapperShape<T, U> {

    #[repr(transparent, dynamic_wrap, tag = "same")]
    First(T),

    #[repr(transparent, dynamic_wrap, tag = "same")]
    Second(U),
}

#[repr(transparent)]
enum MultipleOpenShapes<T, U, V> {

    #[repr(dynamic_wrap)]
    First(T),

    #[repr(dynamic_wrap)]
    Second(U),

    #[repr(dynamic_wrap)]
    Third(V),
}

#[repr(transparent)]
enum Inner<T> {

    #[repr(dynamic_wrap)]
    Value(T),
}

#[repr(transparent)]
enum MultipleNestedOpenShapes<T, U> {

    #[repr(dynamic_wrap)]
    First(Inner<T>),

    #[repr(dynamic_wrap)]
    Second(Inner<U>),
}

#[repr(transparent)]
enum MissingDynamicWrap { Open(term), Text(str), }

#[repr(transparent)]
enum DynamicWrapOnClosed {

    #[repr(dynamic_wrap)]
    Integer(int),
    Text(str),
}

#[repr(dynamic_wrap)]
enum DynamicWrapOnEnum { Value(int), }

pub fn main() {}
