#[repr(Elixir)]
struct Point {
    x: float,
    y: float,
}

pub fn main() {
    // #{ a"__struct__" => a"Elixir.Patina.ByExample.Point", a"x" => 5.2, a"y" => 0.4 }
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(Point {
                                        x: 5.2,
                                        y: 0.4,
                                    } as term)]]);
        ::core::io::nl();
    };
}
