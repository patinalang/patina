#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 11/14

#[repr(Elixir)]
struct Point {
    x: float,
    y: float,
}

pub fn main() {
    // #{ a"__struct__" => a"Elixir.Patina.ByExample.Point", a"x" => 5.2, a"y" => 0.4 }
    {
        io::put_chars([[patina_fmt::debug(Point { x: 5.2, y: 0.4 } as
                                    term)]]);
        io::nl();
    };
}
