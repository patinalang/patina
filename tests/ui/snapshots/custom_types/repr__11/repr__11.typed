#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 11/12

#[attr = Repr {reprs: [ReprTransparent]}]
enum Option<T> {
    #[attr = Repr {reprs: []}]
    Some(T),

    #[attr = Repr {reprs: []}]
    None,
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((Option::<int>::Some as
                                        fn(int) -> Option<int> {Option::<int>::Some})((42 as int))
                                    as Option<int>)) as term), ("    " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((Option::<int>::None as Option<int>)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // 42    a"nil"

                                // `Option<atom>` cannot be transparent, as `a"nil"` is a valid `Some`
                                ((Option::<atom>::Some as
                                        fn(atom) -> Option<atom> {Option::<atom>::Some})((a"hi" as
                                        atom)) as Option<atom>)) as term), ("    " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((Option::<atom>::None as Option<atom>)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"some", a"hi")    a"nil"

                                // Option<Option<int>> also cannot be transparently represented
                                ((Option::<Option<int>>::Some as
                                        fn(Option<int>) -> Option<Option<int>> {Option::<Option<int>>::Some})(((Some
                                            as {type error})((42 as int)) as {type error})) as
                                    Option<Option<int>>)) as term), ("    " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(((Option::<Option<int>>::Some as
                                        fn(Option<int>) -> Option<Option<int>> {Option::<Option<int>>::Some})((None
                                        as {type error})) as Option<Option<int>>)) as term),
                            ("    " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)((Option::<Option<int>>::None as
                                    Option<Option<int>>)) as term)] as [term])] as [[term]])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // (a"some", 42)    (a"some", a"nil")    a"nil"
} as ())
