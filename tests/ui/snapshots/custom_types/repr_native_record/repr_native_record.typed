#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

#[attr = Repr {reprs: [NativeRecord]}]
enum WholeEnum { Unit, }

enum MixedEnum {
    AtomUnit,
    #[attr = Repr {reprs: [NativeRecord]}]
    RecordUnit,
}

#[attr = Repr {reprs: [Elixir]}]
struct ElixirUnit;

#[attr = Repr {reprs: [NativeRecord]}]
struct NativeRecordStruct {
    x: int,
    y: int,
}

#[attr = Repr {reprs: [NativeRecord]}]
struct NativeRecordPair(int, int);

impl NativeRecordStruct {
    fn sum(self)
        ->
            int ({
        (((self as NativeRecordStruct).x as int) +
            ((self as NativeRecordStruct).y as int) as int)
    } as int)
}

fn inherited_unit()
    -> term ({ ((WholeEnum::Unit as WholeEnum) as term as term) } as term)

fn overridden_unit()
    ->
        term ({ ((MixedEnum::RecordUnit as MixedEnum) as term as term) } as
    term)

fn elixir_unit()
    -> term ({ ((ElixirUnit as ElixirUnit) as term as term) } as term)

fn record_struct()
    ->
        NativeRecordStruct ({
    (NativeRecordStruct { x: (10 as int), y: (20 as int) } as
        NativeRecordStruct)
} as NativeRecordStruct)

fn struct_x(value: NativeRecordStruct)
    -> int ({ ((value as NativeRecordStruct).x as int) } as int)

fn record_pair()
    ->
        NativeRecordPair ({
    ((NativeRecordPair as
            fn(int, int) -> NativeRecordPair {NativeRecordPair})((30 as int),
        (40 as int)) as NativeRecordPair)
} as NativeRecordPair)

fn pair_second(value: NativeRecordPair)
    -> int ({ ((value as NativeRecordPair).1 as int) } as int)
