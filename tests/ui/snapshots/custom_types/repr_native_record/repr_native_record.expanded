#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

#[repr(native_record)]
enum WholeEnum { Unit, }

enum MixedEnum {
    AtomUnit,

    #[repr(native_record)]
    RecordUnit,
}

#[repr(Elixir)]
struct ElixirUnit;

#[repr(native_record)]
pub struct NativeRecordStruct {
    x: int,
    y: int,
}

#[repr(native_record)]
pub struct NativeRecordPair(int, int);

impl NativeRecordStruct {
    pub fn sum(self) -> int { self.x + self.y }
}

pub fn inherited_unit() -> term { WholeEnum::Unit as term }

pub fn overridden_unit() -> term { MixedEnum::RecordUnit as term }

pub fn elixir_unit() -> term { ElixirUnit as term }

pub fn record_struct() -> NativeRecordStruct {
    NativeRecordStruct { x: 10, y: 20 }
}

pub fn struct_x(value: NativeRecordStruct) -> int { value.x }

pub fn record_pair() -> NativeRecordPair { NativeRecordPair(30, 40) }

pub fn pair_second(value: NativeRecordPair) -> int { value.1 }
