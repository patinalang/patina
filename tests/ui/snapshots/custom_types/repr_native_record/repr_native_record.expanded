#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

#[repr(native_record)]
enum WholeEnum { Unit, }

enum MixedEnum {
    AtomUnit,

    #[repr(native_record)]
    RecordUnit,
}

#[repr(Elixir)]
struct ElixirUnit;

pub fn inherited_unit() -> term { WholeEnum::Unit as term }

pub fn overridden_unit() -> term { MixedEnum::RecordUnit as term }

pub fn elixir_unit() -> term { ElixirUnit as term }
