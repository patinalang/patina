extern mod erlang;

#[attr = Repr {reprs: []}]
enum TermToBinaryOpts {
    Compressed(int),
    Deterministic,
    MinorVersion(int),
    Local,
}

fn main() ({
    let opts: [TermToBinaryOpts] =
        ([(Deterministic as {type error}),
                ((MinorVersion as {type error})((2 as int)) as {type error})]
            as [{type error}; 2]);
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((opts as {type error}) as term as
                                    {type error})) as term)] as [term; 1])] as [[term; 1]; 1]))
            as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // [a"deterministic", (a"minor_version", 2)]

                                ((erlang::term_to_binary as
                                        fn(term, term) -> term)((val as {type error}),
                                    (opts as {type error})) as term)) as term)] as [term; 1])]
                as [[term; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // <<131, 97, 42>>
} as ())
