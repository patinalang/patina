#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/custom_types/repr.md
// block: 12/14

#[attr = Repr {reprs: [Tagged], modifiers: []}]
enum Result<T, E> {
    #[attr = Repr {reprs: [],
    modifiers: [Tag("ok")]}]
    Ok(T),

    #[attr = Repr {reprs: [],
    modifiers: [Tag("error")]}]
    Err(E),
}

fn main() ({
    // (a"ok", 42)

    // (a"error", "reason")

    // Note that `Result<T, E>` can't represent a bare `:ok` by itself,
    // but we have helpers for that.
    // a"ok"
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)((((Result::<int, str>::Ok as
                                            fn(int) -> Result<int, str> {Result::<int, str>::Ok})((42 as
                                            int)) as Result<int, str>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)((((Result::<int, str>::Err as
                                            fn(str) -> Result<int, str> {Result::<int, str>::Err})(("reason"
                                            as str)) as Result<int, str>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)(((((Result::<(), str>::Ok as
                                                fn(()) -> Result<(), str> {Result::<(), str>::Ok})((() as
                                                ())) as Result<(), str>).into::<Compat::BareOkResult>() as
                                        {type error}) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
