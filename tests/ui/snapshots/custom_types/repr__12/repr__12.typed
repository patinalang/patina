#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 12/14

#[attr = Repr {reprs: [Tagged], modifiers: []}]
enum Result<T, E> {
    #[attr = Repr {reprs: [],
    modifiers: [Tag("ok")]}]
    Ok(T),

    #[attr = Repr {reprs: [],
    modifiers: [Tag("error")]}]
    Err(E),
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Result::<int, str>::Ok as
                                            fn(int) -> Result<int, str> {Result::<int, str>::Ok})((42 as
                                            int)) as Result<int, str>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"ok", 42)

                                (((Result::<int, str>::Err as
                                            fn(str) -> Result<int, str> {Result::<int, str>::Err})(("reason"
                                            as str)) as Result<int, str>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"error", "reason")

                                // Note that `Result<T, E>` can't represent a bare `:ok` by itself,
                                // but we have helpers for that.
                                ((((Result::<(), str>::Ok as
                                                fn(()) -> Result<(), str> {Result::<(), str>::Ok})((() as
                                                ())) as Result<(), str>).into::<Compat::BareOkResult>() as
                                        {type error}) as term as {type error})) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // a"ok"
} as ())
