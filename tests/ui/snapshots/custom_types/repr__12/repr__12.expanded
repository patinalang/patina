#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 12/14

#[repr(tagged)]
pub enum Result<T, E> {

    #[repr(tag = "ok")]
    Ok(T),

    #[repr(tag = "error")]
    Err(E),
}

pub fn main() {
    // (a"ok", 42)

    // (a"error", "reason")

    // Note that `Result<T, E>` can't represent a bare `:ok` by itself,
    // but we have helpers for that.
    // a"ok"
    {
        io::put_chars([[patina_fmt::debug(Result::<int, str>::Ok(42) as
                                    term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Result::<int, str>::Err("reason") as
                                    term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Result::<(),
                                                str>::Ok(()).into::<Compat::BareOkResult>() as term)]]);
        io::nl();
    };
}
