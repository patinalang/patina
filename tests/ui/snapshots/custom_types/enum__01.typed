trait PointeeSized { }

#[attr = Lang(MetaSized)]
trait MetaSized: PointeeSized { }

#[attr = Lang(Sized)]
trait Sized: MetaSized { }

#[attr = Lang(Copy)]
trait Copy { }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[attr = MacroExport {local_inner_macros: false}]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/enum.md
// block: 1/3

// Create an `enum` to classify a web event. Note how both
// names and type information together specify the variant:
// `PageLoad != PageUnload` and `KeyPress(char) != Paste(str)`.
// Each is different and independent.
enum WebEvent {

    // An `enum` variant may either be `unit-like`,
    PageLoad,
    PageUnload,

    // like tuple structs,
    KeyPress(char),
    Paste(str),

    // or map structures.
    Click {
            x: int,
            y: int,
        },
}

// A function which takes a `WebEvent` enum as an argument and
// returns nothing.
fn inspect(event:
        WebEvent) ({
    (match (event as WebEvent) {
        WebEvent::PageLoad => {
            ((io::put_chars as
                    fn(term) -> term)(([([("page loaded" as str)] as [str; 1])]
                    as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }
        WebEvent::PageUnload => {
            ((io::put_chars as
                    fn(term) -> term)(([([("page unloaded" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        }

            // Destructure `c` from inside the `enum` variant.
            WebEvent::KeyPress(c) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("pressed \'" as str),
                                ((patina_fmt::display as fn(term) -> term)((c as char)) as
                                    term), ("\'." as str)] as [term; 3])] as [[term; 3]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }
        WebEvent::Paste(s) => {
            ((io::put_chars as
                    fn(term) -> term)(([([("pasted \"" as str),
                                ((patina_fmt::display as fn(term) -> term)((s as str)) as
                                    term), ("\"." as str)] as [term; 3])] as [[term; 3]; 1])) as
                term);
            ((io::nl as fn() -> term)() as term);
        }

            // Destructure `Click` into `x` and `y`.
            WebEvent::Click {  x,  y } => {
            ({
                ((io::put_chars as
                        fn(term) -> term)(([([("clicked at x=" as str),
                                    ((patina_fmt::display as fn(term) -> term)((x as int)) as
                                        term), (", y=" as str),
                                    ((patina_fmt::display as fn(term) -> term)((y as int)) as
                                        term), ("." as str)] as [term; 5])] as [[term; 5]; 1])) as
                    term);
                ((io::nl as fn() -> term)() as term);
            } as ());
        }
    } as ())
} as ())

fn main() ({
    let pressed =
        ((WebEvent::KeyPress as
                fn(char) -> WebEvent {WebEvent::KeyPress})(('x' as char)) as
            WebEvent);
    let pasted =
        ((WebEvent::Paste as
                fn(str) -> WebEvent {WebEvent::Paste})(("my text" as str)) as
            WebEvent);
    let click =
        (WebEvent::Click { x: (20 as int), y: (80 as int) } as WebEvent);
    let load = (WebEvent::PageLoad as WebEvent);
    let unload = (WebEvent::PageUnload as WebEvent);

    ((inspect as fn(WebEvent) {inspect})((pressed as WebEvent)) as ());
    ((inspect as fn(WebEvent) {inspect})((pasted as WebEvent)) as ());
    ((inspect as fn(WebEvent) {inspect})((click as WebEvent)) as ());
    ((inspect as fn(WebEvent) {inspect})((load as WebEvent)) as ());
    ((inspect as fn(WebEvent) {inspect})((unload as WebEvent)) as ());
} as ())

