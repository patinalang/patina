#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 13/14

#[repr(transparent)]
pub enum Option<T> {

    #[repr(dynamic_wrap, tag = "some")]
    Some(T),

    #[repr(atom, tag = "nil")]
    None,
}

pub fn main() {
    // 42

    // a"nil"

    // `Option<atom>` is transparent as long as the atom itself is not `nil`.
    // a"hi"
    // (a"some", a"nil")

    // Nested options stay distinguishable: only the values that would be
    // mistaken for `None` are wrapped.
    // 42
    // (a"some", a"nil")
    // a"nil"
    {
        io::put_chars([[patina_fmt::debug(Option::<int>::Some(42) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Option::<int>::None as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Option::<atom>::Some(a"hi") as
                                    term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Option::<atom>::Some(a"nil") as
                                    term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Option::<Option<int>>::Some(Option::Some(42))
                                    as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Option::<Option<int>>::Some(Option::None)
                                    as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(Option::<Option<int>>::None as
                                    term)]]);
        io::nl();
    };
}
