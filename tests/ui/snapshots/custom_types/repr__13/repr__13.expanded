#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 13/14

#[repr(transparent)]
pub enum Option<T> {

    #[repr(tag = "some")]
    Some(T),

    #[repr(atom, tag = "nil")]
    None,
}

pub fn main() {
    {
        io::put_chars([[patina_fmt::debug(Option::<int>::Some(42) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // 42

                                Option::<int>::None as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"nil"

                                // `Option<atom>` is transparent as long as the atom itself is not `nil`.
                                Option::<atom>::Some(a"hi") as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // a"hi"
                                Option::<atom>::Some(a"nil") as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"some", a"nil")

                                // Nested options stay distinguishable: only the values that would be
                                // mistaken for `None` are wrapped.
                                Option::<Option<int>>::Some(Some(42)) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // 42
                                Option::<Option<int>>::Some(None) as term)]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::debug(
                                // (a"some", a"nil")
                                Option::<Option<int>>::None as term)]]);
        io::nl();
    };
    // a"nil"
}
