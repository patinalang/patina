#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/custom_types/repr.md
// block: 13/14

#[attr = Repr {reprs: [Transparent], modifiers: []}]
enum Option<T> {
    #[attr = Repr {reprs: [],
    modifiers: [DynamicWrap,
    Tag("some")]}]
    Some(T),

    #[attr = Repr {reprs: [Atom],
    modifiers: [Tag("nil")]}]
    None,
}

fn main() ({
    // 42

    // a"nil"

    // `Option<atom>` is transparent as long as the atom itself is not `nil`.
    // a"hi"
    // (a"some", a"nil")

    // Nested options stay distinguishable: only the values that would be
    // mistaken for `None` are wrapped.
    // 42
    // (a"some", a"nil")
    // a"nil"
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Option::<int>::Some as
                                            fn(int) -> Option<int> {Option::<int>::Some})((42 as int))
                                        as Option<int>) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((Option::<int>::None as Option<int>) as
                                    term as term)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Option::<atom>::Some as
                                            fn(atom) -> Option<atom> {Option::<atom>::Some})((a"hi" as
                                            atom)) as Option<atom>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Option::<atom>::Some as
                                            fn(atom) -> Option<atom> {Option::<atom>::Some})((a"nil" as
                                            atom)) as Option<atom>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Option::<Option<int>>::Some as
                                            fn(Option<int>) -> Option<Option<int>> {Option::<Option<int>>::Some})(((Option::Some
                                                as
                                                fn(int) -> Option<int> {Option::<int>::Some})((42 as int))
                                            as Option<int>)) as Option<Option<int>>) as term as term))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Option::<Option<int>>::Some as
                                            fn(Option<int>) -> Option<Option<int>> {Option::<Option<int>>::Some})((Option::None
                                            as Option<int>)) as Option<Option<int>>) as term as term))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(((Option::<Option<int>>::None as
                                        Option<Option<int>>) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
