#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 13/14

#[attr = Repr {reprs: [ReprTransparent]}]
enum Option<T> {
    #[attr = Repr {reprs: []}]
    Some(T),

    #[attr = Repr {reprs: []}]
    None,
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)((((Option::<int>::Some as
                                            fn(int) -> Option<int> {Option::<int>::Some})((42 as int))
                                        as Option<int>) as term as term)) as term)] as [term])] as
                [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // 42

                                ((Option::<int>::None as Option<int>) as term as term)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // a"nil"

                                // `Option<atom>` is transparent as long as the atom itself is not `nil`.
                                (((Option::<atom>::Some as
                                            fn(atom) -> Option<atom> {Option::<atom>::Some})((a"hi" as
                                            atom)) as Option<atom>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // a"hi"
                                (((Option::<atom>::Some as
                                            fn(atom) -> Option<atom> {Option::<atom>::Some})((a"nil" as
                                            atom)) as Option<atom>) as term as term)) as term)] as
                        [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"some", a"nil")

                                // Nested options stay distinguishable: only the values that would be
                                // mistaken for `None` are wrapped.
                                (((Option::<Option<int>>::Some as
                                            fn(Option<int>) -> Option<Option<int>> {Option::<Option<int>>::Some})(((Some
                                                as {type error})((42 as int)) as {type error})) as
                                        Option<Option<int>>) as term as term)) as term)] as [term])]
                as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // 42
                                (((Option::<Option<int>>::Some as
                                            fn(Option<int>) -> Option<Option<int>> {Option::<Option<int>>::Some})((None
                                            as {type error})) as Option<Option<int>>) as term as term))
                                as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(
                                // (a"some", a"nil")
                                ((Option::<Option<int>>::None as Option<Option<int>>) as
                                    term as term)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    // a"nil"
} as ())
