#[attr = Repr {reprs: [Tagged], modifiers: [TagStyle(SnakeCase)]}]
enum TermToBinaryOpts {
    Compressed(int),
    #[attr = Repr {reprs: [Atom],
    modifiers: []}]
    Deterministic,
    MinorVersion(int),
    #[attr = Repr {reprs: [Atom],
