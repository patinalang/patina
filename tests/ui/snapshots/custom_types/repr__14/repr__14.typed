}

fn main() ({
    let opts: [TermToBinaryOpts] =
        ([(Deterministic as {type error}),
                ((MinorVersion as {type error})((2 as int)) as {type error})]
            as [{type error}]);
    // [a"deterministic", (a"minor_version", 2)]

    // <<131, 97, 42>>
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)(((opts as {type error}) as term as
                                    {type error})) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::debug as
                                    fn(term) -> term)(((erlang::term_to_binary as
                                        fn(term, term) -> term)((42 as int), (opts as {type error}))
                                    as term)) as term)] as [term])] as [[term]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
