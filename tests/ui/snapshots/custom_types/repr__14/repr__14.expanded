#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/custom_types/repr.md
// block: 14/14

extern mod erlang;

#[repr(tagged, tag_style = "snake_case")]
pub enum TermToBinaryOpts {
    Compressed(int),

    #[repr(atom)]
    Deterministic,
    MinorVersion(int),

    #[repr(atom)]
    Local,
}

pub fn main() {
    let opts: [TermToBinaryOpts] = [Deterministic, MinorVersion(2)];
    // [a"deterministic", (a"minor_version", 2)]

    // <<131, 97, 42>>
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(opts as term)]]);
        ::core::io::nl();
    };
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(erlang::term_to_binary(42,
                                    opts))]]);
        ::core::io::nl();
    };
}
