#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/custom_types/repr.md
// block: 14/14

extern mod erlang;

#[repr(tagged, tag_style = "snake_case")]
pub enum TermToBinaryOpts {
    Compressed(int),

    #[repr(atom)]
    Deterministic,
    MinorVersion(int),

    #[repr(atom)]
    Local,
}

pub fn main() {
    let opts: [TermToBinaryOpts] = [Deterministic, MinorVersion(2)];
    { io::put_chars([[patina_fmt::debug(opts as term)]]); io::nl(); };
    {
        io::put_chars([[patina_fmt::debug(
                                // [a"deterministic", (a"minor_version", 2)]

                                erlang::term_to_binary(42, opts))]]);
        io::nl();
    };
    // <<131, 97, 42>>
}
