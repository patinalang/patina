#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/macros/repeat.md
// block: 1/1

// `find_min!` will calculate the minimum of any number of arguments.
macro_rules! find_min {
    ($x:expr) => ($x); ($x:expr, $($y:expr),+) =>
    (Std::Cmp::min($x, find_min!($($y),+)))
    // Base case:
    // `$x` followed by at least one `$y,`
    // Call `find_min!` on the tail `$y`
}

pub fn main() {
    { io::put_chars([[patina_fmt::display(1)]]); io::nl(); };
    {
        io::put_chars([[patina_fmt::display(Std::Cmp::min(1 + 2, 2))]]);
        io::nl();
    };
    {
        io::put_chars([[patina_fmt::display(Std::Cmp::min(5,
                                    Std::Cmp::min(2 * 3, 4)))]]);
        io::nl();
    };
}
