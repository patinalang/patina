#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/macros/repeat.md
// block: 1/1

// `find_min!` will calculate the minimum of any number of arguments.
macro_rules! find_min {
    ($x:expr) => ($x); ($x:expr, $($y:expr),+) =>
    (Std::Cmp::min($x, find_min!($($y),+)))
    // Base case:
    // `$x` followed by at least one `$y,`
    // Call `find_min!` on the tail `$y`
}

fn main() ({
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((1 as int)) as term)] as [term])] as
                [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((Std::Cmp::min as
                                        {type error})(((1 as int) + (2 as int) as int), (2 as int))
                                    as {type error})) as term)] as [term])] as [[term]])) as
            term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((::Core::io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((Std::Cmp::min as
                                        {type error})((5 as int),
                                    ((Std::Cmp::min as
                                            {type error})(((2 as int) * (3 as int) as int), (4 as int))
                                        as {type error})) as {type error})) as term)] as [term])] as
                [[term]])) as term);
        ((::Core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
