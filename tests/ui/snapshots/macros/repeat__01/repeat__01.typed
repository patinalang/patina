#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/repeat.md
// block: 1/1

// `find_min!` will calculate the minimum of any number of arguments.
macro_rules! find_min {
    ($x:expr) => ($x); ($x:expr, $($y:expr),+) =>
    (Std::Cmp::min($x, find_min!($($y),+)))
    // Base case:
    // `$x` followed by at least one `$y,`
    // Call `find_min!` on the tail `$y`
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)((1 as int)) as term)] as [term; 1])] as
                [[term; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((Std::Cmp::min as
                                        {type error})(((1 as int) + (2 as int) as int), (2 as int))
                                    as {type error})) as term)] as [term; 1])] as
                [[term; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::display as
                                    fn(term) -> term)(((Std::Cmp::min as
                                        {type error})((5 as int),
                                    ((Std::Cmp::min as
                                            {type error})(((2 as int) * (3 as int) as int), (4 as int))
                                        as {type error})) as {type error})) as term)] as [term; 1])]
                as [[term; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
