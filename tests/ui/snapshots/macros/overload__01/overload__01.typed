#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/overload.md
// block: 1/1

// `test!` will compare `$left` and `$right`
// in different ways depending on how you invoke it:
macro_rules! test {
    ($left:expr; and $right:expr) =>
    {
        println!("{:?} and {:?} is {:?}", stringify!($left),
        stringify!($right), $left && $right)
        // Arguments don't need to be separated by a comma.
        // Any template can be used!
    }; ($left:expr; or $right:expr) =>
    {
        println!("{:?} or {:?} is {:?}", stringify!($left),
        stringify!($right), $left || $right)
        // ^ each arm must end with a semicolon.
    };
}

fn main() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(("1 + 1 == 2" as str)) as term),
                            (" and " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(("2 * 2 == 4" as str)) as term),
                            (" is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(((((1 as int) + (1 as int) as int) ==
                                        (2 as int) as bool) &&
                                    (((2 as int) * (2 as int) as int) == (4 as int) as bool) as
                                    bool)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(("true" as str)) as term),
                            (" or " as str),
                            ((patina_fmt::debug as fn(term) -> term)(("false" as str))
                                as term), (" is " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(((true as bool) || (false as bool) as
                                    bool)) as term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
