#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/macros/dsl.md
// block: 1/1

macro_rules! calculate {
    (eval $e:expr) =>
    {
        {
            let val: int = $e;
            println!("{} = {}",
            stringify!{$e // Force types to integers
            }, val);
        }
    };
}

pub fn main() {
    {
        let val: int = 1 + 2; // hehehe `eval` is _not_ a Patina keyword!

        {
            ::Core::io::put_chars([[patina_fmt::display("1 + 2"), " = ",
                                patina_fmt::display(val)]]);
            ::Core::io::nl();
        };
    }
    {
        let val: int = (1 + 2) * (3 / 4);
        {
            ::Core::io::put_chars([[patina_fmt::display("(1 + 2) * (3 / 4)"),
                                " = ", patina_fmt::display(val)]]);
            ::Core::io::nl();
        };
    }
}
