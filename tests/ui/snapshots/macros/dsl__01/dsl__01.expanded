#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/dsl.md
// block: 1/1

macro_rules! calculate {
    (eval $e:expr) =>
    {
        {
            let val: int = $e;
            println!("{} = {}",
            stringify!{$e // Force types to integers
            }, val);
        }
    };
}

pub fn main() {
    {
        let val: int = 1 + 2;
        {
            io::put_chars([[patina_fmt::display("1 + 2"), " = ",
                                patina_fmt::display(val)]]);
            io::nl();
        };
    }
    {
        let val: int =  // hehehe `eval` is _not_ a Patina keyword!

            (1 + 2) * (3 / 4);
        {
            io::put_chars([[patina_fmt::display("(1 + 2) * (3 / 4)"), " = ",
                                patina_fmt::display(val)]]);
            io::nl();
        };
    }
}
