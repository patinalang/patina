#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/dsl.md
// block: 1/1

macro_rules! calculate {
    (eval $e:expr) =>
    {
        {
            let val: int = $e;
            println!("{} = {}",
            stringify!{$e // Force types to integers
            }, val);
        }
    };
}

fn main() ({
    ({
        let val: int = ((1 as int) + (2 as int) as int);
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([((patina_fmt::display as
                                        fn(term) -> term)(("1 + 2" as str)) as term),
                                (" = " as str),
                                ((patina_fmt::display as fn(term) -> term)((val as int)) as
                                    term)] as [term; 3])] as [[term; 3]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
    ({
        let val: int =  // hehehe `eval` is _not_ a Patina keyword!

            ((((1 as int) + (2 as int) as int)) *
                (((3 as int) / (4 as int) as int)) as int);
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([((patina_fmt::display as
                                        fn(term) -> term)(("(1 + 2) * (3 / 4)" as str)) as term),
                                (" = " as str),
                                ((patina_fmt::display as fn(term) -> term)((val as int)) as
                                    term)] as [term; 3])] as [[term; 3]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
} as ())
