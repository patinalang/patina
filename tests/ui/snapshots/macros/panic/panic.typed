#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

fn explicit_panic()
    ->
        int ({







    (unsafe {
        (((::core::erlang::error as
                    fn(term, term, term) -> term)(((::core::Panic::new as
                        fn(str) -> core::Panic {core::Panic::new})(("explicit panic"
                        as str)) as core::Panic), (a"none" as atom),
                ([(((a"error_info" as atom),
                            (#{(a"module" as atom) =>
                                    (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                            as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                as term).cast_unchecked::<!>() as !)
    } as int)
} as int)
