fn panic_in_let_else(map: #{int => int})
    ->
        int ({
    let #{(1 as int) => value, ..} = (map as #{int => int}) else
        {
        (unsafe {
            (((::core::erlang::error as
                        fn(term, term, term) -> term)(((::core::Panic::new as
                            fn(str) -> core::Panic {core::Panic::new})(("missing key" as
                            str)) as core::Panic), (a"none" as atom),
                    ([(((a"error_info" as atom),
                                (#{(a"module" as atom) =>
                                        (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                                as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                    as term).cast_unchecked::<!>() as !)
        } as !)
    };
    (value as int)
} as int)
