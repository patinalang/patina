fn panic_in_loop(limit: int)
    ->
        int ({
    let mut i = (0 as int);
    (loop {
        (if ((i as int) == (limit as int) as bool) {
            (unsafe {
                (((::core::erlang::error as
                            fn(term, term, term) -> term)(((::core::Panic::new as
                                fn(str) -> core::Panic {core::Panic::new})(("reached the limit"
                                as str)) as core::Panic), (a"none" as atom),
                        ([(((a"error_info" as atom),
                                    (#{(a"module" as atom) =>
                                            (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                                    as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                        as term).cast_unchecked::<!>() as !)
            } as ())
        } as ())
        ((i as int) += (1 as int) as int);
    } as !)
} as int)
fn panic_in_nested_loop(limit: int)
    ->
        int ({
    let mut i = (0 as int);
    (loop {
        let mut j = (0 as int);
        (loop {
            (if ((j as int) < (limit as int) as bool) {
                (if ((i as int) == (limit as int) as bool) {
                    (unsafe {
                        (((::core::erlang::error as
                                    fn(term, term, term) -> term)(((::core::Panic::new as
                                        fn(str) -> core::Panic {core::Panic::new})(("reached the limit"
                                        as str)) as core::Panic), (a"none" as atom),
                                ([(((a"error_info" as atom),
                                            (#{(a"module" as atom) =>
                                                    (a"Elixir.Patina.Core.Panic" as atom)} as #{atom => atom}))
                                            as (atom, #{atom => atom}))] as [(atom, #{atom => atom})]))
                                as term).cast_unchecked::<!>() as !)
                    } as ())
                } as ())
                ((j as int) += (1 as int) as int);
            } else { (break as !); } as ())
        } as ())
        ((i as int) += (1 as int) as int);
    } as !)
} as int)
