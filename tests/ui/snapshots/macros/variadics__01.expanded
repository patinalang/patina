#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/variadics.md
// block: 1/1

macro_rules! calculate {
    (eval $e:expr) =>
    {
        {
            let val: int = $e;
            println!("{} = {}",
            stringify!{$e
                // The pattern for a single `eval`
                // Force types to be integers
            }, val);
        }
    }; (eval $e:expr, $(eval $es:expr),+) =>
    {{
            calculate!
            {
                eval $e

                // Decompose multiple `eval`s recursively
            } calculate! { $(eval $es),+ }
        }};
}

pub fn main() {
    {
        {
            let val: int =  // Look ma! Variadic `calculate!`!
                1 + 2;
            {
                io::put_chars([[patina_fmt::display("1 + 2"), " = ",
                                    patina_fmt::display(val)]]);
                io::nl();
            };
        }
        {
            {
                let val: int = 3 + 4;
                {
                    io::put_chars([[patina_fmt::display("3 + 4"), " = ",
                                        patina_fmt::display(val)]]);
                    io::nl();
                };
            }
            {
                let val: int = (2 * 3) + 1;
                {
                    io::put_chars([[patina_fmt::display("(2 * 3) + 1"), " = ",
                                        patina_fmt::display(val)]]);
                    io::nl();
                };
            }
        }
    }
}
