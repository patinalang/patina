#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/designators.md
// block: 1/1

macro_rules! create_function {
    ($func_name:ident) =>
    {
        fn $func_name()
        {
            println!("You called {:?}()", stringify!($func_name));
            // This macro takes an argument of designator `ident` and
            // creates a function named `$func_name`.
            // The `ident` designator is used for variable/function names.
            // The `stringify!` macro converts an `ident` into a string.
        }
    };
}
fn foo() {
    {
        io::put_chars([["You called ", patina_fmt::debug("foo"), "()"]]);
        io::nl();
    };
}
fn bar() {
    {
        io::put_chars([["You called ", patina_fmt::debug("bar"), "()"]]);
        io::nl();
    };
}

// Create functions named `foo` and `bar` with the above macro.

macro_rules! print_result {
    ($expression:expr) =>
    {
        println!("{:?} = {:?}", stringify!($expression), $expression);
        // This macro takes an expression of type `expr` and prints
        // it as a string along with its result.
        // The `expr` designator is used for expressions.
        // `stringify!` will convert the expression *as it is* into a string.
    };
}

pub fn main() {
    foo();
    bar();
    {
        io::put_chars([[patina_fmt::debug("1 + 1"), " = ",
                            patina_fmt::debug(

                                1 + 1)]]);
        io::nl();
    };
    ;
    {
        io::put_chars([[patina_fmt::debug("{ let x = 1; x * x + 2 * x - 1 }"),
                            " = ",
                            patina_fmt::debug(

                                // Recall that blocks are expressions too!

                                { let x = 1; x * x + 2 * x - 1 })]]);
        io::nl();
    };
    ;
}
