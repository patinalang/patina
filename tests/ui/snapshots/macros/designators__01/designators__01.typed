#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/macros/designators.md
// block: 1/1

macro_rules! create_function {
    ($func_name:ident) =>
    {
        fn $func_name()
        {
            println!("You called {:?}()", stringify!($func_name));
            // This macro takes an argument of designator `ident` and
            // creates a function named `$func_name`.
            // The `ident` designator is used for variable/function names.
            // The `stringify!` macro converts an `ident` into a string.
        }
    };
}
fn foo() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("You called " as str),
                            ((patina_fmt::debug as fn(term) -> term)(("foo" as str)) as
                                term), ("()" as str)] as [term; 3])] as [[term; 3]; 1])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn bar() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("You called " as str),
                            ((patina_fmt::debug as fn(term) -> term)(("bar" as str)) as
                                term), ("()" as str)] as [term; 3])] as [[term; 3]; 1])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())

// Create functions named `foo` and `bar` with the above macro.

macro_rules! print_result {
    ($expression:expr) =>
    {
        println!("{:?} = {:?}", stringify!($expression), $expression);
        // This macro takes an expression of type `expr` and prints
        // it as a string along with its result.
        // The `expr` designator is used for expressions.
        // `stringify!` will convert the expression *as it is* into a string.
    };
}

fn main() ({
    ((foo as fn() {foo})() as ());
    ((bar as fn() {bar})() as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(("1 + 1" as str)) as term),
                            (" = " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(

                                ((1 as int) + (1 as int) as int)) as term)] as [term; 3])]
                as [[term; 3]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([((patina_fmt::debug as
                                    fn(term) -> term)(("{ let x = 1; x * x + 2 * x - 1 }" as
                                    str)) as term), (" = " as str),
                            ((patina_fmt::debug as
                                    fn(term) -> term)(

                                // Recall that blocks are expressions too!

                                ({
                                    let x = (1 as int);
                                    ((((x as int) * (x as int) as int) +
                                            ((2 as int) * (x as int) as int) as int) - (1 as int) as
                                        int)
                                } as term)) as term)] as [term; 3])] as [[term; 3]; 1])) as
            term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
