#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/macros/variadics.md
// block: 1/1

macro_rules! calculate {
    (eval $e:expr) =>
    {
        {
            let val: int = $e;
            println!("{} = {}",
            stringify!{$e
                // The pattern for a single `eval`
                // Force types to be integers
            }, val);
        }
    }; (eval $e:expr, $(eval $es:expr),+) =>
    {{
            calculate!
            {
                eval $e

                // Decompose multiple `eval`s recursively
            } calculate! { $(eval $es),+ }
        }};
}

pub fn main() {
    {
        {
            let val: int =  // Look ma! Variadic `calculate!`!
                1 + 2;
            {
                ::core::io::put_chars([[patina_fmt::display("1 + 2"), " = ",
                                    patina_fmt::display(val)]]);
                ::core::io::nl();
            };
        }
        {
            {
                let val: int = 3 + 4;
                {
                    ::core::io::put_chars([[patina_fmt::display("3 + 4"), " = ",
                                        patina_fmt::display(val)]]);
                    ::core::io::nl();
                };
            }
            {
                let val: int = (2 * 3) + 1;
                {
                    ::core::io::put_chars([[patina_fmt::display("(2 * 3) + 1"),
                                        " = ", patina_fmt::display(val)]]);
                    ::core::io::nl();
                };
            }
        }
    }
}
