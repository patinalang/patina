#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/macros/variadics.md
// block: 1/1

macro_rules! calculate {
    (eval $e:expr) =>
    {
        {
            let val: int = $e;
            println!("{} = {}",
            stringify!{$e
                // The pattern for a single `eval`
                // Force types to be integers
            }, val);
        }
    }; (eval $e:expr, $(eval $es:expr),+) =>
    {{
            calculate!
            {
                eval $e

                // Decompose multiple `eval`s recursively
            } calculate! { $(eval $es),+ }
        }};
}

fn main() ({
    ({
        ({
            let val: int =  // Look ma! Variadic `calculate!`!
                ((1 as int) + (2 as int) as int);
            ({
                ((::core::io::put_chars as
                        fn(term) -> term)(([([((::core::patina_fmt::display as
                                            fn(term) -> term)(("1 + 2" as str)) as term),
                                    (" = " as str),
                                    ((::core::patina_fmt::display as
                                            fn(term) -> term)((val as int)) as term)] as [term])] as
                        [[term]])) as term);
                ((::core::io::nl as fn() -> term)() as term);
            } as ());
        } as ())
        ({
            ({
                let val: int = ((3 as int) + (4 as int) as int);
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([((::core::patina_fmt::display as
                                                fn(term) -> term)(("3 + 4" as str)) as term),
                                        (" = " as str),
                                        ((::core::patina_fmt::display as
                                                fn(term) -> term)((val as int)) as term)] as [term])] as
                            [[term]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
            } as ())
            ({
                let val: int =
                    (((2 as int) * (3 as int) as int) + (1 as int) as int);
                ({
                    ((::core::io::put_chars as
                            fn(term) -> term)(([([((::core::patina_fmt::display as
                                                fn(term) -> term)(("(2 * 3) + 1" as str)) as term),
                                        (" = " as str),
                                        ((::core::patina_fmt::display as
                                                fn(term) -> term)((val as int)) as term)] as [term])] as
                            [[term]])) as term);
                    ((::core::io::nl as fn() -> term)() as term);
                } as ());
            } as ())
        } as ())
    } as ())
} as ())
