#![allow(internal_features)]
#![feature(no_core, lang_items, rustc_attrs)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {} }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {} }

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
#[macro_export]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/types/alias.md
// block: 1/1

// `NanoSecond`, `Inch`, and `Int` are new names for `int`.
type NanoSecond = int;
type Inch = int;
type Int = int;

pub fn main() {
    // `NanoSecond` = `Inch` = `Int` = `int`.
    let nanoseconds: NanoSecond = 5 as int;
    let inches: Inch = 2 as Int;
    {
        io::put_chars([[patina_fmt::display(

                                // Note that type aliases *don't* provide any extra type safety, because
                                // aliases are *not* new types
                                nanoseconds), " nanoseconds + ",
                            patina_fmt::display(inches), " inches = ",
                            patina_fmt::display(nanoseconds + inches), " unit?"]]);
        io::nl();
    };
}
