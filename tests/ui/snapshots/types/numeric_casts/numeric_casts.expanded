#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

pub fn float_to_int(value: float) -> int { value as int }

pub fn int_to_float(value: int) -> float { value as float }

pub fn float_to_int_to_term(value: float) -> term { (value as int) as term }

pub fn int_to_float_to_term(value: int) -> term { (value as float) as term }

pub fn main() {
    let _ = float_to_int(3.14);
    let _ = int_to_float(42);
    let _ = float_to_int_to_term(3.14);
    let _ = int_to_float_to_term(42);
}
