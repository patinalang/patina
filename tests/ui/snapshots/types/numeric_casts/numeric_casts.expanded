#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

pub fn float_to_int(value: float) -> int { value as int }

pub fn int_to_float(value: int) -> float { value as float }

pub fn float_to_int_to_term(value: float) -> term { (value as int) as term }

pub fn int_to_float_to_term(value: int) -> term { (value as float) as term }

pub fn main() {
    let _ = float_to_int(3.14);
    let _ = int_to_float(42);
    let _ = float_to_int_to_term(3.14);
    let _ = int_to_float_to_term(42);
}
