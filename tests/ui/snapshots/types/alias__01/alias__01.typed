#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// source: patina-by-example/src/types/alias.md
// block: 1/1

// `NanoSecond`, `Inch`, and `Int` are new names for `int`.
type NanoSecond = int;
type Inch = int;
type Int = int;

fn main() ({
    // `NanoSecond` = `Inch` = `Int` = `int`.
    let nanoseconds: NanoSecond = ((5 as int) as int as int);
    let inches: Inch = ((2 as int) as Int as int);

    // Note that type aliases *don't* provide any extra type safety, because
    // aliases are *not* new types
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([((::core::patina_fmt::display as
                                    fn(term) -> term)((nanoseconds as int)) as term),
                            (" nanoseconds + " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)((inches as int)) as term),
                            (" inches = " as str),
                            ((::core::patina_fmt::display as
                                    fn(term) -> term)(((nanoseconds as int) + (inches as int) as
                                    int)) as term), (" unit?" as str)] as [term])] as [[term]]))
            as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
