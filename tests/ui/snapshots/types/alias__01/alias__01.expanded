#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/types/alias.md
// block: 1/1

// `NanoSecond`, `Inch`, and `Int` are new names for `int`.
type NanoSecond = int;
type Inch = int;
type Int = int;

pub fn main() {
    // `NanoSecond` = `Inch` = `Int` = `int`.
    let nanoseconds: NanoSecond = 5 as int;
    let inches: Inch = 2 as Int;

    // Note that type aliases *don't* provide any extra type safety, because
    // aliases are *not* new types
    {
        ::core::io::put_chars([[::core::patina_fmt::display(nanoseconds),
                            " nanoseconds + ", ::core::patina_fmt::display(inches),
                            " inches = ",
                            ::core::patina_fmt::display(nanoseconds + inches),
                            " unit?"]]);
        ::core::io::nl();
    };
}
