#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/types/cast.md
// block: 1/1

pub fn main() {
    let decimal = 65.4321;

    // Error! No implicit conversion
    let integer: int = decimal;

    // Explicit conversion
    let integer =
        decimal as
            int; // casting float to integer is equivalent to decimal.trunc()
    let character = integer as char;

    // Error! There are limitations in conversion rules.
    // A float cannot be directly converted to a char.
    let character = decimal as char;
    {
        io::put_chars([["Casting: ",
                            patina_fmt::display(
                                // FIXME ^ Comment out this line

                                decimal), " -> ", patina_fmt::display(integer), " -> ",
                            patina_fmt::display(character)]]);
        io::nl();
    };

    // str can be cast to bin or bits
    let string = "hello";
    let binary = string as bin;
    let bitstring = string as bits;

    // bin can be cast to bits
    let bitstring = binary as bits;

    // PATINA TODO: how useful is the byte type, really?
    // integer literal can be cast to a byte
    // let byte_val = 123 as byte;

    // byte can be cast to an integer, but not the other way around!
    let integer_from_byte = byte_val as int;
    // Error! Byte cannot be cast from an arbitrary integer
    let byte_from_integer = integer_from_byte as byte;
}
