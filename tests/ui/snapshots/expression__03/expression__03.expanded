#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/expression.md
// block: 3/3

pub fn main() {
    let x = 5;

    let y =
        {
            let x_squared = x * x;
            let x_cube = x_squared * x;

            // This expression will be assigned to `y`
            x_cube + x_squared + x
        };

    let z =
        {
            // The semicolon suppresses this expression and `()` is assigned to `z`
            2 * x;
        };

    {
        ::Core::io::put_chars([["x is ", patina_fmt::debug(x)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["y is ", patina_fmt::debug(y)]]);
        ::Core::io::nl();
    };
    {
        ::Core::io::put_chars([["z is ", patina_fmt::debug(z)]]);
        ::Core::io::nl();
    };
}
