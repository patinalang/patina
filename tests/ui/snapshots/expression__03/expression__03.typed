#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

// source: patina-by-example/src/expression.md
// block: 3/3

fn main() ({
    let x = (5 as int);

    let y =
        ({
            let x_squared = ((x as int) * (x as int) as int);
            let x_cube = ((x_squared as int) * (x as int) as int);

            // This expression will be assigned to `y`
            (((x_cube as int) + (x_squared as int) as int) + (x as int) as
                int)
        } as int);

    let z =
        ({
            // The semicolon suppresses this expression and `()` is assigned to `z`
            ((2 as int) * (x as int) as int);
        } as ());

    ({
        ((io::put_chars as
                fn(term) -> term)(([([("x is " as str),
                            ((patina_fmt::debug as fn(term) -> term)((x as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("y is " as str),
                            ((patina_fmt::debug as fn(term) -> term)((y as int)) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("z is " as str),
                            ((patina_fmt::debug as fn(term) -> term)((z as ())) as
                                term)] as [term])] as [[term]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
