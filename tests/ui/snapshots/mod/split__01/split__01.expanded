// This declaration will look for a file named `my_mod.rs` and will
// insert its contents inside a module named `MyMod` under this scope
mod MyMod {






    mod Inaccessible {
        #[allow(dead_code)]
        pub fn public_function() -> int { 3 }
    }
    pub mod Nested {
        pub fn function() -> int { 1 }
        #[allow(dead_code)]
        fn private_function() -> int { 2 }
    }
    pub fn function() -> int { 1 }
    fn private_function() -> int { 2 }
    pub fn indirect_access() -> int { private_function() }
}
fn function() { { io::put_chars([["called `function()`"]]); io::nl(); }; }
pub fn main() {
    MyMod::function();
    function();
    MyMod::indirect_access();
    MyMod::Nested::function();
}
