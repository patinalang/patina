#![allow(internal_features)]
#![feature(no_core, lang_items)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized { }

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized { }

#[lang = "sized"]
pub trait Sized: MetaSized { }

#[lang = "copy"]
pub trait Copy { }

#[allow(unused)]
extern mod io;

#[macro_export]
macro_rules! println { ($s:literal) => {{ io::format("~s~n", [$s]); }}; }

extern mod used;
extern mod unused;

pub fn main() { used::ping(); }
