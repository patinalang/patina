#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

mod Inaccessible {



    #[allow(dead_code)]
    fn public_function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `MyMod::Inaccessible::public_function()`"
                                    as str)] as [str; 1])] as [[str; 1]; 1])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
}
mod Nested {
    fn function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `MyMod::Nested::function()`" as
                                    str)] as [str; 1])] as [[str; 1]; 1])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
    #[allow(dead_code)]
    fn private_function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `MyMod::Nested::private_function()`"
                                    as str)] as [str; 1])] as [[str; 1]; 1])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
}
fn function() -> int ({ (1 as int) } as int)
fn private_function() -> int ({ (2 as int) } as int)
fn indirect_access()
    ->
        int ({
    ((private_function as fn() -> int {private_function})() as int)
} as int)
