#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

mod Inaccessible {



    #[allow(dead_code)]
    pub fn public_function() {
        {
            io::put_chars([["called `MyMod::Inaccessible::public_function()`"]]);
            io::nl();
        };
    }
}
pub mod Nested {
    pub fn function() {
        {
            io::put_chars([["called `MyMod::Nested::function()`"]]);
            io::nl();
        };
    }
    #[allow(dead_code)]
    fn private_function() {
        {
            io::put_chars([["called `MyMod::Nested::private_function()`"]]);
            io::nl();
        };
    }
}
pub fn function() -> int { 1 }
fn private_function() -> int { 2 }
pub fn indirect_access() -> int { private_function() }
