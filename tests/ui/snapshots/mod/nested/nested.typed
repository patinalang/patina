fn function() ({

    ({
        ((io::put_chars as
                fn(term) -> term)(([([("called `MyMod::Nested::function()`" as
                                str)] as [str])] as [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
