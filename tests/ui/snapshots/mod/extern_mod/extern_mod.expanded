#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

extern mod used;
extern mod unused;
extern mod erlang;

mod inner {
    pub fn use_it() { let _hash = erlang::phash2(()); }
}

pub fn main() {
    used::ping();
    { io::put_chars([[patina_fmt::debug(used::foo::bar)]]); io::nl(); };
    io::foo::bar(1, 2);
    io::a::b::c::d(1);
    io::a::b::c::d(2);
    io::foo::bar::baz(());
    let _m = io::foo::bar;
    inner::use_it();
}
