#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

extern mod used;
extern mod unused;
extern mod erlang;
extern mod io;

mod inner {
    pub fn use_it() { let _hash = erlang::phash2(()); }
}

pub fn main() {
    used::ping();
    {
        ::core::io::put_chars([[::core::patina_fmt::debug(used::foo::bar)]]);
        ::core::io::nl();
    };
    io::foo::bar(1, 2);
    io::a::b::c::d(1);
    io::a::b::c::d(2);
    io::foo::bar::baz(());
    let _m = io::foo::bar;
    inner::use_it();
}
