fn function() ({




    // Let's access all the functions named `function` from this scope!

    // The `self` keyword refers to the current module scope - in this case `My`.
    // Calling `self::function()` and calling `function()` directly both give
    // the same result, because they refer to the same function.

    // We can also use `self` to access another module inside `My`:

    // The `super` keyword refers to the parent scope (outside the `My` module).

    // This will bind to the `Cool::function` in the *pkg* scope.
    // In this case the pkg scope is the outermost scope.

    ({
        ((io::put_chars as
                fn(term) -> term)(([([("called `function()`" as str)] as
                        [str])] as [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
mod Cool {
    fn function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `Cool::function()`" as str)] as
                            [str])] as [[str]])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
}
mod My {
    fn function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `My::function()`" as str)] as
                            [str])] as [[str]])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
    mod Cool {
        fn function() ({
            ({
                ((io::put_chars as
                        {type error})(([([("called `My::Cool::function()`" as str)]
                                as [str])] as [[str]])) as {type error});
                ((io::nl as {type error})() as {type error});
            } as ());
        } as ())
    }
    fn indirect_call() ({
        ({
            ((io::put_chars as
                    {type error})(([("called `My::indirect_call()`, that\n> " as
                            str)] as [str])) as {type error});
        } as ());
        ((self::function as fn() {My::function})() as ());
        ((function as fn() {My::function})() as ());
        ((self::Cool::function as fn() {My::Cool::function})() as ());
        ((super::function as fn() {function})() as ());
        ({
            use pkg::Cool::function as root_function;
            ((root_function as {type error})() as {type error});
        } as ())
    } as ())
}
fn main() ({ ((My::indirect_call as fn() {My::indirect_call})() as ()); } as
    ())
