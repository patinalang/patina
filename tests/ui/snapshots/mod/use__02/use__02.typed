#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/mod/use.md
// block: 2/2

// Bind the `deeply::nested::function` path to `other_function`.
use Deeply::Nested::function as other_function;

fn function() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("called `function()`" as str)] as
                        [str; 1])] as [[str; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())

mod Deeply {
    mod Nested {
        fn function() ({
            ({
                ((io::put_chars as
                        {type error})(([([("called `Deeply::Nested::function()`" as
                                        str)] as [str; 1])] as [[str; 1]; 1])) as {type error});
                ((io::nl as {type error})() as {type error});
            } as ());
        } as ())
    }
}

fn main() ({
    // Easier access to `Deeply::Nested::function`
    ((other_function as fn() {Deeply::Nested::function})() as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Entering block" as str)] as [str; 1])]
                as [[str; 1]; 1])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());

    ({
        // This is equivalent to `use Deeply::Nested::function as function`.
        // This `function()` will shadow the outer one.
        use pkg::Deeply::Nested::function;

        // `use` bindings have a local scope. In this case, the
        // shadowing of `function()` is only in this block.
        ((function as {type error})() as {type error});
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Leaving block" as str)] as
                            [str; 1])] as [[str; 1]; 1])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());

    } as ())

    ((function as fn() {function})() as ());
} as ())
