// Bind the `deeply::nested::function` path to `other_function`.
use Deeply::Nested::function as other_function;

fn function() ({


    // Easier access to `Deeply::Nested::function`

    // This is equivalent to `use Deeply::Nested::function as function`.
    // This `function()` will shadow the outer one.

    // `use` bindings have a local scope. In this case, the
    // shadowing of `function()` is only in this block.


    ({
        ((io::put_chars as
                fn(term) -> term)(([([("called `function()`" as str)] as
                        [str])] as [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
mod Deeply {
    mod Nested {
        fn function() ({
            ({
                ((io::put_chars as
                        {type error})(([([("called `Deeply::Nested::function()`" as
                                        str)] as [str])] as [[str]])) as {type error});
                ((io::nl as {type error})() as {type error});
            } as ());
        } as ())
    }
}
fn main() ({
    ((other_function as fn() {Deeply::Nested::function})() as ());
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("Entering block" as str)] as [str])] as
                [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
    ({
        use pkg::Deeply::Nested::function;
        ((function as {type error})() as {type error});
        ({
            ((io::put_chars as
                    fn(term) -> term)(([([("Leaving block" as str)] as [str])]
                    as [[str]])) as term);
            ((io::nl as fn() -> term)() as term);
        } as ());
    } as ())
    ((function as fn() {function})() as ());
} as ())
