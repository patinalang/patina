extern pkg core as core2;

macro_rules! call_visible { () => { $pkg::first::visible() }; }

macro_rules! call_visible_legacy { () => { $crate::first::visible() }; }

mod first {
    pub(pkg) fn visible() -> int { 1 }
}

mod second {
    pub(pkg) fn call() -> int { pkg::first::visible() }
    fn unqualified() -> int { visible() }
}

pub fn main() {
    let _: core2::Option<int> = core2::Option::Some(call_visible!());
    call_visible_legacy!();
    second::call();
    pkg::first::missing();
}
