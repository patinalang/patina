// source: patina-by-example/src/mod/split.md
// block: 2/4

// Similarly `mod inaccessible` and `mod nested` will locate the `nested.rs`
// and `inaccessible.rs` files and insert them here under their respective
// modules
mod inaccessible {




    #[allow(dead_code)]
    fn public_function() ({
        ({
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("called `my_mod::inaccessible::public_function()`"
                                    as str)] as [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        } as ());
    } as ())
}
mod nested {
    fn function() ({
        ({
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("called `my_mod::nested::function()`"
                                    as str)] as [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        } as ());
    } as ())
    #[allow(dead_code)]
    fn private_function() ({
        ({
            ((::core::io::put_chars as
                    fn(term) -> term)(([([("called `my_mod::nested::private_function()`"
                                    as str)] as [str])] as [[str]])) as term);
            ((::core::io::nl as fn() -> term)() as term);
        } as ());
    } as ())
}
fn function() ({
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("called `my_mod::function()`" as str)]
                        as [str])] as [[str]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn private_function() ({
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([([("called `my_mod::private_function()`"
                                as str)] as [str])] as [[str]])) as term);
        ((::core::io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn indirect_access() ({
    ({
        ((::core::io::put_chars as
                fn(term) -> term)(([("called `my_mod::indirect_access()`, that\n> "
                        as str)] as [str])) as term);
    } as ());
    ((private_function as fn() {private_function})() as ());
} as ())
