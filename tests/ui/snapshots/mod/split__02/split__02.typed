// Similarly `mod inaccessible` and `mod nested` will locate the `nested.rs`
// and `inaccessible.rs` files and insert them here under their respective
// modules
mod Inaccessible {




    #[allow(dead_code)]
    fn public_function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `MyMod::Inaccessible::public_function()`"
                                    as str)] as [str])] as [[str]])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
}
mod Nested {
    fn function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `MyMod::Nested::function()`" as
                                    str)] as [str])] as [[str]])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
    #[allow(dead_code)]
    fn private_function() ({
        ({
            ((io::put_chars as
                    {type error})(([([("called `MyMod::Nested::private_function()`"
                                    as str)] as [str])] as [[str]])) as {type error});
            ((io::nl as {type error})() as {type error});
        } as ());
    } as ())
}
fn function() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("called `MyMod::function()`" as str)]
                        as [str])] as [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
    } as ());
} as ())
fn private_function() ({
    ({
        ((io::put_chars as
                fn(term) -> term)(([([("called `MyMod::private_function()`" as
                                str)] as [str])] as [[str]])) as term);
        ((io::nl as fn() -> term)() as term);
