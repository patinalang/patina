#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/mod/split.md
// block: 2/4

// Similarly `mod inaccessible` and `mod nested` will locate the `nested.rs`
// and `inaccessible.rs` files and insert them here under their respective
// modules
mod Inaccessible {




    #[allow(dead_code)]
    pub fn public_function() {
        {
            io::put_chars([["called `MyMod::Inaccessible::public_function()`"]]);
            io::nl();
        };
    }
}
pub mod Nested {
    pub fn function() {
        {
            io::put_chars([["called `MyMod::Nested::function()`"]]);
            io::nl();
        };
    }
    #[allow(dead_code)]
    fn private_function() {
        {
            io::put_chars([["called `MyMod::Nested::private_function()`"]]);
            io::nl();
        };
    }
}
pub fn function() {
    { io::put_chars([["called `MyMod::function()`"]]); io::nl(); };
}
fn private_function() {
    { io::put_chars([["called `MyMod::private_function()`"]]); io::nl(); };
}
pub fn indirect_access() {
    { io::put_chars(["called `MyMod::indirect_access()`, that\n> "]); };
    private_function();
}
