#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/mod/split.md
// block: 2/4

// Similarly `mod inaccessible` and `mod nested` will locate the `nested.rs`
// and `inaccessible.rs` files and insert them here under their respective
// modules
mod inaccessible {




    #[allow(dead_code)]
    pub fn public_function() {
        {
            ::core::io::put_chars([["called `my_mod::inaccessible::public_function()`"]]);
            ::core::io::nl();
        };
    }
}
pub mod nested {
    pub fn function() {
        {
            ::core::io::put_chars([["called `my_mod::nested::function()`"]]);
            ::core::io::nl();
        };
    }
    #[allow(dead_code)]
    fn private_function() {
        {
            ::core::io::put_chars([["called `my_mod::nested::private_function()`"]]);
            ::core::io::nl();
        };
    }
}
pub fn function() {
    {
        ::core::io::put_chars([["called `my_mod::function()`"]]);
        ::core::io::nl();
    };
}
fn private_function() {
    {
        ::core::io::put_chars([["called `my_mod::private_function()`"]]);
        ::core::io::nl();
    };
}
pub fn indirect_access() {
    {
        ::core::io::put_chars(["called `my_mod::indirect_access()`, that\n> "]);
    };
    private_function();
}
