#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

// Prelude items are in scope in every module, not only at the crate root.

fn top(n: int)
    ->
        Option<int> ({
    (if ((n as int) > (0 as int) as bool) {
        ((Some as
                fn(int) -> core::option::Option<int> {core::option::Option::<int>::Some})((n
                as int)) as core::option::Option<int>)
    } else { (None as core::option::Option<int>) } as
        core::option::Option<int>)
} as core::option::Option<int>)

mod outer {
    fn outer(n: int)
        ->
            Option<int> ({
        (if ((n as int) > (0 as int) as bool) {
            ((Some as
                    fn(int) -> core::option::Option<int> {core::option::Option::<int>::Some})((n
                    as int)) as core::option::Option<int>)
        } else { (None as core::option::Option<int>) } as
            core::option::Option<int>)
    } as core::option::Option<int>)

    mod inner {
        fn inner(value: Option<int>)
            ->
                int ({
            (match (value as core::option::Option<int>) {
                Some(n) => (n as int),
                None => (0 as int),
            } as int)
        } as int)
    }
}
