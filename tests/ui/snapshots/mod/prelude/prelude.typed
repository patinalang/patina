#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use Core::Prelude::*;

#[allow(unused)]
extern mod patina_fmt;

// Prelude items are in scope in every module, not only at the crate root.

fn top(n: int)
    ->
        Option<int> ({
    (if ((n as int) > (0 as int) as bool) {
        ((Some as
                fn(int) -> Core::Option<int> {Core::Option::<int>::Some})((n
                as int)) as Core::Option<int>)
    } else { (None as Core::Option<int>) } as Core::Option<int>)
} as Core::Option<int>)

mod Outer {
    fn outer(n: int)
        ->
            Option<int> ({
        (if ((n as int) > (0 as int) as bool) {
            ((Some as
                    fn(int) -> Core::Option<int> {Core::Option::<int>::Some})((n
                    as int)) as Core::Option<int>)
        } else { (None as Core::Option<int>) } as Core::Option<int>)
    } as Core::Option<int>)

    mod Inner {
        fn inner(value: Option<int>)
            ->
                int ({
            (match (value as Core::Option<int>) {
                Some(n) => (n as int),
                None => (0 as int),
            } as int)
        } as int)
    }
}
