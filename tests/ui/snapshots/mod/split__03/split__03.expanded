pub fn function() {
    { io::put_chars([["called `MyMod::Nested::function()`"]]); io::nl(); };
}

#[allow(dead_code)]
fn private_function() {
    {
        io::put_chars([["called `MyMod::Nested::private_function()`"]]);
        io::nl();
    };
}
