// Function that returns a boolean value
fn is_divisible_by(lhs: int, rhs: int)
    ->
        bool ({
    // Corner case, early return
    (if ((rhs as int) == (0 as int) as bool) {
        (return (false as bool) as !);
    } as ())

    // This is an expression, the `return` keyword is not necessary here
    (((lhs as int) % (rhs as int) as int) == (0 as int) as bool)
} as bool)

