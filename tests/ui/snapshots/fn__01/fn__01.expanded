#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern pkg core;

#[allow(unused_imports)]
#[prelude_import]
use core::prelude::*;

// source: patina-by-example/src/fn.md
// block: 1/1

// There's no restriction on the order of function definitions
pub fn main() {
    // We can use this function here, and define it somewhere later
    fizzbuzz_to(100);
}

// Function that returns a boolean value
fn is_divisible_by(lhs: int, rhs: int) -> bool {
    // Corner case, early return
    if rhs == 0 { return false; }

    // This is an expression, the `return` keyword is not necessary here
    lhs % rhs == 0
}

// Functions that "don't" return a value, actually return the unit type `()`
fn fizzbuzz(n: int) -> () {
    if is_divisible_by(n, 15) {

        // When a function returns `()`, the return type can be omitted from the
        // signature
        { ::core::io::put_chars([["fizzbuzz"]]); ::core::io::nl(); };
    } else if is_divisible_by(n, 3) {
        { ::core::io::put_chars([["fizz"]]); ::core::io::nl(); };
    } else if is_divisible_by(n, 5) {
        { ::core::io::put_chars([["buzz"]]); ::core::io::nl(); };
    } else {
        {
            ::core::io::put_chars([[::core::patina_fmt::display(n)]]);
            ::core::io::nl();
        };
    }
}
fn fizzbuzz_to(n: int) { for n in 1..=n { fizzbuzz(n); } }
