// Exercises the partial `format_args!` implementation: literal text, `{}` (Display)
// and `{:?}` (Debug), positional and captured arguments.

pub fn main() {
    let name = "world";
    let n: int = 42;

    println!("hello, {}!", name);
    println!("{} = {:?}", name, n);
    println!("{name} and {n:?}");
    print!("no ");
    print!("newline");
    println!();
}
