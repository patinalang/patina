#![allow(internal_features)]
#![feature(no_core, rustc_attrs, decl_macro, prelude_import)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
#[prelude_import]
use Core::Prelude::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

struct Foo;

trait FooTrait {
    fn bar() {}
}

impl Foo {
    fn foo() { Self::priv_foo(); }
    fn priv_foo() {}
}

impl FooTrait for Foo {
    fn bar() { Foo::priv_foo(); }
}

struct Bar;

impl Bar {
    fn bar() { Foo::foo(); }
}

pub fn main() { Bar::bar(); }
