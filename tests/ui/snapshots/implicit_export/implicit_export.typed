#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0, decl_macro#0, prelude_import#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern pkg core;

#[allow(unused_imports)]
#[attr = PreludeImport]
use core::prelude::*;

struct Foo;

trait FooTrait {
    fn bar() ({ } as ())
}

impl Foo {
    fn foo() ({ ((Self::priv_foo as fn() {Foo::priv_foo})() as ()); } as ())
    fn priv_foo() ({ } as ())
}

impl FooTrait for Foo {
    fn bar() ({ ((Foo::priv_foo as fn() {Foo::priv_foo})() as ()); } as ())
}

struct Bar;

impl Bar {
    fn bar() ({ ((Foo::foo as fn() {Foo::foo})() as ()); } as ())
}

fn main() ({ ((Bar::bar as fn() {Bar::bar})() as ()); } as ())
