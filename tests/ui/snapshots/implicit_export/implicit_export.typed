#![allow(internal_features)]
#![attr = Feature([no_core#0, rustc_attrs#0])]
#![attr = NoStd]
#![attr = NoCore]

#[allow(unused_imports)]
#[attr = MacroUse {arguments: UseAll}]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[attr = RustcBuiltinMacro {helper_attrs: []}]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

struct Foo;

trait FooTrait {
    fn bar() ({ } as ())
}

impl Foo {
    fn foo() ({ ((Self::priv_foo as fn() {Foo::priv_foo})() as ()); } as ())
    fn priv_foo() ({ } as ())
}

impl FooTrait for Foo {
    fn bar() ({ ((Foo::priv_foo as fn() {Foo::priv_foo})() as ()); } as ())
}

struct Bar;

impl Bar {
    fn bar() ({ ((Foo::foo as fn() {Foo::foo})() as ()); } as ())
}

fn main() ({ ((Bar::bar as fn() {Bar::bar})() as ()); } as ())
