#![allow(internal_features)]
#![feature(no_core, rustc_attrs)]
#![no_std]
#![no_core]

#[allow(unused_imports)]
#[macro_use]
extern crate Core;

#[allow(unused_imports)]
use Core::*;

#[allow(unused)]
extern mod io;

#[allow(unused)]
extern mod patina_fmt;

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! stringify { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! concat { () => {}; }

#[allow(unused_macros)]
#[rustc_builtin_macro]
macro_rules! format_args { () => {}; }

#[allow(unused_macros)]
macro_rules! print {
    ($($arg:tt)*) => {{ io::put_chars(format_args!($($arg)*)); }};
}

#[allow(unused_macros)]
macro_rules! println {
    () => {{ io::nl(); }}; ($($arg:tt)*) =>
    {{ io::put_chars([format_args!($($arg)*)]); io::nl(); }};
}

// source: patina-by-example/src/unsafe.md
// block: 1/2

struct Celcius(int);
struct Fahrenheit(int);

pub fn main() {
    let degrees_term = Celcius(10) as term;

    unsafe {
        // Celcius(10) and Fahrenheit(10) have the same runtime representation,
        // so `try_cast_into` will succeed.
        // But `degrees_term` wasn't Fahrenheit! Even with some guardrails,
        // this circumvents the type system - which is why it's unsafe.
        let fahrenheit = degrees_term.try_cast_into::<Fahrenheit>().unwrap();
    }
}
