pub trait From<T> {
    fn from(t: T) -> Self;
}

pub struct Celsius(pub int);
pub struct Fahrenheit(pub int);

impl From<Fahrenheit> for Celsius {
    fn from(f: Fahrenheit) -> Celsius {
        Celsius((f.0 - 32) * 5 / 9)
    }
}

pub fn to_celsius<T>(t: T) -> int
where
    Celsius: From<T>,
{
    Celsius::from(t).0
}
