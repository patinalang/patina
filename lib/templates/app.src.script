PkgDir = filename:dirname(filename:dirname(filename:absname(SCRIPT))),

{PathSep, Home} =
    case os:type() of
        {win32, _} -> {";", os:getenv("USERPROFILE", "")};
        _ -> {":", os:getenv("HOME", "")}
    end,
SearchPath = os:getenv("PATH", "") ++ PathSep ++ filename:join([Home, ".patina", "patina", "bin"]),
Exe =
    case os:find_executable("patina", SearchPath) of
        false -> error("the `patina` executable isn't in PATH or in ~/.patina/patina/bin");
        Path -> Path
    end,

Port = open_port(
    {spawn_executable, Exe},
    [
        {args, ["-C", PkgDir, "print", "--format", "json", "package", "dependencies"]},
        binary,
        exit_status,
        hide
    ]
),

Collect = fun Collect(Output) ->
    receive
        {Port, {data, Data}} -> Collect([Output, Data]);
        {Port, {exit_status, 0}} -> Output;
        {Port, {exit_status, Status}} -> error({patina_print_failed, Status})
    end
end,

{Printed, ok, _Rest} = json:decode(
    iolist_to_binary(Collect([])), ok, #{string => fun unicode:characters_to_list/1}
),

#{
    "package" := #{"otp_app_name" := App, "version" := Version, "description" := Description},
    "dependencies" := Deps
} = Printed,

{application, list_to_atom(App), [
    {description, Description},
    {vsn, Version},
    {modules, []},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        patina_core
        | [list_to_atom(DepApp) || #{"otp_app_name" := DepApp} <- Deps]
    ]}
]}.
