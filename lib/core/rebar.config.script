{PathSep, Home} =
    case os:type() of
        {win32, _} -> {";", os:getenv("USERPROFILE", "")};
        _ -> {":", os:getenv("HOME", "")}
    end,
SearchPath = os:getenv("PATH", "") ++ PathSep ++ filename:join([Home, ".patina", "patina", "bin"]),
Exe =
    case os:find_executable("patina", SearchPath) of
        false -> error("the `patina` executable isn't in PATH or in ~/.patina/patina/bin");
        Path -> Path
    end,

Port = open_port(
    {spawn_executable, Exe},
    [{args, ["print", "--format", "json", "install_root"]}, binary, exit_status, hide]
),

Collect = fun Collect(Output) ->
    receive
        {Port, {data, Data}} -> Collect([Output, Data]);
        {Port, {exit_status, 0}} -> Output;
        {Port, {exit_status, Status}} -> error({patina_print_failed, Status, Output})
    end
end,

{#{"install_root" := Root}, ok, _Rest} = json:decode(
    iolist_to_binary(Collect([])), ok, #{string => fun unicode:characters_to_list/1}
),

AppDir = filename:dirname(SCRIPT),
PatinaCore = filename:join(Root, "patina_core"),
ErlSrc = filename:join(PatinaCore, "erl_src"),
LocalErlSrc = filename:join(AppDir, "erl_src"),

LinkResult =
    case file:read_link(LocalErlSrc) of
        {ok, ErlSrc} ->
            ok;
        {ok, _OtherInstall} ->
            file:delete(LocalErlSrc),
            file:make_symlink(ErlSrc, LocalErlSrc);
        {error, enoent} ->
            file:make_symlink(ErlSrc, LocalErlSrc);
        {error, enotsup} ->
            {error, enotsup};
        {error, einval} ->
            ok
    end,

case LinkResult of
    ok ->
        ok;
    {error, _} ->
        ok = filelib:ensure_path(LocalErlSrc),
        {ok, Files} = file:list_dir(ErlSrc),
        lists:foreach(
            fun(File) ->
                Src = filename:join(ErlSrc, File),
                Dst = filename:join(LocalErlSrc, File),
                {ok, _} = file:copy(Src, Dst)
            end,
            Files
        )
end,

[
    {src_dirs, ["erl_src"]},
    {patina_opts, [{packages, [PatinaCore]}]},
    {plugins, [rebar3_patina]},
    {project_plugins, [rebar3_hex]}
].
