use pkg::option::Option::{self, None, Some};
use pkg::{IntoIterator, Iterator, NativeEq, MapIter, PartialEq, PhantomData};

extern mod maps;

impl<K, V> #{K => V} {
    /// Returns a lazy iterator over the `(key, value)` entries of the map, in undefined order.
    #[inline]
    #[must_use]
    pub fn iter(self) -> MapIter<K, V> {
        MapIter(unsafe { maps::iterator(self).cast_unchecked() }, PhantomData)
    }

    /// Returns the number of entries in the map.
    /// Allowed in guards.
    #[rustc_intrinsic]
    #[must_use]
    pub fn len(self) -> int;

    /// Returns `true` if the map has no entries.
    #[inline]
    #[must_use]
    pub fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// Returns the value stored under `key`, or `None` if there is none.
    #[inline]
    #[must_use]
    pub fn get(self, key: K) -> Option<V> {
        match self {
            #{^key => value, ..} => Some(value),
            _ => None,
        }
    }

    /// Returns the value stored under `key`, or `default` if there is none.
    #[inline]
    #[must_use]
    pub fn get_or(self, key: K, default: V) -> V {
        unsafe { maps::get(key, self, default).cast_unchecked() }
    }

    /// Returns `true` if the map has an entry for `key`.
    #[inline]
    #[must_use]
    pub fn contains_key(self, key: K) -> bool {
        unsafe { maps::is_key(key, self).cast_unchecked() }
    }

    /// Returns a map with `key` set to `value`, replacing any previous value.
    #[inline]
    #[must_use]
    pub fn insert(self, key: K, value: V) -> #{K => V} {
        unsafe { maps::put(key, value, self).cast_unchecked() }
    }

    /// Returns a map without the entry for `key`.
    #[inline]
    #[must_use]
    pub fn remove(self, key: K) -> #{K => V} {
        unsafe { maps::remove(key, self).cast_unchecked() }
    }

    /// Returns a map with the entries of both maps. Where both have a key, `other`'s value wins.
    #[inline]
    #[must_use]
    pub fn merge(self, other: #{K => V}) -> #{K => V} {
        unsafe { maps::merge(self, other).cast_unchecked() }
    }

    /// Returns the keys of the map, in arbitrary order.
    #[inline]
    #[must_use]
    pub fn keys(self) -> [K] {
        unsafe { maps::keys(self).cast_unchecked() }
    }

    /// Returns the values of the map, in arbitrary order.
    #[inline]
    #[must_use]
    pub fn values(self) -> [V] {
        unsafe { maps::values(self).cast_unchecked() }
    }

    /// Returns the `(key, value)` entries of the map, in arbitrary order.
    #[inline]
    #[must_use]
    pub fn to_list(self) -> [(K, V)] {
        unsafe { maps::to_list(self).cast_unchecked() }
    }
}

impl<K, V> Iterator for MapIter<K, V> {
    type Item = (K, V);

    #[inline]
    fn next(self) -> Option<((K, V), MapIter<K, V>)> {
        match maps::next(self.0) {
            (key, value, rest) => {
                let entry = unsafe { (key.cast_unchecked(), value.cast_unchecked()) };
                Some((entry, MapIter(rest, PhantomData)))
            }
            _ => None,
        }
    }
}

impl<K, V> IntoIterator for #{K => V} {
    type Item = (K, V);
    type IntoIter = MapIter<K, V>;

    #[inline]
    fn into_iter(self) -> MapIter<K, V> {
        self.iter()
    }
}

impl<K, V: PartialEq> PartialEq for #{K => V} {
    default fn eq(self, other: #{K => V}) -> bool {
        if self.len() != other.len() {
            return false;
        }
        for (key, value) in self {
            if other.get(key) != Some(value) {
                return false;
            }
        }
        true
    }
}

// Keys need no bound: map keys are always compared as exact terms.
impl<K, V: NativeEq> NativeEq for #{K => V} {}

impl<K, V: NativeEq> PartialEq for #{K => V} {
    #[inline]
    fn eq(self, other: #{K => V}) -> bool {
        self as term == other as term
    }
}
