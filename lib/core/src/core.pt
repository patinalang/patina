pub trait StructuralPartialEq {}

#[repr(tagged, tag_style = "snake_case")]
pub enum ControlFlow<B, C = ()> {
    #[lang = "Continue"]
    Continue(C),
    #[lang = "Break"]
    Break(B),
}

#[lang = "Try"]
pub trait Try: FromResidual {
    type Output;
    type Residual;

    #[lang = "from_output"]
    fn from_output(output: Self::Output) -> Self;

    #[lang = "branch"]
    fn branch(self) -> ControlFlow<Self::Residual, Self::Output>;
}

pub trait FromResidual<R = <Self as Try>::Residual> {
    #[lang = "from_residual"]
    fn from_residual(residual: R) -> Self;
}

/// A field of this type uses a type parameter without storing anything.
///
/// `PhantomData` fields have no runtime representation; they are only visible in the type system,
/// and they don't contribute to the decision on `#[repr(...)]`. For example,
/// `struct S(int, PhantomData<str>)` can still be `#[repr(transparent)]`.
/// 
/// The type argument decides the variance of the parameter:
/// - `PhantomData<T>`: covariant, for a type that holds or produces `T` values.
/// - `PhantomData<fn(T)>`: contravariant, for a type that consumes `T` values.
/// - `PhantomData<fn(T) -> T>`: invariant.
#[lang = "phantom_data"]
pub struct PhantomData<T>;

/// A half-open range `start..end`.
#[lang = "Range"]
pub struct Range<Idx> {
    pub start: Idx,
    pub end: Idx,
}

/// A closed range `start..=end`.
#[lang = "RangeInclusive"]
pub struct RangeInclusive<Idx> {
    pub start: Idx,
    pub end: Idx,
}

impl<Idx> RangeInclusive<Idx> {
    #[lang = "range_inclusive_new"]
    pub fn new(start: Idx, end: Idx) -> RangeInclusive<Idx> {
        RangeInclusive { start, end }
    }
}

impl term {
    /// Asserts, without checking, that this term is a value of type `T`.
    ///
    /// # Safety
    ///
    /// The term must be a value of type `T`, e.g. the result of an external function known to
    /// return one. Otherwise, the program misbehaves where the value is used.
    #[rustc_intrinsic]
    pub unsafe fn cast_unchecked<T>(self) -> T;
}

/// A lazy sequence of values.
#[lang = "iterator"]
pub trait Iterator {
    type Item;

    #[lang = "next"]
    fn next(self) -> Option<(Self::Item, Self)>;
}

/// A value that can be turned into an iterator.
pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;

    #[lang = "into_iter"]
    fn into_iter(self) -> Self::IntoIter;
}

impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;

    #[inline]
    fn into_iter(self) -> I {
        self
    }
}

#[repr(transparent)]
pub struct ListIter<T>([T]);

#[repr(transparent)]
pub struct MapIter<K, V>(term, PhantomData<(K, V)>);

impl Iterator for Range<int> {
    type Item = int;

    #[inline]
    fn next(self) -> Option<(int, Range<int>)> {
        if self.start < self.end {
            Some((self.start, Range { start: self.start + 1, ..self }))
        } else {
            None
        }
    }
}

impl Iterator for RangeInclusive<int> {
    type Item = int;

    #[inline]
    fn next(self) -> Option<(int, RangeInclusive<int>)> {
        if self.start <= self.end {
            Some((self.start, RangeInclusive { start: self.start + 1, ..self }))
        } else {
            None
        }
    }
}

#[lang = "timeout"]
pub enum Timeout {
    #[repr(transparent)]
    Millis(int),
    #[repr(atom, tag = "infinity")]
    Infinity,
}

#[lang = "exception_class"]
#[repr(tagged, tag_style = "snake_case")]
pub enum ExceptionClass {
    Error(term),
    Throw(term),
    Exit(term),
}

impl Timeout {
    #[inline]
    pub fn from_millis(ms: int) -> Timeout {
        Timeout::Millis(ms)
    }
    #[inline]
    pub fn from_seconds(s: int) -> Timeout {
        Timeout::Millis(s * 1000)
    }
    #[inline]
    pub fn from_minutes(m: int) -> Timeout {
        Timeout::Millis(m * 60000)
    }
}

/// Imported with `#[prelude_import]`.
pub mod prelude {
    pub use pkg::option::Option::{self, None, Some};
    pub use pkg::result::Result::{self, Ok, Err};
    pub use pkg::{
        Copy, Fn, FnOnce, IntoIterator, Iterator, NativeEq, PartialEq, PartialOrd, Timeout,
        convert::{From, Into},
        derive,
    };
}
