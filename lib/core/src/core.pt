#[lang = "eq"]
pub trait PartialEq<Rhs = Self> {
    #[must_use]
    fn eq(self, other: Rhs) -> bool;

    #[inline]
    #[must_use]
    fn ne(self, other: Rhs) -> bool {
        !self.eq(other)
    }
}

macro_rules! partial_eq_impl {
    ($($t:ty)*) => ($(
        impl PartialEq for $t {
            #[inline]
            fn eq(self, other: $t) -> bool { self == other }
        }
    )*)
}
partial_eq_impl! { bool int float str atom bin bits char term }

/// `T: NativeEq` means that `==` on `T` is exact term matching (`=:=`).
///
/// Implementing `NativeEq` for a type whose `PartialEq` isn't `=:=` is a logic error.
#[lang = "native_eq"]
pub trait NativeEq: PartialEq {}

macro_rules! native_eq_impl {
    ($($t:ty)*) => ($(
        impl NativeEq for $t {}
    )*)
}
native_eq_impl! { bool int float str atom bin bits char term }
impl NativeEq for () {}

impl PartialEq for () {
    fn eq(self, _other: ()) -> bool {
        true
    }
}

macro_rules! tuple_partial_eq_impls {
    ($T:ident) => {
        tuple_partial_eq_impls!(@impl $T);
    };
    ($T:ident $($U:ident)+) => {
        tuple_partial_eq_impls!($($U)+);
        tuple_partial_eq_impls!(@impl $T $($U)+);
    };
    (@impl $($T:ident)+) => {
        impl<$($T: PartialEq),+> PartialEq for ($($T,)+) {
            default fn eq(self, other: ($($T,)+)) -> bool {
                $( ${ignore($T)} self.${index()} == other.${index()} )&&+
            }
        }

        impl<$($T: NativeEq),+> NativeEq for ($($T,)+) {}

        impl<$($T: NativeEq),+> PartialEq for ($($T,)+) {
            #[inline]
            fn eq(self, other: ($($T,)+)) -> bool {
                self as term == other as term
            }
        }
    };
}
tuple_partial_eq_impls! { A B C D E F G H I J K L }

impl<T: PartialEq> PartialEq for [T] {
    default fn eq(self, other: [T]) -> bool {
        match (self, other) {
            ([left, left_tail @ ..], [right, right_tail @ ..]) => {
                left == right && left_tail == right_tail
            }
            ([], []) => true,
            _ => false,
        }
    }
}

impl<T: NativeEq> NativeEq for [T] {}

impl<T: NativeEq> PartialEq for [T] {
    #[inline]
    fn eq(self, other: [T]) -> bool {
        self as term == other as term
    }
}

impl<K, V: PartialEq> PartialEq for #{K => V} {
    default fn eq(self, other: #{K => V}) -> bool {
        if self.size() != other.size() {
            return false;
        }
        for (key, value) in self {
            if other.get(key) != Some(value) {
                return false;
            }
        }
        true
    }
}

// Keys need no bound: map keys are always compared as exact terms.
impl<K, V: NativeEq> NativeEq for #{K => V} {}

impl<K, V: NativeEq> PartialEq for #{K => V} {
    #[inline]
    fn eq(self, other: #{K => V}) -> bool {
        self as term == other as term
    }
}

#[lang = "partial_ord"]
pub trait PartialOrd<Rhs = Self> {
    #[must_use]
    fn lt(self, other: Rhs) -> bool;
    #[must_use]
    fn le(self, other: Rhs) -> bool;
    #[must_use]
    fn gt(self, other: Rhs) -> bool;
    #[must_use]
    fn ge(self, other: Rhs) -> bool;
}

macro_rules! partial_ord_impl {
    ($($t:ty)*) => ($(
        impl PartialOrd for $t {
            fn lt(self, other: $t) -> bool { self < other }
            fn le(self, other: $t) -> bool { self <= other }
            fn gt(self, other: $t) -> bool { self > other }
            fn ge(self, other: $t) -> bool { self >= other }
        }
    )*)
}

partial_ord_impl! { bool int float str atom bin bits }

#[lang = "structural_peq"]
pub trait StructuralPartialEq {}

#[lang = "Option"]
#[repr(transparent)]
pub enum Option<T> {
    #[lang = "None"]
    #[repr(atom, tag = "nil")]
    None,
    #[lang = "Some"]
    #[repr(dynamic_wrap, tag = "some")]
    Some(T),
}

impl<T: PartialEq> PartialEq for Option<T> {
    default fn eq(self, other: Option<T>) -> bool {
        match (self, other) {
            (Some(left), Some(right)) => left == right,
            (None, None) => true,
            _ => false,
        }
    }
}

impl<T: NativeEq> NativeEq for Option<T> {}

impl<T: NativeEq> PartialEq for Option<T> {
    #[inline]
    fn eq(self, other: Option<T>) -> bool {
        self as term == other as term
    }
}

impl<T> Try for Option<T> {
    type Output = T;
    type Residual = Option<!>;

    #[inline]
    fn from_output(output: T) -> Option<T> {
        Some(output)
    }

    #[inline]
    fn branch(self) -> ControlFlow<Option<!>, T> {
        match self {
            Some(value) => ControlFlow::Continue(value),
            None => ControlFlow::Break(None),
        }
    }
}

impl<T> FromResidual<Option<!>> for Option<T> {
    #[inline]
    fn from_residual(_residual: Option<!>) -> Option<T> {
        None
    }
}

#[repr(tagged, tag_style = "snake_case")]
pub enum ControlFlow<B, C = ()> {
    #[lang = "Continue"]
    Continue(C),
    #[lang = "Break"]
    Break(B),
}

#[lang = "Try"]
pub trait Try: FromResidual {
    type Output;
    type Residual;

    #[lang = "from_output"]
    fn from_output(output: Self::Output) -> Self;

    #[lang = "branch"]
    fn branch(self) -> ControlFlow<Self::Residual, Self::Output>;
}

pub trait FromResidual<R = <Self as Try>::Residual> {
    #[lang = "from_residual"]
    fn from_residual(residual: R) -> Self;
}

/// A field of this type uses a type parameter without storing anything.
///
/// `PhantomData` fields have no runtime representation; they are only visible in the type system,
/// and they don't contribute to the decision on `#[repr(...)]`. For example,
/// `struct S(int, PhantomData<str>)` can still be `#[repr(transparent)]`.
/// 
/// The type argument decides the variance of the parameter:
/// - `PhantomData<T>`: covariant, for a type that holds or produces `T` values.
/// - `PhantomData<fn(T)>`: contravariant, for a type that consumes `T` values.
/// - `PhantomData<fn(T) -> T>`: invariant.
#[lang = "phantom_data"]
pub struct PhantomData<T>;

/// A half-open range `start..end`.
#[lang = "Range"]
pub struct Range<Idx> {
    pub start: Idx,
    pub end: Idx,
}

/// A closed range `start..=end`.
#[lang = "RangeInclusive"]
pub struct RangeInclusive<Idx> {
    pub start: Idx,
    pub end: Idx,
}

impl<Idx> RangeInclusive<Idx> {
    #[lang = "range_inclusive_new"]
    pub fn new(start: Idx, end: Idx) -> RangeInclusive<Idx> {
        RangeInclusive { start, end }
    }
}

impl term {
    /// Asserts, without checking, that this term is a value of type `T`.
    ///
    /// # Safety
    ///
    /// The term must be a value of type `T`, e.g. the result of an external function known to
    /// return one. Otherwise, the program misbehaves where the value is used.
    #[rustc_intrinsic]
    pub unsafe fn cast_unchecked<T>(self) -> T;
}

extern mod lists;
extern mod maps;

use crate::Option::{None, Some};

impl<T> [T] {
    /// Returns a lazy iterator over the elements of the list.
    #[inline]
    #[must_use]
    pub fn iter(self) -> ListIter<T> {
        ListIter(self)
    }

    /// Returns the number of elements in the list by walking the whole list.
    #[inline]
    #[must_use]
    pub fn len(self) -> int {
        unsafe { erlang::length(self).cast_unchecked() }
    }

    /// Returns `true` if the list has no elements.
    #[inline]
    #[must_use]
    pub fn is_empty(self) -> bool {
        match self {
            [] => true,
            _ => false,
        }
    }

    /// Returns the first element, or `None` if the list is empty.
    #[inline]
    #[must_use]
    pub fn head(self) -> Option<T> {
        match self {
            [head, ..] => Some(head),
            [] => None,
        }
    }

    /// Returns the list without its first element.
    ///
    /// The tail of an empty list is an empty list.
    #[inline]
    #[must_use]
    pub fn tail(self) -> [T] {
        match self {
            [_, tail @ ..] => tail,
            [] => [],
        }
    }

    /// Returns the last element, or `None` if the list is empty.
    #[inline]
    #[must_use]
    pub fn last(self) -> Option<T> {
        match self {
            [] => None,
            _ => Some(unsafe { lists::last(self).cast_unchecked() }),
        }
    }

    /// Returns the element at the zero-based `index`, or `None` if it's out of bounds.
    #[inline]
    #[must_use]
    pub fn get(self, index: int) -> Option<T> {
        match self {
            [head, ..] if index == 0 => Some(head),
            [_, tail @ ..] if index > 0 => tail.get(index - 1),
            _ => None,
        }
    }

    /// Returns `true` if the list has an element that is exactly `value`.
    #[inline]
    #[must_use]
    pub fn contains(self, value: T) -> bool {
        unsafe { lists::member(value, self).cast_unchecked() }
    }

    /// Returns the list in reverse order.
    #[inline]
    #[must_use]
    pub fn reverse(self) -> [T] {
        unsafe { lists::reverse(self).cast_unchecked() }
    }

    /// Returns the elements of `self` followed by the elements of `other`.
    ///
    /// This copies `self`, but shares `other`.
    #[must_use]
    pub fn concat(self, other: [T]) -> [T] {
        unsafe { lists::append(self, other).cast_unchecked() }
    }
}

impl<K, V> #{K => V} {
    /// Returns a lazy iterator over the `(key, value)` entries of the map, in undefined order.
    #[inline]
    #[must_use]
    pub fn iter(self) -> MapIter<K, V> {
        MapIter(unsafe { maps::iterator(self).cast_unchecked() }, PhantomData)
    }

    /// Returns the number of entries in the map.
    #[inline]
    #[must_use]
    pub fn size(self) -> int {
        unsafe { erlang::map_size(self).cast_unchecked() }
    }

    /// Returns `true` if the map has no entries.
    #[inline]
    #[must_use]
    pub fn is_empty(self) -> bool {
        self.size() == 0
    }

    /// Returns the value stored under `key`, or `None` if there is none.
    #[inline]
    #[must_use]
    pub fn get(self, key: K) -> Option<V> {
        match self {
            #{^key => value, ..} => Some(value),
            _ => None,
        }
    }

    /// Returns the value stored under `key`, or `default` if there is none.
    #[inline]
    #[must_use]
    pub fn get_or(self, key: K, default: V) -> V {
        unsafe { maps::get(key, self, default).cast_unchecked() }
    }

    /// Returns `true` if the map has an entry for `key`.
    #[inline]
    #[must_use]
    pub fn contains_key(self, key: K) -> bool {
        unsafe { maps::is_key(key, self).cast_unchecked() }
    }

    /// Returns a map with `key` set to `value`, replacing any previous value.
    #[inline]
    #[must_use]
    pub fn insert(self, key: K, value: V) -> #{K => V} {
        unsafe { maps::put(key, value, self).cast_unchecked() }
    }

    /// Returns a map without the entry for `key`.
    #[inline]
    #[must_use]
    pub fn remove(self, key: K) -> #{K => V} {
        unsafe { maps::remove(key, self).cast_unchecked() }
    }

    /// Returns a map with the entries of both maps. Where both have a key, `other`'s value wins.
    #[inline]
    #[must_use]
    pub fn merge(self, other: #{K => V}) -> #{K => V} {
        unsafe { maps::merge(self, other).cast_unchecked() }
    }

    /// Returns the keys of the map, in arbitrary order.
    #[inline]
    #[must_use]
    pub fn keys(self) -> [K] {
        unsafe { maps::keys(self).cast_unchecked() }
    }

    /// Returns the values of the map, in arbitrary order.
    #[inline]
    #[must_use]
    pub fn values(self) -> [V] {
        unsafe { maps::values(self).cast_unchecked() }
    }

    /// Returns the `(key, value)` entries of the map, in arbitrary order.
    #[inline]
    #[must_use]
    pub fn to_list(self) -> [(K, V)] {
        unsafe { maps::to_list(self).cast_unchecked() }
    }
}

/// A lazy sequence of values.
#[lang = "iterator"]
pub trait Iterator {
    type Item;

    #[lang = "next"]
    fn next(self) -> Option<(Self::Item, Self)>;
}

/// A value that can be turned into an iterator.
pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;

    #[lang = "into_iter"]
    fn into_iter(self) -> Self::IntoIter;
}

impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;

    #[inline]
    fn into_iter(self) -> I {
        self
    }
}

#[repr(transparent)]
pub struct ListIter<T>([T]);

impl<T> Iterator for ListIter<T> {
    type Item = T;

    #[inline]
    fn next(self) -> Option<(T, ListIter<T>)> {
        match self.0 {
            [head, tail @ ..] => Some((head, ListIter(tail))),
            [] => None,
        }
    }
}

impl<T> IntoIterator for [T] {
    type Item = T;
    type IntoIter = ListIter<T>;

    #[inline]
    fn into_iter(self) -> ListIter<T> {
        self.iter()
    }
}

#[repr(transparent)]
pub struct MapIter<K, V>(term, PhantomData<(K, V)>);

impl<K, V> Iterator for MapIter<K, V> {
    type Item = (K, V);

    #[inline]
    fn next(self) -> Option<((K, V), MapIter<K, V>)> {
        match maps::next(self.0) {
            (key, value, rest) => {
                let entry = unsafe { (key.cast_unchecked(), value.cast_unchecked()) };
                Some((entry, MapIter(rest, PhantomData)))
            }
            _ => None,
        }
    }
}

impl<K, V> IntoIterator for #{K => V} {
    type Item = (K, V);
    type IntoIter = MapIter<K, V>;

    #[inline]
    fn into_iter(self) -> MapIter<K, V> {
        self.iter()
    }
}

impl Iterator for Range<int> {
    type Item = int;

    #[inline]
    fn next(self) -> Option<(int, Range<int>)> {
        if self.start < self.end {
            Some((self.start, Range { start: self.start + 1, ..self }))
        } else {
            None
        }
    }
}

impl Iterator for RangeInclusive<int> {
    type Item = int;

    #[inline]
    fn next(self) -> Option<(int, RangeInclusive<int>)> {
        if self.start <= self.end {
            Some((self.start, RangeInclusive { start: self.start + 1, ..self }))
        } else {
            None
        }
    }
}

#[lang = "timeout"]
pub enum Timeout {
    #[repr(transparent)]
    Millis(int),
    #[repr(atom, tag = "infinity")]
    Infinity,
}

#[lang = "exception_class"]
#[repr(tagged, tag_style = "snake_case")]
pub enum ExceptionClass {
    Error(term),
    Throw(term),
    Exit(term),
}

impl Timeout {
    #[inline]
    pub fn from_millis(ms: int) -> Timeout {
        Timeout::Millis(ms)
    }
    #[inline]
    pub fn from_seconds(s: int) -> Timeout {
        Timeout::Millis(s * 1000)
    }
    #[inline]
    pub fn from_minutes(m: int) -> Timeout {
        Timeout::Millis(m * 60000)
    }
}

/// Imported with `#[prelude_import]`.
pub mod prelude {
    pub use crate::Option::{None, Some};
    pub use crate::{
        Copy, Fn, FnOnce, IntoIterator, Iterator, NativeEq, Option, PartialEq, PartialOrd, Timeout,
        derive,
    };
}
