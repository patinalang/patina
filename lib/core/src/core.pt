#[lang = "eq"]
pub trait PartialEq<Rhs = Self> {
    #[must_use]
    fn eq(self, other: Rhs) -> bool;

    #[inline]
    #[must_use]
    fn ne(self, other: Rhs) -> bool {
        !self.eq(other)
    }
}

macro_rules! partial_eq_impl {
    ($($t:ty)*) => ($(
        impl PartialEq for $t {
            #[inline]
            fn eq(self, other: $t) -> bool { self == other }
        }
    )*)
}
partial_eq_impl! { bool int float str atom bin bits char term pid port ref }

/// `T: NativeEq` means that `==` on `T` is exact term matching (`=:=`).
///
/// Implementing `NativeEq` for a type whose `PartialEq` isn't `=:=` is a logic error.
#[lang = "native_eq"]
pub trait NativeEq: PartialEq {}

macro_rules! native_eq_impl {
    ($($t:ty)*) => ($(
        impl NativeEq for $t {}
    )*)
}
native_eq_impl! { bool int float str atom bin bits char term pid port ref }
impl NativeEq for () {}

impl PartialEq for () {
    fn eq(self, _other: ()) -> bool {
        true
    }
}

macro_rules! tuple_partial_eq_impls {
    ($T:ident) => {
        tuple_partial_eq_impls!(@impl $T);
    };
    ($T:ident $($U:ident)+) => {
        tuple_partial_eq_impls!($($U)+);
        tuple_partial_eq_impls!(@impl $T $($U)+);
    };
    (@impl $($T:ident)+) => {
        impl<$($T: PartialEq),+> PartialEq for ($($T,)+) {
            default fn eq(self, other: ($($T,)+)) -> bool {
                $( ${ignore($T)} self.${index()} == other.${index()} )&&+
            }
        }

        impl<$($T: NativeEq),+> NativeEq for ($($T,)+) {}

        impl<$($T: NativeEq),+> PartialEq for ($($T,)+) {
            #[inline]
            fn eq(self, other: ($($T,)+)) -> bool {
                self as term == other as term
            }
        }
    };
}
tuple_partial_eq_impls! { A B C D E F G H I J K L }


#[lang = "partial_ord"]
pub trait PartialOrd<Rhs = Self> {
    #[must_use]
    fn lt(self, other: Rhs) -> bool;
    #[must_use]
    fn le(self, other: Rhs) -> bool;
    #[must_use]
    fn gt(self, other: Rhs) -> bool;
    #[must_use]
    fn ge(self, other: Rhs) -> bool;
}

macro_rules! partial_ord_impl {
    ($($t:ty)*) => ($(
        impl PartialOrd for $t {
            fn lt(self, other: $t) -> bool { self < other }
            fn le(self, other: $t) -> bool { self <= other }
            fn gt(self, other: $t) -> bool { self > other }
            fn ge(self, other: $t) -> bool { self >= other }
        }
    )*)
}

partial_ord_impl! { bool int float str atom bin bits term pid port ref }

