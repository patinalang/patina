#![allow(internal_features)]
#![feature(
    no_core,
    lang_items,
    rustc_attrs,
    unboxed_closures,
    fundamental,
    arbitrary_self_types,
    decl_macro,
    intrinsics,
    macro_metavar_expr,
    min_specialization,
    allow_internal_unstable
)]
#![no_std]
#![no_core]
#![rustc_coherence_is_core]

#[macro_export]
macro_rules! panic {
    () => { $pkg::panic!(@raise "explicit panic") };
    ($msg:literal) => { $pkg::panic!(@raise $msg) };
    (@raise $msg:expr) => {
        unsafe {
            $pkg::erlang::error(
                $pkg::Panic::new($msg),
                a"none",
                [(a"error_info", #{a"module" => a"Elixir.Patina.Core.Panic"})],
            )
            .cast_unchecked::<!>()
        }
    };
}

#[macro_export]
macro_rules! todo {
    () => { $pkg::panic!(@raise "not yet implemented") };
    ($msg:literal) => { $pkg::panic!(@raise $pkg::concat!("not yet implemented: ", $msg)) };
}

#[macro_export]
#[rustc_diagnostic_item = "matches_macro"]
#[allow_internal_unstable(non_exhaustive_omitted_patterns_lint, stmt_expr_attributes)]
macro_rules! matches {
    ($expression:expr, $pattern:pat $(if $guard:expr)? $(,)?) => {
        #[allow(non_exhaustive_omitted_patterns)]
        match $expression {
            $pattern $(if $guard)? => true,
            _ => false
        }
    };
}

