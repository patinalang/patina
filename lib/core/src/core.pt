#![allow(internal_features)]
#![feature(
    no_core,
    lang_items,
    rustc_attrs,
    unboxed_closures,
    fundamental,
    arbitrary_self_types,
    decl_macro,
    intrinsics,
    macro_metavar_expr,
    min_specialization,
    never_type,
    allow_internal_unstable
)]
#![no_std]
#![no_core]
#![rustc_coherence_is_core]

pub mod proc_macro;

pub extern mod erlang;
pub extern mod io;
pub extern mod patina_fmt;
pub extern mod unicode;

#[macro_export]
#[rustc_builtin_macro]
macro_rules! stringify {
    () => {};
}

#[macro_export]
#[rustc_builtin_macro]
macro_rules! concat {
    () => {};
}

#[macro_export]
#[rustc_builtin_macro]
macro_rules! format_args {
    () => {};
}

#[rustc_builtin_macro]
pub macro derive($item:item) {}

#[macro_export]
macro_rules! print {
    ($($arg:tt)*) => {{ $crate::io::put_chars($crate::format_args!($($arg)*)); }};
}

#[macro_export]
macro_rules! println {
    () => {{ $crate::io::nl(); }};
    ($($arg:tt)*) => {{ $crate::io::put_chars([$crate::format_args!($($arg)*)]); $crate::io::nl(); }};
}

#[macro_export]
macro_rules! format {
    ($($arg:tt)*) => {
        unsafe {
            $crate::unicode::characters_to_binary($crate::format_args!($($arg)*))
                .cast_unchecked::<str>()
        }
    };
}

#[macro_export]
macro_rules! assert_eq {
    (@impl $left:expr, $right:expr, $message:expr) => {
        match ($left, $right) {
            (left_val, right_val) => {
                if !(left_val == right_val) {
                    $crate::panic!(@raise $crate::format!(
                        "assertion `left == right` failed{}\n  left: {:?}\n right: {:?}",
                        $message,
                        left_val,
                        right_val,
                    ))
                }
            }
        }
    };
    ($left:expr, $right:expr $(,)?) => {
        $crate::assert_eq!(@impl $left, $right, "")
    };
    ($left:expr, $right:expr, $($arg:tt)+) => {
        $crate::assert_eq!(@impl $left, $right, $crate::format!(": {}", $crate::format!($($arg)+)))
    };
}

#[repr(Elixir)]
pub struct Panic {
    __exception__: bool,
    pub message: str,
}

impl Panic {
    pub fn new(message: str) -> Panic {
        Panic { __exception__: true, message }
    }

    pub fn message(self) -> str {
        self.message
    }

    pub fn format_error(reason: Panic, _stacktrace: term) -> #{atom => str} {
        #{a"reason" => "panic: " + reason.message()}
    }
}

#[macro_export]
#[allow_internal_unstable(never_type)]
macro_rules! panic {
    () => { $crate::panic!(@raise "explicit panic") };
    ($msg:literal) => { $crate::panic!(@raise $msg) };
    (@raise $msg:expr) => {
        unsafe {
            $crate::erlang::error(
                $crate::Panic::new($msg),
                a"none",
                [(a"error_info", #{a"module" => a"Elixir.Patina.Core.Panic"})],
            )
            .cast_unchecked::<!>()
        }
    };
}

#[macro_export]
macro_rules! todo {
    () => { $crate::panic!(@raise "not yet implemented") };
    ($msg:literal) => { $crate::panic!(@raise $crate::concat!("not yet implemented: ", $msg)) };
}

