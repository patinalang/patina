#[lang = "not"]
pub trait Not {
    type Output;

    #[must_use]
    fn not(self) -> Self::Output;
}

impl Not for bool {
    type Output = bool;
    fn not(self) -> bool {
        !self
    }
}

impl Not for int {
    type Output = int;
    fn not(self) -> int {
        !self
    }
}

#[lang = "neg"]
pub trait Neg {
    type Output;

    #[must_use = "this returns the result of the operation, without modifying the original"]
    fn neg(self) -> Self::Output;
}

macro_rules! neg_impl {
    ($($t:ty)*) => ($(
        impl Neg for $t {
            type Output = $t;
            fn neg(self) -> $t { -self }
        }
    )*)
}

neg_impl! { int float }

