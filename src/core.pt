macro_rules! mul_impl {
    ($($t:ty)*) => ($(
        impl const Mul for $t {
            type Output = $t;
            fn mul(self, other: $t) -> $t { self * other }
        }
        impl const MulAssign for $t {
            fn mul_assign(&mut self, other: $t) { *self *= other; }
        }
    )*)
}

mul_impl! { int float }

