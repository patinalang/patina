rem_impl! { int float }

#[lang = "not"]
pub const trait Not {
    type Output;

    #[must_use]
    fn not(self) -> Self::Output;
}

impl const Not for bool {
    type Output = bool;
    fn not(self) -> bool {
        !self
    }
}

impl const Not for int {
    type Output = int;
    fn not(self) -> int {
        !self
    }
}

#[lang = "neg"]
pub const trait Neg {
    type Output;

    #[must_use = "this returns the result of the operation, without modifying the original"]
    fn neg(self) -> Self::Output;
}

macro_rules! neg_impl {
    ($($t:ty)*) => ($(
        impl const Neg for $t {
            type Output = $t;
            fn neg(self) -> $t { -self }
        }
    )*)
}

neg_impl! { int float }

