#![allow(internal_features)]
#![feature(
    no_core,
    lang_items,
    rustc_attrs,
    unboxed_closures,
    fundamental,
    const_trait_impl,
    arbitrary_self_types
)]
#![no_std]
#![no_core]

#[lang = "pointee_sized"]
pub trait PointeeSized {}

#[lang = "meta_sized"]
pub trait MetaSized: PointeeSized {}

#[lang = "sized"]
pub trait Sized: MetaSized {}

#[lang = "copy"]
pub trait Copy {}
